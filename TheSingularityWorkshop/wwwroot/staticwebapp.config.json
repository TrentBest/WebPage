{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [ "/Workshop/*" ]
  },
  "mimeTypes": {
    ".wasm": "application/wasm",
    ".dll": "application/octet-stream",
    ".data": "application/octet-stream",
    ".br": "application/brotli",
    ".gz": "application/gzip",
    ".js": "text/javascript",
    ".json": "application/json"
  },
  "globalHeaders": {
    "Cache-Control": "no-cache"
  }
}