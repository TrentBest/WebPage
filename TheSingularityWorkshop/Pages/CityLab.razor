@page "/city-lab"
@layout BareLayout
@using Microsoft.AspNetCore.Components
@using TheSingularityWorkshop.Workshop.City

<PageTitle>Singularity City // City Lab</PageTitle>

<main class="city-lab @(_skin)" data-skin="@_skin">
    <header class="lab-header">
        <a href="/digitens" class="lab-back">← DIGITENS</a>
        <div class="lab-eyebrow">THE SINGULARITY WORKSHOP / WORLD GENERATION TEST</div>
        <h1>Singularity <em>City Lab</em></h1>
        <p>One city model. Three possible futures. Change the skin; the streets, structures, and their identities stay the same.</p>
        <div class="lab-controls" role="group" aria-label="City visual skin">
            <button class="skin-button noir @(_skin == "noir" ? "active" : "")" aria-pressed="@(_skin == "noir")" @onclick="SelectNoirSkin"><span></span><strong>01 / NOIR</strong><small>Neon density · cyberpunk</small></button>
            <button class="skin-button metro @(_skin == "metro" ? "active" : "")" aria-pressed="@(_skin == "metro")" @onclick="SelectMetroSkin"><span></span><strong>02 / METRO</strong><small>Future New York · lived-in</small></button>
            <button class="skin-button solarpunk @(_skin == "solarpunk" ? "active" : "")" aria-pressed="@(_skin == "solarpunk")" @onclick="SelectHarmonySkin"><span></span><strong>03 / HARMONY</strong><small>Green infrastructure · human-scale</small></button>
        </div>
        <div class="view-controls" role="group" aria-label="Choose city observation mode">
            <span class="lab-eyebrow">SAME WORLD / CHANGE THE OBSERVER</span>
            <button class="view-button @(_viewMode == "isometric" ? "active" : "")" aria-pressed="@(_viewMode == "isometric")" @onclick='() => SetViewMode("isometric")'>01 / CITY OVERVIEW</button>
            <button class="view-button @(_viewMode == "plan" ? "active" : "")" aria-pressed="@(_viewMode == "plan")" @onclick='() => SetViewMode("plan")'>02 / TOP-DOWN PLAN</button>
            <button class="view-button @(_viewMode == "street" ? "active" : "")" aria-pressed="@(_viewMode == "street")" @onclick='() => SetViewMode("street")'>03 / STREET VIEW</button>
            <button class="view-button @(_viewMode == "pipeline" ? "active" : "")" aria-pressed="@(_viewMode == "pipeline")" disabled="@(!PipelineAvailable)" @onclick='() => SetViewMode("pipeline")'>04 / RENDERER → VISUALIZE</button>
        </div>
    </header>

    <section class="city-history" aria-labelledby="city-history-title">
        <div class="history-heading">
            <span class="lab-eyebrow">THE CITY IS A STORY / HISTORICAL AND SPECULATIVE ERAS</span>
            <h2 id="city-history-title">From harbor settlement to sovereign megacity.</h2>
            <p>Choose a moment in the city's evolution. Each chapter changes the massing input and the civic story together. Historical milestones are grounded in New York history; future chapters are explicitly a fictional planning scenario, not a prediction.</p>
        </div>
        <div class="history-timeline" role="group" aria-label="Choose a city-history era">
            @foreach (var historyEra in CityEras)
            {
                <button @key="historyEra.Id" class="era-button @(historyEra.Id == _selectedEra ? "active" : "")" aria-pressed="@(historyEra.Id == _selectedEra)" @onclick="() => SelectEra(historyEra.Id)">
                    <span class="era-year">@historyEra.YearLabel</span>
                    <strong>@historyEra.Title</strong>
                    <small>@historyEra.StageLabel</small>
                </button>
            }
        </div>
        @if (SelectedEra is { } era)
        {
            <article class="history-chapter">
                <div class="chapter-era"><span>@era.YearLabel</span><strong>@era.Title</strong><small>@era.StageLabel</small></div>
                <div class="chapter-story">
                    <p class="chapter-summary">@era.Summary</p>
                    <dl>
                        <div><dt>WHY HERE?</dt><dd>@era.WhyHere</dd></div>
                        <div><dt>TURNING POINT</dt><dd>@era.TurningPoint</dd></div>
                        <div><dt>CIVIC LEADERSHIP</dt><dd>@era.Leadership</dd></div>
                    </dl>
                    <p class="chapter-boundary">@era.Boundary</p>
                </div>
            </article>
        }
    </section>

    <section class="lab-stage" aria-label="Procedural city model">
        <div class="stage-topline"><span>@ViewTitle</span><span>ONE DETERMINISTIC WORLD · @Buildings.Count STRUCTURES · @(_viewMode == "street" ? "CAMERA " + CameraX.ToString("0.0") + "," + CameraZ.ToString("0.0") + " / YAW " + CameraYaw.ToString("0") + "°" : "STABLE BUILDING IDS")</span></div>
        @if (_viewMode == "pipeline")
        {
            <div class="pipeline-readout">
                <span class="lab-eyebrow">REAL FRAME PATH / RENDERER → FRAME ADAPTER → VISUALIZE → GUI.SVG</span>
                <p>@_pipelineStatus</p>
            </div>
            <div class="camera-controls" role="group" aria-label="Move observer for Renderer pipeline">
                <button @onclick="MoveLeft" aria-label="Pipeline move left">← LEFT</button>
                <button @onclick="MoveForward" aria-label="Pipeline move forward">↑ PIPELINE FORWARD</button>
                <button @onclick="MoveBack" aria-label="Pipeline move backward">↓ BACK</button>
                <button @onclick="MoveRight" aria-label="Pipeline move right">RIGHT →</button>
            </div>
            @if (PipelineAvailable && !string.IsNullOrWhiteSpace(_pipelineSvg))
            {
                <div class="pipeline-surface" role="img" aria-label="City buildings manifested from Renderer draw commands through Visualize and GUI.SVG">
                    @((MarkupString)_pipelineSvg)
                </div>
            }
            else
            {
                <div class="pipeline-unavailable">The live pipeline view is available in repository-source mode. The existing city views remain the host-side SVG prototype.</div>
            }
        }
        else if (_viewMode == "street")
        {
            <div class="camera-controls" role="group" aria-label="Move the first-person observer">
                <button @onclick="TurnLeft" aria-label="Turn left">↶ TURN</button>
                <button @onclick="MoveLeft" aria-label="Move left">← LEFT</button>
                <button @onclick="MoveForward" aria-label="Move forward">↑ FORWARD</button>
                <button @onclick="MoveBack" aria-label="Move backward">↓ BACK</button>
                <button @onclick="MoveRight" aria-label="Move right">RIGHT →</button>
                <button @onclick="TurnRight" aria-label="Turn right">TURN ↷</button>
            </div>
            <svg class="city-render street-render" viewBox="0 0 1000 620" role="img" aria-label="First-person perspective into the same procedurally generated city; move the observer to change the view">
                <defs><linearGradient id="street-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" class="atmosphere-top"/><stop offset="100%" class="atmosphere-bottom"/></linearGradient></defs>
                <rect width="1000" height="620" fill="url(#street-sky)" />
                <path d="M 0 620 L 410 300 L 590 300 L 1000 620 Z" class="street-road" />
                <path d="M 500 620 L 500 300 M 0 620 L 430 300 M 1000 620 L 570 300" class="street-lane" />
                @foreach (var building in StreetBuildings)
                {
                    <g @key="building.Id" class="street-building @building.Kind" data-entity-id="@building.Id">
                        <rect x="@building.X.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" y="@building.Top.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" width="@building.Width.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" height="@building.Height.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                        @if (building.Width > 9 && building.Height > 18)
                        {
                            <path d="@building.Windows" />
                        }
                    </g>
                }
                <path d="M 0 620 L 410 300 M 1000 620 L 590 300" class="street-curb" />
                <g class="street-hud"><text x="24" y="34">SINGULARITY CITY / STREET OBSERVER</text><text x="24" y="54">ENTITY IDS PERSIST · CAMERA TRANSFORM CHANGES</text><text x="976" y="34" text-anchor="end">YAW @CameraYaw.ToString("0")°</text></g>
            </svg>
        }
        else if (_viewMode == "plan")
        {
            <svg class="city-render plan-render" viewBox="0 0 1000 790" role="img" aria-label="Top-down plan of the same city model, with the current observer marked on the map">
                <rect width="1000" height="790" class="plan-ground" />
                @for (var gx = 0; gx <= 22; gx++)
                {
                    <path class="plan-grid" d="M @(30 + gx * 42) 24 V 750" />
                }
                @for (var gz = 0; gz <= 18; gz++)
                {
                    <path class="plan-grid" d="M 24 @(30 + gz * 40) H 970" />
                }
                @foreach (var district in Districts)
                {
                    <g @key="district.Id"><text class="plan-district-label" x="@district.LabelX" y="@district.LabelY">@district.Name</text></g>
                }
                @foreach (var building in WorldSnapshot.Entities)
                {
                    <rect @key="building.Id" class="plan-building @building.Kind" data-entity-id="@building.Id"
                          x="@((30 + building.GridX * 42).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                          y="@((30 + building.GridZ * 40).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))"
                          width="15" height="11" rx="1">
                        <title>Building @building.Id · @building.Kind · @building.Floors floors</title>
                    </rect>
                }
                <g class="plan-observer" transform="translate(@(30 + CameraX * 42) @(30 + CameraZ * 40)) rotate(@CameraYaw)">
                    <circle r="11" /><path d="M 0 -18 L -6 -5 L 6 -5 Z" />
                </g>
                <text class="plan-map-label" x="34" y="770">NORTH ↑ / ONE WORLD MODEL / OBSERVER MARKER</text>
            </svg>
        }
        else
        {
        <svg class="city-render" viewBox="0 0 1000 790" role="img" aria-label="Procedurally generated isometric futuristic city with hundreds of buildings, districts, and connected streets">
            <defs>
                <pattern id="city-ground-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                    <path d="M 20 0 L 0 0 0 20" class="ground-grid" fill="none" stroke-width="0.7" />
                </pattern>
                <linearGradient id="city-atmosphere" x1="0" y1="0" x2="0.8" y2="1">
                    <stop offset="0%" class="atmosphere-top" />
                    <stop offset="100%" class="atmosphere-bottom" />
                </linearGradient>
            </defs>
            <rect width="1000" height="790" fill="url(#city-atmosphere)" />
            <rect width="1000" height="790" fill="url(#city-ground-grid)" opacity=".28" />
            @foreach (var district in Districts)
            {
                <g @key="district.Id" class="district-mark">
                    <polygon points="@district.Points" class="district-plane" />
                    <text x="@district.LabelX" y="@district.LabelY" class="district-label">@district.Name</text>
                </g>
            }
            @foreach (var road in Roads)
            {
                <polyline @key="road.Id" points="@road.Points" class="city-road" />
            }
            <path d="@LeftFacesPath" class="building-left" />
            <path d="@RightFacesPath" class="building-right" />
            <path d="@RoofFacesPath" class="building-roof" />
            <path d="@WindowLinesPath" class="building-windows" />
            <path d="@LandmarkCrownsPath" class="building-crown" />
            <g class="workshop-anchor">
                <circle cx="500" cy="385" r="18" class="anchor-halo" />
                <circle cx="500" cy="385" r="5" class="anchor-core" />
                <path d="M 500 365 V 342 M 500 405 V 428 M 480 385 H 457 M 520 385 H 543" class="anchor-cross" />
                <text x="518" y="358" class="anchor-label">THE WORKSHOP</text>
                <text x="518" y="371" class="anchor-subtitle">FIXED COMPOSITION ANCHOR</text>
            </g>
        </svg>
        }
        <div class="stage-footer"><span>@StageLeftLabel</span><span>↓ SAME MODEL / NEW OBSERVATION ↓</span><span>@StageRightLabel</span></div>
    </section>

    <section class="lab-readout">
        <article class="readout-card">
            <span class="readout-label">WORLD DATA</span>
            <strong>@Buildings.Count</strong><p>Generated structures</p>
        </article>
        <article class="readout-card">
            <span class="readout-label">DENSITY MODEL</span>
            <strong>@DensityPerKm2.ToString("N0")</strong><p>Target residents / km² · adjustable input</p>
        </article>
        <article class="readout-card">
            <span class="readout-label">TALLEST STRUCTURE</span>
            <strong>@Buildings.Max(x => x.Floors) <small>floors</small></strong><p>Procedural height, not a real building</p>
        </article>
        <article class="readout-card">
            <span class="readout-label">REPRESENTATION</span>
            <strong>Massing</strong><p>District-scale geometry · no interior simulation yet</p>
        </article>
    </section>

    <section class="density-panel">
        <div><span class="lab-eyebrow">CITY STATISTICS / MODEL INPUT</span><h2>Ground the skyline in real urban patterns.</h2><p>Density is an active input to deterministic massing rules: it changes plot vacancy, structure clustering, and tower heights. Reference profiles use sourced 2020 Census population and land-area figures; their densities are converted to residents/km². The procedural geometry is a model response to density, not a census-calibrated map of individual buildings.</p></div>
        <label for="density-profile">Reference profile / planning scenario</label>
        <select id="density-profile" @bind="_selectedProfile" @bind:after="ApplySelectedProfile">
            @foreach (var cityProfile in CityProfiles)
            {
                <option value="@cityProfile.Id">@cityProfile.Name · 2020 Census · ~@cityProfile.DensityPerKm2.ToString("N0")/km²</option>
            }
            <option value="future-core">Dense future core · 40,000/km² planning assumption</option>
            <option value="arcology">Arcology stress test · 50,000/km² planning assumption</option>
            <option value="custom">Custom / slider value</option>
        </select>
        @if (SelectedProfile is { } profile)
        {
            <div class="profile-facts">
                <strong>@profile.Population.ToString("N0") residents</strong>
                <span>@profile.LandAreaSquareMiles.ToString("N2") sq mi land area · 2020 Census</span>
                <a href="@profile.SourceUrl" target="_blank" rel="noopener noreferrer">Open this borough's Census profile ↗</a>
            </div>
        }
        else if (_selectedProfile != "custom")
        {
            <div class="profile-facts"><strong>Planning scenario</strong><span>Density assumption, not an observed city statistic.</span></div>
        }
        <label for="density-input">Target population density <strong>@DensityPerKm2.ToString("N0") residents/km²</strong></label>
        <input id="density-input" type="range" min="5000" max="50000" step="1" value="@DensityPerKm2" @oninput="OnDensityChanged" />
        <div class="density-scale"><span>5,000 / km²</span><span>50,000 / km²</span></div>
        <p class="model-source">REFERENCE DATA: 2020 population density from U.S. Census Bureau QuickFacts, converted from people per square mile to people per km² (1 sq mi = 2.58999 km²): <a href="https://www.census.gov/quickfacts/table/EDU635214/36061" target="_blank" rel="noopener noreferrer">Manhattan ↗</a> · <a href="https://www.census.gov/quickfacts/fact/table/bronxcountynewyork/POP715223" target="_blank" rel="noopener noreferrer">Bronx ↗</a> · <a href="https://www.census.gov/quickfacts/fact/table/kingscountynewyork/EDU635223" target="_blank" rel="noopener noreferrer">Brooklyn ↗</a> · <a href="https://www.census.gov/quickfacts/fact/table/queenscountynewyork/POP060220" target="_blank" rel="noopener noreferrer">Queens ↗</a></p>
        <p class="model-boundary">MODEL BOUNDARY: the four NYC borough profiles are sourced; the future-core and arcology presets are planning assumptions. Density changes procedural building placement and height, not yet household distribution, census population allocation, or transport demand.</p>
    </section>

    <section class="reference-studies">
        <span class="lab-eyebrow">REFERENCE TRAILS / STUDY THE SCALE, NOT THE IP</span>
        <h2>Learn from the ambition. Build our own city.</h2>
        <div class="reference-links">
            <a href="https://unity.com/megacity" target="_blank" rel="noopener noreferrer"><strong>Unity · Megacity</strong><span>Large-scale real-time city technology demonstration ↗</span></a>
            <a href="https://experimental.design/work/asce" target="_blank" rel="noopener noreferrer"><strong>ASCE · Mega City</strong><span>Research-led future-city exploration across global, city, district, and street-corner views ↗</span></a>
        </div>
        <p>These are reference studies, not assets or designs to copy. Singularity City will be grounded in our own world model, documented urban statistics, Digitens, and the Renderer/Visualize pipeline.</p>
    </section>

    <footer class="lab-footer"><a href="/">THE SINGULARITY WORKSHOP</a><span>ONE WORLD MODEL · MANY REPRESENTATIONS · MANY POSSIBLE FUTURES</span></footer>
</main>

<style>
.city-lab{--bg:#050a12;--panel:#091522;--ink:#edf8ff;--muted:#9ab0bf;--line:#244253;--accent:#00eaff;--accent2:#ff3fd2;--ground:#0b1924;min-height:100vh;padding:clamp(1rem,3vw,3rem);background:var(--bg);color:var(--ink);font-family:Inter,system-ui,sans-serif}
.city-lab.metro{--bg:#101821;--panel:#18232b;--ink:#f0eee8;--muted:#aeb9bc;--line:#52616a;--accent:#f4bb68;--accent2:#76c9d1;--ground:#27353c}
.city-lab.solarpunk{--bg:#edf4e9;--panel:#dce9dc;--ink:#19372f;--muted:#506d62;--line:#a8c7b5;--accent:#1d8065;--accent2:#d28b46;--ground:#d4e7d9}
.lab-header{max-width:1500px;margin:0 auto 1.5rem}.lab-back,.lab-footer a{color:var(--accent);text-decoration:none;font-weight:800;font-size:.72rem;letter-spacing:.14em}.lab-eyebrow{font-size:.68rem;letter-spacing:.18em;color:var(--accent);font-weight:800;margin-top:1.2rem}.lab-header h1{font-size:clamp(2.6rem,7vw,6.4rem);line-height:.94;letter-spacing:-.065em;margin:.6rem 0 1rem}.lab-header h1 em{color:var(--accent);font-style:normal}.lab-header>p{max-width:780px;color:var(--muted);font-size:1.05rem;line-height:1.65}.lab-controls{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.7rem;margin-top:1.5rem}.skin-button{display:grid;grid-template-columns:3rem 1fr;grid-template-rows:auto auto;gap:.15rem .8rem;text-align:left;padding:1rem;background:var(--panel);border:1px solid var(--line);color:var(--ink);cursor:pointer}.skin-button>span{grid-row:1/3;width:3rem;height:3rem;border-radius:50%;border:3px solid var(--accent);background:linear-gradient(135deg,#060912,#ff2dd0,#00eaff)}.skin-button.metro>span{background:linear-gradient(135deg,#26343c,#f2ba6a,#76c9d1);border-color:#f4bb68}.skin-button.solarpunk>span{background:linear-gradient(135deg,#edf4e9,#7ab99b,#d28b46);border-color:#1d8065}.skin-button strong{font-size:.78rem;letter-spacing:.08em}.skin-button small{color:var(--muted);font-size:.75rem}.skin-button.active{border-color:var(--accent);box-shadow:inset 0 -3px var(--accent)}.city-history{max-width:1500px;margin:1rem auto 1.25rem;padding:clamp(1rem,3vw,2rem);background:var(--panel);border:1px solid var(--line)}.history-heading h2{font-size:clamp(1.6rem,4vw,3.2rem);line-height:1.05;letter-spacing:-.04em;margin:.5rem 0}.history-heading>p{max-width:900px;color:var(--muted);line-height:1.65}.history-timeline{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:.5rem;margin:1.5rem 0}.era-button{min-height:115px;display:flex;flex-direction:column;align-items:flex-start;gap:.45rem;padding:.85rem;background:var(--bg);border:1px solid var(--line);border-top:3px solid var(--line);color:var(--ink);text-align:left;cursor:pointer}.era-button.active,.era-button:focus-visible{border-color:var(--accent);border-top-color:var(--accent);outline:none}.era-year{font:800 .7rem ui-monospace,monospace;color:var(--accent);letter-spacing:.08em}.era-button strong{font-size:.83rem;line-height:1.2}.era-button small{margin-top:auto;color:var(--muted);font-size:.62rem;line-height:1.4}.history-chapter{display:grid;grid-template-columns:minmax(150px,.7fr) minmax(0,2fr);gap:1.5rem;padding:1.25rem 0 0;border-top:1px solid var(--line)}.chapter-era{display:flex;flex-direction:column;align-items:flex-start;gap:.4rem}.chapter-era span{font:800 .85rem ui-monospace,monospace;color:var(--accent)}.chapter-era strong{font-size:1.35rem;line-height:1.1}.chapter-era small{color:var(--muted);font-size:.68rem;letter-spacing:.08em}.chapter-summary{font-size:1rem;line-height:1.7;margin-top:0}.chapter-story dl{display:grid;gap:.65rem}.chapter-story dl>div{display:grid;grid-template-columns:minmax(115px,.5fr) minmax(0,2fr);gap:1rem}.chapter-story dt{font-size:.62rem;letter-spacing:.12em;font-weight:900;color:var(--accent)}.chapter-story dd{margin:0;color:var(--muted);font-size:.82rem;line-height:1.6}.chapter-boundary{padding:.7rem .9rem;border-left:3px solid var(--accent2);font-size:.72rem;line-height:1.55;color:var(--muted)}
.view-controls{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;margin-top:1rem;padding:.8rem 0;border-top:1px solid var(--line)}.view-controls .lab-eyebrow{margin:0 1rem 0 0}.view-button,.camera-controls button{padding:.7rem .85rem;background:var(--panel);border:1px solid var(--line);color:var(--ink);font:800 .65rem ui-monospace,monospace;letter-spacing:.06em;cursor:pointer}.view-button.active,.view-button:focus-visible{border-color:var(--accent);box-shadow:inset 0 -3px var(--accent);outline:none}.lab-stage{max-width:1500px;margin:0 auto;background:var(--panel);border:1px solid var(--line);overflow:hidden}.pipeline-readout{padding:.75rem 1rem;background:var(--bg);border-bottom:1px solid var(--line)}.pipeline-readout p{margin:.45rem 0 0;color:var(--muted);font:700 .7rem/1.6 ui-monospace,monospace}.pipeline-surface{width:100%;background:#07131d}.pipeline-surface svg{display:block;width:100%;height:auto;max-height:760px}.pipeline-unavailable{padding:2rem;color:var(--muted);line-height:1.6}.view-button:disabled{opacity:.4;cursor:not-allowed}.camera-controls{display:flex;gap:.4rem;flex-wrap:wrap;padding:.7rem 1rem;background:var(--bg)}.camera-controls button:hover{border-color:var(--accent);color:var(--accent)}.street-render{height:auto;min-height:420px}.street-road{fill:var(--ground);stroke:var(--accent);stroke-opacity:.25;stroke-width:2}.street-lane{fill:none;stroke:var(--accent);stroke-opacity:.4;stroke-width:2;stroke-dasharray:9 12}.street-curb{fill:none;stroke:var(--accent2);stroke-opacity:.5;stroke-width:3}.street-building rect{fill:var(--accent);fill-opacity:.32;stroke:var(--accent);stroke-opacity:.7;stroke-width:1}.street-building.tower rect,.street-building.landmark rect{fill:var(--accent2);fill-opacity:.48;stroke:var(--accent2)}.street-building path{fill:none;stroke:var(--ink);stroke-opacity:.6;stroke-width:1}.street-hud{fill:var(--accent);font:700 12px ui-monospace,monospace;letter-spacing:1px}.plan-ground{fill:var(--ground)}.plan-grid{fill:none;strok