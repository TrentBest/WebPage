@code {
    private string _skin = "noir";
    private string _viewMode = "isometric";
    private double CameraX = 10.5;
    private double CameraZ = 0.5;
    private double CameraYaw = 0;
    private string ViewTitle => _viewMode switch
    {
        "plan" => "WORLD SLICE / TOP-DOWN PLAN · SAME BUILDING IDENTITIES",
        "street" => "WORLD SLICE / FIRST-PERSON STREET VIEW · CAMERA-RELATIVE PROJECTION",
        _ => "WORLD SLICE / ISOMETRIC MASSING · HOST SVG PROTOTYPE"
    };
    private string StageLeftLabel => _viewMode switch { "plan" => "TOP-DOWN / SPATIAL INDEX", "street" => "STREET / OBSERVER-RELATIVE", _ => "OBSERVE THE WHOLE" };
    private string StageRightLabel => _viewMode switch { "plan" => "SELECT A DIFFERENT VIEW", "street" => "MOVE / TURN THE OBSERVER", _ => "ZOOM INTO A DISTRICT NEXT" };
    private string _pipelineSvg = string.Empty;
    private string _pipelineStatus = "Select this view to submit the city snapshot through Renderer and Visualize.";
    private bool PipelineAvailable
    {
        get
        {
#if WORKSHOP_USE_REPOSITORY_SOURCES
            return true;
#else
            return false;
#endif
        }
    }

    private async Task SetViewMode(string mode)
    {
        _viewMode = mode;
        if (mode == "pipeline" && PipelineAvailable)
            await RenderPipelineAsync();
    }

    private async Task MoveForward()
    {
        CameraZ = Math.Min(16.5, CameraZ + .75);
        await RefreshPipelineIfActive();
    }
    private async Task MoveBack()
    {
        CameraZ = Math.Max(.5, CameraZ - .75);
        await RefreshPipelineIfActive();
    }
    private async Task MoveLeft()
    {
        CameraX = Math.Max(.5, CameraX - .75);
        await RefreshPipelineIfActive();
    }
    private async Task MoveRight()
    {
        CameraX = Math.Min(21.5, CameraX + .75);
        await RefreshPipelineIfActive();
    }
    private async Task TurnLeft()
    {
        CameraYaw = (CameraYaw - 12 + 360) % 360;
        await RefreshPipelineIfActive();
    }
    private async Task TurnRight()
    {
        CameraYaw = (CameraYaw + 12) % 360;
        await RefreshPipelineIfActive();
    }

    private Task RefreshPipelineIfActive() =>
        _viewMode == "pipeline" && PipelineAvailable ? RenderPipelineAsync() : Task.CompletedTask;

    private async Task RenderPipelineAsync()
    {
#if WORKSHOP_USE_REPOSITORY_SOURCES
        _pipelineStatus = "Building stable entity candidates and reducing each entity to the observer-selected detail ceiling…";
        var catalog = new TheSingularityWorkshop.Visualize.VisualizerResourceCatalog();
        var geometrySizes = new (float Width, float Height)[]
        {
            (0.006f, 0.006f), // Semantic
            (0.011f, 0.009f), // Aggregate
            (0.017f, 0.013f), // Distant
            (0.023f, 0.017f), // Near
            (0.029f, 0.021f)  // Interactive
        };
        var colors = new[]
        {
            new System.Numerics.Vector4(0.48f, 0.62f, 0.70f, 1f),
            new System.Numerics.Vector4(0.66f, 0.40f, 0.88f, 1f),
            new System.Numerics.Vector4(0.95f, 0.64f, 0.30f, 1f),
            new System.Numerics.Vector4(0.16f, 0.72f, 0.92f, 1f),
            new System.Numerics.Vector4(0.22f, 0.95f, 0.80f, 1f)
        };
        for (var i = 0; i < 5; i++)
        {
            var geometryId = new TheSingularityWorkshop.Visualize.VisualizerResourceId((ulong)(i + 1));
            var materialId = new TheSingularityWorkshop.Visualize.VisualizerResourceId((ulong)(i + 11));
            catalog.SetGeometry(geometryId, CreatePipelineQuad());
            catalog.SetMaterial(materialId, new TheSingularityWorkshop.Visualize.VisualizerMaterial(1, colors[i]));
        }

        var policy = new TheSingularityWorkshop.Renderer.ObserverRepresentationPolicy(
        [
            new TheSingularityWorkshop.Renderer.RepresentationHorizonRule(
                new TheSingularityWorkshop.Renderer.EventHorizon("Interactive", 0.18, 16),
                TheSingularityWorkshop.Renderer.RepresentationTarget.Interactive),
            new TheSingularityWorkshop.Renderer.RepresentationHorizonRule(
                new TheSingularityWorkshop.Renderer.EventHorizon("Near", 0.32, 8),
                TheSingularityWorkshop.Renderer.RepresentationTarget.Near),
            new TheSingularityWorkshop.Renderer.RepresentationHorizonRule(
                new TheSingularityWorkshop.Renderer.EventHorizon("Distant", 0.52, 4),
                TheSingularityWorkshop.Renderer.RepresentationTarget.Distant),
            new TheSingularityWorkshop.Renderer.RepresentationHorizonRule(
                new TheSingularityWorkshop.Renderer.EventHorizon("Aggregate", 0.85, 2),
                TheSingularityWorkshop.Renderer.RepresentationTarget.Aggregate),
            new TheSingularityWorkshop.Renderer.RepresentationHorizonRule(
                new TheSingularityWorkshop.Renderer.EventHorizon("Semantic", 10, 1),
                TheSingularityWorkshop.Renderer.RepresentationTarget.Semantic)
        ]);

        // Time the policy/candidate/reduction stage separately from SVG manifestation.
        // These are interactive diagnostic timings, not BenchmarkDotNet performance claims.
        var preparationStarted = System.Diagnostics.Stopwatch.GetTimestamp();
        var selectedCommands = new List<TheSingularityWorkshop.Renderer.RenderDrawCommand>();
        var inputCount = 0;
        foreach (var building in WorldSnapshot.Entities)
        {
            var worldX = (float)((building.GridX - 10.5) / 12d);
            var worldY = (float)((8.5 - building.GridZ) / 10d);
            var dx = building.GridX - CameraX;
            var dz = building.GridZ - CameraZ;
            var distance = Math.Sqrt(dx * dx + dz * dz) / 10d;
            var ceiling = ToRendererRepresentation(policy.Select(distance).Representation);
            var numericEntityId = ulong.Parse(building.Id, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture);
            var entityId = new TheSingularityWorkshop.Renderer.RenderEntityId(numericEntityId);
            var candidates = new List<TheSingularityWorkshop.Renderer.RenderDrawCommand>(5);
            for (var level = 0; level < 5; level++)
            {
                var size = geometrySizes[level];
                var transform = System.Numerics.Matrix4x4.CreateScale(size.Width, size.Height, 1f) *
                    System.Numerics.Matrix4x4.CreateTranslation(worldX, worldY, 0f);
                candidates.Add(new TheSingularityWorkshop.Renderer.RenderDrawCommand(
                    new TheSingularityWorkshop.Renderer.RenderResourceId((ulong)(level + 1)),
                    new TheSingularityWorkshop.Renderer.RenderResourceId((ulong)(level + 11)),
                    transform,
                    6,
                    0,
                    0,
                    (TheSingularityWorkshop.Renderer.RendererRepresentation)level,
                    entity: entityId));
            }

            inputCount += candidates.Count;
            var reduced = TheSingularityWorkshop.Renderer.RenderCommandReducer.Reduce(candidates, ceiling);
            selectedCommands.AddRange(reduced.Commands);
        }

        var preparationElapsed = System.Diagnostics.Stopwatch.GetElapsedTime(preparationStarted);
        var observerPosition = new System.Numerics.Vector3(
            (float)((CameraX - 10.5) / 12d),
            (float)((8.5 - CameraZ) / 10d),
            0f);
        var view = System.Numerics.Matrix4x4.CreateTranslation(-observerPosition.X, -observerPosition.Y, 0f) *
            System.Numerics.Matrix4x4.CreateRotationZ((float)(-CameraYaw * Math.PI / 180d));
        // Renderer supplies clip-space coordinates to the SVG backend. The backend maps
        // normalized device coordinates into its 100 × 56.25 viewBox, so this matrix must
        // normalize the city's already-centered 2D grid rather than pre-map it into SVG units.
        // X spans roughly ±0.9 world units; Y spans roughly ±1.0. The backend performs the
        // final clip-to-SVG mapping. This is an orthographic 2D proof, not an FPS camera.
        var projection = System.Numerics.Matrix4x4.CreateScale(0.56f, 1f, 1f);
        var frame = new TheSingularityWorkshop.Renderer.RenderFrame(
            new TheSingularityWorkshop.Renderer.RenderView(observerPosition, view, projection),
            selectedCommands);
        var manifestationStarted = System.Diagnostics.Stopwatch.GetTimestamp();
        await using var visualizer = new TheSingularityWorkshop.Visualize.Visualizer(
            new TheSingularityWorkshop.Visualize.GuiSvg.GuiSvgVisualizerBackend(
                svg => _pipelineSvg = svg,
                projectWithCamera: true,
                sceneLabel: "Singularity City · observer-relative Renderer frame → Visualize → GUI.SVG",
                backgroundColor: "#07131d",
                gridColor: "#234657"),
            catalog);
        var frameResult = await visualizer.RenderAsync(frame, new TheSingularityWorkshop.Renderer.VisualizeAdapter.RendererFrameAdapter());
        var manifestationElapsed = System.Diagnostics.Stopwatch.GetElapsedTime(manifestationStarted);
        var backendTiming = frameResult.CpuSubmissionTime is { } cpuSubmissionTime
            ? $"{cpuSubmissionTime.TotalMilliseconds:0.###} ms"
            : "not reported";
        var svgBytes = System.Text.Encoding.UTF8.GetByteCount(_pipelineSvg ?? string.Empty);
        var svgDrawPaths = (_pipelineSvg ?? string.Empty).Split("draw-", StringSplitOptions.None).Length - 1;
        var representationCounts = string.Join(" · ", selectedCommands
            .GroupBy(command => command.Representation)
            .OrderBy(group => group.Key)
            .Select(group => $"{group.Key} {group.Count()}"));
        _pipelineStatus = $"Snapshot {WorldSnapshot.Revision} · stable buildings {WorldSnapshot.Entities.Count} · candidate commands {inputCount:N0} → submitted {selectedCommands.Count:N0} · reduced {inputCount - selectedCommands.Count:N0} · {representationCounts} · policy/reduction {preparationElapsed.TotalMilliseconds:0.###} ms · frame path {manifestationElapsed.TotalMilliseconds:0.###} ms · backend-reported CPU submission {backendTiming} · SVG {svgBytes:N0} bytes / {svgDrawPaths:N0} draw paths · CPU SVG proof, not GPU rendering.";
#else
        await Task.CompletedTask;
        _pipelineStatus = "Repository-source mode is required to use the Renderer → Visualize → GUI.SVG integration.";
#endif
    }

#if WORKSHOP_USE_REPOSITORY_SOURCES
    private static TheSingularityWorkshop.Visualize.VisualizerGeometry CreatePipelineQuad() => new(1,
    [
        new TheSingularityWorkshop.Visualize.VisualizerVertex(new System.Numerics.Vector3(-0.5f, -0.5f, 0), System.Numerics.Vector3.UnitZ, System.Numerics.Vector2.Zero, System.Numerics.Vector4.One),
        new TheSingularityWorkshop.Visualize.VisualizerVertex(new System.Numerics.Vector3(-0.5f, 0.5f, 0), System.Numerics.Vector3.UnitZ, System.Numerics.Vector2.Zero, System.Numerics.Vector4.One),
        new TheSingularityWorkshop.Visualize.VisualizerVertex(new System.Numerics.Vector3(0.5f, 0.5f, 0), System.Numerics.Vector3.UnitZ, System.Numerics.Vector2.Zero, System.Numerics.Vector4.One),
        new TheSingularityWorkshop.Visualize.VisualizerVertex(new System.Numerics.Vector3(0.5f, -0.5f, 0), System.Numerics.Vector3.UnitZ, System.Numerics.Vector2.Zero, System.Numerics.Vector4.One)
    ], [0, 1, 2, 0, 2, 3]);

    private static TheSingularityWorkshop.Renderer.RendererRepresentation ToRendererRepresentation(
        TheSingularityWorkshop.Renderer.RepresentationTarget target) => target switch
    {
        TheSingularityWorkshop.Renderer.RepresentationTarget.Semantic => TheSingularityWorkshop.Renderer.RendererRepresentation.Semantic,
        TheSingularityWorkshop.Renderer.RepresentationTarget.Aggregate => TheSingularityWorkshop.Renderer.RendererRepresentation.Aggregate,
        TheSingularityWorkshop.Renderer.RepresentationTarget.Distant => TheSingularityWorkshop.Renderer.RendererRepresentation.Distant,
        TheSingularityWorkshop.Renderer.RepresentationTarget.Near => TheSingularityWorkshop.Renderer.RendererRepresentation.Near,
        TheSingularityWorkshop.Renderer.RepresentationTarget.Interactive => TheSingularityWorkshop.Renderer.RendererRepresentation.Interactive,
        _ => throw new ArgumentOutOfRangeException(nameof(target), target, "Unknown representation target.")
    };
#endif

    private sealed record StreetBuilding(string Id, string Kind, double Depth, double X, double Top, double Width, double Height, string Windows);
    private List<StreetBuilding> StreetBuildings
    {
        get
        {
            var result = new List<StreetBuilding>();
            var radians = CameraYaw * Math.PI / 180d;
            foreach (var building in WorldSnapshot.Entities)
            {
                var dx = building.GridX - CameraX;
                var dz = building.GridZ - CameraZ;
                var lateral = dx * Math.Cos(radians) - dz * Math.Sin(radians);
                var depth = dx * Math.Sin(radians) + dz * Math.Cos(radians);
                if (depth < .8 || depth > 24 || Math.Abs(lateral / depth) > 3.3) continue;
                var scale = 170d / depth;
                var width = Math.Clamp(90d / depth, 2, 110);
                var height = Math.Clamp(building.Floors * 0.72 * scale, 2, 460);
                var x = 500 + lateral * scale;
                var baseY = 310 + 400 / depth;
                var top = baseY - height;
                if (x + width < 0 || x - width > 1000 || baseY < 300 || top > 620) continue;
                var windows = $"M {x - width * .22:0.##} {top + 4:0.##} V {baseY - 2:0.##} M {x + width * .22:0.##} {top + 4:0.##} V {baseY - 2:0.##}";
                result.Add(new StreetBuilding(building.Id, building.Kind, depth, x - width / 2, top, width, Math.Max(1, baseY - top), windows));
            }
            return result.OrderByDescending(item => item.Depth).ToList();
        }
    }
    private string _selectedEra = "modern";
    private static readonly CityHistoryEra[] CityEras =
    [
        new("settlement", "c. 1625", "New Amsterdam", "HARBOR SETTLEMENT", 5000,
