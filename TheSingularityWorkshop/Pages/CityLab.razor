    private static List<CityRoad> BuildRoads()
    {
        var roads = new List<CityRoad>();
        for (var i = 0; i < 15; i++)
        {
            var a = 130 + i * 48;
            roads.Add(new CityRoad(i, $"{a},90 {a-230},320 {a-460},550 {a-690},780"));
            roads.Add(new CityRoad(i + 20, $"{a-100},90 {a+130},320 {a+360},550 {a+590},780"));
        }
        return roads;
    }
