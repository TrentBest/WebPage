    private int DensityPerKm2 = 28874;
    private string _selectedProfile = "manhattan";
    private string _skinClass => _skin switch { "metro" => "metro", "solarpunk" => "solarpunk", _ => "noir" };
    private void SetSkin(string skin)
    {
        _skin = skin;
        StateHasChanged();
    }
    private void SelectNoirSkin() => SetSkin("noir");
    private void SelectMetroSkin() => SetSkin("metro");
    private void SelectHarmonySkin() => SetSkin("solarpunk");
    private async Task OnDensityChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var density))
        {
            _selectedProfile = "custom";
            _selectedEra = "custom";
            SetDensity(density);
            StateHasChanged();
            await RefreshPipelineIfActive();
        }
    }

    private async Task ApplySelectedProfile()
    {
        _selectedEra = "custom";
        if (CityProfiles.FirstOrDefault(profile => profile.Id == _selectedProfile) is { } profile)
            SetDensity(profile.DensityPerKm2);
        else if (_selectedProfile == "future-core")
            SetDensity(40000);
        else if (_selectedProfile == "arcology")
            SetDensity(50000);
        StateHasChanged();
        await RefreshPipelineIfActive();
    }

    private async Task SelectEra(string eraId)
    {
        _selectedEra = eraId;
        if (SelectedEra is { } era)
        {
            _selectedProfile = era.Id == "modern" ? "manhattan" : "custom";
            SetDensity(era.DensityPerKm2);
        }
        await RefreshPipelineIfActive();
    }

    private CityHistoryEra? SelectedEra => CityEras.FirstOrDefault(era => era.Id == _selectedEra);

    private sealed record CityHistoryEra(string Id, string YearLabel, string Title, string StageLabel, int DensityPerKm2,
        string Summary, string WhyHere, string TurningPoint, string Leadership, string Boundary);

    private void SetDensity(int density)
    {
        DensityPerKm2 = Math.Clamp(density, 5000, 50000);
        Buildings = BuildCity(DensityPerKm2);
        WorldSnapshot = CreateWorldSnapshot(Buildings, DensityPerKm2);
    }

