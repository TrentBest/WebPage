    private sealed record CityBuilding(int Id, string Kind, int Floors, string LeftFace, string RightFace, string Roof, string WindowLines, string Crown, bool IsLandmark, double GridX, double GridZ);
    private sealed record CityDistrict(int Id, string Name, string Points, int LabelX, int LabelY);
    private sealed record CityRoad(int Id, string Points);

    private List<CityBuilding> Buildings { get; set; } = BuildCity(28874);
    private CityWorldSnapshot WorldSnapshot { get; set; } = CreateWorldSnapshot(BuildCity(28874), 28874);

    private static CityWorldSnapshot CreateWorldSnapshot(IEnumerable<CityBuilding> buildings, int density) =>
        CityWorldSnapshot.Create(
            $"city-massing-v1-density-{density}",
            buildings.Select(building => new CityWorldEntity(
                building.Id.ToString("D5", System.Globalization.CultureInfo.InvariantCulture),
                building.Kind,
                building.GridX,
                building.GridZ,
                building.Floors)));
    private string LeftFacesPath => JoinPolygons(Buildings.Select(building => building.LeftFace));
    private string RightFacesPath => JoinPolygons(Buildings.Select(building => building.RightFace));
    private string RoofFacesPath => JoinPolygons(Buildings.Select(building => building.Roof));
    private string WindowLinesPath => string.Join(" ", Buildings.Select(building => building.WindowLines));
    private string LandmarkCrownsPath => JoinPolygons(Buildings.Where(building => building.IsLandmark).Select(building => building.Crown));

    private static string JoinPolygons(IEnumerable<string> polygons) => string.Join(" ", polygons.Select(points =>
    {
        var vertices = points.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return vertices.Length < 3 ? string.Empty : $"M {string.Join(" L ", vertices)} Z";
    }));
    private List<CityDistrict> Districts { get; } = BuildDistricts();
    private List<CityRoad> Roads { get; } = BuildRoads();

    private static List<CityBuilding> BuildCity(int targetDensity)
    {
        var result = new List<CityBuilding>();
        var densityFactor = Math.Clamp((targetDensity - 5000) / 45000d, 0d, 1d);
        var openSpaceThreshold = 25 - (int)Math.Round(17 * densityFactor);
        for (var row = 0; row < 18; row++)
        for (var col = 0; col < 22; col++)
        {
            var hash = (col * 73 + row * 151 + col * row * 17) % 101;
            if (hash < openSpaceThreshold) continue; // density-dependent plazas, parks, water cuts and transport voids
            var count = 1 + (hash % 4 < 1 + (int)(densityFactor * 3) ? 1 : 0) + (densityFactor > .72 && hash % 7 == 0 ? 1 : 0);
            for (var local = 0; local < count; local++)
            {
                var id = row * 1000 + col * 10 + local + 1;
                var localHash = (col * 97 + row * 61 + local * 43 + col * row * 7) % 997;
                var x = 500 + (col - row) * 25 + (local - 1) * 7;
                var y = 55 + (col + row) * 15 + (local % 2) * 4;
                var floors = 3 + (int)((localHash % 58) * (.65 + densityFactor * .8));
                var landmark = (col == 10 && row == 8 && local == 0) || (col == 14 && row == 5 && local == 0) || (col == 5 && row == 13 && local == 0);
                if (landmark) floors = 75 + localHash % 45;
                var h = floors * 1.55;
                const double w = 10;
                const double d = 6;
                var roof = $"{x-w:0.#},{y-h} {x:0.#},{y-h-d} {x+w:0.#},{y-h} {x:0.#},{y-h+d}";
                var left = $"{x-w:0.#},{y-h} {x:0.#},{y-h+d} {x:0.#},{y+d} {x-w:0.#},{y}";
                var right = $"{x+w:0.#},{y-h} {x:0.#},{y-h+d} {x:0.#},{y+d} {x+w:0.#},{y}";
                var windows = $"M {x-w/2:0.#} {y-h+8:0.#} V {y-2:0.#} M {x+w/2:0.#} {y-h+8:0.#} V {y-2:0.#} M {x-w/2:0.#} {y-h+8:0.#} L {x:0.#} {y-h+12:0.#} M {x:0.#} {y-h+20:0.#} L {x+w/2:0.#} {y-h+24:0.#}";
                var crown = $"{x-w*.6:0.#},{y-h} {x:0.#},{y-h-d-12} {x+w*.6:0.#},{y-h}";
                var kind = landmark ? "landmark" : floors > 35 ? "tower" : floors > 16 ? "midrise" : "lowrise";
                result.Add(new CityBuilding(id, kind, floors, left, right, roof, windows, crown, landmark, col + (local - 1) * .15, row + (local % 2) * .1));
            }
        }
        // Near-to-far painter ordering makes the same deterministic geometry read as a massing model.
        return result.OrderBy(b => b.Id).ToList();
    }

