@page "/living-gui"
@using System.Collections.Generic

<PageTitle>The Living GUI — The Singularity Workshop</PageTitle>

<div class="living-sequence-shell @(densityReached ? "density-reached" : "") @(gravityReleased ? "gravity-released" : "") @(sequenceComplete ? "sequence-complete" : "")">
    <div class="moniker-layer" aria-hidden="true">
        <div class="moniker-title">
            <span class="blue">T</span><span class="magenta">H</span><span class="orange">E</span><span class="space"></span>
            <span class="red">S</span><span class="yellow">I</span><span class="green">N</span><span class="blue">G</span><span class="magenta">U</span><span class="orange">L</span><span class="red">A</span><span class="yellow">R</span><span class="green">I</span><span class="blue">T</span><span class="magenta">Y</span><span class="space"></span>
            <span class="orange">W</span><span class="red">O</span><span class="yellow">R</span><span class="green">K</span><span class="blue">S</span><span class="magenta">H</span><span class="orange">O</span><span class="red">P</span>
        </div>
    </div>

    <div class="venom-field" aria-hidden="true"></div>

    <main class="living-canvas" aria-label="Living GUI executable architecture">
        <div class="architecture-atmosphere"></div>

        @foreach (var node in nodes)
        {
            <button class="architecture-node @node.CssClass @(selectedNode == node.Name ? "selected" : "")"
                    style="--node-delay:@node.Delay;"
                    @onclick="() => SelectNode(node.Name)">
                <span class="node-index">@node.Index</span>
                <strong>@node.Name</strong>
                <small>@node.Role</small>
            </button>
        }

        <div class="execution-core">
            <div class="core-ring ring-a"></div>
            <div class="core-ring ring-b"></div>
            <span>DETERMINISTIC CORE</span>
            <strong>FSM</strong>
            <small>@(selectedNode ?? "EXECUTION ARMED")</small>
        </div>

        <div class="trace-rail">
            @foreach (var line in traceLines)
            {
                <span>@line</span>
            }
        </div>

        <div class="density-readout">
            <span>ARCHITECTURE</span>
            <strong>@(densityReached ? "DENSITY REACHED" : "MATERIALIZING")</strong>
        </div>
    </main>
</div>

<style>
    .living-sequence-shell { position:fixed; inset:0; z-index:10000; overflow:hidden; isolation:isolate; background:#020407; color:#f4f7f8; font-family:Consolas,"Courier New",monospace; opacity:1; transition:opacity 1.1s ease; }
    .living-sequence-shell.sequence-complete { opacity:0; pointer-events:none; }
    .living-canvas { position:absolute; inset:0; overflow:hidden; perspective:1200px; }
    .architecture-atmosphere { position:absolute; inset:-20%; background:radial-gradient(circle at 50% 50%,rgba(255,48,48,.09),transparent 24%),radial-gradient(circle at 18% 28%,rgba(255,211,77,.045),transparent 22%),radial-gradient(circle at 82% 72%,rgba(82,224,90,.035),transparent 24%),repeating-linear-gradient(118deg,transparent 0 120px,rgba(255,48,48,.035) 121px 132px,rgba(255,211,77,.028) 133px 145px,transparent 146px 260px); animation:atmosphereDrift 12s ease-in-out infinite; }
    .venom-field { position:absolute; inset:0; z-index:-1; background:repeating-linear-gradient(115deg,transparent 0 150px,rgba(255,48,48,.035) 151px 166px,rgba(255,211,77,.025) 167px 181px,transparent 182px 330px); mask-image:radial-gradient(circle at center,black 0,transparent 78%); opacity:.8; }
    .moniker-layer { position:absolute; inset:0; z-index:2; display:flex; align-items:center; justify-content:center; pointer-events:none; opacity:0; transform:scale(.82); filter:blur(10px); transition:opacity .35s ease,transform 1s cubic-bezier(.16,1,.3,1),filter 1s ease; }
    .density-reached .moniker-layer { opacity:.74; transform:scale(1); filter:blur(1.2px); }
    .gravity-released .moniker-layer { opacity:.92; filter:blur(0); transform:scale(1.025); }
    .moniker-title { display:flex; flex-wrap:wrap; justify-content:center; max-width:94vw; font-size:clamp(2.2rem,8vw,8rem); font-weight:900; line-height:.88; letter-spacing:.075em; text-transform:uppercase; text-shadow:0 0 26px rgba(255,48,48,.12); animation:kelpSway 6.5s ease-in-out infinite; transform-origin:50% 62%; }
    .moniker-title span { display:inline-block; animation:letterDrift 4.8s ease-in-out infinite; }
    .moniker-title .space { width:.24em; }
    .blue{color:#00a8ff}.magenta{color:#ff2cff}.orange{color:#ff7a00}.red{color:#ff3030}.yellow{color:#ffd34d}.green{color:#52e05a}
    .architecture-node { position:absolute; z-index:20; width:clamp(145px,13vw,205px); min-height:86px; padding:.8rem .9rem; border:1px solid rgba(255,211,77,.36); border-left:5px solid #ff3030; border-radius:2px; background:rgba(5,6,8,.93); color:#f4f7f8; font:inherit; text-align:left; cursor:pointer; opacity:0; transform:translateY(-32px) scale(.82); animation:materialize .75s cubic-bezier(.16,1,.3,1) forwards; animation-delay:var(--node-delay); box-shadow:0 14px 40px rgba(0,0,0,.48),inset 0 0 24px rgba(255,48,48,.035); transition:border-color .25s ease,box-shadow .25s ease; }
    .architecture-node:hover,.architecture-node.selected { border-color:#ffd34d; box-shadow:0 0 30px rgba(255,48,48,.24),inset 0 0 25px rgba(255,211,77,.06); outline:none; }
    .node-index { display:block; color:#ff3030; font-size:.56rem; letter-spacing:.16em; }.architecture-node strong{display:block;margin-top:.22rem;color:#fff;font-size:clamp(.72rem,1vw,.9rem);letter-spacing:.08em}.architecture-node small{display:block;margin-top:.35rem;color:#8b999d;font-size:.51rem;letter-spacing:.1em}
    .node-bootstrap{left:5%;top:13%;border-left-color:#ff3030}.node-ontology{left:24%;top:7%;border-left-color:#ffd34d}.node-warehouse{right:23%;top:7%;border-left-color:#52e05a}.node-context{right:5%;top:13%;border-left-color:#00a8ff}.node-hub{left:4%;top:43%;border-left-color:#ff2cff}.node-actor{right:4%;top:43%;border-left-color:#ff7a00}.node-signature{left:12%;bottom:12%;border-left-color:#52e05a}.node-command{left:36%;bottom:5%;border-left-color:#00a8ff}.node-grammar{right:36%;bottom:5%;border-left-color:#ffd34d}.node-representation{right:12%;bottom:12%;border-left-color:#ff3030}
    .execution-core { position:absolute; z-index:30; left:50%; top:50%; width:clamp(150px,15vw,220px); aspect-ratio:1; display:flex; align-items:center; justify-content:center; flex-direction:column; transform:translate(-50%,-50%) scale(.55); border:1px solid #ff3030; border-radius:50%; background:radial-gradient(circle,rgba(52,8,8,.95),rgba(3,4,6,.98) 65%); box-shadow:0 0 34px rgba(255,48,48,.34),inset 0 0 35px rgba(255,48,48,.13); animation:coreAwaken 1.2s 1.8s cubic-bezier(.16,1,.3,1) forwards,corePulse 3s 3s ease-in-out infinite; }
    .execution-core span{color:#9eaaae;font-size:.5rem;letter-spacing:.13em}.execution-core strong{margin:.35rem 0;color:#ffd34d;font-size:clamp(1.5rem,3vw,2.6rem);letter-spacing:.14em}.execution-core small{max-width:120px;overflow:hidden;color:#ff3030;font-size:.48rem;letter-spacing:.08em;text-overflow:ellipsis;white-space:nowrap}.core-ring{position:absolute;border:1px solid rgba(255,211,77,.18);border-radius:50%;pointer-events:none}.ring-a{inset:-14px;animation:ringSpin 15s linear infinite}.ring-b{inset:-30px;border-color:rgba(255,48,48,.12);animation:ringSpinReverse 21s linear infinite}
    .trace-rail{position:absolute;z-index:25;left:50%;bottom:2.5%;display:flex;gap:1.1rem;width:min(900px,78vw);justify-content:center;transform:translateX(-50%);color:rgba(174,189,194,.46);font-size:clamp(.43rem,.7vw,.6rem);letter-spacing:.13em;text-align:center}.trace-rail span::before{content:"◆";margin-right:.5rem;color:#ff3030}.density-readout{position:absolute;z-index:25;left:50%;top:3%;display:flex;align-items:center;gap:.8rem;transform:translateX(-50%);color:#ffd34d;font-size:.57rem;letter-spacing:.18em;opacity:0;animation:readoutIn .6s 1.7s ease forwards}.density-readout strong{color:#ff3030}
    .gravity-released .architecture-node,.gravity-released .execution-core,.gravity-released .trace-rail,.gravity-released .density-readout{animation:fallAway 1.7s cubic-bezier(.55,.06,.68,.19) forwards}.gravity-released .node-ontology{animation-delay:.06s}.gravity-released .node-warehouse{animation-delay:.12s}.gravity-released .node-context{animation-delay:.18s}.gravity-released .node-hub{animation-delay:.24s}.gravity-released .node-actor{animation-delay:.30s}.gravity-released .node-signature{animation-delay:.36s}.gravity-released .node-command{animation-delay:.42s}.gravity-released .node-grammar{animation-delay:.48s}.gravity-released .node-representation{animation-delay:.54s}
    @@keyframes materialize{0%{opacity:0;transform:translateY(-32px) scale(.82)}70%{opacity:1;transform:translateY(5px) scale(1.02)}100%{opacity:1;transform:translateY(0) scale(1)}}
    @@keyframes coreAwaken{0%{opacity:0;transform:translate(-50%,-50%) scale(.55)}70%{opacity:1;transform:translate(-50%,-50%) scale(1.06)}100%{opacity:1;transform:translate(-50%,-50%) scale(1)}}
    @@keyframes fallAway{0%{opacity:1;transform:translateY(0) rotate(0deg) scale(1)}100%{opacity:0;transform:translateY(125vh) rotate(11deg) scale(.92)}}
    @@keyframes corePulse{0%,100%{box-shadow:0 0 28px rgba(255,48,48,.28),inset 0 0 30px rgba(255,48,48,.1)}50%{box-shadow:0 0 48px rgba(255,48,48,.52),0 0 90px rgba(255,211,77,.08),inset 0 0 38px rgba(255,48,48,.18)}}
    @@keyframes ringSpin{from{transform:rotate(0)}to{transform:rotate(360deg)}}@@keyframes ringSpinReverse{from{transform:rotate(360deg)}to{transform:rotate(0)}}
    @@keyframes kelpSway{0%,100%{transform:rotate(-1.2deg) skewX(-.6deg) translateY(0)}25%{transform:rotate(1deg) skewX(.9deg) translateY(-3px)}50%{transform:rotate(-.6deg) skewX(-1deg) translateY(2px)}75%{transform:rotate(1.4deg) skewX(.7deg) translateY(-2px)}}
    @@keyframes letterDrift{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}@@keyframes atmosphereDrift{0%,100%{transform:translate3d(-1%,0,0) scale(1)}50%{transform:translate3d(1%,1%,0) scale(1.03)}}@@keyframes readoutIn{to{opacity:.75}}
    @@media (max-width:800px){.architecture-node{width:125px;min-height:72px;padding:.6rem}.node-bootstrap{left:2%;top:13%}.node-ontology{left:28%;top:5%}.node-warehouse{right:28%;top:5%}.node-context{right:2%;top:13%}.node-hub{left:2%;top:43%}.node-actor{right:2%;top:43%}.node-signature{left:4%;bottom:15%}.node-representation{right:4%;bottom:15%}.node-command{left:25%;bottom:5%}.node-grammar{right:25%;bottom:5%}.trace-rail{width:92vw;gap:.4rem}.trace-rail span:nth-child(n+3){display:none}.moniker-title{font-size:clamp(1.65rem,8vw,3.5rem)}}
    @@media (prefers-reduced-motion:reduce){.living-sequence-shell *,.living-sequence-shell *::before,.living-sequence-shell *::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
</style>

@code {
    private bool densityReached;
    private bool gravityReleased;
    private bool sequenceComplete;
    private string? selectedNode;

    private readonly List<LivingNode> nodes = new()
    {
        new("01", "BOOTSTRAP", "WAKE THE MACHINE", "node-bootstrap", "0.20s"),
        new("02", "ONTOLOGY", "NAME REALITY", "node-ontology", "0.42s"),
        new("03", "WAREHOUSE", "HOLD STATE", "node-warehouse", "0.64s"),
        new("04", "CONTEXT", "SELECT RELEVANCE", "node-context", "0.86s"),
        new("05", "HUB", "DISCOVER / ROUTE", "node-hub", "1.08s"),
        new("06", "ACTOR", "OWN BEHAVIOR", "node-actor", "1.30s"),
        new("07", "SIGNATURE", "ADDRESS MEANING", "node-signature", "1.52s"),
        new("08", "COMMAND", "EXECUTABLE INTENT", "node-command", "1.74s"),
        new("09", "GRAMMAR", "VALID COMPOSITION", "node-grammar", "1.96s"),
        new("10", "REPRESENTATION", "DENSITY NEGOTIATED", "node-representation", "2.18s")
    };

    private readonly List<string> traceLines = new() { "BOOTSTRAP", "ONTOLOGY", "CONTEXT", "FSM_API" };

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(2900);
        densityReached = true;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(450);
        gravityReleased = true;
        await InvokeAsync(StateHasChanged);

        // The last surface falls for 1.7 seconds. Then the browser UI waits three seconds before arriving.
        await Task.Delay(4700);
        sequenceComplete = true;
        await InvokeAsync(StateHasChanged);
    }

    private void SelectNode(string node)
    {
        selectedNode = node;
        traceLines.Insert(0, node);
        if (traceLines.Count > 4)
            traceLines.RemoveAt(traceLines.Count - 1);
    }

    private sealed record LivingNode(string Index, string Name, string Role, string CssClass, string Delay);
}
