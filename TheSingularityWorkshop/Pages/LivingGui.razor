@page "/living-gui"
@using System
@using TheSingularityWorkshop.Components
@using TheSingularityWorkshop.Services
@inject FSMManagerService FSM
@implements IDisposable

<PageTitle>Living GUI</PageTitle>

<div class="living-experience-panel" aria-label="Living GUI experience">
    @if (FSM.Context.MonikerReady)
    {
        <FirstContactView State="@FirstContactState" Ticks="FSM.Context.MonikerPresentationStartTick" />
    }
    @foreach (var actor in FSM.Context.LivingNodes)
    {
        <label class="living-actor @(actor.IsRoot ? "living-actor-root" : "") @(GravityActive ? "living-actor-gravity" : "")"
               style="@ActorStyle(actor)"
               aria-label="@actor.Lineage">
            @actor.Lineage
        </label>
    }
</div>

<style>
    /* The Living GUI is an experience hosted by the panel supplied to it.
       The panel is the coordinate space. The experience contributes actors;
       it does not create a second GUI, diagnostic overlay, or coordinate plane. */
    .living-experience-panel {
        container-type:size;
        position:relative;
        width:100%;
        height:100%;
        min-width:0;
        min-height:0;
        overflow:hidden;
        box-sizing:border-box;
        isolation:isolate;
        background:
            radial-gradient(circle at 50% 50%,rgba(0,168,255,.055),transparent 34%),
            radial-gradient(circle at 18% 82%,rgba(255,44,255,.035),transparent 30%),
            #020304;
        color:#f4f7f8;
        font-family:Consolas,"Courier New",monospace;
    }

    .living-experience-panel::before {
        content:"";
        position:absolute;
        inset:0;
        pointer-events:none;
        background:
            linear-gradient(90deg,rgba(0,168,255,.035) 1px,transparent 1px),
            linear-gradient(0deg,rgba(255,44,255,.025) 1px,transparent 1px);
        background-size:32px 32px;
        mask-image:radial-gradient(circle at center,black,transparent 78%);
    }

    /* The actor is the GUI element of the experience. Its FSM position is a
       percentage of the supplied panel, so 50,50 is the exact panel center. */
    .living-actor {
        position:absolute;
        box-sizing:border-box;
        min-width:10px;
        min-height:10px;
        display:flex;
        align-items:center;
        justify-content:center;
        padding:0 12px;
        border:6px solid var(--flower-color);
        border-radius:50% 44% 52% 47%;
        background:
            radial-gradient(circle at 38% 34%,color-mix(in srgb,var(--flower-color) 34%,transparent),transparent 44%),
            radial-gradient(circle at 65% 68%,color-mix(in srgb,var(--flower-color) 20%,transparent),transparent 52%),
            rgba(3,6,10,.94);
        color:#fff;
        font:900 .72rem/1 Consolas,"Courier New",monospace;
        letter-spacing:.12em;
        text-align:center;
        white-space:nowrap;
        overflow:hidden;
        text-shadow:0 0 9px rgba(255,255,255,.8);
        box-shadow:
            0 0 12px color-mix(in srgb,var(--flower-color) 72%,transparent),
            0 0 34px color-mix(in srgb,var(--flower-color) 34%,transparent),
            inset 0 0 18px color-mix(in srgb,var(--flower-color) 22%,transparent);
        transition:left .16s linear,top .16s linear,width .16s linear,height .16s linear,opacity .16s linear,transform .16s linear;
        will-change:left,top,width,height,transform;
        --actor-logical-size:50;
        width:clamp(10px,calc(var(--actor-logical-size) * .10cqmin),18cqmin)!important;
        height:clamp(10px,calc(var(--actor-logical-size) * .10cqmin),18cqmin)!important;
        transform-origin:center;
        z-index:20;
    }

    .living-actor-root {
        border-width:6px;
        border-color:#ff7a00;
        box-shadow:
            0 0 16px rgba(255,122,0,.58),
            0 0 42px rgba(255,122,0,.26),
            inset 0 0 22px rgba(255,122,0,.13);
    }

    .living-actor-gravity {
        pointer-events:none;
    }

    @@media(prefers-reduced-motion:reduce) {
        .living-experience-panel *,
        .living-experience-panel *::before,
        .living-experience-panel *::after {
            animation-duration:.01ms!important;
            animation-iteration-count:1!important;
            transition-duration:.01ms!important;
        }
    }
</style>

@code {
    private bool GravityActive => FSM.CurrentState is PageFSM.Gravity or PageFSM.LivingGuiDissipating or PageFSM.NavigationArrival or PageFSM.Running;

    // The moniker remains the persistent landing surface. When the page FSM reaches
    // navigation arrival, MainLayout manifests the Workshop chrome alongside it.
    // The hub is therefore layout-owned navigation, not a full-stage overlay.
    private const string FirstContactState = "Landing";

    protected override void OnInitialized()
    {
        FSM.StateChanged += HandleFSMStateChanged;
        FSM.LivingGuiChanged += HandleLivingGuiChanged;

        // Entry is authorized by Home only after FSM_COS has composed the
        // Living GUI Experience and resolved its Moniker dependency.
    }

    private void HandleFSMStateChanged(string state) => _ = InvokeAsync(StateHasChanged);

    private void HandleLivingGuiChanged() => _ = InvokeAsync(StateHasChanged);

    private static string ActorStyle(PageStateContext.LivingNodeState actor)
        => $"left:{ActorLeft(actor)};top:{ActorTop(actor)};--actor-logical-size:{actor.Size:0.##};transform:{ActorTransform(actor)};opacity:{ActorOpacity(actor):0.###};--flower-color:{ActorColor(actor)};";

    private static string ActorLeft(PageStateContext.LivingNodeState actor)
        => $"{actor.X:0.###}%";

    private static string ActorTop(PageStateContext.LivingNodeState actor)
        => $"{actor.Y:0.###}%";

    private static string ActorTransform(PageStateContext.LivingNodeState actor)
        => $"translate(-50%,-50%) rotate({actor.Rotation:0.##}deg)";

    private static double ActorOpacity(PageStateContext.LivingNodeState actor)
        => actor.Y <= 100 ? 1 : Math.Clamp(1 - ((actor.Y - 100) / 30), 0, 1);

    private static string ActorColor(PageStateContext.LivingNodeState actor)
    {
        if (actor.IsRoot)
            return "#ff7a00";

        var hash = 17;
        foreach (var character in actor.Lineage)
            hash = unchecked((hash * 31) + character);

        return FlowerPalette[Math.Abs(hash % FlowerPalette.Length)];
    }

    private static readonly string[] FlowerPalette =
    {
        "#ff3030",
        "#ff7a00",
        "#ffd34d",
        "#52e05a",
        "#00a8ff",
        "#ff2cff"
    };

    public void Dispose()
    {
        FSM.StateChanged -= HandleFSMStateChanged;
        FSM.LivingGuiChanged -= HandleLivingGuiChanged;
    }
}
