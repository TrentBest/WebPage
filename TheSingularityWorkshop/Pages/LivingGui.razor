@page "/living-gui"

<PageTitle>The Living GUI — The Singularity Workshop</PageTitle>

<div class="living-gui-shell @(gravityEngaged ? "gravity-engaged" : "")">
    <div class="moniker-layer" aria-hidden="true">
        <div class="moniker-kicker">THE IDENTITY UNDER THE MACHINE</div>
        <div class="moniker-title">
            <span class="blue">T</span><span class="magenta">H</span><span class="orange">E</span><span class="space"></span>
            <span class="red">S</span><span class="yellow">I</span><span class="green">N</span><span class="blue">G</span><span class="magenta">U</span><span class="orange">L</span><span class="red">A</span><span class="yellow">R</span><span class="green">I</span><span class="blue">T</span><span class="magenta">Y</span><span class="space"></span>
            <span class="orange">W</span><span class="red">O</span><span class="yellow">R</span><span class="green">K</span><span class="blue">S</span><span class="magenta">H</span><span class="orange">O</span><span class="red">P</span>
        </div>
    </div>

    <div class="venom-aura" aria-hidden="true"></div>
    <div class="venom-bands" aria-hidden="true"></div>

    <header class="living-header">
        <div>
            <span class="eyebrow">LIVING GUI // EXECUTABLE ARCHITECTURE</span>
            <h1>THE INTERFACE IS THE EXPERIMENT.</h1>
            <p>The architecture is suspended above its identity. For now.</p>
        </div>
        <div class="kernel-readout">
            <span>KERNEL STATE</span>
            <strong>@(gravityEngaged ? "GRAVITY / ACTIVE" : "SUSPENDED")</strong>
            <i></i>
        </div>
    </header>

    <main class="living-stage">
        <section class="architecture-field" aria-label="Living architecture">
            <div class="field-ring ring-one"></div>
            <div class="field-ring ring-two"></div>
            <div class="field-ring ring-three"></div>

            <div class="connection connection-a"></div>
            <div class="connection connection-b"></div>
            <div class="connection connection-c"></div>
            <div class="connection connection-d"></div>

            <button class="architecture-node node-bootstrap" @onclick='() => SelectNode("BOOTSTRAP")'>
                <small>01</small><strong>BOOTSTRAP</strong><span>WAKE THE MACHINE</span>
            </button>
            <button class="architecture-node node-ontology" @onclick='() => SelectNode("ONTOLOGY")'>
                <small>02</small><strong>ONTOLOGY</strong><span>NAME REALITY</span>
            </button>
            <button class="architecture-node node-warehouse" @onclick='() => SelectNode("WAREHOUSE")'>
                <small>03</small><strong>WAREHOUSE</strong><span>HOLD STATE</span>
            </button>
            <button class="architecture-node node-context" @onclick='() => SelectNode("CONTEXT")'>
                <small>04</small><strong>CONTEXT</strong><span>SELECT RELEVANCE</span>
            </button>
            <button class="architecture-node node-fsm" @onclick='() => SelectNode("FSM_API")'>
                <small>05</small><strong>FSM_API</strong><span>EXECUTE</span>
            </button>

            <div class="core-node">
                <span class="core-halo"></span>
                <small>DETERMINISTIC CORE</small>
                <strong>FSM</strong>
                <span>@(selectedNode ?? "AWAITING INPUT")</span>
            </div>

            <div class="architecture-caption">
                <span>AI CHOOSES</span><b>·</b><span>CONTEXT SELECTS</span><b>·</b><span>ACTOR OWNS BEHAVIOR</span><b>·</b><span>FSM EXECUTES</span>
            </div>
        </section>

        <aside class="living-console">
            <div class="console-header"><span>LIVE TRACE</span><em>@(gravityEngaged ? "EVENT CASCADE" : "LISTENING")</em></div>
            <div class="trace-lines">
                @foreach (var line in traceLines)
                {
                    <div class="trace-line @(line.StartsWith(">") ? "command" : "")">@line</div>
                }
            </div>
            <div class="inspector">
                <small>ACTIVE ADDRESS</small>
                <strong>@(selectedNode ?? "NONE")</strong>
                <p>@GetNodeDescription()</p>
            </div>
        </aside>
    </main>

    <footer class="gravity-deck">
        <div>
            <span>PHYSICAL SIMULATION</span>
            <strong>@(gravityEngaged ? "GRAVITY EVENT IN PROGRESS" : "ARCHITECTURE SUSPENDED")</strong>
            <small>@(gravityEngaged ? "The interface falls away. The identity remains." : "Everything is deliberately being held above the thing it belongs to.")</small>
        </div>
        <button class="gravity-button" @onclick="EngageGravity" disabled="@gravityEngaged">
            <b>↓</b><span>@(gravityEngaged ? "GRAVITY ENGAGED" : "ENGAGE GRAVITY")</span>
        </button>
    </footer>
</div>

<style>
    .living-gui-shell { position:relative; min-height:calc(100vh - 7.5rem); overflow:hidden; isolation:isolate; background:#030508; color:#f4f7f8; font-family:Consolas,'Courier New',monospace; }
    .moniker-layer { position:absolute; inset:0; z-index:0; display:flex; align-items:center; justify-content:center; flex-direction:column; pointer-events:none; transition:transform 1.4s cubic-bezier(.16,1,.3,1),filter 1.4s ease; }
    .moniker-kicker { margin-bottom:1rem; color:rgba(244,247,248,.3); font-size:.7rem; letter-spacing:.34em; }
    .moniker-title { display:flex; flex-wrap:wrap; justify-content:center; max-width:94vw; font-size:clamp(2rem,6.2vw,6.2rem); font-weight:900; line-height:.92; letter-spacing:.075em; text-transform:uppercase; filter:blur(1.1px) drop-shadow(0 0 22px rgba(255,48,48,.1)); }
    .moniker-title span { display:inline-block; animation:monikerBreath 4.8s ease-in-out infinite; }
    .moniker-title .space { width:.24em; }
    .blue{color:#00a8ff}.magenta{color:#ff2cff}.orange{color:#ff7a00}.red{color:#ff3030}.yellow{color:#ffd34d}.green{color:#52e05a}
    .venom-aura { position:absolute; z-index:-1; left:50%; top:50%; width:min(70vw,900px); aspect-ratio:1; transform:translate(-50%,-50%); border-radius:50%; background:radial-gradient(circle,rgba(255,48,48,.14),rgba(255,211,77,.045) 34%,transparent 68%); filter:blur(10px); animation:venomBreath 5s ease-in-out infinite; }
    .venom-bands { position:absolute; inset:0; z-index:-2; opacity:.2; background:repeating-linear-gradient(115deg,transparent 0 92px,rgba(255,48,48,.055) 93px 104px,rgba(255,211,77,.045) 105px 116px,transparent 117px 210px); mask-image:radial-gradient(circle at center,black,transparent 75%); }
    .living-header { position:relative; z-index:30; display:flex; align-items:flex-start; justify-content:space-between; gap:2rem; padding:clamp(1.5rem,4vw,3rem) clamp(1rem,4vw,4rem) 1rem; }
    .eyebrow,.gravity-deck span,.inspector small { color:#ffd34d; font-size:.66rem; letter-spacing:.2em; text-transform:uppercase; }
    .living-header h1 { margin:.6rem 0 .4rem; font-size:clamp(1.4rem,3.4vw,3rem); line-height:1; letter-spacing:.08em; }
    .living-header p { margin:0; color:#9eaaae; font-size:.8rem; }
    .kernel-readout { min-width:180px; padding:.8rem 1rem; border:1px solid rgba(255,211,77,.3); border-left:4px solid #ff3030; background:rgba(8,7,7,.8); }
    .kernel-readout span,.kernel-readout strong { display:block; }.kernel-readout span{color:#737d81;font-size:.58rem;letter-spacing:.18em}.kernel-readout strong{margin-top:.35rem;font-size:.72rem;letter-spacing:.08em}.kernel-readout i{display:block;width:7px;height:7px;margin-top:.55rem;border-radius:50%;background:#ff3030;box-shadow:0 0 10px #ff3030;animation:pulse 1.3s infinite}
    .living-stage { position:relative; z-index:20; display:grid; grid-template-columns:minmax(0,1fr) 280px; gap:1rem; min-height:590px; padding:0 clamp(1rem,3vw,3rem) 1rem; }
    .architecture-field { position:relative; min-height:590px; overflow:hidden; border:1px solid rgba(255,211,77,.18); background:rgba(3,5,8,.56); box-shadow:inset 0 0 90px rgba(255,48,48,.035); }
    .architecture-field:before { content:""; position:absolute; inset:18px; border:1px solid rgba(255,48,48,.08); pointer-events:none; }
    .field-ring { position:absolute; left:50%; top:48%; border:1px solid rgba(255,211,77,.14); border-radius:50%; transform:translate(-50%,-50%) rotateX(66deg); pointer-events:none; }
    .ring-one{width:470px;height:470px;animation:ringPulse 6s infinite}.ring-two{width:330px;height:330px;border-color:rgba(255,48,48,.2);animation:ringSpin 18s linear infinite}.ring-three{width:190px;height:190px;border-color:rgba(255,211,77,.22);animation:ringSpinReverse 12s linear infinite}
    .connection { position:absolute; height:1px; transform-origin:left; background:linear-gradient(90deg,transparent,rgba(255,211,77,.45),transparent); box-shadow:0 0 7px rgba(255,48,48,.3); animation:connectionBreath 3s infinite; }
    .connection-a{width:280px;left:25%;top:31%;transform:rotate(28deg)}.connection-b{width:260px;left:56%;top:32%;transform:rotate(143deg);animation-delay:-.8s}.connection-c{width:300px;left:27%;top:66%;transform:rotate(-25deg);animation-delay:-1.5s}.connection-d{width:290px;left:56%;top:67%;transform:rotate(-155deg);animation-delay:-2.2s}
    .architecture-node { position:absolute; z-index:8; width:154px; min-height:78px; padding:.7rem .8rem; border:1px solid rgba(255,211,77,.32); border-left:5px solid #ff3030; border-radius:2px; background:rgba(8,7,7,.92); color:#f4f7f8; font:inherit; text-align:left; cursor:pointer; box-shadow:0 8px 25px rgba(0,0,0,.4); animation:nodeFloat 4.8s ease-in-out infinite; transition:.3s; }
    .architecture-node:hover,.architecture-node:focus-visible{border-color:#ffd34d;box-shadow:0 0 24px rgba(255,48,48,.25);outline:none}.architecture-node small{display:block;color:#ff3030;font-size:.56rem}.architecture-node strong{display:block;margin-top:.2rem;font-size:.82rem;letter-spacing:.08em}.architecture-node span{display:block;margin-top:.3rem;color:#879397;font-size:.52rem;letter-spacing:.1em}.node-bootstrap{left:7%;top:17%}.node-ontology{right:8%;top:17%;border-left-color:#ffd34d;animation-delay:-1s}.node-warehouse{left:4%;bottom:17%;border-left-color:#52e05a;animation-delay:-1.9s}.node-context{right:5%;bottom:17%;border-left-color:#00a8ff;animation-delay:-2.7s}.node-fsm{left:50%;top:8%;transform:translateX(-50%);border-left-color:#ff2cff;animation-delay:-3.5s}
    .node-fsm:hover,.node-fsm:focus-visible{transform:translateX(-50%) translateY(-3px)}
    .core-node { position:absolute; z-index:10; left:50%;top:48%; width:150px;height:150px; transform:translate(-50%,-50%); display:flex;align-items:center;justify-content:center;flex-direction:column; border:1px solid #ff3030;border-radius:50%;background:radial-gradient(circle,rgba(48,9,9,.94),rgba(5,5,6,.97) 65%);box-shadow:0 0 24px rgba(255,48,48,.32),inset 0 0 28px rgba(255,48,48,.1);animation:coreBreath 3s infinite}.core-halo{position:absolute;inset:-12px;border:1px solid rgba(255,211,77,.13);border-radius:50%;animation:pulse 3s infinite}.core-node small{font-size:.48rem;color:#aebdc2;letter-spacing:.12em}.core-node strong{margin:.3rem 0;color:#ffd34d;font-size:1.6rem;letter-spacing:.12em}.core-node span:last-child{max-width:115px;color:#ff3030;font-size:.48rem;letter-spacing:.07em;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .architecture-caption{position:absolute;left:50%;bottom:5%;z-index:9;width:92%;transform:translateX(-50%);display:flex;justify-content:center;gap:.6rem;color:#727d81;font-size:.5rem;letter-spacing:.1em;text-align:center}.architecture-caption b{color:#ff3030}
    .living-console{display:flex;min-height:590px;flex-direction:column;border:1px solid rgba(255,48,48,.27);background:rgba(5,5,6,.88)}.console-header{display:flex;justify-content:space-between;padding:.9rem;border-bottom:1px solid rgba(255,211,77,.15);color:#ffd34d;font-size:.62rem;letter-spacing:.14em}.console-header em{color:#ff3030;font-style:normal}.trace-lines{flex:1;padding:.85rem;overflow:hidden}.trace-line{margin-bottom:.6rem;color:#687579;font-size:.58rem;line-height:1.45}.trace-line.command{color:#d9e1e3}.inspector{margin:.75rem;padding:.9rem;border:1px solid rgba(255,211,77,.18);border-top:3px solid #ff3030;background:rgba(18,8,8,.66)}.inspector strong{display:block;margin-top:.35rem;color:#ffd34d;font-size:.95rem;letter-spacing:.1em}.inspector p{margin:.55rem 0 0;color:#98a4a8;font-size:.6rem;line-height:1.6}
    .gravity-deck{position:relative;z-index:30;display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:1rem clamp(1rem,4vw,4rem) 1.5rem;border-top:1px solid rgba(255,48,48,.18);background:rgba(3,5,8,.9)}.gravity-deck strong{display:block;margin-top:.3rem;font-size:.75rem;letter-spacing:.1em}.gravity-deck small{display:block;margin-top:.35rem;color:#737d81;font-size:.6rem}.gravity-button{display:flex;align-items:center;gap:.7rem;min-width:190px;padding:.85rem 1.1rem;border:1px solid #ffd34d;border-left:5px solid #ff3030;background:#0a0707;color:#fff;font:inherit;font-size:.65rem;font-weight:700;letter-spacing:.1em;cursor:pointer;transition:.3s}.gravity-button:hover:not(:disabled){background:#180b0b;box-shadow:0 0 28px rgba(255,48,48,.24);transform:translateY(-2px)}.gravity-button:disabled{color:#697174;border-color:#453d3d;cursor:default}.gravity-button b{color:#ff3030;font-size:1.3rem}
    .gravity-engaged .architecture-node,.gravity-engaged .living-console,.gravity-engaged .architecture-caption,.gravity-engaged .connection,.gravity-engaged .field-ring,.gravity-engaged .core-node{animation:gravityFall 1.65s cubic-bezier(.55,.06,.68,.19) forwards}.gravity-engaged .living-console{animation-delay:.12s}.gravity-engaged .architecture-caption{animation-delay:.06s}.gravity-engaged .moniker-layer{transform:scale(1.05);filter:brightness(1.28)}.gravity-engaged .moniker-title{filter:blur(0) drop-shadow(0 0 34px rgba(255,48,48,.2))}
    @@keyframes gravityFall{0%{opacity:1;transform:translateY(0) rotate(0)}100%{opacity:0;transform:translateY(120vh) rotate(9deg)}}
    @@keyframes monikerBreath{0%,100%{opacity:.62;transform:translateY(0)}50%{opacity:1;transform:translateY(-2px)}}
    @@keyframes venomBreath{0%,100%{opacity:.62;transform:translate(-50%,-50%) scale(.96)}50%{opacity:1;transform:translate(-50%,-50%) scale(1.04)}}
    @@keyframes pulse{0%,100%{opacity:.55;transform:scale(.85)}50%{opacity:1;transform:scale(1.18)}}
    @@keyframes ringPulse{0%,100%{opacity:.4;transform:translate(-50%,-50%) rotateX(66deg) scale(.98)}50%{opacity:1;transform:translate(-50%,-50%) rotateX(66deg) scale(1.03)}}
    @@keyframes ringSpin{from{transform:translate(-50%,-50%) rotateX(66deg) rotateZ(0)}to{transform:translate(-50%,-50%) rotateX(66deg) rotateZ(360deg)}}
    @@keyframes ringSpinReverse{from{transform:translate(-50%,-50%) rotateX(66deg) rotateZ(360deg)}to{transform:translate(-50%,-50%) rotateX(66deg) rotateZ(0)}}
    @@keyframes connectionBreath{0%,100%{opacity:.3}50%{opacity:.9}}
    @@keyframes nodeFloat{0%,100%{translate:0 0}50%{translate:0 -4px}}
    @@keyframes coreBreath{0%,100%{box-shadow:0 0 18px rgba(255,48,48,.24),inset 0 0 24px rgba(255,48,48,.08)}50%{box-shadow:0 0 34px rgba(255,48,48,.48),inset 0 0 34px rgba(255,48,48,.17)}}
    @@media(max-width:950px){.living-stage{grid-template-columns:1fr}.living-console{min-height:260px}.trace-lines{max-height:130px}}
    @@media(max-width:700px){.living-header{flex-direction:column}.kernel-readout{width:100%;box-sizing:border-box}.architecture-field{min-height:550px}.node-bootstrap{left:2%}.node-ontology{right:2%}.node-warehouse{left:1%}.node-context{right:1%}.architecture-caption{font-size:.43rem;gap:.35rem}.gravity-deck{align-items:stretch;flex-direction:column}.gravity-button{width:100%;justify-content:center}.moniker-title{max-width:98vw;font-size:clamp(1.5rem,7vw,3rem)}}
</style>

@code {
    private bool gravityEngaged;
    private string? selectedNode;

    private readonly List<string> traceLines = new()
    {
        "> SYSTEM / LIVING_GUI INITIALIZED",
        "  address space: workshop://architecture",
        "  render authority: LOCAL",
        "  state authority: FSM",
        "> CONTEXT / AWAITING SELECTION",
        "  deterministic execution armed"
    };

    private void SelectNode(string node)
    {
        selectedNode = node;
        traceLines.Insert(0, $"> INPUT / {node} SELECTED");
        if (traceLines.Count > 7) traceLines.RemoveAt(traceLines.Count - 1);
    }

    private string GetNodeDescription() => selectedNode switch
    {
        "BOOTSTRAP" => "The entry boundary: establish the environment in which the machine becomes addressable.",
        "ONTOLOGY" => "The machine-readable vocabulary: human meaning becomes deterministic address space.",
        "WAREHOUSE" => "The single-source-of-truth layer: state and assets become structured, addressable data.",
        "CONTEXT" => "The relevance boundary: context determines what representation, capability, relationship, and behavior is addressable now.",
        "FSM_API" => "The execution boundary: explicit state transitions with deterministic ownership of behavior.",
        _ => "Select an architectural node. The interface will tell you what it is doing."
    };

    private void EngageGravity()
    {
        if (gravityEngaged) return;
        gravityEngaged = true;
        traceLines.Insert(0, "> GRAVITY / RELEASE ALL SUSPENDED SURFACES");
        if (traceLines.Count > 7) traceLines.RemoveAt(traceLines.Count - 1);
    }
}
