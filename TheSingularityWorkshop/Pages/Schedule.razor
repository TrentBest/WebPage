@page "/schedule"
@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation
<PageTitle>Schedule a Consultation // The Singularity Workshop</PageTitle>

<div class="schedule-experience">
    <header><span class="schedule-pulse"></span><span>THE SINGULARITY WORKSHOP</span><i>// CONSULTATION DESK</i></header>
    <main class="schedule-grid">
        <section class="schedule-copy">
            <div class="schedule-kicker">BRING THE DIFFICULT PROBLEM</div>
            <h1>Let's find the<br/><em>right next step.</em></h1>
            <p>Technical consultation for complex .NET architecture, runtime composition, system integration, and ideas that don't fit a standard template.</p>
            <div class="meeting-types">
                <div><b>01</b><span><strong>First conversation</strong><small>Understand the problem, goals, and constraints.</small></span></div>
                <div><b>02</b><span><strong>Technical deep dive</strong><small>Review architecture, trade-offs, and evidence.</small></span></div>
                <div><b>03</b><span><strong>Follow-up session</strong><small>Review a concrete plan, prototype, or next experiment.</small></span></div>
            </div>
            <div class="schedule-note">A request is not a confirmed booking. We confirm the time directly; no calendar slot is reserved by this form.</div>
        </section>
        <section class="booking-panel">
            <div class="booking-top"><span>NEW APPOINTMENT REQUEST</span><span>LOCAL TIME REQUIRED</span></div>
            <label for="meeting">Conversation type</label>
            <select id="meeting" @bind="_meetingType"><option>First conversation (30 minutes)</option><option>Technical deep dive (60 minutes)</option><option>Institutional / program briefing (60 minutes)</option><option>Follow-up session (30 minutes)</option></select>
            <label for="date">Preferred date</label>
            <input id="date" type="date" @bind="_preferredDate" />
            <label for="time">Preferred time and time zone</label>
            <input id="time" @bind="_preferredTime" placeholder="e.g. 2:00 PM Pacific" maxlength="100" />
            <label for="contact">Your name / organization</label>
            <input id="contact" @bind="_contact" placeholder="How should I address you?" maxlength="160" />
            <label for="topic">What should we discuss?</label>
            <textarea id="topic" @bind="_topic" rows="3" maxlength="1200" placeholder="The problem, current stack, constraints, and what a useful meeting would accomplish."></textarea>
            <button @onclick="PrepareRequest">PREPARE APPOINTMENT REQUEST <b>↗</b></button>
            <a href="mailto:thesingularityworkshop@gmail.com">Email the Workshop directly ↗</a>
            <small>The request opens your email application for you to review and send. The live availability / booking calendar will be enabled when the Workshop scheduling endpoint is connected.</small>
        </section>
    </main>
    <footer><span>NO AUTO-BOOKING. NO FAKE AVAILABILITY.</span><span>CONFIRMED TIMES ARE CONFIRMED DIRECTLY.</span></footer>
</div>

<style>
.schedule-experience{--cyan:#00eaff;--pink:#ff2cff;position:relative;width:100%;height:100%;min-height:0;overflow:hidden;box-sizing:border-box;padding:clamp(.8rem,2.5vh,1.8rem) clamp(1rem,4vw,4rem);display:grid;grid-template-rows:auto minmax(0,1fr) auto;gap:clamp(.7rem,2vh,1.4rem);background:radial-gradient(ellipse at 15% 50%,#092237 0,transparent 44%),radial-gradient(ellipse at 85% 45%,#210b2c 0,transparent 35%),#020711;color:#eaf8ff;font-family:system-ui,sans-serif}.schedule-experience header,.schedule-experience footer,.schedule-kicker,.booking-top{display:flex;align-items:center;gap:.65rem;font:700 .6rem Consolas,monospace;letter-spacing:.13em;color:#86aab9}.schedule-experience header i{font-style:normal;color:var(--pink)}.schedule-pulse{width:.5rem;height:.5rem;border-radius:50%;background:var(--cyan);box-shadow:0 0 12px var(--cyan)}.schedule-grid{width:min(1300px,100%);min-height:0;margin:auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,.7fr);gap:clamp(1.2rem,5vw,5rem);align-items:center}.schedule-copy h1{font-size:clamp(2.7rem,6vw,5.7rem);letter-spacing:-.065em;line-height:.9;margin:.9rem 0 1rem}.schedule-copy h1 em{font-style:normal;color:var(--cyan);text-shadow:0 0 35px #00eaff2a}.schedule-copy>p{max-width:55ch;font-size:.95rem;line-height:1.65;color:#afc5d0}.meeting-types{display:grid;gap:.5rem;margin-top:1.1rem;max-width:610px}.meeting-types>div{display:flex;gap:.8rem;align-items:center;padding:.65rem .8rem;border:1px solid #17394b;background:#04101b}.meeting-types b{font:800 .8rem Consolas,monospace;color:var(--pink)}.meeting-types span{display:grid;gap:.2rem}.meeting-types strong{font-size:.8rem}.meeting-types small{font-size:.7rem;color:#8ca7b5}.schedule-note{margin-top:.75rem;color:#ffd34d;font-size:.67rem;line-height:1.5}.booking-panel{padding:clamp(1rem,2vw,1.5rem);border:1px solid #245064;background:#040c17;box-shadow:0 20px 70px #0005;min-width:0}.booking-top{justify-content:space-between;gap:.4rem;font-size:.52rem;padding-bottom:.8rem;border-bottom:1px solid #1b3444}.booking-panel label{display:block;margin:.75rem 0 .3rem;color:#8fb0bd;font:700 .59rem Consolas,monospace;letter-spacing:.07em}.booking-panel input,.booking-panel select,.booking-panel textarea{display:block;width:100%;box-sizing:border-box;padding:.65rem .7rem;border:1px solid #254454;background:#020711;color:#eaf8ff;font: .8rem system-ui,sans-serif;border-radius:0}.booking-panel input:focus,.booking-panel select:focus,.booking-panel textarea:focus{outline:1px solid var(--cyan);border-color:var(--cyan)}.booking-panel button{display:flex;justify-content:space-between;align-items:center;width:100%;margin-top:1rem;padding:.8rem;border:1px solid var(--cyan);background:var(--cyan);color:#031019;font:800 .62rem Consolas,monospace;cursor:pointer}.booking-panel button:hover{background:#a8fbff}.booking-panel>a{display:block;margin-top:.7rem;color:var(--cyan);font-size:.7rem;text-decoration:none}.booking-panel>small{display:block;margin-top:.7rem;color:#668491;font-size:.62rem;line-height:1.45}.schedule-experience footer{justify-content:space-between;font-size:.52rem;color:#628493}
@media(max-width:760px){.schedule-grid{grid-template-columns:1fr;gap:.6rem;align-content:center}.schedule-copy h1{font-size:clamp(2.1rem,7vw,3.4rem);margin:.45rem 0}.schedule-copy>p{font-size:.75rem;line-height:1.4;margin:.4rem 0}.meeting-types{grid-template-columns:repeat(3,minmax(0,1fr));gap:.3rem;margin-top:.5rem}.meeting-types>div{padding:.45rem;gap:.35rem;align-items:flex-start}.meeting-types b{font-size:.6rem}.meeting-types strong{font-size:.64rem}.meeting-types small{font-size:.56rem}.schedule-note{font-size:.57rem;margin-top:.35rem}.booking-panel{padding:.65rem}.booking-top{font-size:.46rem;padding-bottom:.35rem}.booking-panel label{margin:.35rem 0 .2rem;font-size:.52rem}.booking-panel input,.booking-panel select,.booking-panel textarea{padding:.42rem .5rem;font-size:.72rem}.booking-panel textarea{height:3.2rem}.booking-panel button{margin-top:.5rem;padding:.55rem}.booking-panel>a{margin-top:.35rem}.booking-panel>small{font-size:.52rem;margin-top:.35rem}.schedule-experience footer{font-size:.43rem}.schedule-experience footer span:last-child{display:none}}
@media(max-height:720px) and (min-width:761px){.schedule-grid{gap:1.2rem}.schedule-copy h1{font-size:clamp(2.4rem,5vw,4.4rem);margin:.5rem 0}.schedule-copy>p{line-height:1.4;margin:.4rem 0}.meeting-types{gap:.3rem;margin-top:.5rem}.meeting-types>div{padding:.45rem .7rem}.booking-panel{padding:.8rem}.booking-panel label{margin:.45rem 0 .2rem}.booking-panel input,.booking-panel select,.booking-panel textarea{padding:.48rem}.booking-panel textarea{height:3.3rem}}
</style>

@code {
    private string _meetingType = "First conversation (30 minutes)";
    private string _preferredDate = "";
    private string _preferredTime = "";
    private string _contact = "";
    private string _topic = "";

    private void PrepareRequest()
    {
        var subject = Uri.EscapeDataString("Workshop appointment request: " + _meetingType);
        var body = Uri.EscapeDataString($"Hello,\n\nI'd like to request a Workshop appointment.\n\nMeeting type: {_meetingType}\nPreferred date: {_preferredDate}\nPreferred time / time zone: {_preferredTime}\nName / organization: {_contact}\nTopic and context: {_topic}\n\nI understand this is a request and the time is not confirmed until we reply.\n");
        Navigation.NavigateTo($"mailto:thesingularityworkshop@gmail.com?subject={subject}&body={body}");
    }
}
