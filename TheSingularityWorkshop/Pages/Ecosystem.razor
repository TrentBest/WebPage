</style>

@code {
    private string _filter = "all";
    private string _bundleName = "WeatherSimulation";
    private string _bundlePurpose = "A capability that models changing weather conditions for a host simulation.";
    private string _testProfile = "standard";
    private bool _hasRun;
    private List<GauntletCheck> _checks = new();
    private List<string> _advice = new();
    private bool _allPassed => _checks.Count > 0 && _checks.All(c => c.Passed);
    private int _passedCount => _checks.Count(c => c.Passed);
    private string _consultTopic = "";
    private string _consultAvailability = "";
    private string _consultDetail = "";

    private void SetFilter(string value) => _filter = value;

    private void RunGauntlet()
    {
        _hasRun = true;
        var hasName = !string.IsNullOrWhiteSpace(_bundleName) && _bundleName.All(c => char.IsLetterOrDigit(c) || c == '_');
        var hasPurpose = !string.IsNullOrWhiteSpace(_bundlePurpose) && _bundlePurpose.Trim().Length >= 24;
        var hasForbidden = _bundlePurpose.Contains("unsafe", StringComparison.OrdinalIgnoreCase) ||
                           _bundlePurpose.Contains("secret", StringComparison.OrdinalIgnoreCase) ||
                           _bundlePurpose.Contains("infinite loop", StringComparison.OrdinalIgnoreCase);
        _checks = new()
        {
            new("Manifest identity", hasName, hasName ? "A simple identifier is present in the draft." : "Name must be non-empty and use letters, digits, or underscores."),
            new("Capability description", hasPurpose, hasPurpose ? "The draft explains a purpose at a basic descriptive level." : "Provide at least 24 non-whitespace characters describing intent."),
            new("Dependency closure", _testProfile != "strict" && hasName, _testProfile == "strict" ? "Strict mode requires an explicit dependency declaration; this draft has none." : "Placeholder check only: no dependency graph is actually loaded."),
            new("Host compatibility", _testProfile != "compat" && hasPurpose, _testProfile == "compat" ? "Compatibility mode requires declared target frameworks and host capabilities." : "Placeholder check only: no target framework is compiled."),
            new("Adversarial input review", !hasForbidden && _testProfile != "strict", _testProfile == "strict" ? "Strict profile intentionally rejects drafts without explicit resource and threat-boundary declarations." : hasForbidden ? "Draft wording triggered a simulated policy marker; this is not a real security scan." : "Basic text heuristic only; this does not prove the code is safe."),
            new("Reproducible test evidence", hasName && hasPurpose && _testProfile == "standard", _testProfile == "standard" && hasName && hasPurpose ? "Placeholder check: real deterministic tests would need to run in isolation." : "No executable test report or deterministic build evidence is attached.")
        };
        _advice = new();
        if (!hasName) _advice.Add("Choose a stable capability identifier; keep display names separate from machine identity.");
        if (!hasPurpose) _advice.Add("Describe what the capability does, what it needs, and what it promises not to do.");
        if (_testProfile == "strict") _advice.Add("Declare dependencies, permissions, resource limits, and threat boundaries before strict arbitration.");
        if (_testProfile == "compat") _advice.Add("Declare supported target frameworks and host capabilities, then test each supported combination.");
        if (hasForbidden) _advice.Add("Review the suspicious wording and document intended behavior and resource boundaries.");
        if (_advice.Count == 0 && !_allPassed) _advice.Add("Attach concrete evidence for each failing check and rerun the relevant tests.");
        if (_allPassed) _advice.Add("This is only a local demonstration result; a real submission still requires isolated execution and external review.");
    }

    private void RequestConsultation()
    {
        var subject = Uri.EscapeDataString("Workshop consultation request: " + (_consultTopic.Trim().Length > 0 ? _consultTopic.Trim() : "Complex .NET problem"));
        var body = Uri.EscapeDataString($"Hello,\n\nI'd like to discuss a technical problem with The Singularity Workshop.\n\nProblem: {_consultTopic}\nAvailability / time zone: {_consultAvailability}\nContext: {_consultDetail}\n\nThank you.");
        Navigation.NavigateTo($"mailto:thesingularityworkshop@gmail.com?subject={subject}&body={body}");
    }

    private sealed record GauntletCheck(string Name, bool Passed, string Detail);
}
