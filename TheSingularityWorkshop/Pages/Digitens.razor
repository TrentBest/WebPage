@page "/digitens"
@layout BareLayout
@using TheSingularityWorkshop.Gui
@using Microsoft.AspNetCore.Components
@implements IDisposable

<PageTitle>Digitens // Singularity City</PageTitle>

<main class="digiten-world">
    <header class="world-header">
        <a class="world-back" href="/" target="_top">← THE WORKSHOP</a>
        <div class="world-signal"><span></span> SINGULARITY CITY <i>/</i> LIVING DIGITAL CITIZENS</div>
        <h2 class="world-label">DIGITENS</h2>
        <h1>Not just avatars.<br /><em>People in a world.</em></h1>
        <p class="world-intro">A Digiten is a digital citizen with an identity, a place in the world, and a relationship to the systems around them. This first slice exposes the Workshop's existing civic identity and mansion-architecture data; it does not pretend that disconnected citizens are running autonomous agents yet.</p>
        <h2 class="world-thesis">The Workshop stays at the heart of the city.</h2>
    </header>


    <section class="topic-workbench" aria-label="Explore Digitens and Singularity City">
        <nav class="topic-choices" aria-label="Choose a topic">
            <div class="section-kicker">START EXPLORING</div>
            <h2>Digital citizens. A city. A new scale of detail.</h2>
            <p>Choose a question. The surrounding panels explain the idea; the central surface shows the relevant model or a verified rendering proof.</p>
            <button class="topic-choice @(_selectedTopic == "digitens" ? "active" : "")" @onclick='() => SelectTopic("digitens")' aria-pressed="@(_selectedTopic == "digitens")"><span>01</span><strong>Meet the Digitens</strong><small>Identity, place, and goals</small></button>
            <button class="topic-choice @(_selectedTopic == "theory" ? "active" : "")" @onclick='() => SelectTopic("theory")' aria-pressed="@(_selectedTopic == "theory")"><span>02</span><strong>Code &amp; theory</strong><small>What a Digiten is made of</small></button>
            <button class="topic-choice @(_selectedTopic == "renderer" ? "active" : "")" @onclick='() => SelectTopic("renderer")' aria-pressed="@(_selectedTopic == "renderer")"><span>03</span><strong>Renderer &amp; detail</strong><small>Event Horizons</small></button>
            <button class="topic-choice @(_selectedTopic == "city" ? "active" : "")" @onclick='() => SelectTopic("city")' aria-pressed="@(_selectedTopic == "city")"><span>04</span><strong>Singularity City</strong><small>Places, districts, and opportunity</small></button>
        </nav>

        <section class="topic-stage" aria-live="polite">
            <div class="topic-stage-head"><span class="section-kicker">WORKSPACE / @TopicEyebrow</span><span class="topic-stage-state">MODEL + PRESENTATION</span></div>
            @if (_selectedTopic == "renderer")
            {
                <div class="visualize-proof">
                    <img src="/Visualize/07-gui-svg-connected-points.svg" alt="Connected geometry emitted through the Visualize C# frame pipeline and GUI.SVG proof backend" />
                    <p class="proof-caption">REAL VISUALIZE OUTPUT · C# FRAME → VISUALIZER API → GUI.SVG PROOF BACKEND</p>
                </div>
            }
            else if (_selectedTopic == "city")
            {
                <div class="topic-city-map">
                    <div class="city-map-header">SINGULARITY CITY <span>SEMANTIC PLACE INDEX</span></div>
                    <div class="city-map-center"><strong>MAYOR'S MANSION</strong><small>SPATIAL ANCHOR</small></div>
                    <div class="city-map-branches">
                        @foreach (var feature in SingularityMansionArchitecture.Features.Take(6))
                        {
                            <div @key="feature.Id" class="city-map-node"><span>@feature.Kind.ToUpperInvariant()</span><strong>@feature.Name</strong></div>
                        }
                    </div>
                    <p class="proof-caption">HOST-MANIFESTED COMPOSITION · LABELS COME FROM THE EXISTING C# CITY MODEL</p>
                </div>
            }
            else if (_selectedTopic == "theory")
            {
                <div class="digiten-composition">
                    <div class="composition-identity"><span>IDENTITY</span><strong>Digiten</strong><small>Stable concept / changing representation</small></div>
                    <div class="composition-flow"><span>GOAL</span><b>→</b><span>CAPABILITIES</span><b>→</b><span>OBSERVATION</span></div>
                    <div class="composition-foot">Domain meaning belongs to the Experience. Renderer chooses computational detail. Visualize presents the resulting frame.</div>
                    <p class="proof-caption">EXPLANATORY HOST GUI · NOT A CLAIM THAT TEXT IS ALREADY A VISUALIZE DRAW COMMAND</p>
                </div>
            }
            else
            {
                <div class="digiten-composition">
                    <div class="composition-identity"><span>ONE DIGITAL CITIZEN</span><strong>@_selectedOfficial.Name</strong><small>@_selectedOfficial.Role</small></div>
                    <div class="composition-flow"><span>IDENTITY</span><b>+</b><span>PLACE</span><b>+</b><span>GOAL</span></div>
                    <div class="composition-foot">The civic catalog supplies identity. Shopping, housing, jobs, and citizen-owned companies are future capabilities—not implemented behavior in this page.</div>
                    <p class="proof-caption">HOST-MANIFESTED EXPLANATION · IDENTITY DATA COMES FROM THE EXISTING CIVIC CATALOG</p>
                </div>
            }
            <div class="topic-stage-bottom">
                <div><span class="detail-label">WHAT THIS PROVES</span><p>@TopicProof</p></div>
                <div><span class="detail-label">WHAT IT DOES NOT CLAIM</span><p>@TopicBoundary</p></div>
            </div>
        </section>

        <aside class="topic-inspector">
            <div class="section-kicker">INSPECT / @TopicNumber</div><h3>@TopicTitle</h3><p>@TopicDescription</p>
            @if (_selectedTopic == "renderer")
            {
                <div class="inspector-facts">
                    <div><span>COMPUTATIONAL MODEL</span><strong>5 representation targets</strong></div>
                    <div><span>DETAIL POLICY</span><strong>Event Horizons</strong></div>
                    <div><span>GPU MEMORY PER DIGITEN</span><strong>Not measured here</strong></div>
                </div>
                @if (_rendererProbe.IsConnected)
                {
                    <div class="renderer-live"><span class="detail-label">LIVE RENDERER FSM / SOURCE MODE</span><strong>@_rendererProbe.ActiveRepresentation</strong>
                        <div class="representation-buttons">
                            @foreach (var representation in RendererRepresentations)
                            {
                                <button @key="representation" class="representation-button @(string.Equals(_rendererProbe.ActiveRepresentation, representation, StringComparison.OrdinalIgnoreCase) ? "active" : "")" @onclick="() => SelectRepresentation(representation)">@representation</button>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p class="source-mode-note">The live representation FSM is enabled when WebPage is built with the sibling Renderer source repository. Default NuGet mode does not pretend the source project is loaded.</p>
                }
                <a class="source-link" href="https://github.com/TrentBest/TheSingularityWorkshop.Renderer" target="_blank" rel="noopener noreferrer">Explore Renderer source ↗</a>
                <a class="source-link" href="https://github.com/TrentBest/TheSingularityWorkshop.Visualize/tree/development/samples/PrimitiveGallery" target="_blank" rel="noopener noreferrer">Explore Visualize proof gallery ↗</a>
            }
            else if (_selectedTopic == "city")
            {
                <div class="inspector-facts"><div><span>EXISTING SPATIAL MODEL</span><strong>@SingularityMansionArchitecture.Features.Count mansion features</strong></div><div><span>MAP STATUS</span><strong>Semantic schematic</strong></div><div><span>FUTURE CITY</span><strong>Homes · jobs · companies</strong></div></div>
            }
            else
            {
                <div class="inspector-facts"><div><span>EXISTING DATA</span><strong>Civic identity catalog</strong></div><div><span>IDENTITY ≠ DETAIL</span><strong>One citizen, many representations</strong></div><div><span>GOAL COMPLEXITY</span><strong>Requires explicit capability data</strong></div></div>
            }
        </aside>
    </section>

    <section class="world-grid" aria-label="Singularity City civic directory and Mayor's Mansion plan">
        <section class="citizen-panel">
            <div class="section-kicker">01 / CIVIC DIRECTORY</div>
            <div class="section-heading"><h2>Meet the officials.</h2><span>@SingularityCivicDigitenCatalog.Officials.Count REGISTERED</span></div>
            <p class="section-copy">Select an official to inspect their identity, office, role, and committee assignments. The directory is backed by the existing C# civic catalog.</p>
            <div class="citizen-list">
                @foreach (var official in SingularityCivicDigitenCatalog.Officials)
                {
                    <button class="citizen-row @(string.Equals(official.Id, _selectedOfficial.Id, StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
                            @key="official.Id"
                            @onclick="() => SelectOfficial(official)"
                            aria-pressed="@(string.Equals(official.Id, _selectedOfficial.Id, StringComparison.OrdinalIgnoreCase))">
                        <span class="citizen-glyph">@Initials(official.Name)</span>
                        <span class="citizen-name"><strong>@official.Name</strong><small>@official.Role</small></span>
                        <span class="citizen-arrow">↗</span>
                    </button>
                }
            </div>
            <article class="citizen-detail" aria-live="polite">
                <div class="detail-label">SELECTED IDENTITY</div>
                <h3>@_selectedOfficial.Name</h3>
                <p class="office-id">@_selectedOfficial.OfficeId</p>
                <p>@_selectedOfficial.Role</p>
                <div class="committee-list">
                    @foreach (var committee in _selectedOfficial.CommitteeAssignments)
                    {
                        <span @key="committee">@committee</span>
                    }
                </div>
            </article>
        </section>

        <section class="mansion-panel">
            <div class="section-kicker">02 / SPATIAL ANCHOR</div>
            <div class="section-heading"><h2>The Mayor's Mansion.</h2><span>@SingularityMansionArchitecture.Features.Count FEATURES</span></div>
            <p class="section-copy">A semantic plan, not a fabrication-ready architectural drawing. Choose a feature to inspect the meaning already recorded in the Workshop model.</p>
            <div class="plan-frame">
                <svg class="mansion-plan" viewBox="0 0 100 100" role="img" aria-label="Conceptual Mayor's Mansion feature map">
                    <rect class="plan-boundary" x="2" y="2" width="96" height="96" rx="1" />
                    @foreach (var feature in SingularityMansionArchitecture.Features)
                    {
                        <g @key="feature.Id" class="plan-feature @(string.Equals(feature.Id, _selectedFeature.Id, StringComparison.Ordinal) ? "active" : "")">
                            <rect x="@feature.X" y="@feature.Y" width="@feature.Width" height="@feature.Height" rx="1" />
                            <title>@feature.Name — @feature.Description</title>
                            <text x="@(feature.X + feature.Width / 2)" y="@(feature.Y + feature.Height / 2)" text-anchor="middle" dominant-baseline="middle">@ShortLabel(feature.Name)</text>
                        </g>
                    }
                    <path class="plan-axis" d="M 50 2 V 98 M 2 50 H 98" />
                </svg>
                <div class="plan-caption"><span>SCHEMATIC / NORMALIZED COORDINATES</span><span>NOT TO SCALE</span></div>
            </div>
            <div class="feature-list" aria-label="Mansion features">
                @foreach (var feature in SingularityMansionArchitecture.Features)
                {
                    <button @key="feature.Id"
                            class="feature-chip @(string.Equals(feature.Id, _selectedFeature.Id, StringComparison.Ordinal) ? "selected" : "")"
                            @onclick="() => SelectFeature(feature)"
                            aria-pressed="@(string.Equals(feature.Id, _selectedFeature.Id, StringComparison.Ordinal))">
                        <span>@feature.Kind</span><strong>@feature.Name</strong>
                    </button>
                }
            </div>
            <article class="feature-detail" aria-live="polite">
                <div class="detail-label">SELECTED PLACE / @_selectedFeature.Kind.ToUpperInvariant()</div>
                <h3>@_selectedFeature.Name</h3>
                <p>@_selectedFeature.Description</p>
            </article>
        </section>
    </section>

    <footer class="presence-contract">
        <span class="contract-mark">✳</span>
        <div><div class="section-kicker">03 / PRESENCE CONTRACT</div><h2>A world persists. A live avatar does not.</h2>
            <p>@SingularityDigitenPresenceRules.PresenceContract</p>
            <small>This is the declared boundary, not a claim that account connection, durable storage, or network presence is implemented by this page.</small>
        </div>
    </footer>
    <footer class="world-footer"><span>THE SINGULARITY WORKSHOP</span><span>IDENTITY · PLACE · PRESENCE · PERSISTENCE</span></footer>
</main>

<style>
