.topic-stage{display:flex;flex-direction:column;gap:.8rem}.topic-stage-head{display:flex;justify-content:space-between;gap:.5rem;flex-wrap:wrap}.topic-stage-state{color:#58e8c1;font:700 .52rem Consolas,monospace;letter-spacing:.1em}.visualize-proof{min-height:220px;display:grid;align-content:center;gap:.65rem;background:#020711;border:1px solid #193746;padding:.65rem}.visualize-proof img{display:block;width:100%;height:auto}.proof-caption{margin:0;color:#6792a4;font:700 .5rem/1.5 Consolas,monospace;letter-spacing:.07em}
.topic-stage-bottom{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;border-top:1px solid #193746;padding-top:.8rem}.topic-stage-bottom p{font-size:.68rem;line-height:1.55;color:#a7bdc7;margin:.4rem 0 0}
.topic-city-map,.digiten-composition{display:flex;flex-direction:column;justify-content:center;gap:1rem;min-height:250px;padding:1rem;border:1px solid #23475b;background:radial-gradient(ellipse at center,#092237 0,#020711 72%)}.city-map-header{display:flex;justify-content:space-between;gap:.5rem;flex-wrap:wrap;color:#00eaff;font:800 .65rem Consolas,monospace;letter-spacing:.1em}.city-map-header span{color:#63899a;font-size:.5rem}.city-map-center{align-self:center;display:grid;gap:.35rem;text-align:center;padding:1rem 1.4rem;border:1px solid #ff2cff;background:#ff2cff0c;box-shadow:0 0 28px #ff2cff12}.city-map-center strong{font-size:.85rem}.city-map-center small{color:#7ea8ba;font:700 .5rem Consolas,monospace}.city-map-branches{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem}.city-map-node{display:grid;gap:.25rem;padding:.6rem;border:1px solid #1d4052;background:#04101b}.city-map-node span{font:700 .48rem Consolas,monospace;color:#00eaff}.city-map-node strong{font-size:.65rem;line-height:1.3}
.composition-identity{display:grid;gap:.4rem;text-align:center;padding:1.1rem;border:1px solid #00eaff;background:#00eaff08}.composition-identity span{font:700 .52rem Consolas,monospace;letter-spacing:.12em;color:#00eaff}.composition-identity strong{font-size:clamp(1.5rem,3vw,2.4rem)}.composition-identity small{color:#93b1bf;font-size:.7rem}.composition-flow{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:.65rem;color:#eaf8ff;font:700 .62rem Consolas,monospace}.composition-flow b{color:#ff2cff;font-size:1rem}.composition-foot{color:#a8c1cc;font-size:.73rem;line-height:1.6;text-align:center;max-width:52ch;align-self:center}
.topic-inspector h3{font-size:1.3rem;line-height:1.1;margin:.6rem 0}.inspector-facts{display:grid;gap:.45rem;margin-top:1rem}.inspector-facts>div{display:grid;gap:.3rem;padding:.65rem;border:1px solid #193746;background:#04101b}.inspector-facts span{font:700 .48rem Consolas,monospace;letter-spacing:.1em;color:#6e98a9}.inspector-facts strong{font-size:.68rem;line-height:1.4;color:#eaf8ff}.source-link{display:block;margin-top:.7rem;color:#00eaff;text-decoration:none;font:700 .6rem Consolas,monospace}.source-link:hover{text-decoration:underline}.source-mode-note{margin:.8rem 0;color:#91a6b0;font-size:.65rem;line-height:1.55}.renderer-live{margin-top:1rem;padding:.75rem;border:1px solid #2d5b6c;background:#00eaff08;display:grid;gap:.5rem}.renderer-live>strong{font:800 1.2rem Consolas,monospace;color:#00eaff}.representation-buttons{display:flex;flex-wrap:wrap;gap:.3rem}.representation-button{padding:.4rem .45rem;background:#04101b;border:1px solid #254655;color:#a8c1cc;font:700 .5rem Consolas,monospace;cursor:pointer}.representation-button.active,.representation-button:hover{border-color:#00eaff;color:#00eaff}
@@media(max-width:1100px){.topic-workbench{grid-template-columns:minmax(0,1fr) minmax(0,1.5fr)}.topic-inspector{grid-column:1/-1}}
