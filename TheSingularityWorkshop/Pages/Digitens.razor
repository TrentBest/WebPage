</style>

@code {
    private string _selectedTopic = "digitens";
    private readonly DigitenRendererProbe _rendererProbe = new();
    private static readonly string[] RendererRepresentations = ["Semantic", "Aggregate", "Distant", "Near", "Interactive"];

    private string TopicEyebrow => _selectedTopic switch { "theory" => "CODE + THEORY", "renderer" => "EVENT HORIZONS", "city" => "CITY MODEL", _ => "CITIZEN IDENTITY" };
    private string TopicNumber => _selectedTopic switch { "theory" => "02", "renderer" => "03", "city" => "04", _ => "01" };
    private string TopicTitle => _selectedTopic switch { "theory" => "Identity is not detail.", "renderer" => "Render only what matters.", "city" => "A place has structure.", _ => "A citizen is more than an avatar." };
