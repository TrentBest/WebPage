@page "/deep-dive/{ExperienceId:long}"
@using TheSingularityWorkshop.SingularityHub
@using TheSingularityWorkshop.Workshop.Composition
@using TheSingularityWorkshop.Services
@inject NavigationManager Navigation
@inject WorkshopDeepDiveCatalog DeepDiveCatalog
@inject WorkshopExperienceService ExperienceService

<PageTitle>Deep Dive // @ExperienceName</PageTitle>

<div class="deep-dive">
    <header class="hero">
        <div class="kicker">THE SINGULARITY WORKSHOP // DEEP DIVE</div>
        <h1>@ExperienceName</h1>
        <p class="lede">
            You just watched the runtime at full power. Now we take the machine apart without
            pretending the machine was a movie.
        </p>
        <div class="actions">
            <button @onclick="ReturnToExperience">RUN IT AGAIN</button>
            <button @onclick="GoCreate">MAKE YOUR OWN</button>
        </div>
    </header>

    <main>
        <section class="statement">
            <span>01 // THE POINT</span>
            <h2>The spectacle comes first. The explanation comes second.</h2>
            <p>
                A Deep Dive is the Workshop's way of exposing the construction of an Experience
                after you have actually seen it run. We explain what was composed, what depended
                on what, which runtime owns each decision, and which ontological identifiers let
                another creator find the same capability.
            </p>
        </section>
    </main>
</div>

<style>
.deep-dive{max-width:1100px;margin:0 auto;padding:clamp(1.5rem,5vw,4rem);color:#d9f8ff}
.hero{padding:2rem 0 3rem;border-bottom:1px solid rgba(0,234,255,.2)}
.kicker{color:#00eaff;letter-spacing:.16em;font-size:.7rem;margin-bottom:1.2rem}
h1{font-size:clamp(2.5rem,7vw,5rem);line-height:1.05;margin:0 0 1rem}
.lede{max-width:50rem;color:#a9bdc6;line-height:1.8}
.actions{display:flex;gap:1rem;flex-wrap:wrap;margin-top:2rem}
button{padding:.9rem 1.2rem;border:1px solid rgba(0,234,255,.45);background:transparent;color:#d9f8ff;cursor:pointer}
.statement{padding:3rem 0;border-bottom:1px solid rgba(0,234,255,.15)}
.statement span{color:#00eaff;font-size:.7rem;letter-spacing:.14em}
h2{font-size:clamp(1.5rem,4vw,2.5rem);max-width:45rem}
.statement p{max-width:50rem;color:#a9bdc6;line-height:1.8}
</style>

@code {
    [Parameter] public long ExperienceId { get; set; }

    private WorkshopDeepDiveModel? Model =>
        DeepDiveCatalog.TryResolve(
            (ulong)ExperienceId,
            ExperienceService.RuntimeAssembly,
            ExperienceService.PrimaryManifestExperience?.MicroBundles.Select(root => root.BundleId).ToArray(),
            out var model)
            ? model
            : null;

    private string RuntimeSummary => Model?.RuntimeAssembly is { } assembly
        ? $"ASSEMBLY {assembly.RuntimeId} // {assembly.Bundles.Count} BUNDLES"
        : "FSM_COS // CATALOG VIEW";

    private string RuntimeDescription => Model?.RuntimeAssembly is { } assembly
        ? $"This view is backed by the actual RuntimeAssembly returned by FSM_COS. It contains {assembly.Bundles.Count} resolved MicroBundles and converged after {assembly.ArbitrationRounds} arbitration rounds. Requested roots and resolved bundles are shown separately below."
        : "This page was opened without an available startup RuntimeAssembly. The fallback view describes catalog declarations only; it is not evidence of the dependency-closed runtime. Return to the hub and open SHOW DEEP DIVE to inspect the running assembly.";

    private IExperience? CurrentExperience => Model?.Experience;

    private string ExperienceName => CurrentExperience?.Name ?? $"EXPERIENCE 0x{ExperienceId:X16}";
}
