@page "/create"
@inject NavigationManager Navigation

<PageTitle>Create // The Singularity Workshop</PageTitle>

<div class="create-workshop">
    <section class="create-rail" aria-label="Creation concepts">
        <button type="button" class="rail-toggle" @onclick="ToggleConceptRail" title="@(conceptRailCollapsed ? "Open creation concepts" : "Collapse creation concepts")">@(conceptRailCollapsed ? "≪" : "≫")</button>
        @if (!conceptRailCollapsed)
        {
            <div class="rail-label">CREATE // CONCEPTS</div>
            @foreach (var concept in Concepts)
            {
                <button type="button" class="concept-button @(SelectedConcept.Id == concept.Id ? "selected" : "")" @onclick="() => SelectConcept(concept.Id)">
                    <span class="concept-index">@concept.Index</span>
                    <span><strong>@concept.Name</strong><small>@concept.ShortDescription</small></span>
                </button>
            }
        }
    </section>

    <section class="create-canvas">
        <header class="create-header">
            <div>
                <div class="create-kicker">THE WORKSHOP // CREATE</div>
                <h1>@SelectedConcept.Name</h1>
                <p>@SelectedConcept.Description</p>
            </div>
            <div class="bus-indicator"><span></span> COMMON DATA BUS READY</div>
        </header>

        <div class="builder-grid">
            <article class="builder-panel primary-panel">
                <div class="panel-chrome"><span>01 // VISUALIZE</span><span>@SelectedConcept.Name.ToUpperInvariant()</span></div>
                <div class="concept-visual">
                    @if (SelectedConcept.Id == "memory")
                    {
                        <div class="memory-map">
                            <div class="memory-block cyan">MANIFEST<br /><small>IDENTITY</small></div>
                            <div class="memory-block magenta">MICROBUNDLES<br /><small>CAPABILITIES</small></div>
                            <div class="memory-block yellow">EXPERIENCE<br /><small>COMPOSITION</small></div>
                            <div class="memory-block green">RUNTIME<br /><small>STATE</small></div>
                        </div>
                    }
                    else if (SelectedConcept.Id == "circuit")
                    {
                        <div class="circuit-map">
                            <div class="circuit-node">INPUT</div><i></i><div class="circuit-node active">PROCESS</div><i></i><div class="circuit-node">OUTPUT</div>
                            <div class="circuit-branch"><span></span><b>COMMON BUS</b><span></span></div>
                        </div>
                    }
                    else if (SelectedConcept.Id == "experience")
                    {
                        <div class="recipe-map">
                            <div class="recipe-step"><b>1</b><span>ADD MICRO-BUNDLE</span></div>
                            <div class="recipe-stir">STIR → ARBITRATE → OBSERVE</div>
                            <div class="recipe-step"><b>2</b><span>ENTER EXPERIENCE</span></div>
                        </div>
                    }
                    else
                    {
                        <div class="state-map">
                            <div>STATE A</div><span>→</span><div class="active">STATE B</div><span>→</span><div>STATE C</div>
                        </div>
                    }
                </div>
            </article>

            <article class="builder-panel inspector-panel">
                <div class="panel-chrome"><span>02 // INSPECT</span><span>CONTEXT</span></div>
                <div class="inspector-content">
                    <div class="inspector-row"><span>FOCUS</span><strong>@SelectedConcept.Name</strong></div>
                    <div class="inspector-row"><span>ROLE</span><strong>@SelectedConcept.Role</strong></div>
                    <div class="inspector-row"><span>COMPOSED OF</span><strong>@SelectedConcept.Composition</strong></div>
                    <div class="inspector-row"><span>BUS</span><strong>AVAILABLE</strong></div>
                    <div class="inspector-note">Select another concept. The workspace remains the same environment; only the focused model changes.</div>
                </div>
            </article>
        </div>

        <section class="recipe-panel">
            <div class="panel-chrome"><span>03 // EXPERIENCE RECIPE</span><span>MICROBUNDLES + ORDER + ARBITRATION</span></div>
            <div class="recipe-flow">
                <div><b>ADD</b><span>focused MicroBundle</span></div><em>+</em>
                <div><b>ORDER</b><span>manifest sequence</span></div><em>→</em>
                <div><b>ARBITRATE</b><span>resolve contributions</span></div><em>→</em>
                <div><b>RUN</b><span>observe the Experience</span></div>
            </div>
        </section>

        <footer class="create-footer">
            <span>THE BUILDER IS THE DOCUMENTATION.</span>
            <button type="button" class="forge-entry" @onclick="EnterForge">ENTER THE FORGE →</button>
        </footer>
    </section>
</div>

@code {
    private bool conceptRailCollapsed;
    private string selectedConceptId = "experience";

    private static readonly IReadOnlyList<CreationConcept> Concepts =
    [
        new("experience", "Experiences", "ENVIRONMENT", "Compose an environment from focused capabilities.", "MicroBundles + presentation + behavior"),
        new("memory", "Memory Layout", "STRUCTURE", "Draw how information is arranged and addressed.", "ontology + manifest + runtime state"),
        new("circuit", "Circuit Layouts", "FLOW", "Map inputs, processing, outputs, and shared buses.", "providers + process groups + data flow"),
        new("fsm", "State Machines", "BEHAVIOR", "Shape states, transitions, predicates, and heartbeat.", "FSM_API state + transitions + execution")
    ];

    private CreationConcept SelectedConcept => Concepts.First(x => x.Id == selectedConceptId);

    private void ToggleConceptRail() => conceptRailCollapsed = !conceptRailCollapsed;
    private void SelectConcept(string id) => selectedConceptId = id;
    private void EnterForge() => Navigation.NavigateTo("/explore?room=engineering");

    private sealed record CreationConcept(string Id, string Name, string Role, string Description, string Composition)
    {
        public int Index => Id switch { "experience" => 1, "memory" => 2, "circuit" => 3, "fsm" => 4, _ => 0 };
        public string ShortDescription => Role;
    }
}

<style>
    .create-workshop{position:relative;min-height:calc(100vh - 5rem);margin:-1rem -1.5rem;padding:1rem;box-sizing:border-box;display:flex;gap:.75rem;overflow:hidden;color:#eafcff;background:radial-gradient(circle at 65% 18%,rgba(0,234,255,.08),transparent 32%),radial-gradient(circle at 85% 78%,rgba(255,44,255,.09),transparent 30%),#020711;font-family:Consolas,'Courier New',monospace}.create-rail{width:clamp(180px,18vw,280px);flex:0 0 clamp(180px,18vw,280px);border:1px solid rgba(255,44,255,.25);background:rgba(3,8,20,.88);box-shadow:inset 0 0 30px rgba(255,44,255,.025);transition:width .35s ease,flex-basis .35s ease}.rail-toggle{margin:.7rem;width:2.2rem;height:2.2rem;border:1px solid rgba(0,234,255,.5);background:rgba(0,234,255,.035);color:#00eaff;font:800 1rem Consolas,'Courier New',monospace;cursor:pointer}.rail-toggle:hover{color:#ff2cff;border-color:#ff2cff}.create-rail:has(.rail-toggle:first-child:only-child){width:3.7rem;flex-basis:3.7rem}.rail-label{padding:.4rem .75rem .7rem;color:#00eaff;font-size:.58rem;letter-spacing:.16em}.concept-button{width:100%;display:grid;grid-template-columns:2rem 1fr;gap:.55rem;padding:.75rem;border:0;border-top:1px solid rgba(0,234,255,.08);background:transparent;color:#6f8992;text-align:left;font:inherit;cursor:pointer}.concept-button:hover,.concept-button.selected{background:linear-gradient(90deg,rgba(255,44,255,.09),transparent);color:#fff}.concept-button.selected{box-shadow:inset 2px 0 #ff2cff}.concept-index{color:#ff2cff;font-size:.65rem}.concept-button strong{display:block;font-size:.7rem;letter-spacing:.08em}.concept-button small{display:block;margin-top:.2rem;color:#5e7882;font-size:.52rem;letter-spacing:.08em}.create-canvas{min-width:0;flex:1;display:flex;flex-direction:column;gap:.75rem}.create-header{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;padding:1rem 1.25rem;border:1px solid rgba(0,234,255,.18);background:rgba(3,12,24,.7)}.create-kicker{color:#00eaff;font-size:.6rem;letter-spacing:.18em}.create-header h1{margin:.4rem 0 .45rem;font-size:clamp(1.8rem,4vw,4rem);line-height:1}.create-header p{max-width:850px;margin:0;color:#8eaab4;font-family:system-ui,sans-serif;line-height:1.55}.bus-indicator{white-space:nowrap;color:#52e05a;font-size:.55rem;letter-spacing:.1em}.bus-indicator span{display:inline-block;width:6px;height:6px;margin-right:.35rem;border-radius:50%;background:#52e05a;box-shadow:0 0 10px #52e05a;animation:busPulse 1.8s ease-in-out infinite}.builder-grid{min-height:0;flex:1;display:grid;grid-template-columns:minmax(0,2fr) minmax(220px,.8fr);gap:.75rem}.builder-panel,.recipe-panel{border:1px solid rgba(0,234,255,.18);background:rgba(3,12,24,.78);box-shadow:inset 0 0 35px rgba(0,234,255,.018)}.panel-chrome{display:flex;justify-content:space-between;padding:.55rem .75rem;border-bottom:1px solid rgba(0,234,255,.12);color:#62808a;font-size:.52rem;letter-spacing:.12em}.primary-panel{min-height:390px}.concept-visual{height:calc(100% - 2rem);display:flex;align-items:center;justify-content:center;padding:2rem}.memory-map{width:min(700px,90%);display:grid;grid-template-columns:1fr 1.25fr 1fr;grid-template-rows:1fr 1fr;gap:8px;transform:perspective(700px) rotateX(4deg)}.memory-block{display:flex;align-items:center;justify-content:center;min-height:90px;text-align:center;border:1px solid currentColor;background:rgba(0,234,255,.025);font-weight:800;font-size:.72rem;line-height:1.4;box-shadow:0 0 20px rgba(0,234,255,.04)}.memory-block:nth-child(1){grid-row:span 2}.memory-block:nth-child(2){grid-row:span 2}.memory-block small{font-weight:400;font-size:.48rem;letter-spacing:.1em}.cyan{color:#00eaff}.magenta{color:#ff2cff}.yellow{color:#ffd34d}.green{color:#52e05a}.circuit-map{display:flex;align-items:center;justify-content:center;gap:.6rem;flex-wrap:wrap}.circuit-node{padding:1rem 1.4rem;border:1px solid #00eaff;color:#8eaab4;font-size:.62rem}.circuit-node.active{color:#fff;border-color:#ff2cff;box-shadow:0 0 24px rgba(255,44,255,.2)}.circuit-map i{width:55px;height:1px;background:linear-gradient(90deg,#00eaff,#ff2cff)}.circuit-branch{width:100%;display:flex;align-items:center;justify-content:center;gap:1rem;color:#00eaff;font-size:.5rem;letter-spacing:.12em}.circuit-branch span{width:80px;height:1px;background:#00eaff}.recipe-map,.state-map{display:flex;align-items:center;justify-content:center;gap:1rem;flex-wrap:wrap}.recipe-step{display:flex;align-items:center;gap:.6rem;padding:1rem;border:1px solid #00eaff;color:#fff}.recipe-step b{color:#ff2cff}.recipe-step span,.state-map div{font-size:.65rem;letter-spacing:.08em}.recipe-stir{color:#ffd34d;font-size:.58rem;letter-spacing:.14em}.state-map div{padding:1rem;border:1px solid #00eaff;color:#7e9aa5}.state-map .active{color:#fff;border-color:#ff2cff;box-shadow:0 0 20px rgba(255,44,255,.16)}.state-map span{color:#00eaff}.inspector-content{padding:1rem}.inspector-row{display:flex;justify-content:space-between;gap:1rem;padding:.8rem 0;border-bottom:1px solid rgba(0,234,255,.08);font-size:.58rem}.inspector-row span{color:#5e7882}.inspector-row strong{text-align:right;color:#d9faff;font-size:.55rem}.inspector-note{margin-top:1rem;color:#607d87;font-family:system-ui,sans-serif;font-size:.75rem;line-height:1.55}.recipe-panel{flex:0 0 auto}.recipe-flow{display:flex;align-items:center;justify-content:space-around;gap:.5rem;padding:1rem}.recipe-flow div{text-align:center}.recipe-flow b{display:block;color:#fff;font-size:.6rem;letter-spacing:.1em}.recipe-flow span{display:block;margin-top:.25rem;color:#607d87;font-family:system-ui,sans-serif;font-size:.7rem}.recipe-flow em{color:#ff2cff;font-style:normal}.create-footer{display:flex;justify-content:space-between;gap:1rem;padding:.35rem .25rem;color:#4e6973;font-size:.5rem;letter-spacing:.08em}.create-footer span:first-child{color:#00eaff}.forge-entry{padding:.55rem .8rem;border:1px solid rgba(255,44,255,.55);background:rgba(255,44,255,.08);color:#ff2cff;font:inherit;font-size:.5rem;letter-spacing:.1em;cursor:pointer}.forge-entry:hover{background:rgba(255,44,255,.16);box-shadow:0 0 18px rgba(255,44,255,.14)}@@keyframes busPulse{0%,100%{opacity:.45;transform:scale(.8)}50%{opacity:1;transform:scale(1.3)}}@@media(max-width:900px){.create-header{flex-direction:column}.builder-grid{grid-template-columns:1fr}.inspector-panel{min-height:220px}}@@media(max-width:650px){.create-workshop{margin:-.5rem -.75rem;padding:.5rem}.create-rail{width:3.7rem;flex-basis:3.7rem}.create-rail:not(:has(.rail-toggle:first-child:only-child)){width:180px;flex-basis:180px}.create-header{padding:.8rem}.recipe-flow{flex-wrap:wrap}.create-footer{flex-direction:column}}
</style>
