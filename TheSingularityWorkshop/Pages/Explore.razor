@page "/explore"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using TheSingularityWorkshop.Gui
@using TheSingularityWorkshop.Workshop.MicroBundles
@implements IDisposable

<PageTitle>Explore // The Singularity Workshop</PageTitle>

@BuildGui().Build()

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private readonly ExploreExperienceMicroBundle Experience;
    private readonly SpatialWorkshopScene Scene = SpatialWorkshopScene.CreateDefault();
    private string? insideRoomId;
    private int detailLevel = 16;
    private IJSObjectReference? spatialModule;

    private static readonly IReadOnlyList<SpatialRoom> Rooms =
    [
        new("experience", "Experience Deck", "LIVING SPACE", 25, 28, 25, 42, 25, 42, "The sensory side of the Workshop. This is where an Experience becomes something a visitor can actually inhabit.", "EXPERIENCE", "Living GUI / presentation"),
        new("engineering", "The Forge", "FSM WORKSHOP", 73, 30, 73, 46, 73, 46, "The Workshop's first real building: a place for shaping state, lifecycle, reusable substrates, and executable machinery.", "FORGE", "FSM / lifecycle / composition"),
        new("creation", "Creation Bay", "BUILDER SPACE", 34, 72, 34, 88, 34, 88, "The composition boundary. Focused capabilities become MicroBundles, then recipes, then executable Experiences.", "CREATION", "MicroBundles / composition"),
        new("unknown", "Unknown Annex", "UNMAPPED", 79, 76, 79, 90, 79, 90, "Something exists beyond the architecture currently exposed to the visitor. There is no reason to assume it is empty.", "UNKNOWN", "Undisclosed")
    ];

    public ExploreExperienceMicroBundle ExperienceForTests => Experience;

    public Explore()
    {
        Experience = new ExploreExperienceMicroBundle();
        Experience.Navigation.MoveTo(Scene.StartingPosition.X, Scene.StartingPosition.Y);
    }

    private double AvatarX => Experience.Navigation.X;
    private double AvatarY => Experience.Navigation.Y;
    private bool ConferenceJoined => Experience.Conference.Joined;
    private FsmForgeMicroBundle Forge => Experience.Forge;

    private ElementBuilder BuildGui()
    {
        if (insideRoomId == "conference")
            return ConferenceRoomGuiBuilder.Build(this, ConferenceJoined, JoinConference, LeaveConference, ExitRoom);

        if (insideRoomId == "engineering")
            return SpatialInteriorGuiBuilder.Build(this, "The Forge", "The Forge is still a place, not a panel. State labs, FSM workbenches, MicroBundle stock, and runtime bays surround the visitor.", Experience.User.DisplayName, ExitRoom);

        if (insideRoomId == "library")
            return SpatialInteriorGuiBuilder.Build(this, "Blueprint Library", "A spatial archive of the definitions from which Workshop places and Experiences are composed.", Experience.User.DisplayName, ExitRoom);

        var world = SpatialWorkshopGuiBuilder.Build(this, Scene, AvatarX, AvatarY, detailLevel, SetDetailLevel, HandleKeyDown, HandleWorldClick, InteractRoom);
        return WorkshopGui.MultiPanel(this).Style("position", "fixed").Style("inset", "0").Style("width", "100vw").Style("height", "100vh").Style("overflow", "hidden").Content(world).Content(UserNameLabel());
    }

    private ElementBuilder UserNameLabel()
        => WorkshopGui.Element(this, "span").Style("position", "fixed").Style("left", "50%").Style("top", "calc(50% - 24px)").Style("transform", "translateX(-50%)").Style("z-index", "20").Style("padding", ".12rem .35rem").Style("border", "1px solid rgba(255,255,255,.18)").Style("background", "rgba(1,4,10,.82)").Style("color", "#ffffff").Style("font-family", "Consolas, 'Courier New', monospace").Style("font-size", ".5rem").Style("letter-spacing", ".12em").Style("white-space", "nowrap").Style("pointer-events", "none").Text(Experience.User.DisplayName);

    private void SetDetailLevel(int level) => detailLevel = Math.Clamp(level, 1, 64);
    private void JoinConference() => Experience.Conference.Join();
    private void LeaveConference() => Experience.Conference.Leave();

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key.ToLowerInvariant())
        {
            case "w":
            case "arrowup": MoveAvatar(0, -3); break;
            case "s":
            case "arrowdown": MoveAvatar(0, 3); break;
            case "a":
            case "arrowleft": MoveAvatar(-3, 0); break;
            case "d":
            case "arrowright": MoveAvatar(3, 0); break;
        }
    }

    private void MoveAvatar(double dx, double dy)
    {
        if (insideRoomId is not null) return;
        NavigateTo(new SpatialPoint(AvatarX + dx, AvatarY + dy));
    }

    /// <summary>Converts an empty-space left click into a collision-safe world destination.</summary>
    private async Task HandleWorldClick(MouseEventArgs args)
    {
        if (insideRoomId is not null) return;
        spatialModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Workshop/spatial-workshop.js");
        var point = await spatialModule.InvokeAsync<SpatialPoint>("screenToWorld", args.ClientX, args.ClientY, AvatarX, AvatarY);
        NavigateTo(point);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Approaches a spatial object at the most direct available interaction position.</summary>
    private async Task InteractRoom(string id)
    {
        if (insideRoomId is not null) return;

        var interactable = Scene.Interactables.FirstOrDefault(item => item.Id == id);
        if (interactable is null) return;

        var selected = interactable.InteractionPoints
            .Select(point => new { Point = point, Path = SpatialGeometryEngine.FindPath(new SpatialPoint(AvatarX, AvatarY), Center(point.Bounds), SpatialGeometryEngine.FromInteractables(Scene.Interactables)) })
            .Where(candidate => candidate.Path.Count > 0)
            .OrderBy(candidate => PathLength(new SpatialPoint(AvatarX, AvatarY), candidate.Path))
            .FirstOrDefault();

        if (selected is null) return;

        NavigatePath(selected.Path);
        await InvokeAsync(StateHasChanged);
        interactable.OnInteraction();
        insideRoomId = interactable.ExperienceId;
        await InvokeAsync(StateHasChanged);
    }

    private void NavigateTo(SpatialPoint target)
    {
        var path = SpatialGeometryEngine.FindPath(new SpatialPoint(AvatarX, AvatarY), target, SpatialGeometryEngine.FromInteractables(Scene.Interactables));
        NavigatePath(path);
    }

    private void NavigatePath(IReadOnlyList<SpatialPoint> path)
    {
        foreach (var point in path)
            Experience.Navigation.MoveTo(point.X, point.Y);
    }

    private static SpatialPoint Center(SpatialBounds bounds)
        => new(bounds.X + bounds.Width / 2, bounds.Y + bounds.Height / 2);

    private static double PathLength(SpatialPoint start, IReadOnlyList<SpatialPoint> path)
    {
        var total = 0d;
        var previous = start;
        foreach (var point in path)
        {
            total += Math.Sqrt(Math.Pow(point.X - previous.X, 2) + Math.Pow(point.Y - previous.Y, 2));
            previous = point;
        }
        return total;
    }

    private void ExitRoom()
    {
        Forge.Reset();
        Experience.Conference.Leave();
        var roomId = insideRoomId == "conference" ? "yup" : insideRoomId;
        var room = Rooms.FirstOrDefault(x => x.Id == roomId);
        if (room is not null) Experience.Navigation.MoveToExit(room);
        insideRoomId = null;
    }

    public void Dispose()
    {
        Experience.Dispose();
        if (spatialModule is not null) _ = spatialModule.DisposeAsync();
    }
}
