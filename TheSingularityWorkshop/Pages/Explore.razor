                .Style("border", "1px solid #00eaff88").Style("background", "rgba(1,5,11,.96)")
                .Content(WorkshopGui.Element(this, "div").Style("color", "#00eaff").Style("font-size", ".5rem").Style("letter-spacing", ".16em").Text("MAYOR'S MANSION // BUTLER"))
                .Content(WorkshopGui.Element(this, "div").Style("margin-top", ".7rem").Style("color", "#fff").Style("font-family", "system-ui,sans-serif").Style("font-size", ".9rem").Text(SingularityMansionElevation.ButlerGreeting))
                .Content(WorkshopGui.Element(this, "div").Style("display", "flex").Style("gap", ".5rem").Style("margin-top", ".9rem")
                    .Content(WorkshopGui.Button(this).Label("FOLLOW TO MEET THE MAYOR").Style("padding", ".5rem .7rem").Style("cursor", "pointer").OnClick(MeetMayor))
                    .Content(WorkshopGui.Button(this).Label("CANCEL").Style("padding", ".5rem .7rem").Style("cursor", "pointer").OnClick(CancelMayorMeeting)));

        if (mayorOfficeOfferVisible)
            return WorkshopGui.Element(this, "div")
                .Style("position", "fixed").Style("left", "50%").Style("bottom", "8%").Style("transform", "translateX(-50%)")
                .Style("z-index", "120").Style("width", "min(700px,86vw)").Style("padding", "1rem")
                .Style("border", "1px solid #ffd34d88").Style("background", "rgba(1,5,11,.97)")
                .Content(WorkshopGui.Element(this, "div").Style("color", "#ffd34d").Style("font-size", ".5rem").Style("letter-spacing", ".16em").Text("CIVIC OPPORTUNITY"))
                .Content(WorkshopGui.Element(this, "div").Style("margin-top", ".7rem").Style("color", "#fff").Style("font-family", "system-ui,sans-serif").Style("font-size", ".9rem").Text(SingularityMansionElevation.MeetingCancelledPrompt))
                .Content(WorkshopGui.Button(this).Label("TAKE OVER THE MAYOR'S OFFICE").Style("margin-top", ".9rem").Style("padding", ".55rem .8rem").Style("cursor", "pointer").OnClick(TakeMayorOffice))
                .Content(WorkshopGui.Button(this).Label("NO, THANK YOU").Style("margin-left", ".5rem").Style("padding", ".55rem .8rem").Style("cursor", "pointer").OnClick(() => mayorOfficeOfferVisible = false));

        return WorkshopGui.Element(this, "span");
    }

