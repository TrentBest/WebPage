@page "/explore"
@using Microsoft.AspNetCore.Components.Web
@using TheSingularityWorkshop.Gui
@using TheSingularityWorkshop.Infrastructure.FsmForge
@using TheSingularityWorkshop.Infrastructure.Hub
@inject HubRuntime Runtime

<PageTitle>Explore // The Singularity Workshop</PageTitle>

<style>
    html:has(#workshop-spatial-map),
    body:has(#workshop-spatial-map) {
        overflow: hidden !important;
    }

    div:has(> div > #workshop-spatial-map) {
        height: 100vh !important;
        max-height: 100vh !important;
        min-height: 0 !important;
        overflow: hidden !important;
    }

    div:has(> div > #workshop-spatial-map) > div:first-child {
        z-index: 0 !important;
    }

    div:has(> div > #workshop-spatial-map) > div:first-child svg {
        background: transparent !important;
    }

    div:has(> div > #workshop-spatial-map) > div:nth-child(3) {
        flex: 1 1 auto !important;
        min-height: 0 !important;
        overflow: hidden !important;
    }

    #workshop-spatial-map {
        min-height: 0 !important;
        height: 100% !important;
        z-index: 30 !important;
        cursor: crosshair;
    }

    /* The first real spatial room prototype: a fixed-size blueprint object
       living inside the map's coordinate system, not the browser viewport. */
    #workshop-spatial-map [title="Approach Yup"] {
        width: 350px !important;
        height: 200px !important;
        padding: 0 !important;
        border: 6px solid #00eaff !important;
        border-radius: 0 !important;
        background: transparent !important;
        box-shadow: 0 0 28px rgba(0,234,255,.12) !important;
    }

    #workshop-spatial-map [title="Approach Yup"] > div:first-child {
        inset: 3% !important;
        border: 2px solid rgba(0,234,255,.5) !important;
        background: transparent !important;
        box-shadow: none !important;
    }

    #workshop-spatial-map [title="Approach Yup"] > div:first-child > div {
        background: rgba(0,234,255,.45) !important;
    }
</style>

@BuildGui().Build()

@code {
    private double AvatarX { get; set; } = 50;
    private double AvatarY { get; set; } = 54;
    private string? selectedRoomId;
    private string? insideRoomId;
    private bool unknownUnlocked;
    private bool conferenceJoined;
    private readonly FsmForgePreview ForgePreview = new();

    private SpatialRoom? SelectedRoom => Rooms.FirstOrDefault(x => x.Id == selectedRoomId);
    private SpatialRoom? InsideRoom => Rooms.FirstOrDefault(x => x.Id == insideRoomId);

    private static readonly IReadOnlyList<SpatialRoom> Rooms =
    [
        new("experience", "Experience Deck", "LIVING SPACE", 25, 28,
            "The sensory side of the Workshop. This is where an Experience becomes something a visitor can actually inhabit.",
            "EXPERIENCE", "Living GUI / presentation"),
        new("engineering", "The Forge", "FSM WORKSHOP", 73, 30,
            "The Workshop's first real building: a place for shaping state, lifecycle, reusable substrates, and executable machinery.",
            "FORGE", "FSM / lifecycle / composition"),
        new("creation", "Creation Bay", "BUILDER SPACE", 34, 72,
            "The composition boundary. Focused capabilities become MicroBundles, then recipes, then executable Experiences.",
            "CREATION", "MicroBundles / composition"),
        new("yup", "Yup", "CONFERENCE ROOM", 78, 11,
            "The first spatial-room prototype. A room is a place with a boundary, a door, shared objects, and eventually other people.",
            "CONFERENCE", "Presence / conference / shared workspace"),
        new("unknown", "Unknown Annex", "UNMAPPED", 79, 76,
            "Something exists beyond the architecture currently exposed to the visitor. There is no reason to assume it is empty.",
            "UNKNOWN", "Undisclosed")
    ];

    private ElementBuilder BuildGui()
    {
        if (insideRoomId == "conference")
        {
            return ConferenceRoomGuiBuilder.Build(
                this,
                conferenceJoined,
                JoinConference,
                LeaveConference,
                ExitRoom);
        }

        if (insideRoomId == "engineering")
        {
            return FsmForgeGuiBuilder.Build(
                this,
                ForgePreview,
                StartForgePreview,
                TickForgePreview,
                ResetForgePreview,
                ExitRoom);
        }

        return SpatialExploreGuiBuilder.Build(
            this,
            Runtime,
            Rooms,
            selectedRoomId,
            insideRoomId,
            unknownUnlocked,
            AvatarX,
            AvatarY,
            HandleKeyDown,
            MoveAvatar,
            MoveAvatarTo,
            ApproachRoom,
            EnterSelectedRoom,
            UnlockUnknown,
            ExitRoom);
    }

    private void StartForgePreview() => ForgePreview.Start();
    private void TickForgePreview() => ForgePreview.Tick();
    private void ResetForgePreview() => ForgePreview.Stop();

    private void JoinConference() => conferenceJoined = true;
    private void LeaveConference() => conferenceJoined = false;

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key.ToLowerInvariant())
        {
            case "w":
            case "arrowup":
                MoveAvatar(0, -3);
                break;
            case "s":
            case "arrowdown":
                MoveAvatar(0, 3);
                break;
            case "a":
            case "arrowleft":
                MoveAvatar(-3, 0);
                break;
            case "d":
            case "arrowright":
                MoveAvatar(3, 0);
                break;
        }
    }

    private void MoveAvatar(double dx, double dy)
    {
        if (InsideRoom is not null)
            return;

        AvatarX = Math.Clamp(AvatarX + dx, 4, 96);
        AvatarY = Math.Clamp(AvatarY + dy, 8, 92);
    }

    private void MoveAvatarTo(double x, double y)
    {
        if (InsideRoom is not null)
            return;

        AvatarX = Math.Clamp(x, 4, 96);
        AvatarY = Math.Clamp(y, 8, 92);
        selectedRoomId = null;
    }

    private void ApproachRoom(string id)
    {
        var room = Rooms.First(x => x.Id == id);
        AvatarX = room.X;
        AvatarY = room.Y + 6;
        selectedRoomId = id;
    }

    private void EnterSelectedRoom()
    {
        if (SelectedRoom is null || (SelectedRoom.Id == "unknown" && !unknownUnlocked))
            return;

        insideRoomId = SelectedRoom.Id == "yup" ? "conference" : SelectedRoom.Id;
    }

    private void UnlockUnknown()
    {
        unknownUnlocked = true;
        selectedRoomId = "unknown";
    }

    private void ExitRoom()
    {
        ForgePreview.Stop();
        conferenceJoined = false;
        insideRoomId = null;
    }
}
