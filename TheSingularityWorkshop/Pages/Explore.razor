@page "/explore"
@using Microsoft.AspNetCore.Components.Web
@using TheSingularityWorkshop.Infrastructure.Hub
@inject HubRuntime Runtime

<PageTitle>Explore // The Singularity Workshop</PageTitle>

<div class="exploration-experience">
    <div class="warp-layer" aria-hidden="true">
        <div class="warp-stars"></div>
        <div class="warp-core"></div>
        <div class="warp-caption">
            <span>ENTERING</span>
            <strong>THE WORKSHOP</strong>
        </div>
    </div>

    <section class="exploration-shell">
        <header class="exploration-header">
            <div>
                <div class="exploration-kicker">EXPERIENCE // EXPLORATION</div>
                <h1>The Workshop is a place.</h1>
                <p>Walk it. Find its boundaries. Discover what is alive inside.</p>
            </div>
            <div class="runtime-readout" aria-label="Live Workshop data">
                <span><b>@Runtime.Hub.LoadedBundles.Count</b> BUNDLES</span>
                <span><b>@Runtime.ArbitrationMutations</b> MUTATIONS</span>
                <span><b>@Runtime.Hub.Audit.Events.Count</b> EVENTS</span>
            </div>
        </header>

        <div class="exploration-body">
            <section class="workshop-map" tabindex="0" aria-label="Interactive Workshop map. Use WASD or arrow keys to move." @onkeydown="HandleKeyDown" @onkeydown:preventDefault>
                <div class="map-grid" aria-hidden="true"></div>
                <div class="map-horizon" aria-hidden="true"></div>

                <div class="boundary boundary-experience" aria-hidden="true">
                    <span>EXPERIENCE BOUNDARY</span>
                </div>
                <div class="boundary boundary-engineering" aria-hidden="true">
                    <span>ENGINEERING BOUNDARY</span>
                </div>
                <div class="boundary boundary-creation" aria-hidden="true">
                    <span>CREATION BOUNDARY</span>
                </div>

                @foreach (var room in Rooms)
                {
                    var isSelected = selectedRoomId == room.Id;
                    var isLocked = room.Id == "unknown" && !unknownUnlocked;
                    <button type="button"
                            class="map-interactable @(isSelected ? "selected" : "") @(isLocked ? "locked" : "")"
                            style="left:@room.X%;top:@room.Y%"
                            @onclick="() => ApproachRoom(room.Id)"
                            title="@(isLocked ? "Unmapped structure" : $"Approach {room.Name}")">
                        <span class="interactable-ring"></span>
                        <span class="interactable-core"></span>
                        <span class="interactable-label">
                            <b>@room.Name</b>
                            <small>@room.Kind</small>
                        </span>
                    </button>
                }

                <div class="visitor-avatar" style="left:@AvatarX%;top:@AvatarY%" aria-label="Your position">
                    <span></span>
                </div>

                <div class="map-controls" aria-label="Movement controls">
                    <button type="button" @onclick="() => MoveAvatar(0, -5)">▲</button>
                    <div>
                        <button type="button" @onclick="() => MoveAvatar(-5, 0)">◀</button>
                        <button type="button" @onclick="() => MoveAvatar(0, 5)">▼</button>
                        <button type="button" @onclick="() => MoveAvatar(5, 0)">▶</button>
                    </div>
                    <small>WASD / ARROWS</small>
                </div>

                <div class="map-status">
                    <span>POSITION</span>
                    <strong>@AvatarX.ToString("0") : @AvatarY.ToString("0")</strong>
                    <small>CLICK THE MAP, THEN WALK</small>
                </div>

                @if (unknownUnlocked)
                {
                    <div class="new-spaces" aria-live="polite">
                        <span>BOUNDARY UNLOCKED</span>
                        <strong>NEW FUNCTIONAL SPACES ONLINE</strong>
                    </div>
                }
            </section>

            <aside class="exploration-panel">
                <div class="panel-kicker">LOCAL SPACE // INSPECTOR</div>

                @if (InsideRoom is not null)
                {
                    <div class="room-view">
                        <span class="room-state">INSIDE EXPERIENCE</span>
                        <h2>@InsideRoom.Name</h2>
                        <p>@InsideRoom.Description</p>
                        <div class="room-detail">
                            <span>BOUNDARY</span>
                            <strong>@InsideRoom.Boundary</strong>
                        </div>
                        <div class="room-detail">
                            <span>LIVE DATA</span>
                            <strong>@InsideRoom.Data</strong>
                        </div>
                        <button type="button" class="exit-button" @onclick="ExitRoom">← EXIT TO MAP</button>
                    </div>
                }
                else if (SelectedRoom is not null)
                {
                    <div class="room-view">
                        <span class="room-state">FOCUS ACQUIRED</span>
                        <h2>@SelectedRoom.Name</h2>
                        <p>@SelectedRoom.Description</p>

                        @if (SelectedRoom.Id == "unknown" && !unknownUnlocked)
                        {
                            <div class="warning-frame">
                                <span>UNMAPPED STRUCTURE</span>
                                <strong>PROCEED WITH DISCOVERY?</strong>
                                <button type="button" class="warning-button" @onclick="UnlockUnknown">
                                    WARNING...<br /><small>DISCOVER THE ROOM</small>
                                </button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="enter-button" @onclick="EnterSelectedRoom">ENTER ROOM →</button>
                        }
                    </div>
                }
                else
                {
                    <div class="orientation">
                        <span class="room-state">NO TARGET</span>
                        <h2>Explore freely.</h2>
                        <p>
                            Your avatar is the dot. The Workshop is the map. Move through the environment
                            and approach anything that catches your eye.
                        </p>
                        <div class="interaction-rules">
                            <div><b>01</b><span>APPROACH</span><small>Walk toward a structure.</small></div>
                            <div><b>02</b><span>BREATHE</span><small>Hovering reveals what can be touched.</small></div>
                            <div><b>03</b><span>ENTER</span><small>Cross the boundary and change worlds.</small></div>
                            <div><b>04</b><span>EXIT</span><small>Return to where you were.</small></div>
                        </div>
                    </div>
                }

                <div class="boundary-key">
                    <div><i></i><span>EXPERIENCE</span><small>presentation / sensory</small></div>
                    <div><i></i><span>ENGINEERING</span><small>FSM / Hub / runtime</small></div>
                    <div><i></i><span>CREATION</span><small>MicroBundles / composition</small></div>
                </div>
            </aside>
        </div>

        <footer class="exploration-footer">
            <span>THE BUILDER IS THE DOCUMENTATION.</span>
            <span>THIS MAP IS AN EXPERIENCE, NOT A CARD CATALOG.</span>
            <span>V0.0.108</span>
        </footer>
    </section>
</div>

@code {
    private double AvatarX { get; set; } = 50;
    private double AvatarY { get; set; } = 54;
    private string? selectedRoomId;
    private string? insideRoomId;
    private bool unknownUnlocked;

    private RoomNode? SelectedRoom => Rooms.FirstOrDefault(x => x.Id == selectedRoomId);
    private RoomNode? InsideRoom => Rooms.FirstOrDefault(x => x.Id == insideRoomId);

    private static readonly IReadOnlyList<RoomNode> Rooms =
    [
        new("experience", "Experience Deck", "LIVING SPACE", 25, 28,
            "The sensory side of the Workshop. This is where an Experience becomes something a visitor can actually inhabit.",
            "EXPERIENCE", "Living GUI / presentation"),
        new("engineering", "Engineering Core", "RUNTIME MACHINE", 73, 30,
            "The machinery beneath the experience: deterministic state, Hub coordination, process groups, and runtime observation.",
            "ENGINEERING", "FSM / Hub / audit"),
        new("creation", "Creation Bay", "BUILDER SPACE", 34, 72,
            "The composition boundary. Focused capabilities become MicroBundles, then recipes, then executable Experiences.",
            "CREATION", "MicroBundles / composition"),
        new("unknown", "Unknown Annex", "UNMAPPED", 79, 76,
            "Something exists beyond the architecture currently exposed to the visitor. There is no reason to assume it is empty.",
            "UNKNOWN", "Undisclosed")
    ];

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key.ToLowerInvariant())
        {
            case "w":
            case "arrowup":
                MoveAvatar(0, -3);
                break;
            case "s":
            case "arrowdown":
                MoveAvatar(0, 3);
                break;
            case "a":
            case "arrowleft":
                MoveAvatar(-3, 0);
                break;
            case "d":
            case "arrowright":
                MoveAvatar(3, 0);
                break;
        }
    }

    private void MoveAvatar(double dx, double dy)
    {
        if (InsideRoom is not null)
            return;

        AvatarX = Math.Clamp(AvatarX + dx, 4, 96);
        AvatarY = Math.Clamp(AvatarY + dy, 8, 92);
    }

    private void ApproachRoom(string id)
    {
        var room = Rooms.First(x => x.Id == id);
        AvatarX = room.X;
        AvatarY = room.Y + 6;
        selectedRoomId = id;
    }

    private void EnterSelectedRoom()
    {
        if (SelectedRoom is null || (SelectedRoom.Id == "unknown" && !unknownUnlocked))
            return;

        insideRoomId = SelectedRoom.Id;
    }

    private void UnlockUnknown()
    {
        unknownUnlocked = true;
        selectedRoomId = "unknown";
    }

    private void ExitRoom()
    {
        insideRoomId = null;
    }

    private sealed record RoomNode(
        string Id,
        string Name,
        string Kind,
        double X,
        double Y,
        string Description,
        string Boundary,
        string Data);
}

