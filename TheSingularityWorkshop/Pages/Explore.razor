    /// <summary>Approaches a spatial object, then enters its child scene only after arrival.</summary>
    private async Task InteractRoom(string id)
    {
        if (insideRoomId is not null) return;

        var interactable = Scene.Interactables.FirstOrDefault(item => item.Id == id);
        if (interactable is null) return;

        // The AEC Remote Office is a compound Experience: arriving at the building
        // first places the visitor in its lobby. The receptionist then leads them to
        // the intent conference before the drafting office is exposed.
        if (id == "aec-remote-office")
        {
            var selectedLobbyPoint = interactable.InteractionPoints
                .Select(point => new { Point = point, Path = SpatialGeometryEngine.FindPath(new SpatialPoint(AvatarX, AvatarY), Center(point.Bounds), SpatialGeometryEngine.FromInteractables(Scene.Interactables)) })
                .Where(candidate => candidate.Path.Count > 0)
                .OrderBy(candidate => PathLength(new SpatialPoint(AvatarX, AvatarY), candidate.Path))
                .FirstOrDefault();

            if (selectedLobbyPoint is null) return;
            await NavigatePath(selectedLobbyPoint.Path);
            insideRoomId = "aec-lobby";
            await InvokeAsync(StateHasChanged);
            return;
        }
        if (id == "singularity-lab")
        {
            var selectedLabPoint = interactable.InteractionPoints
                .Select(point => new { Point = point, Path = SpatialGeometryEngine.FindPath(new SpatialPoint(AvatarX, AvatarY), Center(point.Bounds), SpatialGeometryEngine.FromInteractables(Scene.Interactables)) })
                .Where(candidate => candidate.Path.Count > 0)
                .OrderBy(candidate => PathLength(new SpatialPoint(AvatarX, AvatarY), candidate.Path))
                .FirstOrDefault();

            if (selectedLabPoint is null) return;
            await NavigatePath(selectedLabPoint.Path);
            SingularityLab.Reset();
            insideRoomId = "singularity-lab";
            await InvokeAsync(StateHasChanged);
            return;
        }


        var selected = interactable.InteractionPoints
            .Select(point => new { Point = point, Path = SpatialGeometryEngine.FindPath(new SpatialPoint(AvatarX, AvatarY), Center(point.Bounds), SpatialGeometryEngine.FromInteractables(Scene.Interactables)) })
            .Where(candidate => candidate.Path.Count > 0)
            .OrderBy(candidate => PathLength(new SpatialPoint(AvatarX, AvatarY), candidate.Path))
            .FirstOrDefault();

        if (selected is null) return;

        await NavigatePath(selected.Path);
        UpdateConstructionTour(AvatarX, AvatarY);
        interactable.OnInteraction();
        var returnPosition = new SpatialPoint(AvatarX, AvatarY);
        var place = interactable.Place;
        var firstVisit = Router.Enter(place, returnPosition);
        var entry = place.EntryPoint;
        Experience.Navigation.MoveTo(entry.X, entry.Y);
        insideRoomId = place.SceneId;
        mansionWelcomeVisible = false;
        if (place.SceneId == "mansion" && firstVisit)
        {
            mansionPresentation = SpatialMansionGuiBuilder.PresentationMode.ExteriorElevation;
            selectedMansionFeatureId = null;
            mayorButlerVisible = true;
            mayorMeetingCancelled = false;
            mayorOfficeOfferVisible = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task NavigateTo(SpatialPoint target)
    {
        var path = SpatialGeometryEngine.FindPath(new SpatialPoint(AvatarX, AvatarY), target, SpatialGeometryEngine.FromInteractables(Scene.Interactables));
        await NavigatePath(path);
    }

    private Task NavigateMansionTo(SpatialPoint target)
        => NavigatePath([new SpatialPoint(Math.Clamp(target.X, 4, 96), Math.Clamp(target.Y, 8, 92))]);

    /// <summary>Animates each navigation segment so the camera does not teleport between path nodes.</summary>
    private async Task NavigatePath(IReadOnlyList<SpatialPoint> path)
    {
        if (path.Count == 0) return;

        var previous = new SpatialPoint(AvatarX, AvatarY);
        foreach (var point in path)
        {
            const int frames = 8;
            for (var frame = 1; frame <= frames; frame++)
            {
                var t = frame / (double)frames;
                var eased = t * t * (3d - 2d * t);
                Experience.Navigation.MoveTo(previous.X + (point.X - previous.X) * eased, previous.Y + (point.Y - previous.Y) * eased);
                await InvokeAsync(StateHasChanged);
                await Task.Delay(16);
            }
            previous = point;
        }
    }

    private async Task DrawAECPoint(MouseEventArgs args)
    {
        if (insideRoomId != "aec-remote-office") return;
        spatialModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Workshop/spatial-workshop.js");
        var point = await spatialModule.InvokeAsync<SpatialPoint>("screenToLinePoint", args.ClientX, args.ClientY);
        if (!AECDraft.Drawing)
        {
            AECDraft.Begin(point);
            await InvokeAsync(StateHasChanged);
            return;
        }

        AECDraft.End(point);
        await InvokeAsync(StateHasChanged);
    }

