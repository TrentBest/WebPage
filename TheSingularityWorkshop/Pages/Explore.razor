    private async Task DrawForgePoint(MouseEventArgs args)
    {
        spatialModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Workshop/spatial-workshop.js");
        var point = await spatialModule.InvokeAsync<SpatialPoint>("screenToLinePoint", args.ClientX, args.ClientY);
        if (!drawingLine)
        {
            ForgeLinework.BeginLine(point);
            drawingLine = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        ForgeLinework.ContinueLine(point);
        ForgeLinework.EndLine();
        drawingLine = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ClearForgeLines()
    {
        drawingLine = false;
        ForgeLinework.Clear();
    }

    private void SetForgeStyle(SpatialLineStyle style) => forgeStyle = style;

    private static SpatialPoint Center(SpatialBounds bounds)
        => new(bounds.X + bounds.Width / 2, bounds.Y + bounds.Height / 2);

    private static double PathLength(SpatialPoint start, IReadOnlyList<SpatialPoint> path)
    {
        var total = 0d;
        var previous = start;
        foreach (var point in path)
        {
            total += Math.Sqrt(Math.Pow(point.X - previous.X, 2) + Math.Pow(point.Y - previous.Y, 2));
            previous = point;
        }
        return total;
    }

    private void ExitRoom()
    {
        Forge.Reset();
        Experience.Conference.Leave();
        if (insideRoomId == "conference")
        {
            var room = Rooms.FirstOrDefault(x => x.Id == "yup");
            if (room is not null) Experience.Navigation.MoveToExit(room);
            insideRoomId = null;
            return;
        }

        mansionWelcomeVisible = false;
        mayorButlerVisible = false;
        mayorMeetingCancelled = false;
        mayorOfficeOfferVisible = false;
        selectedMansionFeatureId = null;
        mansionPresentation = SpatialMansionGuiBuilder.PresentationMode.Plan;
        constructionWelcomeVisible = false;
        constructionTourActive = false;
        if (insideRoomId == "maze")
        {
            mazeStartedAtUtc = null;
            selectedLeaderboardEntry = null;
        }

        if (insideRoomId == "singularity-lab")
            SingularityLab.Reset();

        if (insideRoomId == "singularity-transit")
        {
            selectedTransitDestinationId = null;
            transitTrainVisible = false;
            transitMicroGameActive = false;
            transitMicroGameScore = 0;
            transitMicroGameRound = 0;
            transitMicroGameTargetId = null;
        }

        if (Router.TryExit(out var frame))
            Experience.Navigation.MoveTo(frame.ReturnPosition.X, frame.ReturnPosition.Y);
        insideRoomId = Router.CurrentSceneId == "workshop" ? null : Router.CurrentSceneId;
    }

    public void Dispose()
    {
        Experience.Dispose();
        TransitTrain.Dispose();
        ForgeLinework.Dispose();
        AECDraft.Dispose();
        MansionStructure.Dispose();
        MazeLeaderboard.Dispose();
        if (spatialModule is not null) _ = spatialModule.DisposeAsync();
    }
