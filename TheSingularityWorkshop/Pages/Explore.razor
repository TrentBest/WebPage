@page "/explore"
@using Microsoft.AspNetCore.Components.Web
@using TheSingularityWorkshop.Gui
@using TheSingularityWorkshop.Infrastructure.Hub
@using TheSingularityWorkshop.Workshop.MicroBundles
@inject HubRuntime Runtime
@implements IDisposable

<PageTitle>Explore // The Singularity Workshop</PageTitle>

@BuildGui().Build()

@code {
    private readonly ExploreExperienceMicroBundle Experience = new();
    private string? selectedRoomId;
    private string? insideRoomId;
    private bool unknownUnlocked;

    private static readonly IReadOnlyList<SpatialRoom> Rooms =
    [
        new("experience", "Experience Deck", "LIVING SPACE", 25, 28,
            "The sensory side of the Workshop. This is where an Experience becomes something a visitor can actually inhabit.",
            "EXPERIENCE", "Living GUI / presentation"),
        new("engineering", "The Forge", "FSM WORKSHOP", 73, 30,
            "The Workshop's first real building: a place for shaping state, lifecycle, reusable substrates, and executable machinery.",
            "FORGE", "FSM / lifecycle / composition"),
        new("creation", "Creation Bay", "BUILDER SPACE", 34, 72,
            "The composition boundary. Focused capabilities become MicroBundles, then recipes, then executable Experiences.",
            "CREATION", "MicroBundles / composition"),
        new("yup", "Yup", "CONFERENCE ROOM", 78, 11,
            "The first spatial-room prototype. A room is a place with a boundary, a door, shared objects, and eventually other people.",
            "CONFERENCE", "Presence / conference / shared workspace"),
        new("unknown", "Unknown Annex", "UNMAPPED", 79, 76,
            "Something exists beyond the architecture currently exposed to the visitor. There is no reason to assume it is empty.",
            "UNKNOWN", "Undisclosed")
    ];

    private double AvatarX => Experience.Navigation.X;
    private double AvatarY => Experience.Navigation.Y;
    private bool ConferenceJoined => Experience.Conference.Joined;
    private FsmForgeMicroBundle Forge => Experience.Forge;

    private ElementBuilder BuildGui()
    {
        if (insideRoomId == "conference")
        {
            return ConferenceRoomGuiBuilder.Build(
                this,
                ConferenceJoined,
                JoinConference,
                LeaveConference,
                ExitRoom);
        }

        if (insideRoomId == "engineering")
        {
            return FsmForgeGuiBuilder.Build(this, Forge, ExitRoom);
        }

        return SpatialWorldGuiBuilder.Build(
            this,
            Runtime,
            Rooms,
            selectedRoomId,
            unknownUnlocked,
            AvatarX,
            AvatarY,
            HandleKeyDown,
            MoveAvatar,
            MoveAvatarTo,
            ApproachRoom,
            EnterSelectedRoom,
            UnlockUnknown);
    }

    private void JoinConference() => Experience.Conference.Join();
    private void LeaveConference() => Experience.Conference.Leave();

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key.ToLowerInvariant())
        {
            case "w":
            case "arrowup":
                MoveAvatar(0, -3);
                break;
            case "s":
            case "arrowdown":
                MoveAvatar(0, 3);
                break;
            case "a":
            case "arrowleft":
                MoveAvatar(-3, 0);
                break;
            case "d":
            case "arrowright":
                MoveAvatar(3, 0);
                break;
        }
    }

    private void MoveAvatar(double dx, double dy)
    {
        if (insideRoomId is not null)
            return;

        Experience.Navigation.Move(dx, dy);
    }

    private void MoveAvatarTo(double x, double y)
    {
        if (insideRoomId is not null)
            return;

        Experience.Navigation.MoveTo(x, y);
        selectedRoomId = null;
    }

    private void ApproachRoom(string id)
    {
        var room = Rooms.First(x => x.Id == id);
        Experience.Navigation.Approach(room.X, room.Y);
        selectedRoomId = id;
    }

    private void EnterSelectedRoom()
    {
        if (SelectedRoom is null || (SelectedRoom.Id == "unknown" && !unknownUnlocked))
            return;

        insideRoomId = SelectedRoom.Id == "yup" ? "conference" : SelectedRoom.Id;
    }

    private SpatialRoom? SelectedRoom => Rooms.FirstOrDefault(x => x.Id == selectedRoomId);

    private void UnlockUnknown()
    {
        unknownUnlocked = true;
        selectedRoomId = "unknown";
    }

    private void ExitRoom()
    {
        Forge.Reset();
        Experience.Conference.Leave();
        insideRoomId = null;
    }

    public void Dispose() => Experience.Dispose();
}
