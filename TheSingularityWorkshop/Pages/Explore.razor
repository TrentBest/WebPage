    private void SelectGravityBodies(string bodyAId, string bodyBId)
    {
        if (bodyAId == bodyBId) return;
        gravityBodyAId = bodyAId;
        gravityBodyBId = bodyBId;
    }

    private void ToggleThreeDimensionalLab()
    {
        threeDimensionalLabActive = !threeDimensionalLabActive;
    }

    private void JoinConference() => Experience.Conference.Join();
    private void LeaveConference() => Experience.Conference.Leave();

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key.ToLowerInvariant())
        {
            case "w":
            case "arrowup":
                if (insideRoomId == "singularity-transit") _ = MoveTransitAvatar(AvatarX, AvatarY - 1.5);
                else _ = MoveAvatar(0, -1);
                break;
            case "s":
            case "arrowdown":
                if (insideRoomId == "singularity-transit") _ = MoveTransitAvatar(AvatarX, AvatarY + 1.5);
                else _ = MoveAvatar(0, 1);
                break;
            case "a":
            case "arrowleft":
                if (insideRoomId == "singularity-transit") _ = MoveTransitAvatar(AvatarX - 1.5, AvatarY);
                else _ = MoveAvatar(-1, 0);
                break;
            case "d":
            case "arrowright":
                if (insideRoomId == "singularity-transit") _ = MoveTransitAvatar(AvatarX + 1.5, AvatarY);
                else _ = MoveAvatar(1, 0);
                break;
        }
    }

    private async Task MoveForgeTo(double x, double y)
    {
        if (insideRoomId != "forge") return;

        var target = new SpatialPoint(Math.Clamp(x, 4, 96), Math.Clamp(y, 8, 92));
        var previous = new SpatialPoint(AvatarX, AvatarY);

        const int frames = 8;
        for (var frame = 1; frame <= frames; frame++)
        {
            var t = frame / (double)frames;
            var eased = t * t * (3d - 2d * t);
            Experience.Navigation.MoveTo(
                previous.X + (target.X - previous.X) * eased,
                previous.Y + (target.Y - previous.Y) * eased);
            await InvokeAsync(StateHasChanged);
            await Task.Delay(16);
        }
    }

    private async Task MoveAvatar(double dx, double dy)
    {
        if (insideRoomId == "forge")
        {
            await MoveForgeTo(AvatarX + dx, AvatarY + dy);
            return;
        }

        if (insideRoomId == "mansion")
        {
            await NavigateMansionTo(new SpatialPoint(AvatarX + dx, AvatarY + dy));
            return;
        }

        if (insideRoomId is not null) return;
        await NavigateTo(new SpatialPoint(AvatarX + dx, AvatarY + dy));
        UpdateConstructionTour(AvatarX, AvatarY);
    }

    /// <summary>Converts an empty-space left click into a collision-safe world destination.</summary>
    private async Task HandleWorldClick(MouseEventArgs args)
    {
        if (insideRoomId is not null || workshopMapVisible) return;
        spatialModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Workshop/spatial-workshop.js");
        var point = await spatialModule.InvokeAsync<SpatialPoint>("screenToWorld", args.ClientX, args.ClientY, AvatarX, AvatarY, spatialZoom);
        await NavigateTo(point);
        UpdateConstructionTour(AvatarX, AvatarY);
    }

    /// <summary>Moves freely through the Mansion's line-rendered world without Workshop building collisions.</summary>
    private async Task HandleMazeWorldClick(MouseEventArgs args)
    {
        if (insideRoomId != "maze") return;
        spatialModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Workshop/spatial-workshop.js");
        var point = await spatialModule.InvokeAsync<SpatialPoint>("screenToCenteredWorld", args.ClientX, args.ClientY, AvatarX, AvatarY, mazeZoom);
        var distance = Math.Sqrt(Math.Pow(point.X - AvatarX, 2) + Math.Pow(point.Y - AvatarY, 2));
        if (distance > 3.25) return;
        var dx = Math.Sign(point.X - AvatarX);
        var dy = Math.Sign(point.Y - AvatarY);
        if (Math.Abs(point.X - AvatarX) >= Math.Abs(point.Y - AvatarY))
            dy = 0;
        else
            dx = 0;
        MoveMazeAvatar(dx, dy);
    }

    private void MoveMazeAvatar(double dx, double dy)
    {
        if (insideRoomId != "maze" || mazeFinished) return;

        mazeStartedAtUtc ??= DateTime.UtcNow;
        var maze = SpatialMazeCatalog.Showcase;
        var nextX = (int)Math.Floor(AvatarX + dx);
        var nextY = (int)Math.Floor(AvatarY + dy);
        if (!maze.IsWalkable(nextX, nextY)) return;

        Experience.Navigation.MoveTo(nextX + .5, nextY + .5);
        mazeSteps++;
        MazeLeaderboard.Update();

        if ((int)Math.Floor(AvatarX) == (int)Math.Floor(maze.Exit.X) &&
            (int)Math.Floor(AvatarY) == (int)Math.Floor(maze.Exit.Y))
        {
            mazeFinished = true;
            MazeLeaderboard.Record(Experience.User.DisplayName, mazeStartedAtUtc.HasValue ? (long)(DateTime.UtcNow - mazeStartedAtUtc.Value).TotalMilliseconds : 0, mazeSteps);
        }
    }

