@page "/explore"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@using TheSingularityWorkshop.Gui
@using TheSingularityWorkshop.Workshop.MicroBundles
@implements IDisposable

<PageTitle>Explore // The Singularity Workshop</PageTitle>

@BuildGui().Build()

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private readonly ExploreExperienceMicroBundle Experience;
    private readonly SpatialWorkshopScene Scene = SpatialWorkshopScene.CreateDefault();
    private readonly WorkshopRouter Router = new("workshop");
    private readonly SpatialLinework ForgeLinework = new();
    private readonly SpatialAECRemoteOfficeManifest AECManifest = SpatialAECRemoteOfficeManifest.CreateDefault();
    private readonly SpatialAECDraftModel AECDraft = new();
    private readonly SpatialAECIntentModel AECIntent = new();
    private SpatialAECGeneratedStructure? AECGeneratedStructure;
    private readonly SpatialSingularityLabModel SingularityLab = new();
    private readonly LeaderboardMicroBundle MazeLeaderboard = CreateMazeLeaderboard();
    private readonly SpatialTransitManifest TransitManifest = SpatialTransitManifest.CreateDefault();
    private readonly SpatialShipyardManifest ShipyardManifest = SpatialShipyardManifest.CreateDefault();
    private readonly SpatialShipDesignManifest ShipDesignManifest = SpatialShipDesignManifest.CreateDefault();
    private readonly TransitTrainMicroBundle TransitTrain = new(7301, TransitTrainSpecification.WorkshopHoEmu());
    private readonly SpatialLaboratoryManifest LaboratoryManifest = SpatialLaboratoryManifest.CreateDefault();
    private SpatialLinework MansionStructure = SingularityMansionLineworkFactory.Create();
    private SpatialLineStyle forgeStyle = SpatialLineStyleCatalog.Neon;
    private bool drawingLine;
    private bool mansionWelcomeVisible;
    private SpatialMansionGuiBuilder.PresentationMode mansionPresentation = SpatialMansionGuiBuilder.PresentationMode.Plan;
    private string? selectedMansionFeatureId;
    private bool mayorButlerVisible;
    private bool mayorMeetingCancelled;
    private bool mayorOfficeOfferVisible;
    private string? occupiedCivicOfficeId;
    private bool constructionWelcomeVisible;
    private bool constructionTourActive;
    private string constructionTourMessage = "Stay close. I will show you what is being built.";
    private bool workshopMapVisible = true;
    private SpatialMapScope workshopMapScope = SpatialMapScope.Workshop;
    private double workshopMapZoom = 1d;
    private bool gardenMode = true;
    private bool gardenVisitResolved;
    private double spatialZoom = 1d;
    private double mansionZoom = 1d;
    private double constructionZoom = 1d;
    private double mazeZoom = 1d;
    private int mazeSteps;
    private bool mazeFinished;
    private DateTime? mazeStartedAtUtc;
    private string? selectedLeaderboardEntry;
    private string? insideRoomId;
    private string? selectedTransitDestinationId;
    private bool transitTrainVisible;
    private bool transitMicroGameActive;
    private int transitMicroGameScore;
    private int transitMicroGameRound;
    private string? transitMicroGameTargetId;
    private string? selectedLaboratoryFloorId;
    private string? preparedLaboratoryExperimentId;
    private string? gravityBodyAId = "earth";
    private string? gravityBodyBId = "moon";
    private bool threeDimensionalLabActive;
    private static readonly SpatialIslandExperience Island = SpatialIslandExperience.SingularityIsland;
    private int detailLevel = 16;
    private int mansionDensity = 1;
    private IJSObjectReference? spatialModule;

    private static readonly IReadOnlyList<SpatialRoom> Rooms =
    [
        new("experience", "Experience Deck", "LIVING SPACE", 25, 28, 25, 42, 25, 42, "The sensory side of the Workshop. This is where an Experience becomes something a visitor can actually inhabit.", "EXPERIENCE", "Living GUI / presentation"),
        new("engineering", "The Forge", "FSM WORKSHOP", 73, 30, 73, 46, 73, 46, "The Workshop's first real building: a place for shaping state, lifecycle, reusable substrates, and executable machinery.", "FORGE", "FSM / lifecycle / composition"),
        new("creation", "Creation Bay", "BUILDER SPACE", 34, 72, 34, 88, 34, 88, "The composition boundary. Focused capabilities become MicroBundles, then recipes, then executable Experiences.", "CREATION", "MicroBundles / composition"),
        new("unknown", "Unknown Annex", "UNMAPPED", 79, 76, 79, 90, 79, 90, "Something exists beyond the architecture currently exposed to the visitor. There is no reason to assume it is empty.", "UNKNOWN", "Undisclosed")
    ];

    public ExploreExperienceMicroBundle ExperienceForTests => Experience;
    public SpatialSceneStack SceneStackForTests => Router.SceneStack;

    public Explore()
    {
        Experience = new ExploreExperienceMicroBundle();
        Router.RegisterEntryPoint("mansion", new SpatialPoint(50, 78));
        Router.RegisterEntryPoint("construction-site", new SpatialPoint(12, 9));
        Router.RegisterEntryPoint("maze", SpatialMazeCatalog.Showcase.Start);
        Router.RegisterEntryPoint("singularity-lab", new SpatialPoint(50, 78));
        Router.RegisterEntryPoint("space-elevator", new SpatialPoint(50, 78));
        Router.RegisterEntryPoint("singularity-station", new SpatialPoint(50, 78));
        Router.RegisterEntryPoint("singularity-island", new SpatialPoint(50, 78));
        foreach (var interactable in Scene.Interactables)
        {
            if (interactable.Place is not null)
                Router.RegisterPlace(interactable.Place);
        }

        Experience.Navigation.MoveTo(Scene.StartingPosition.X, Scene.StartingPosition.Y);
    }

    private double AvatarX => Experience.Navigation.X;
    private double AvatarY => Experience.Navigation.Y;
    private bool ConferenceJoined => Experience.Conference.Joined;
    private FsmForgeMicroBundle Forge => Experience.Forge;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || gardenVisitResolved) return;

        try
        {
            var visited = await JS.InvokeAsync<bool>("workshopExploreGardenVisited");
            gardenMode = !visited;
            gardenVisitResolved = true;
            if (!visited)
                await JS.InvokeVoidAsync("markWorkshopExploreGardenVisited");
        }
        catch (JSException)
        {
            // The spatial Experience must remain usable if the optional garden-visit
            // persistence hook is unavailable (for example during a stale deployment).
            // Do not let a browser-side storage/module problem tear down the Blazor circuit.
            gardenMode = false;
            gardenVisitResolved = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private ElementBuilder BuildGui()
    {
        if (!gardenVisitResolved || gardenMode)
            return SpatialGardenGuiBuilder.Build(this, SpatialGardenManifest.CreateDefault(), Experience.User.DisplayName, EnterGardenDestination, ExitGarden);

        if (insideRoomId is "hangout" or "settings")
        {
            insideRoomId = null;
            gardenMode = true;
            gardenVisitResolved = true;
            return SpatialGardenGuiBuilder.Build(this, SpatialGardenManifest.CreateDefault(), Experience.User.DisplayName, EnterGardenDestination, ExitGarden);
        }

        if (insideRoomId == "conference")
            return ConferenceRoomGuiBuilder.Build(this, ConferenceJoined, JoinConference, LeaveConference, ExitRoom);

        if (insideRoomId == "forge")
            return SpatialForgeGuiBuilder.Build(this, Experience.User.DisplayName, AvatarX, AvatarY, HandleKeyDown, (x, y) => _ = MoveForgeTo(x, y), ExitRoom);

        if (insideRoomId == "aec-lobby")
            return SpatialAECRemoteOfficeLobbyGuiBuilder.Build(this, Experience.User.DisplayName, EnterAECConsultation, ExitRoom);

        if (insideRoomId == "aec-consultation")
            return SpatialAECConsultationGuiBuilder.Build(this, AECIntent, Experience.User.DisplayName, AnswerAECIntent, GenerateAECStructure, ExitAECConsultation);

        if (insideRoomId == "aec-generated-structure" && AECGeneratedStructure is not null)
            return SpatialAECGeneratedStructureGuiBuilder.Build(this, AECGeneratedStructure, Experience.User.DisplayName, EnterGeneratedAECStructure, RegenerateAECStructure, ExitRoom); 

        if (insideRoomId == "aec-remote-office")
            return SpatialAECRemoteOfficeGuiBuilder.Build(this, AECManifest, AECDraft, Experience.User.DisplayName, AvatarX, AvatarY, args => _ = DrawAECPoint(args), ClearAECDraft, UndoAECDraft, SetAECElementKind, SetAECSnap, SetAECOrthogonal, SetAECFloor, SetAECTrade, ExitRoom);

        if (insideRoomId == "line-lab")
            return SpatialLineWorkshopGuiBuilder.Build(this, ForgeLinework, forgeStyle, drawingLine, args => _ = DrawForgePoint(args), ClearForgeLines, SetForgeStyle, ExitRoom, Experience.User.DisplayName);

        if (insideRoomId == "construction-site")
            return SpatialConstructionExperienceGuiBuilder.Build(this, Scene.ConstructionExperience, Experience.User.DisplayName, AvatarX, AvatarY, constructionZoom, SetConstructionZoom, HandleKeyDown, HandleConstructionWorldClick, ExitRoom);

        if (insideRoomId == "maze")
            return SpatialMazeExperienceGuiBuilder.Build(this, SpatialMazeCatalog.Showcase, Experience.User.DisplayName, new SpatialPoint(AvatarX, AvatarY), SpatialMazeCatalog.Participants, MazeLeaderboard, SelectLeaderboardEntry, selectedLeaderboardEntry, HandleKeyDown, ExitRoom, mazeZoom, SetMazeZoom, mazeFinished);

        if (insideRoomId == "singularity-shipyard")
            return SpatialShipyardGuiBuilder.Build(this, ShipyardManifest, ShipDesignManifest, Experience.User.DisplayName, ExitRoom);

        if (insideRoomId == "singularity-capitol")
            return SingularityGovernmentGuiBuilder.Build(this, Experience.User.DisplayName, DateTimeOffset.UtcNow, ExitRoom, TakeCivicOffice, occupiedCivicOfficeId);

        if (insideRoomId == "singularity-transit")
            return SpatialTransitStationGuiBuilder.Build(this, TransitManifest, Experience.User.DisplayName, selectedTransitDestinationId, transitTrainVisible, SelectTransitPlatform, BoardTransitTrain, ExitRoom, transitMicroGameActive, transitMicroGameScore, transitMicroGameRound, transitMicroGameTargetId, StartTransitMicroGame, SelectTransitMicroGamePlatform, AvatarX, AvatarY, HandleKeyDown, HandleTransitWorldClick, TransitTrain.Specification);

        if (insideRoomId == "singularity-island")
            return SpatialIslandExperienceGuiBuilder.Build(this, Island, Experience.User.DisplayName, EnterIslandAttraction, ExitRoom);

        if (insideRoomId == "singularity-lab")
            return SpatialSingularityLabGuiBuilder.Build(
                this,
                SingularityLab,
                Experience.User.DisplayName,
                ExitRoom,
                EnterLabSecurity,
                PlaceLabBelongings,
                CompleteLabScreening,
                EnterLabElevator,
                ScanLabId,
                ScanLabFingerprint,
                ScanLabRetina,
                SelectLabFloor,
                ResolveLabFloorChallenge,
                ReturnToLabElevator);

        if (insideRoomId == "mansion")
            return SpatialMansionGuiBuilder.Build(
                this,
                MansionStructure,
                Experience.User.DisplayName,
                AvatarX,
                AvatarY,
                mansionDensity,
                args => _ = HandleMansionWorldClick(args),
                HandleKeyDown,
                SetMansionDensity,
                ExitRoom,
                mansionWelcomeVisible,
                DismissMansionWelcome,
                mansionZoom,
                SetMansionZoom,
                mansionPresentation,
                SelectMansionFeature,
                selectedMansionFeatureId)
                .Content(MansionMayorOverlay());

        if (insideRoomId is not null)
        {
            var interactable = Scene.Interactables.FirstOrDefault(item => item.ExperienceId == insideRoomId);
            var title = interactable?.Name ?? "Spatial Room";
            var description = interactable is null
                ? "A child scene in the Workshop spatial hierarchy."
                : $"A spatial interior generated from the {interactable.Name} MicroBundle boundary.";
            return SpatialInteriorGuiBuilder.Build(this, title, description, Experience.User.DisplayName, ExitRoom);
        }

        var world = SpatialWorkshopGuiBuilder.Build(this, Scene, AvatarX, AvatarY, detailLevel, SetDetailLevel, HandleKeyDown, HandleWorldClick, InteractRoom, spatialZoom, SetSpatialZoom, ShowWorkshopMap, EnterConstructionSite, constructionTourActive, constructionTourMessage, constructionWelcomeVisible, RequestConstructionTour, ExitConstructionSite);
        var root = WorkshopGui.MultiPanel(this).Style("position", "fixed").Style("inset", "0").Style("width", "100vw").Style("height", "100vh").Style("overflow", "hidden").Content(world).Content(WorkshopAdBanner());
        if (workshopMapVisible)
            root.Content(SpatialWorkshopMapGuiBuilder.Build(this, Scene, AvatarX, AvatarY, Experience.User.DisplayName, SelectMapDestination, CloseWorkshopMap, workshopMapScope, workshopMapZoom, SetWorkshopMapZoom, SetWorkshopMapScope));
        return root;
    }

    /// <summary>Renders the Workshop's first self-advertisement as spatial scenery rather than intrusive chrome.</summary>
