@page "/explore"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@using TheSingularityWorkshop.Gui
@using TheSingularityWorkshop.Workshop.MicroBundles
@implements IDisposable

<PageTitle>Explore // The Singularity Workshop</PageTitle>

@BuildGui().Build()

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private readonly ExploreExperienceMicroBundle Experience;
    private readonly SpatialWorkshopScene Scene = SpatialWorkshopScene.CreateDefault();
    private readonly WorkshopRouter Router = new("workshop");
    private readonly SpatialLinework ForgeStructure = SpatialForgeLineworkFactory.Create();
    private readonly SpatialLinework ForgeLinework = new();
    private readonly LeaderboardMicroBundle MazeLeaderboard = CreateMazeLeaderboard();
    private readonly SpatialTransitManifest TransitManifest = SpatialTransitManifest.CreateDefault();
    private readonly TransitTrainMicroBundle TransitTrain = new(7301, TransitTrainSpecification.WorkshopHoEmu());
    private readonly SpatialLaboratoryManifest LaboratoryManifest = SpatialLaboratoryManifest.CreateDefault();
    private SpatialLinework MansionStructure = SingularityMansionLineworkFactory.Create();
    private SpatialLineStyle forgeStyle = SpatialLineStyleCatalog.Neon;
    private bool drawingLine;
    private bool mansionWelcomeVisible;
    private bool constructionWelcomeVisible;
    private bool constructionTourActive;
    private string constructionTourMessage = "Stay close. I will show you what is being built.";
    private bool workshopMapVisible = true;
    private bool gardenMode = true;
    private bool gardenVisitResolved;
    private double spatialZoom = 1d;
    private double mansionZoom = 1d;
    private double constructionZoom = 1d;
    private double mazeZoom = 1d;
    private int mazeSteps;
    private bool mazeFinished;
    private DateTime? mazeStartedAtUtc;
    private string? selectedLeaderboardEntry;
    private string? insideRoomId;
    private string? selectedTransitDestinationId;
    private bool transitTrainVisible;
    private bool transitMicroGameActive;
    private int transitMicroGameScore;
    private int transitMicroGameRound;
    private string? transitMicroGameTargetId;
    private string? selectedLaboratoryFloorId;
    private static readonly SpatialIslandExperience Island = SpatialIslandExperience.SingularityIsland;
    private int detailLevel = 16;
    private int mansionDensity = 1;
    private IJSObjectReference? spatialModule;

    private static readonly IReadOnlyList<SpatialRoom> Rooms =
    [
        new("experience", "Experience Deck", "LIVING SPACE", 25, 28, 25, 42, 25, 42, "The sensory side of the Workshop. This is where an Experience becomes something a visitor can actually inhabit.", "EXPERIENCE", "Living GUI / presentation"),
        new("engineering", "The Forge", "FSM WORKSHOP", 73, 30, 73, 46, 73, 46, "The Workshop's first real building: a place for shaping state, lifecycle, reusable substrates, and executable machinery.", "FORGE", "FSM / lifecycle / composition"),
        new("creation", "Creation Bay", "BUILDER SPACE", 34, 72, 34, 88, 34, 88, "The composition boundary. Focused capabilities become MicroBundles, then recipes, then executable Experiences.", "CREATION", "MicroBundles / composition"),
        new("unknown", "Unknown Annex", "UNMAPPED", 79, 76, 79, 90, 79, 90, "Something exists beyond the architecture currently exposed to the visitor. There is no reason to assume it is empty.", "UNKNOWN", "Undisclosed")
    ];

    public ExploreExperienceMicroBundle ExperienceForTests => Experience;
    public SpatialSceneStack SceneStackForTests => Router.SceneStack;

    public Explore()
    {
        Experience = new ExploreExperienceMicroBundle();
        Router.RegisterEntryPoint("mansion", new SpatialPoint(50, 78));
        Router.RegisterEntryPoint("construction-site", new SpatialPoint(12, 9));
        Router.RegisterEntryPoint("maze", SpatialMazeCatalog.Showcase.Start);
        Router.RegisterEntryPoint("singularity-lab", new SpatialPoint(50, 78));
        Router.RegisterEntryPoint("space-elevator", new SpatialPoint(50, 78));
        Router.RegisterEntryPoint("singularity-station", new SpatialPoint(50, 78));
        Router.RegisterEntryPoint("singularity-island", new SpatialPoint(50, 78));
        Experience.Navigation.MoveTo(Scene.StartingPosition.X, Scene.StartingPosition.Y);
    }

    private double AvatarX => Experience.Navigation.X;
    private double AvatarY => Experience.Navigation.Y;
    private bool ConferenceJoined => Experience.Conference.Joined;
    private FsmForgeMicroBundle Forge => Experience.Forge;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || gardenVisitResolved) return;

        try
        {
            var visited = await JS.InvokeAsync<bool>("workshopExploreGardenVisited");
            gardenMode = !visited;
            gardenVisitResolved = true;
            if (!visited)
                await JS.InvokeVoidAsync("markWorkshopExploreGardenVisited");
        }
        catch (JSException)
        {
            // The spatial Experience must remain usable if the optional garden-visit
            // persistence hook is unavailable (for example during a stale deployment).
            // Do not let a browser-side storage/module problem tear down the Blazor circuit.
            gardenMode = false;
            gardenVisitResolved = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private ElementBuilder BuildGui()
    {
        if (!gardenVisitResolved || gardenMode)
            return SpatialGardenGuiBuilder.Build(this, SpatialGardenManifest.CreateDefault(), Experience.User.DisplayName, EnterGardenDestination, ExitGarden);

        if (insideRoomId is "hangout" or "settings")
        {
            insideRoomId = null;
            gardenMode = true;
            gardenVisitResolved = true;
            return SpatialGardenGuiBuilder.Build(this, SpatialGardenManifest.CreateDefault(), Experience.User.DisplayName, EnterGardenDestination, ExitGarden);
        }

        if (insideRoomId == "conference")
            return ConferenceRoomGuiBuilder.Build(this, ConferenceJoined, JoinConference, LeaveConference, ExitRoom);

        if (insideRoomId == "forge")
            return SpatialForgeGuiBuilder.Build(this, ForgeStructure, Experience.User.DisplayName, EnterLineLab, ExitRoom);

        if (insideRoomId == "line-lab")
            return SpatialLineWorkshopGuiBuilder.Build(this, ForgeLinework, forgeStyle, drawingLine, args => _ = DrawForgePoint(args), ClearForgeLines, SetForgeStyle, ExitRoom, Experience.User.DisplayName);

        if (insideRoomId == "construction-site")
            return SpatialConstructionExperienceGuiBuilder.Build(this, Scene.ConstructionExperience, Experience.User.DisplayName, AvatarX, AvatarY, constructionZoom, SetConstructionZoom, HandleKeyDown, HandleConstructionWorldClick, ExitRoom);

        if (insideRoomId == "maze")
            return SpatialMazeExperienceGuiBuilder.Build(this, SpatialMazeCatalog.Showcase, Experience.User.DisplayName, new SpatialPoint(AvatarX, AvatarY), SpatialMazeCatalog.Participants, MazeLeaderboard, SelectLeaderboardEntry, selectedLeaderboardEntry, HandleKeyDown, ExitRoom, mazeZoom, SetMazeZoom, mazeFinished);

        if (insideRoomId == "singularity-transit")
            return SpatialTransitStationGuiBuilder.Build(this, TransitManifest, Experience.User.DisplayName, selectedTransitDestinationId, transitTrainVisible, SelectTransitPlatform, BoardTransitTrain, ExitRoom, transitMicroGameActive, transitMicroGameScore, transitMicroGameRound, transitMicroGameTargetId, StartTransitMicroGame, SelectTransitMicroGamePlatform, AvatarX, AvatarY, HandleKeyDown, HandleTransitWorldClick, TransitTrain.Specification);

        if (insideRoomId == "singularity-island")
            return SpatialIslandExperienceGuiBuilder.Build(this, Island, Experience.User.DisplayName, EnterIslandAttraction, ExitRoom);

        if (insideRoomId == "singularity-lab")
            return SpatialLaboratoryExperienceGuiBuilder.Build(this, LaboratoryManifest, Experience.User.DisplayName, selectedLaboratoryFloorId, SelectLaboratoryFloor, ExitRoom);

        if (insideRoomId == "mansion")
            return SpatialMansionGuiBuilder.Build(this, MansionStructure, Experience.User.DisplayName, AvatarX, AvatarY, mansionDensity, args => _ = HandleMansionWorldClick(args), HandleKeyDown, SetMansionDensity, ExitRoom, mansionWelcomeVisible, DismissMansionWelcome, mansionZoom, SetMansionZoom);

        if (insideRoomId is not null)
        {
            var interactable = Scene.Interactables.FirstOrDefault(item => item.ExperienceId == insideRoomId);
            var title = interactable?.Name ?? "Spatial Room";
            var description = interactable is null
                ? "A child scene in the Workshop spatial hierarchy."
                : $"A spatial interior generated from the {interactable.Name} MicroBundle boundary.";
            return SpatialInteriorGuiBuilder.Build(this, title, description, Experience.User.DisplayName, ExitRoom);
        }

        var world = SpatialWorkshopGuiBuilder.Build(this, Scene, AvatarX, AvatarY, detailLevel, SetDetailLevel, HandleKeyDown, HandleWorldClick, InteractRoom, spatialZoom, SetSpatialZoom, ShowWorkshopMap, EnterConstructionSite, constructionTourActive, constructionTourMessage, constructionWelcomeVisible, RequestConstructionTour, ExitConstructionSite);
        var root = WorkshopGui.MultiPanel(this).Style("position", "fixed").Style("inset", "0").Style("width", "100vw").Style("height", "100vh").Style("overflow", "hidden").Content(world).Content(WorkshopAdBanner());
        if (workshopMapVisible)
            root.Content(SpatialWorkshopMapGuiBuilder.Build(this, Scene, AvatarX, AvatarY, Experience.User.DisplayName, SelectMapDestination, CloseWorkshopMap));
        return root;
    }

    /// <summary>Renders the Workshop's first self-advertisement as spatial scenery rather than intrusive chrome.</summary>
    private ElementBuilder WorkshopAdBanner()
        => WorkshopGui.Element(this, "div")
            .Style("position", "fixed")
            .Style("left", "50%")
            .Style("top", "1.25rem")
            .Style("transform", "translateX(-50%)")
            .Style("z-index", "40")
            .Style("min-width", "min(520px,82vw)")
            .Style("padding", ".55rem 1.1rem .6rem")
            .Style("border", "1px solid rgba(255,211,77,.72)")
            .Style("background", "linear-gradient(90deg,rgba(1,4,10,.94),rgba(35,18,3,.9),rgba(1,4,10,.94))")
            .Style("box-shadow", "0 0 24px rgba(255,211,77,.14),inset 0 0 18px rgba(255,211,77,.06)")
            .Style("color", "#ffd34d")
            .Style("font-family", "Consolas, 'Courier New', monospace")
            .Style("text-align", "center")
            .Style("letter-spacing", ".12em")
            .Style("pointer-events", "none")
            .Content(WorkshopGui.Element(this, "div")
                .Style("font-size", ".68rem")
                .Text("THE SINGULARITY WORKSHOP"))
            .Content(WorkshopGui.Element(this, "div")
                .Style("margin-top", ".18rem")
                .Style("font-size", ".48rem")
                .Style("color", "#d7e8dd")
                .Text("YOUR AD COULD BE HERE"));

    private void SetDetailLevel(int level) => detailLevel = Math.Clamp(level, 1, 64);

    private void SetSpatialZoom(double zoom)
        => spatialZoom = Math.Clamp(zoom, Scene.View.MinZoom, Scene.View.MaxZoom);

    private void SetMansionZoom(double zoom)
        => mansionZoom = Math.Clamp(zoom, Scene.View.MinZoom, Scene.View.MaxZoom);

    private void SetConstructionZoom(double zoom)
        => constructionZoom = Math.Clamp(zoom, Scene.View.MinZoom, Scene.View.MaxZoom);

    private void SetMazeZoom(double zoom)
        => mazeZoom = Math.Clamp(zoom, .6, 2.2);

    private void ShowWorkshopMap() => workshopMapVisible = true;

    private void EnterGardenDestination(string destinationId)
    {
        if (destinationId == "exit")
        {
            ExitGarden();
            return;
        }

        if (destinationId == "settings")
        {
            gardenMode = false;
            gardenVisitResolved = true;
            insideRoomId = "settings";
            return;
        }

        if (destinationId == "hangout")
        {
            gardenMode = false;
            gardenVisitResolved = true;
            insideRoomId = "hangout";
            return;
        }

        if (destinationId == "singularity-station")
        {
            gardenMode = false;
            gardenVisitResolved = true;
            Router.Enter("singularity-station", new SpatialPoint(AvatarX, AvatarY));
            var entry = Router.GetEntryPoint("singularity-station");
            Experience.Navigation.MoveTo(entry.X, entry.Y);
            insideRoomId = "singularity-station";
        }
    }

    private void ExitGarden()
    {
        gardenMode = false;
        gardenVisitResolved = true;
        NavigationManager.NavigateTo("/", replace: false);
    }

    private async Task EnterConstructionSite()
    {
        if (constructionTourActive) return;
        constructionWelcomeVisible = true;
        constructionTourMessage = "Stay close. I will show you what is being built.";
        await InvokeAsync(StateHasChanged);
    }

    private void RequestConstructionTour()
    {
        constructionWelcomeVisible = false;
        constructionTourActive = false;

        var returnPosition = new SpatialPoint(AvatarX, AvatarY);
        var firstVisit = Router.Enter("construction-site", returnPosition);
        var entry = Router.GetEntryPoint("construction-site");
        Experience.Navigation.MoveTo(entry.X, entry.Y);
        insideRoomId = Router.CurrentSceneId;

        // The construction tour is now the site's own Experience. The exterior is gone.
        if (firstVisit)
            constructionZoom = 1d;
    }

    private void ExitConstructionSite()
    {
        constructionWelcomeVisible = false;
        constructionTourActive = false;
        constructionTourMessage = "Stay close. I will show you what is being built.";
    }

    private void UpdateConstructionTour(double x, double y)
    {
        if (!constructionTourActive) return;

        var site = Scene.ConstructionSite;
        var relativeX = (x - site.Bounds.X) / site.Bounds.Width;
        var relativeY = (y - site.Bounds.Y) / site.Bounds.Height;
        constructionTourMessage = relativeY < .35
            ? "This is the public-facing edge. We are establishing the structure before we open the facility."
            : relativeX < .45
                ? "This side will support the creative production spaces. The exact studios will emerge as their definitions become real."
                : relativeX > .7
                    ? "This is the service side: equipment, materials, and the systems that let the visible creation spaces work."
                    : "Here is the heart of the expansion. When the definitions are ready, this becomes a place where creators can build, rehearse, record, and sell what they make.";
    }
    private void CloseWorkshopMap() => workshopMapVisible = false;

    private async Task SelectMapDestination(string id)
    {
        if (insideRoomId is not null) return;
        var interactable = Scene.Interactables.FirstOrDefault(item => item.Id == id);
        if (interactable is null) return;

        workshopMapVisible = false;
        await InvokeAsync(StateHasChanged);
        await NavigateTo(Center(interactable.InteractionPoint));
    }

    private void SetMansionDensity(int density)
    {
        mansionDensity = Math.Max(1, density);
        MansionStructure.Dispose();
        MansionStructure = SingularityMansionLineworkFactory.Create(mansionDensity);
    }

    private void DismissMansionWelcome() => mansionWelcomeVisible = false;

    private void JoinConference() => Experience.Conference.Join();
    private void LeaveConference() => Experience.Conference.Leave();

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key.ToLowerInvariant())
        {
            case "w":
            case "arrowup":
                if (insideRoomId == "singularity-transit") _ = MoveTransitAvatar(AvatarX, AvatarY - 1.5);
                else _ = MoveAvatar(0, -1);
                break;
            case "s":
            case "arrowdown":
                if (insideRoomId == "singularity-transit") _ = MoveTransitAvatar(AvatarX, AvatarY + 1.5);
                else _ = MoveAvatar(0, 1);
                break;
            case "a":
            case "arrowleft":
                if (insideRoomId == "singularity-transit") _ = MoveTransitAvatar(AvatarX - 1.5, AvatarY);
                else _ = MoveAvatar(-1, 0);
                break;
            case "d":
            case "arrowright":
                if (insideRoomId == "singularity-transit") _ = MoveTransitAvatar(AvatarX + 1.5, AvatarY);
                else _ = MoveAvatar(1, 0);
                break;
        }
    }

    private async Task MoveAvatar(double dx, double dy)
    {
        if (insideRoomId == "mansion")
        {
            await NavigateMansionTo(new SpatialPoint(AvatarX + dx, AvatarY + dy));
            return;
        }

        if (insideRoomId is not null) return;
        await NavigateTo(new SpatialPoint(AvatarX + dx, AvatarY + dy));
        UpdateConstructionTour(AvatarX, AvatarY);
    }

    /// <summary>Converts an empty-space left click into a collision-safe world destination.</summary>
    private async Task HandleWorldClick(MouseEventArgs args)
    {
        if (insideRoomId is not null || workshopMapVisible) return;
        spatialModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Workshop/spatial-workshop.js");
        var point = await spatialModule.InvokeAsync<SpatialPoint>("screenToWorld", args.ClientX, args.ClientY, AvatarX, AvatarY, spatialZoom);
        await NavigateTo(point);
        UpdateConstructionTour(AvatarX, AvatarY);
    }

    /// <summary>Moves freely through the Mansion's line-rendered world without Workshop building collisions.</summary>
    private async Task HandleMazeWorldClick(MouseEventArgs args)
    {
        if (insideRoomId != "maze") return;
        spatialModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Workshop/spatial-workshop.js");
        var point = await spatialModule.InvokeAsync<SpatialPoint>("screenToCenteredWorld", args.ClientX, args.ClientY, AvatarX, AvatarY, mazeZoom);
        var distance = Math.Sqrt(Math.Pow(point.X - AvatarX, 2) + Math.Pow(point.Y - AvatarY, 2));
        if (distance > 3.25) return;
        var dx = Math.Sign(point.X - AvatarX);
        var dy = Math.Sign(point.Y - AvatarY);
        if (Math.Abs(point.X - AvatarX) >= Math.Abs(point.Y - AvatarY))
            dy = 0;
        else
            dx = 0;
        MoveMazeAvatar(dx, dy);
    }

    private void MoveMazeAvatar(double dx, double dy)
    {
        if (insideRoomId != "maze" || mazeFinished) return;

        mazeStartedAtUtc ??= DateTime.UtcNow;
        var maze = SpatialMazeCatalog.Showcase;
        var nextX = (int)Math.Floor(AvatarX + dx);
        var nextY = (int)Math.Floor(AvatarY + dy);
        if (!maze.IsWalkable(nextX, nextY)) return;

        Experience.Navigation.MoveTo(nextX + .5, nextY + .5);
        mazeSteps++;
        MazeLeaderboard.Update();

        if ((int)Math.Floor(AvatarX) == (int)Math.Floor(maze.Exit.X) &&
            (int)Math.Floor(AvatarY) == (int)Math.Floor(maze.Exit.Y))
        {
            mazeFinished = true;
            MazeLeaderboard.Record(Experience.User.DisplayName, mazeStartedAtUtc.HasValue ? (long)(DateTime.UtcNow - mazeStartedAtUtc.Value).TotalMilliseconds : 0, mazeSteps);
        }
    }

    private void SelectLeaderboardEntry(string? name)
        => selectedLeaderboardEntry = name;

    private Task MoveTransitAvatar(double x, double y)
    {
        if (insideRoomId != "singularity-transit") return Task.CompletedTask;

        // Grand Central is currently a schematic floor plan. Keep movement inside
        // the architectural envelope; collision volumes will be derived from the
        // same walls/rooms once the blueprint is stable.
        Experience.Navigation.MoveTo(Math.Clamp(x, 4, 96), Math.Clamp(y, 8, 94));
        return InvokeAsync(StateHasChanged);
    }

    private async Task HandleTransitWorldClick(MouseEventArgs args)
    {
        if (insideRoomId != "singularity-transit") return;

        spatialModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Workshop/spatial-workshop.js");
        var point = await spatialModule.InvokeAsync<SpatialPoint>(
            "screenToCenteredWorld",
            args.ClientX,
            args.ClientY,
            AvatarX,
            AvatarY,
            1d);

        await MoveTransitAvatar(point.X, point.Y);
    }

    private void SelectTransitPlatform(string destinationId)
    {
        if (!TransitManifest.Destinations.Any(destination => destination.Id == destinationId))
            return;

        selectedTransitDestinationId = destinationId;
        transitTrainVisible = true;
    }

    private void StartTransitMicroGame()
    {
        transitMicroGameActive = true;
        transitMicroGameScore = 0;
        transitMicroGameRound = 1;
        transitMicroGameTargetId = TransitManifest.Destinations[0].Id;
    }

    private void SelectTransitMicroGamePlatform(string platformId)
    {
        if (!transitMicroGameActive || transitMicroGameTargetId is null) return;

        var platform = TransitManifest.Platforms.FirstOrDefault(item => item.Id == platformId);
        if (platform == default) return;

        if (platform.DestinationId == transitMicroGameTargetId)
        {
            transitMicroGameScore += 10;
            transitMicroGameRound++;
            transitMicroGameTargetId = TransitManifest.Destinations[(transitMicroGameRound - 1) % TransitManifest.Destinations.Count].Id;
        }
        else
        {
            transitMicroGameScore = Math.Max(0, transitMicroGameScore - 2);
        }
    }

    private void BoardTransitTrain(string destinationId)
    {
        if (!transitTrainVisible || selectedTransitDestinationId != destinationId)
            return;

        var destination = TransitManifest.Destinations.FirstOrDefault(item => item.Id == destinationId);
        if (destination == default)
            return;

        transitTrainVisible = false;
        Router.Enter(destination.SceneId, new SpatialPoint(AvatarX, AvatarY));
        var entry = Router.GetEntryPoint(destination.SceneId);
        Experience.Navigation.MoveTo(entry.X, entry.Y);
        insideRoomId = destination.SceneId;

        if (destination.SceneId == LaboratoryManifest.Id)
            selectedLaboratoryFloorId = LaboratoryManifest.Floors.FirstOrDefault().Id;
    }

    private void SelectLaboratoryFloor(string floorId)
    {
        if (!LaboratoryManifest.Floors.Any(floor => floor.Id == floorId))
            return;

        selectedLaboratoryFloorId = floorId;
    }

    private void EnterIslandAttraction(string experienceId)
    {
        if (insideRoomId != "singularity-island") return;
        var attraction = Island.Attractions.FirstOrDefault(item => item.ExperienceId == experienceId);
        if (attraction is null) return;

        Router.Enter(experienceId, new SpatialPoint(AvatarX, AvatarY));
        var entry = Router.GetEntryPoint(experienceId);
        Experience.Navigation.MoveTo(entry.X, entry.Y);
        insideRoomId = experienceId;
    }

    private static LeaderboardMicroBundle CreateMazeLeaderboard()
        => new(
            "Workshop Maze Leaderboard",
            SpatialMazeCatalog.Leaderboard.Select(x =>
                new LeaderboardEntry(x.Name, ParseLeaderboardTime(x.Time), x.Steps)));

    private static long ParseLeaderboardTime(string value)
    {
        var parts = value.Split(':', '.');
        if (parts.Length != 3 ||
            !int.TryParse(parts[0], out var minutes) ||
            !int.TryParse(parts[1], out var seconds) ||
            !int.TryParse(parts[2], out var centiseconds))
            return 0;

        return (minutes * 60_000L) + (seconds * 1_000L) + (centiseconds * 10L);
    }

    private async Task HandleConstructionWorldClick(MouseEventArgs args)
    {
        if (insideRoomId != "construction-site") return;
        spatialModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Workshop/spatial-workshop.js");
        var point = await spatialModule.InvokeAsync<SpatialPoint>("screenToCenteredWorld", args.ClientX, args.ClientY, AvatarX, AvatarY, constructionZoom);
        await NavigateConstructionTo(point);
    }

    private Task NavigateConstructionTo(SpatialPoint target)
        => NavigatePath([new SpatialPoint(Math.Clamp(target.X, 4, 96), Math.Clamp(target.Y, 5, 90))]);

    private async Task HandleMansionWorldClick(MouseEventArgs args)
    {
        if (insideRoomId != "mansion") return;
        spatialModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Workshop/spatial-workshop.js");
        var point = await spatialModule.InvokeAsync<SpatialPoint>("screenToCenteredWorld", args.ClientX, args.ClientY, AvatarX, AvatarY, mansionZoom);
        await NavigateMansionTo(point);
    }

    /// <summary>Approaches a spatial object, then enters its child scene only after arrival.</summary>
    private async Task InteractRoom(string id)
    {
        if (insideRoomId is not null) return;

        var interactable = Scene.Interactables.FirstOrDefault(item => item.Id == id);
        if (interactable is null) return;

        var selected = interactable.InteractionPoints
            .Select(point => new { Point = point, Path = SpatialGeometryEngine.FindPath(new SpatialPoint(AvatarX, AvatarY), Center(point.Bounds), SpatialGeometryEngine.FromInteractables(Scene.Interactables)) })
            .Where(candidate => candidate.Path.Count > 0)
            .OrderBy(candidate => PathLength(new SpatialPoint(AvatarX, AvatarY), candidate.Path))
            .FirstOrDefault();

        if (selected is null) return;

        await NavigatePath(selected.Path);
        UpdateConstructionTour(AvatarX, AvatarY);
        interactable.OnInteraction();
        var returnPosition = new SpatialPoint(AvatarX, AvatarY);
        var firstVisit = Router.Enter(interactable.ExperienceId, returnPosition);
        Experience.Navigation.MoveTo(Router.GetEntryPoint(interactable.ExperienceId).X, Router.GetEntryPoint(interactable.ExperienceId).Y);
        insideRoomId = interactable.ExperienceId;
        mansionWelcomeVisible = interactable.ExperienceId == "mansion" && firstVisit;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Moves from the Forge floor into its nested Linework Lab scene.</summary>
    private void EnterLineLab()
    {
        if (insideRoomId != "forge") return;

        Router.Enter("line-lab", new SpatialPoint(AvatarX, AvatarY));
        var entry = Router.GetEntryPoint("line-lab");
        Experience.Navigation.MoveTo(entry.X, entry.Y);
        insideRoomId = "line-lab";
    }

    private async Task NavigateTo(SpatialPoint target)
    {
        var path = SpatialGeometryEngine.FindPath(new SpatialPoint(AvatarX, AvatarY), target, SpatialGeometryEngine.FromInteractables(Scene.Interactables));
        await NavigatePath(path);
    }

    private Task NavigateMansionTo(SpatialPoint target)
        => NavigatePath([new SpatialPoint(Math.Clamp(target.X, 4, 96), Math.Clamp(target.Y, 8, 92))]);

    /// <summary>Animates each navigation segment so the camera does not teleport between path nodes.</summary>
    private async Task NavigatePath(IReadOnlyList<SpatialPoint> path)
    {
        if (path.Count == 0) return;

        var previous = new SpatialPoint(AvatarX, AvatarY);
        foreach (var point in path)
        {
            const int frames = 8;
            for (var frame = 1; frame <= frames; frame++)
            {
                var t = frame / (double)frames;
                var eased = t * t * (3d - 2d * t);
                Experience.Navigation.MoveTo(previous.X + (point.X - previous.X) * eased, previous.Y + (point.Y - previous.Y) * eased);
                await InvokeAsync(StateHasChanged);
                await Task.Delay(16);
            }
            previous = point;
        }
    }

    private async Task DrawForgePoint(MouseEventArgs args)
    {
        spatialModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Workshop/spatial-workshop.js");
        var point = await spatialModule.InvokeAsync<SpatialPoint>("screenToLinePoint", args.ClientX, args.ClientY);
        if (!drawingLine)
        {
            ForgeLinework.BeginLine(point);
            drawingLine = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        ForgeLinework.ContinueLine(point);
        ForgeLinework.EndLine();
        drawingLine = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ClearForgeLines()
    {
        drawingLine = false;
        ForgeLinework.Clear();
    }

    private void SetForgeStyle(SpatialLineStyle style) => forgeStyle = style;

    private static SpatialPoint Center(SpatialBounds bounds)
        => new(bounds.X + bounds.Width / 2, bounds.Y + bounds.Height / 2);

    private static double PathLength(SpatialPoint start, IReadOnlyList<SpatialPoint> path)
    {
        var total = 0d;
        var previous = start;
        foreach (var point in path)
        {
            total += Math.Sqrt(Math.Pow(point.X - previous.X, 2) + Math.Pow(point.Y - previous.Y, 2));
            previous = point;
        }
        return total;
    }

    private void ExitRoom()
    {
        Forge.Reset();
        Experience.Conference.Leave();
        if (insideRoomId == "conference")
        {
            var room = Rooms.FirstOrDefault(x => x.Id == "yup");
            if (room is not null) Experience.Navigation.MoveToExit(room);
            insideRoomId = null;
            return;
        }

        mansionWelcomeVisible = false;
        constructionWelcomeVisible = false;
        constructionTourActive = false;
        if (insideRoomId == "maze")
        {
            mazeStartedAtUtc = null;
            selectedLeaderboardEntry = null;
        }

        if (insideRoomId == "singularity-transit")
        {
            selectedTransitDestinationId = null;
            transitTrainVisible = false;
            transitMicroGameActive = false;
            transitMicroGameScore = 0;
            transitMicroGameRound = 0;
            transitMicroGameTargetId = null;
        }

        if (Router.TryExit(out var frame))
            Experience.Navigation.MoveTo(frame.ReturnPosition.X, frame.ReturnPosition.Y);
        insideRoomId = Router.CurrentSceneId == "workshop" ? null : Router.CurrentSceneId;
    }

    public void Dispose()
    {
        Experience.Dispose();
        TransitTrain.Dispose();
        ForgeStructure.Dispose();
        ForgeLinework.Dispose();
        MansionStructure.Dispose();
        MazeLeaderboard.Dispose();
        if (spatialModule is not null) _ = spatialModule.DisposeAsync();
    }
}
