    .studios-audio { display:grid; grid-template-columns:minmax(0,1fr) minmax(280px,.8fr); gap:2rem; align-items:center; padding:2rem; border:1px solid #1b3545; background:radial-gradient(ellipse at 0 0,#0b2331,#050b14 65%); }
