    .studios-status span { width:.55rem; height:.55rem; border-radius:50%; background:#ffd34d; box-shadow:0 0 12px #ffd34d; }
    .studios-status i { color:#ff2cff; font-style:normal; }
    .studios-hero { display:grid; grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr); gap:clamp(1rem,3vw,3rem); align-items:center; padding:clamp(1rem,3vw,2rem) 0 3rem; }
    .studios-hero-copy h2,.studios-audio h2 { max-width:40rem; margin:.8rem 0 1rem; font-size:clamp(1.8rem,3.7vw,3.5rem); line-height:1.04; letter-spacing:-.04em; }
    .studios-hero-copy p,.studio-card p,.studios-audio p { color:#adc2ce; line-height:1.75; }
    .studios-stage-art { overflow:hidden; border:1px solid #174151; background:#030a14; box-shadow:0 0 50px #00eaff0c; }
    .studios-stage-art svg,.studios-acoustic-map svg,.studios-stage-plan { display:block; width:100%; height:auto; }
    .studios-plan-legend { display:flex; flex-wrap:wrap; gap:.7rem 1rem; padding:.8rem; border-top:1px solid #174151; color:#adc2ce; font:.65rem Consolas,monospace; }
    .studios-plan-legend span { display:flex; align-items:center; gap:.4rem; }
    .studios-plan-legend i { display:inline-block; width:.65rem; height:.65rem; border:1px solid #d8fbff; }
