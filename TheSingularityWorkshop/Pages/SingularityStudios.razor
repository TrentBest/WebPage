    .studios-acoustic-map p { margin:.5rem 0 0; color:#819ba9; font: .65rem Consolas,monospace; text-align:center; }\n    .studios-model-proof { grid-column:1 / -1; padding:1.3rem; border:1px solid #174151; background:#050d17; }\n    .studios-model-proof h2 { margin:.7rem 0; font-size:clamp(1.5rem,3vw,2.2rem); }\n    .studios-model-proof p,.studios-model-proof small { color:#adc2ce; line-height:1.65; }\n    .studios-model-proof img { display:block; width:100%; max-width:720px; height:auto; margin:1rem auto; border:1px solid #174151; }\n    .studios-proof-links { display:flex; flex-wrap:wrap; gap:1.2rem; margin:1rem 0; }\n    .studios-proof-links a { color:#00eaff; text-decoration:none; font:.68rem Consolas,monospace; letter-spacing:.08em; }\n    .studios-model-proof small { display:block; }
    .studios-footer { display:flex; flex-wrap:wrap; align-items:center; gap:1.5rem; padding:2rem 0 1rem; }
    .studios-footer div { flex:1 1 18rem; }
    .studios-footer strong { color:#ff2cff; font: .7rem Consolas,monospace; letter-spacing:.16em; }
    .studios-footer p { color:#adc2ce; }
    @@media(max-width:850px) { .studios-hero,.studios-audio { grid-template-columns:1fr; } .studios-grid { grid-template-columns:1fr; } }
    @@media(prefers-reduced-motion:reduce) { * { scroll-behavior:auto !important; } }
</style>
