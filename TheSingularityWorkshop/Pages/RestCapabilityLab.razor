808a;font-size:.52rem;letter-spacing:.12em}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;padding:1rem}.form-grid label{display:flex;flex-direction:column;gap:.35rem}.form-grid span,.operation-title span{color:#5e7882;font-size:.5rem;letter-spacing:.1em}.rest-lab input,.rest-lab select{width:100%;box-sizing:border-box;padding:.7rem;border:1px solid rgba(0,234,255,.2);background:#010812;color:#dffaff;font:inherit;font-size:.68rem;outline:none}.rest-lab input:focus,.rest-lab select:focus{border-color:#00eaff;box-shadow:0 0 16px rgba(0,234,255,.12)}.operation-title{margin-top:.25rem}.operation-form{display:grid;grid-template-columns:1.2fr .7fr 1.4fr auto;gap:.5rem;padding:.8rem}.rest-lab button{border:1px solid rgba(0,234,255,.4);background:rgba(0,234,255,.035);color:#dffaff;padding:.65rem .8rem;font:700 .58rem Consolas,'Courier New',monospace;letter-spacing:.08em;cursor:pointer}.rest-lab button:hover{border-color:#ff2cff;color:#fff;box-shadow:0 0 18px rgba(255,44,255,.12)}.rest-lab button.primary{border-color:#ff2cff;color:#fff;background:rgba(255,44,255,.055)}.operation-list{display:flex;flex-direction:column;gap:.35rem;padding:.8rem}.operation-row{display:grid;grid-template-columns:4.5rem 1fr 1fr 2rem;align-items:center;gap:.5rem;padding:.6rem;border:1px solid rgba(0,234,255,.09);background:rgba(0,234,255,.018);font-size:.58rem}.method{color:#52e05a;font-weight:800}.path{color:#00eaff}.name{color:#d8f7ff}.operation-row button{padding:.25rem}.rest-actions{display:flex;gap:.5rem;padding:.8rem;border-top:1px solid rgba(0,234,255,.1)}.recipe-panel pre{min-height:410px;margin:0;padding:1rem;overflow:auto;color:#9fefff;font:500 .68rem/1.55 Consolas,'Courier New',monospace;background:rgba(0,0,0,.22)}.recipe-note{display:flex;flex-direction:column;gap:.35rem;padding:.8rem;border-top:1px solid rgba(255,44,255,.12);font-family:system-ui,sans-serif;font-size:.72rem;line-height:1.45}.recipe-note strong{color:#ff2cff;font:700 .56rem Consolas,'Courier New',monospace;letter-spacing:.1em}.recipe-note span{color:#78939c}.rest-footer{display:flex;justify-content:space-between;gap:1rem;padding:.75rem .15rem;color:#4e6973;font-size:.5rem;letter-spacing:.08em}.rest-footer span:first-child{color:#00eaff}@@media(max-width:900px){.rest-pipeline{grid-template-columns:1fr}.rest-pipeline i{transform:rotate(90deg);justify-self:center}.rest-grid{grid-template-columns:1fr}.form-grid,.operation-form{grid-template-columns:1fr}.rest-footer{flex-direction:column}.rest-lab{margin:-.5rem -.75rem;padding:.65rem}}
</style>
