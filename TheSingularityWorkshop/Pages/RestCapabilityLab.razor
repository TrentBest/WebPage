@page "/rest-lab"
@using TheSingularityWorkshop.Workshop.Experiences

<PageTitle>REST Capability Lab // The Singularity Workshop</PageTitle>

<div class="rest-lab">
    <header class="rest-lab-header">
        <div>
            <div class="rest-kicker">WORKSHOP EXPERIENCE // SCIENCE LAB</div>
            <h1>REST CAPABILITY LAB</h1>
            <p>
                Turn an external REST API into a reusable capability recipe.
                The recipe describes what software can ask for; it does not contain the remote response.
            </p>
        </div>
        <div class="rest-status"><span></span> RECIPE SERIALIZER ONLINE</div>
    </header>

    <section class="rest-pipeline" aria-label="REST capability composition flow">
        <div><b>REMOTE API</b><small>outside the Workshop</small></div>
        <i>→</i>
        <div class="active"><b>CAPABILITY RECIPE</b><small>method + path + identity</small></div>
        <i>→</i>
        <div><b>MICROBUNDLE</b><small>portable composition data</small></div>
        <i>→</i>
        <div><b>EXPERIENCE</b><small>someone else can use it</small></div>
    </section>

    <main class="rest-grid">
        <section class="rest-panel">
            <div class="panel-title"><span>01 // AUTHOR</span><span>CAPABILITY IDENTITY</span></div>
            <div class="form-grid">
                <label>
                    <span>API NAME</span>
                    <input @bind="Experience.ApiName" />
                </label>
                <label>
                    <span>BASE URI</span>
                    <input @bind="Experience.BaseUri" />
                </label>
            </div>

            <div class="panel-title operation-title"><span>02 // ADD OPERATION</span><span>ENDPOINT RECIPE</span></div>
            <div class="operation-form">
                <input @bind="operationName" placeholder="Operation name" />
                <select @bind="operationMethod">
                    <option>GET</option>
                    <option>POST</option>
                    <option>PUT</option>
                    <option>PATCH</option>
                    <option>DELETE</option>
                </select>
                <input @bind="operationPath" placeholder="/resource/{id}" />
                <button type="button" @onclick="AddOperation">ADD</button>
            </div>

            <div class="operation-list">
                @foreach (var operation in Experience.Operations.Select((value, index) => (value, index)))
                {
                    <div class="operation-row">
                        <span class="method">@operation.value.Method</span>
                        <span class="path">@operation.value.Path</span>
                        <span class="name">@operation.value.Name</span>
                        <button type="button" title="Remove operation" @onclick="() => Experience.RemoveOperation(operation.index)">×</button>
                    </div>
                }
            </div>

            <div class="rest-actions">
                <button type="button" class="primary" @onclick="SerializeRecipe">SERIALIZE MICROBUNDLE RECIPE</button>
                <button type="button" @onclick="ResetRecipe">RESET</button>
            </div>
        </section>

        <section class="rest-panel recipe-panel">
            <div class="panel-title"><span>03 // SERIALIZED ARTIFACT</span><span>PORTABLE DATA</span></div>
            <pre>@SerializedRecipe</pre>
            <div class="recipe-note">
                <strong>THE RESULT IS THE RECIPE.</strong>
                <span>The remote catalog, inventory, prices, or user-specific response is runtime data and stays outside this artifact.</span>
            </div>
        </section>
    </main>

    <footer class="rest-footer">
        <span>REST FORM → MICROBUNDLE DATA → FSM_COS → EXPERIENCE</span>
        <span>Next boundary: bind this surface to TheSingularityWorkshop.FSM_REST.</span>
    </footer>
</div>

@code {
    private readonly RestCapabilityLabExperience Experience = new();
    private string operationName = "GetItem";
    private string operationMethod = "GET";
    private string operationPath = "/catalog/{id}";
    private string SerializedRecipe = string.Empty;

    protected override void OnInitialized() => SerializeRecipe();

    private void AddOperation()
    {
        try
        {
            Experience.AddOperation(operationName, operationMethod, operationPath);
            operationName = "GetItem";
            operationMethod = "GET";
            operationPath = "/catalog/{id}";
            SerializeRecipe();
        }
        catch (ArgumentException)
        {
        }
    }

    private void SerializeRecipe() => SerializedRecipe = Experience.Serialize();

    private void ResetRecipe()
    {
        Experience.Reset();
        SerializeRecipe();
    }
}

<style>
