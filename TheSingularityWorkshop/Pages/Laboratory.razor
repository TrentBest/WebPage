@page "/laboratory"
@using TheSingularityWorkshop.Workshop.Gui
@using TheSingularityWorkshop.Workshop.Laboratory
@using TheSingularityWorkshop.Workshop.MicroBundles
@implements IDisposable

<PageTitle>Singularity Laboratory // The Singularity Workshop</PageTitle>

@((RenderFragment)BlazorGuiRenderer.Render(
    SingularityLaboratoryGuiBuilder.Build(_laboratory.ConfigurableRooms, _laboratory.LastResults),
    this,
    HandleCommand))

@code {
    private readonly SingularityLaboratoryMicroBundle _laboratory = new();

    private void HandleCommand(string command)
    {
        var parts = command.Split(':', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 2)
            return;

        var room = _laboratory.ConfigurableRooms.FirstOrDefault(x =>
            string.Equals(x.Id, parts[1], StringComparison.Ordinal));
        if (room is null)
            return;

        if (string.Equals(parts[0], "run", StringComparison.Ordinal) && parts.Length == 3)
        {
            try { _laboratory.RunExperiment(parts[2]); } catch (KeyNotFoundException) { }
            return;
        }

        if (string.Equals(parts[0], "clear", StringComparison.Ordinal))
        {
            room.Clear();
            return;
        }

        if (parts.Length == 3 &&
            string.Equals(parts[0], "configure", StringComparison.Ordinal) &&
            Enum.TryParse<LaboratoryDiscipline>(parts[2], ignoreCase: true, out var discipline))
        {
            var catalogRoom = LaboratoryRoomCatalog.Rooms.FirstOrDefault(x => x.Discipline == discipline);
            if (catalogRoom is null) return;
            room.Clear();
            room.Configure(catalogRoom.Name, catalogRoom.Discipline, catalogRoom.Description);
            foreach (var instrument in catalogRoom.Instruments) room.AddInstrument(instrument);
            foreach (var experimentId in catalogRoom.ExperimentIds)
                room.AddExperiment(SingularityLaboratory.Experiments.First(x => x.Id == experimentId));
        }
    }

    public void Dispose() => _laboratory.Dispose();
}
