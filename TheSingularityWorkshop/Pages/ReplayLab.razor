.replay-capabilities{max-width:1180px;margin:1.5rem auto 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:rgba(0,234,255,.16);border:1px solid rgba(0,234,255,.16)}.capability-card{background:#040d1b;padding:1.2rem}.capability-index{font-size:.58rem}.capability-card h3{font-size:1rem;margin:1rem 0 .5rem}.capability-card p{min-height:5rem;color:#9eb4bf;font-size:.82rem;line-height:1.65}.capability-card a,.capability-unavailable{display:inline-block;margin-top:.5rem;color:#00eaff;text-decoration:none;font:700 .6rem Consolas,monospace;letter-spacing:.06em}.capability-card.pending .capability-index{color:#ffcb88}.capability-card.planned .capability-index{color:#dba6ff}.capability-unavailable{color:#8399a4}
.replay-footer{max-width:1180px;margin:1.3rem auto 0;color:#637f8c;font-size:.72rem;line-height:1.6}
