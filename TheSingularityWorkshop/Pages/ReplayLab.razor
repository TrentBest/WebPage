@page "/replay-lab"
@using Microsoft.AspNetCore.Components
@implements IAsyncDisposable

<PageTitle>Replay Lab // The Singularity Workshop</PageTitle>

<main class="replay-lab">
    <a class="replay-back" href="/?tab=demonstrations">← RETURN TO THE WORKSHOP</a>
    <header class="replay-header">
        <div>
            <p class="replay-kicker">THE SINGULARITY WORKSHOP / EXPERIMENTAL EXPERIENCE</p>
            <h1>Replay <span>Lab</span></h1>
            <p class="replay-lede">A moment is more than a frame. Explore a bounded timeline, inspect its events, and move the playhead to see how the scene changes.</p>
        </div>
        <div class="replay-state" role="status">
            <span class="status-dot"></span>
            ILLUSTRATIVE FIXTURE
        </div>
    </header>

    <section class="replay-disclaimer" aria-label="Prototype status">
        <strong>DEMO DATA — NOT YET CONNECTED TO PHYSICS WORLD REPLAY</strong>
        <p>This interactive scene is a local, deterministic presentation fixture. The Physics repository has tested model-level replay and fork-aware route coordination, but this browser scene does not consume a Physics checkpoint or reconstruct a physical world.</p>
    </section>

    <section class="replay-workbench" aria-label="Interactive timeline demonstration">
        <div class="scene-topline">
            <div><span class="scene-label">SCENE / 001</span><h2>The passing signal</h2></div>
            <div class="tick-readout"><span>SELECTED TICK</span><strong>@CurrentTick.ToString("000")</strong></div>
        </div>

        <div class="replay-scene" aria-label="@($"Illustrative scene at tick {CurrentTick}")">
            <div class="scene-grid" aria-hidden="true"></div>
            <div class="scene-orbit orbit-one" aria-hidden="true"></div>
            <div class="scene-orbit orbit-two" aria-hidden="true"></div>
            <div class="scene-star star-one" aria-hidden="true"></div>
            <div class="scene-star star-two" aria-hidden="true"></div>
            <div class="scene-star star-three" aria-hidden="true"></div>
            <div class="scene-planet"></div>
            <div class="scene-signal" style="@($"--signal-x:{SignalX}%;--signal-y:{SignalY}%;")">
                <span class="signal-core"></span><span class="signal-trail"></span>
            </div>
            <div class="scene-caption">
                <span>FIXTURE STATE</span>
                <strong>@CurrentEvent.Title</strong>
                <small>@CurrentEvent.Description</small>
            </div>
            <div class="scene-coordinates">X @SignalX.ToString("000") / Y @SignalY.ToString("000")</div>
        </div>

        <div class="timeline-panel">
            <div class="timeline-head">
                <span>HISTORY WINDOW</span>
                <span>000 — 100 TICKS</span>
            </div>
            <div class="timeline-track-wrap">
                <div class="timeline-track" aria-hidden="true"></div>
                @foreach (var marker in Events)
                {
                    <button class="timeline-marker @(CurrentTick >= marker.Tick ? "reached" : "") @(CurrentEvent.Tick == marker.Tick ? "selected" : "")"
                            style="@($"left:{marker.Tick}%;")"
                            title="@($"{marker.Title}, tick {marker.Tick}")"
                            aria-label="@($"Jump to {marker.Title}, tick {marker.Tick}")"
                            @onclick="() => SetTick(marker.Tick)">
                        <span></span>
                    </button>
                }
                <input class="timeline-slider" type="range" min="0" max="100" step="1" value="@CurrentTick"
                       aria-label="Scrub illustrative timeline" aria-valuetext="@($"Tick {CurrentTick}: {CurrentEvent.Title}")"
                       @oninput="OnScrub" />
            </div>
            <div class="timeline-labels"><span>START · 000</span><span>HIGHLIGHT · 060</span><span>END · 100</span></div>
            <div class="timeline-controls">
                <button class="replay-control secondary" @onclick="StepBack" disabled="@(CurrentTick == 0)" aria-label="Previous tick">− 1 TICK</button>
                <button class="replay-control primary" @onclick="TogglePlayback">@(_isPlaying ? "Ⅱ PAUSE" : "▶ PLAY")</button>
                <button class="replay-control secondary" @onclick="StepForward" disabled="@(CurrentTick == 100)" aria-label="Next tick">+ 1 TICK</button>
                <button class="replay-control secondary reset-control" @onclick="Reset">RESET</button>
            </div>
        </div>

        <div class="event-ledger">
            <div class="ledger-heading"><span>EVENT LEDGER</span><span>LOCAL FIXTURE / READ-ONLY</span></div>
            @foreach (var item in Events)
            {
                <button class="event-row @(CurrentEvent.Tick == item.Tick ? "active" : "")"
                        @onclick="() => SetTick(item.Tick)" aria-pressed="@(CurrentEvent.Tick == item.Tick)">
                    <span class="event-tick">@item.Tick.ToString("000")</span>
                    <span class="event-marker-dot"></span>
                    <span class="event-copy"><strong>@item.Title</strong><small>@item.Description</small></span>
                    <span class="event-action">JUMP ↗</span>
                </button>
            }
        </div>
    </section>

    <section class="replay-capabilities" aria-label="Implementation status">
        <article class="capability-card verified">
            <span class="capability-index">01 / VERIFIED IN PHYSICS</span>
            <h3>Model-level reconstruction</h3>
            <p>Single-segment replay, fork-aware route coordination, and a focused test using the repository's actual ConstantAccelerationSolver.</p>
            <a href="https://github.com/TrentBest/TheSingularityWorkshop.Physics/tree/development/Physics/Universe" target="_blank" rel="noopener noreferrer">INSPECT PHYSICS ↗</a>
        </article>
        <article class="capability-card pending">
            <span class="capability-index">02 / NOT YET INTEGRATED</span>
            <h3>Browser world adapter</h3>
            <p>This page does not yet load real solver checkpoints, physics-world snapshots, or portable scene history.</p>
            <span class="capability-unavailable">UNAVAILABLE IN THIS PROTOTYPE</span>
        </article>
        <article class="capability-card planned">
            <span class="capability-index">03 / PLANNED</span>
            <h3>Share and remix</h3>
            <p>Portable moments, share links, hosted playback, and branch/remix workflows need real end-to-end contracts first.</p>
            <span class="capability-unavailable">NOT IMPLEMENTED</span>
        </article>
    </section>
    <footer class="replay-footer">A visible experiment, not a claim of completed physics playback. No data is uploaded or shared by this page.</footer>
</main>

@code {
    private sealed record TimelineEvent(int Tick, string Title, string Description);
    private static readonly TimelineEvent[] Events =
    [
        new(0, "Signal enters", "A marker appears at the edge of the observation window."),
        new(24, "Course change", "The illustrative path bends toward the orbital field."),
        new(60, "Moment highlighted", "The selected instant is called out for closer inspection."),
        new(82, "Signal passes", "The marker continues beyond the highlighted moment."),
        new(100, "Window ends", "The local sample reaches its final tick.")
    ];

    private int CurrentTick { get; set; } = 60;
    private bool _isPlaying;
    private CancellationTokenSource? _playbackCancellation;

    private TimelineEvent CurrentEvent => Events.LastOrDefault(item => item.Tick <= CurrentTick) ?? Events[0];
    private int SignalX => 10 + (int)(CurrentTick * .78);
    private int SignalY => 48 - (int)(Math.Sin(CurrentTick / 100d * Math.PI * 2) * 24);

    private void OnScrub(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var tick))
            SetTick(tick);
    }

    private void SetTick(int tick)
    {
        CurrentTick = Math.Clamp(tick, 0, 100);
        if (CurrentTick >= 100)
            StopPlayback();
    }

    private void StepBack() => SetTick(CurrentTick - 1);
    private void StepForward() => SetTick(CurrentTick + 1);
    private void Reset()
    {
        StopPlayback();
        CurrentTick = 0;
    }

    private async Task TogglePlayback()
    {
        if (_isPlaying)
        {
            StopPlayback();
            return;
        }

        if (CurrentTick >= 100)
            CurrentTick = 0;

        _isPlaying = true;
        _playbackCancellation = new CancellationTokenSource();
        var token = _playbackCancellation.Token;
        try
        {
            while (!token.IsCancellationRequested && CurrentTick < 100)
            {
                await Task.Delay(100, token);
                if (token.IsCancellationRequested)
                    break;
                CurrentTick++;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when the visitor pauses or leaves the page.
        }
        finally
        {
            _isPlaying = false;
            _playbackCancellation?.Dispose();
            _playbackCancellation = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StopPlayback()
    {
        _playbackCancellation?.Cancel();
        _isPlaying = false;
    }

    public ValueTask DisposeAsync()
    {
        StopPlayback();
        _playbackCancellation?.Dispose();
        _playbackCancellation = null;
        return ValueTask.CompletedTask;
    }
}

