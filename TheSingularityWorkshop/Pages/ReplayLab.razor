.replay-lab{min-height:100vh;box-sizing:border-box;padding:clamp(1rem,4vw,3.5rem);background:radial-gradient(ellipse at 80% 5%,rgba(0,168,255,.1),transparent 30%),#020711;color:#eafaff;font-family:system-ui,sans-serif}
.replay-back{display:inline-block;color:#7c9ca9;text-decoration:none;font:700 .68rem Consolas,monospace;letter-spacing:.12em}.replay-back:hover,.replay-back:focus-visible{color:#00eaff}
.replay-header{max-width:1180px;margin:2rem auto 1.5rem;display:flex;justify-content:space-between;align-items:end;gap:1.5rem;flex-wrap:wrap}
