@page "/support"
@using Microsoft.JSInterop
@inject IJSRuntime JS
<PageTitle>Support & Contact</PageTitle>

<div class="container py-5">
    <header class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">Help keep the Workshop alive.</h1>
        <p class="lead text-muted">Voluntary support helps an independent software project keep building. There is no admission price and no required contribution.</p>
    </header>

    <div class="card p-4 shadow-lg mx-auto" style="max-width: 600px;">
        <div class="card-body text-center">

            <h2 class="h5 mb-4">Support the work</h2>
            <p class="mb-4">
                If this work has been useful or interesting, choose whatever amount feels right. PayPal handles the payment flow; the Workshop never asks for your payment credentials.
            </p>

            <div id="paypal-donate-button-container" class="my-4 p-3 border rounded" aria-live="polite">Preparing the donation gate…</div>

@code {
    private bool _donationInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _donationInitialized) return;
        _donationInitialized = true;
        await JS.InvokeVoidAsync("workshopPayments.renderDonation");
    }
}
            <div id="donation-celebration" class="alert alert-success mt-4" hidden aria-live="polite"><strong>✦ SIGNAL RECEIVED ✦</strong><div id="donation-celebration-detail" class="mt-2">Thank you. The Workshop has noticed your kindness.</div><div class="mt-2 fw-bold">THE WORKSHOP CONTINUES.</div></div>
            <p class="small text-muted">A donation supports development; it does not purchase access, ownership, or a promised feature.</p>
            <a href="mailto:thesingularityworkshop@gmail.com" class="btn btn-primary btn-lg mb-4">
                <span class="oi oi-envelope-closed" aria-hidden="true"></span> Email Support Now
            </a>
            <img src="/Images/TheSingularityWorkshopLogo.png"
                 alt="The Singularity Workshop Splash Logo"
                 class="img-fluid mb-4"
                 style="max-width: 400px; height: auto; border-radius: 10px; box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);" />

        </div>
    </div>

    <div class="mt-5 text-center">
        <h3 class="h6 text-muted">Legal Compliance Notice</h3>
        <p class="small text-muted">
            For terms and policies, please visit our dedicated pages:
            <a href="privacy-policy" class="text-decoration-none mx-2">Privacy Policy</a> |
            <a href="terms-of-service" class="text-decoration-none mx-2">Terms of Service</a>
        </p>
    </div>
</div>