@page "/support"
<PageTitle>Support & Contact</PageTitle>

<div class="container py-5">
    <header class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">Support & Contact</h1>
        <p class="lead text-muted">We're here to help you forge the future of logic.</p>
    </header>

    <div class="card p-4 shadow-lg mx-auto" style="max-width: 600px;">
        <div class="card-body text-center">

            <h2 class="h5 mb-4">Immediate Assistance</h2>
            <p class="mb-4">
                For technical questions regarding the FSM_API, partnership inquiries, or general support, please reach out directly via email.
            </p>

            <a href="mailto:thesingularityworkshop@gmail.com" class="btn btn-primary btn-lg mb-4">
                <span class="oi oi-envelope-closed" aria-hidden="true"></span> Email Support Now
            </a>
            <img src="/images/TheSingularityWorkshopLogo.png"
                 alt="The Singularity Workshop Splash Logo"
                 class="img-fluid mb-4"
                 style="max-width: 400px; height: auto; border-radius: 10px; box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);" />

        </div>
    </div>

    <div class="mt-5 text-center">
        <h3 class="h6 text-muted">Legal Compliance Notice</h3>
        <p class="small text-muted">
            For terms and policies, please visit our dedicated pages:
            <a href="privacy-policy" class="text-decoration-none mx-2">Privacy Policy</a> |
            <a href="terms-of-service" class="text-decoration-none mx-2">Terms of Service</a>
        </p>
    </div>
</div>