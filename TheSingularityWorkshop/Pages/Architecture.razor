splay:flex;gap:.8rem 1.2rem;flex-wrap:wrap;padding:.8rem 1rem 1rem;border-top:1px solid rgba(0,234,255,.12);color:#9eb7c2;font-size:.65rem}.plan-legend span{display:flex;align-items:center;gap:.4rem}.plan-legend i{display:inline-block;width:18px;height:3px}.legend-hinged{background:#ffcb70}.legend-sliding{background:#6ddcf2}.legend-pocket{border-top:2px dashed #6ddcf2}.legend-revolving{border:1px solid #ffcb70;border-radius:50%;width:10px!important;height:10px!important}.legend-window{background:#68e0cf}
