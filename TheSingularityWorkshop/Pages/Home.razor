.manifest-hub-description{max-width:75ch;margin:1.25rem 0 1.5rem;color:#c3d0d6;font-size:clamp(1rem,1.7vw,1.25rem);line-height:1.65}
.manifest-hub-actions{display:flex;gap:.8rem;flex-wrap:wrap}
.manifest-hub-action{display:inline-flex;align-items:center;justify-content:center;min-height:3.7rem;padding:.8rem 1.5rem;border-radius:.8rem;border:1px solid rgba(0,234,255,.5);background:linear-gradient(135deg,rgba(0,234,255,.18),rgba(0,168,255,.08));color:#fff;text-decoration:none;font:900 .95rem Consolas,'Courier New',monospace;letter-spacing:.1em;transition:transform .2s ease,box-shadow .2s ease}
.manifest-hub-action:hover{transform:translateY(-2px);box-shadow:0 12px 35px rgba(0,234,255,.14)}
.manifest-hub-secondary{border-color:rgba(255,255,255,.18);background:rgba(255,255,255,.04)}
.manifest-hub-note{margin-top:1rem;color:#718792;font-size:.75rem;line-height:1.5}
.manifest-deep-dive{margin-top:1rem;padding:clamp(1.25rem,3vw,2.5rem);border:1px solid rgba(255,211,77,.28);border-radius:1rem;background:linear-gradient(135deg,rgba(255,211,77,.06),rgba(3,8,17,.92))}.manifest-deep-dive h2{margin:.7rem 0;color:#fff;font-size:clamp(1.5rem,3vw,2.4rem);letter-spacing:.02em}.manifest-deep-dive p{max-width:70ch;color:#9fb0b8;line-height:1.7}
@@keyframes hubPulse{0%,100%{transform:scale(.8);opacity:.25}50%{transform:scale(1);opacity:.55}}
@@keyframes hubDot{0%,100%{transform:scale(.8);opacity:.55}50%{transform:scale(1.25);opacity:1}}
.landing-stage{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1.2rem;overflow:hidden;background:radial-gradient(circle at 50% 42%,rgba(0,234,255,.09),transparent 35%),#020711}
.landing-aura{position:absolute;width:60vw;height:60vw;border:1px solid rgba(0,234,255,.08);border-radius:50%;box-shadow:0 0 100px rgba(0,234,255,.04);pointer-events:none}
.workshop-running-surface{position:absolute;inset:0;min-width:0;min-height:0;overflow:hidden;background:#020711}
.workshop-running-hub{position:absolute;inset:0;min-width:0;min-height:0;overflow:auto}
.workshop-running-hub .manifest-hub{position:relative;inset:auto;min-height:100%;box-sizing:border-box;align-items:center;padding:clamp(5rem,10vh,7rem) clamp(1rem,5vw,5rem) 3rem}
.workshop-running-hub .manifest-hub-shell{width:min(1180px,100%);margin:auto}
.workshop-running-hub .manifest-hub-header{display:none}
.manifest-hub-tabs{position:absolute;z-index:20;top:clamp(.7rem,2vw,1.5rem);left:clamp(.7rem,2vw,1.5rem);display:flex;gap:.35rem;max-width:calc(100% - 1.4rem);overflow-x:auto;padding:.35rem;border:1px solid rgba(0,234,255,.12);border-radius:0 0 1rem 0;background:rgba(2,7,17,.76);backdrop-filter:blur(16px)}
.manifest-hub-tab{position:relative;border:1px solid rgba(0,234,255,.18);border-radius:.55rem .55rem .15rem .15rem;padding:.65rem .9rem;background:rgba(0,234,255,.025);color:#7895a4;font:700 .72rem Consolas,'Courier New',monospace;letter-spacing:.12em;white-space:nowrap;cursor:pointer;transition:color .25s ease,border-color .25s ease,background .25s ease,transform .25s ease}
.manifest-hub-tab:hover{color:#fff;border-color:rgba(0,234,255,.6);transform:translateY(-2px)}
.manifest-hub-tab.active{color:#fff;border-color:#00eaff;background:linear-gradient(180deg,rgba(0,234,255,.18),rgba(0,234,255,.04));box-shadow:0 -2px 18px rgba(0,234,255,.12),inset 0 0 16px rgba(0,234,255,.06)}
.manifest-hub-tab.active::after{content:"";position:absolute;left:.7rem;right:.7rem;bottom:-1px;height:2px;background:#00eaff;box-shadow:0 0 10px #00eaff}
.manifest-hub-moniker{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;overflow:hidden;background:radial-gradient(ellipse at 50% 44%,rgba(0,234,255,.09),transparent 30%),radial-gradient(ellipse at 50% 78%,rgba(255,44,255,.045),transparent 42%),#020711}
.manifest-hub-moniker .first-contact-stage{background:transparent}
.manifest-hub-moniker .hello-glyph{font-size:clamp(2.3rem,8.5vw,8rem);letter-spacing:.035em}
.manifest-hub-arrival{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:.8rem;color:#83a5b4;font-size:.75rem;letter-spacing:.18em}
.manifest-hub-selected{position:relative;width:min(1000px,100%);margin:auto;animation:hubContentWake .75s cubic-bezier(.16,.84,.24,1) both}
.manifest-hub-selected .manifest-hub-card{border-radius:0 1.5rem 1.5rem 1.5rem}
.manifest-hub-support{max-width:780px;margin:auto;padding:clamp(1.5rem,5vw,4rem);border:1px solid rgba(255,211,77,.32);border-radius:0 1.5rem 1.5rem 1.5rem;background:radial-gradient(circle at 80% 15%,rgba(255,211,77,.09),transparent 36%),linear-gradient(145deg,rgba(10,25,38,.94),rgba(3,8,17,.96));box-shadow:0 30px 100px rgba(0,0,0,.4);animation:hubContentWake .75s cubic-bezier(.16,.84,.24,1) both}
.manifest-hub-support .support-kicker{color:#ffd34d;font-size:.7rem;letter-spacing:.22em}
.manifest-hub-support h2{margin:1rem 0;font-size:clamp(2rem,6vw,4.5rem);line-height:.95;letter-spacing:.02em}
.manifest-hub-support p{max-width:65ch;color:#b7c7cf;line-height:1.8}
.manifest-hub-support a{display:inline-flex;margin-top:1rem;padding:.9rem 1.2rem;border:1px solid rgba(255,211,77,.5);border-radius:.5rem;color:#fff;text-decoration:none;font:800 .8rem Consolas,'Courier New',monospace;letter-spacing:.12em;transition:transform .2s ease,box-shadow .2s ease}
.manifest-hub-support a:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(255,211,77,.12)}
@@keyframes hubContentWake{from{opacity:0;transform:translateY(18px) scale(.985);filter:blur(5px)}to{opacity:1;transform:translateY(0) scale(1);filter:none}}
@@media(max-width:700px){.workshop-running-hub .manifest-hub{padding:5.5rem 1rem 2rem}.manifest-hub-tabs{gap:.2rem}.manifest-hub-tab{padding:.6rem .65rem;font-size:.65rem}.manifest-hub-moniker .hello-glyph{font-size:clamp(1.8rem,10vw,4rem)}}
</style>

@code {
    private bool firstRender;
    private string _selectedHubTab = "MONIKER";

    private RenderFragment BuildRootGui()
    {
        return WorkshopGui.Panel(this)
            .Class("workshop-root").Style("position","absolute").Style("inset","0").Style("width","100%").Style("height","100%")
            .Style("min-height","0").Style("overflow","hidden").Style("background","#020711").Style("color","#fff")
            .Style("font-family","Consolas,'Courier New',monospace").Child(BuildExperienceContent()).Build();
    }

    private RenderFragment BuildExperienceContent() => builder =>
    {
        if (Experience.Manifest is null)
        {
            builder.OpenElement(0, "section");
            builder.AddAttribute(1, "class", "landing-stage");
            builder.OpenElement(2, "p");
            builder.AddAttribute(3, "role", "status");
            builder.AddContent(4, "COMPOSING WORKSHOP EXPERIENCE…");
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        if (FSM.CurrentState is PageFSM.FirstContactFirstLabel or PageFSM.FirstContactTransition or PageFSM.FirstContactSecondLabel)
        {
            var state = FSM.CurrentState;
            builder.OpenComponent<TheSingularityWorkshop.Components.FirstContactView>(0);
            builder.AddAttribute(1, "State", state switch
            {
                PageFSM.FirstContactFirstLabel => "FirstOnly",
                PageFSM.FirstContactTransition => "FirstFadingSecondComingIn",
                _ => "SecondOnly"
            });
            builder.AddAttribute(2, "StatementOpacity", state == PageFSM.FirstContactFirstLabel ? 1d : 0d);
            builder.AddAttribute(3, "QuestionOpacity", state == PageFSM.FirstContactSecondLabel ? 1d : state == PageFSM.FirstContactTransition ? 1d : 0d);
            builder.CloseComponent();
            return;
        }

        if (FSM.CurrentState == PageFSM.Gateway)
        {
            builder.OpenComponent<TheSingularityWorkshop.Components.FirstContactView>(0);
            builder.AddAttribute(1, "State", "Gateway");
            builder.AddAttribute(2, "OnEntryRequested", EventCallback.Factory.Create(this, EnterWorkshop));
            builder.CloseComponent();
            return;
        }

        if (FSM.CurrentState is PageFSM.NavigationArrival or PageFSM.Running)
        {
            builder.OpenElement(0, "section");
            builder.AddAttribute(1, "class", "workshop-running-surface");
            builder.OpenElement(2, "div");
            builder.AddAttribute(3, "class", "workshop-running-hub");
            if (FSM.CurrentState == PageFSM.Running)
            {
                BuildManifestHub(builder);
            }
            else
            {
                builder.OpenElement(4, "div");
                builder.AddAttribute(5, "class", "manifest-hub-arrival");
                builder.OpenElement(6, "span");
                builder.AddAttribute(7, "class", "manifest-hub-pulse");
                builder.CloseElement();
                builder.AddContent(8, "WORKSHOP HUB ARRIVING");
                builder.CloseElement();
            }
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        builder.OpenComponent<LivingGui>(0);
        builder.CloseComponent();
    };

    private async Task EnterWorkshop()
    {
        await JS.InvokeVoidAsync("interop.markWorkshopVisited");
        FSM.RequestEnter();
    }

    private void SelectHubTab(string tab)
    {
        if (string.Equals(_selectedHubTab, tab, StringComparison.OrdinalIgnoreCase))
            return;

        _selectedHubTab = tab;
        _ = InvokeAsync(StateHasChanged);
    }

    private void BuildManifestHub(RenderTreeBuilder builder)
    {
        var manifest = Experience.Manifest;
        if (manifest is null)
            return;

        builder.OpenElement(0, "section");
        builder.AddAttribute(1, "class", "manifest-hub");

        builder.OpenElement(2, "nav");
        builder.AddAttribute(3, "class", "manifest-hub-tabs");
        builder.AddAttribute(4, "aria-label", "Workshop experiences");

        var sequence = 10;
        RenderHubTab(builder, ref sequence, "MONIKER", "THE WORKSHOP", "MONIKER");
        foreach (var item in manifest.Hub)
            RenderHubTab(builder, ref sequence, item.Name.ToUpperInvariant(), item.Name.ToUpperInvariant(), item.Name);
        RenderHubTab(builder, ref sequence, "SUPPORT", "SUPPORT", "SUPPORT");
        builder.CloseElement();

        if (string.Equals(_selectedHubTab, "MONIKER", StringComparison.OrdinalIgnoreCase))
        {
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "manifest-hub-moniker");
            builder.OpenComponent<TheSingularityWorkshop.Components.FirstContactView>(sequence++);
            builder.AddAttribute(sequence++, "State", "Landing");
            builder.AddAttribute(sequence++, "MonikerComposition", Experience.MonikerComposition);
            builder.CloseComponent();
            builder.CloseElement();
        }
        else if (string.Equals(_selectedHubTab, "SUPPORT", StringComparison.OrdinalIgnoreCase))
        {
            builder.OpenElement(sequence++, "section");
            builder.AddAttribute(sequence++, "class", "manifest-hub-support");
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "support-kicker");
            builder.AddContent(sequence++, "A HUMAN POINT OF CONTACT");
            builder.CloseElement();
            builder.OpenElement(sequence++, "h2");
            builder.AddContent(sequence++, "SUPPORT THE WORKSHOP.");
            builder.CloseElement();
            builder.OpenElement(sequence++, "p");
            builder.AddContent(sequence++, "A living software workshop is built in the open, one experiment at a time. Explore the work, ask questions, and help shape what comes next.");
            builder.CloseElement();
            builder.OpenElement(sequence++, "a");
            builder.AddAttribute(sequence++, "href", "/about-us");
            builder.AddContent(sequence++, "MEET THE WORKSHOP");
            builder.CloseElement();
            builder.CloseElement();
        }
        else
        {
            var item = manifest.Hub.FirstOrDefault(x =>
                string.Equals(x.Name, _selectedHubTab, StringComparison.OrdinalIgnoreCase));
            if (item is not null)
            {
                builder.OpenElement(sequence++, "section");
                builder.AddAttribute(sequence++, "class", "manifest-hub-selected");
                builder.OpenElement(sequence++, "article");
                builder.AddAttribute(sequence++, "class", "manifest-hub-card");
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "manifest-hub-status");
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "manifest-hub-pulse");
                builder.CloseElement();
                builder.AddContent(sequence++, $"MANIFEST DESTINATION // {item.Kind.ToUpperInvariant()}");
                builder.CloseElement();

                builder.OpenElement(sequence++, "h2");
                builder.AddContent(sequence++, item.Name);
                builder.CloseElement();
                builder.OpenElement(sequence++, "p");
                builder.AddAttribute(sequence++, "class", "manifest-hub-description");
                builder.AddContent(sequence++, item.Description);
                builder.CloseElement();

                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "manifest-hub-actions");
                builder.OpenElement(sequence++, "a");
                builder.AddAttribute(sequence++, "class", "manifest-hub-action");
                builder.AddAttribute(sequence++, "href", item.Route ?? item.DeploymentUrl ?? item.AboutUrl);
                if (string.IsNullOrWhiteSpace(item.Route))
                {
                    builder.AddAttribute(sequence++, "target", "_blank");
                    builder.AddAttribute(sequence++, "rel", "noopener noreferrer");
                }
                builder.AddContent(sequence++, string.IsNullOrWhiteSpace(item.Route) ? "OPEN DESTINATION" : "ENTER EXPERIENCE");
                builder.CloseElement();
                builder.CloseElement();
                builder.CloseElement();
                builder.CloseElement();
            }
        }

        builder.CloseElement();
    }

    private void RenderHubTab(
        RenderTreeBuilder builder,
        ref int sequence,
        string key,
        string label,
        string selectedValue)
    {
        var isActive = string.Equals(_selectedHubTab, selectedValue, StringComparison.OrdinalIgnoreCase);
        builder.OpenElement(sequence++, "button");
        builder.AddAttribute(sequence++, "type", "button");
        builder.AddAttribute(sequence++, "class", isActive ? "manifest-hub-tab active" : "manifest-hub-tab");
        builder.AddAttribute(sequence++, "aria-pressed", isActive ? "true" : "false");
        builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => SelectHubTab(selectedValue)));
        builder.AddContent(sequence++, label);
        builder.CloseElement();
    }

    private string _lastRenderedPageState = string.Empty;

    protected override void OnInitialized()
    {
        _lastRenderedPageState = FSM.CurrentState;
        Experience.StateChanged += ExperienceChanged;
        FSM.StateChanged += PageStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || this.firstRender)
            return;

        this.firstRender = true;
        var returningVisitor = await JS.InvokeAsync<bool>("interop.workshopVisited");
        await Experience.InitializeAsync(returningVisitor);
    }

    private void ExperienceChanged()
        => _ = InvokeAsync(StateHasChanged);

    private void PageStateChanged(string stateName)
    {
        // PageFSM reports every heartbeat as well as transitions. Re-render this
        // parent only when the state used by BuildExperienceContent actually changes.
        var currentState = FSM.CurrentState;
        if (string.Equals(currentState, _lastRenderedPageState, StringComparison.Ordinal))
            return;

        _lastRenderedPageState = currentState;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Experience.StateChanged -= ExperienceChanged;
        FSM.StateChanged -= PageStateChanged;
    }
}