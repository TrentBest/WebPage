@page "/"
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject TheSingularityWorkshop.Services.WorkshopExperienceService Experience
@inject TheSingularityWorkshop.Services.FSMManagerService FSM
@inject TheSingularityWorkshop.Workshop.Composition.WorkshopExperienceCatalog ExperienceCatalog
@implements IDisposable
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Rendering
@using TheSingularityWorkshop.Services
@using TheSingularityWorkshop.Workshop.Gui
<PageTitle>The Singularity Workshop</PageTitle>

@BuildRootGui()

<style>
.manifest-moniker{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.15em;background:radial-gradient(circle at 50% 42%,rgba(0,234,255,.09),transparent 35%),#020711;color:#fff;font:900 clamp(2.8rem,9vw,8rem)/.86 Consolas,'Courier New',monospace;letter-spacing:.07em;text-align:center;text-shadow:0 0 24px rgba(0,234,255,.22);animation:manifestMonikerBreath 3.8s ease-in-out infinite}.manifest-moniker #the{color:#00a8ff}.manifest-moniker #singularity{color:#ff2cff}.manifest-moniker #workshop{color:#ff7a00}.manifest-moniker #moniker-composition{display:flex;flex-direction:column;align-items:center;gap:.15em}.manifest-moniker small{margin-top:1.2rem;font-size:clamp(.55rem,1vw,.8rem);letter-spacing:.18em;color:#617784}@@keyframes manifestMonikerBreath{0%,100%{transform:scale(.985)}50%{transform:scale(1.015)}}
.manifest-hub{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:clamp(1rem,4vw,4rem);overflow:hidden;overscroll-behavior:none;background:radial-gradient(circle at 18% 28%,rgba(0,168,255,.10),transparent 28%),radial-gradient(circle at 82% 72%,rgba(255,44,255,.07),transparent 30%),#020711}
.manifest-hub-shell{width:min(1100px,100%);display:grid;gap:clamp(1rem,2vw,2rem)}
.manifest-hub-header{display:flex;align-items:end;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.manifest-hub-kicker{font-size:clamp(.65rem,1.2vw,.9rem);letter-spacing:.2em;color:#6d8795}
.manifest-hub-title{margin:.25rem 0 0;font-size:clamp(2rem,6vw,5rem);line-height:.9;letter-spacing:.04em}
.manifest-hub-version{font-size:.7rem;letter-spacing:.14em;color:#536873}
.manifest-public-brief{border:1px solid rgba(255,44,255,.24);border-radius:1rem;padding:clamp(1.2rem,2.6vw,2rem);background:linear-gradient(120deg,rgba(0,168,255,.08),rgba(255,44,255,.045),rgba(3,8,17,.92));}.manifest-public-brief h2{margin:.65rem 0;color:#fff;font-size:clamp(1.45rem,3.3vw,2.5rem);line-height:1.05;}.manifest-public-brief p{max-width:78ch;color:#c3d0d6;line-height:1.65;margin:.8rem 0;}.manifest-public-brief .brief-status{color:#ffb15c;font-size:.68rem;letter-spacing:.15em;font-weight:800;}.manifest-public-brief .brief-flow{display:flex;gap:.55rem;align-items:center;flex-wrap:wrap;margin:1.1rem 0;color:#9bdfea;font-size:.72rem;letter-spacing:.07em;}.manifest-public-brief .brief-flow b{color:#ff2cff;}.manifest-public-brief .manifest-hub-actions{margin-top:1rem;}
.manifest-hub-tabs,.manifest-hub-tab{display:none!important}
.manifest-hub-moniker{position:fixed;inset:0;z-index:2;width:100vw;height:100dvh;box-sizing:border-box;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:0;background:radial-gradient(ellipse at 50% 48%,rgba(0,234,255,.09),transparent 30%),radial-gradient(ellipse at 50% 78%,rgba(255,44,255,.045),transparent 42%),#020711}
.manifest-hub-moniker .first-contact-stage{position:absolute;inset:0;background:transparent}
.manifest-hub-moniker .hub-moniker-panel{position:absolute;inset:0;width:100%;height:100%;padding:0;box-sizing:border-box}
.manifest-hub-moniker .hello-moniker{max-width:100%;transform:scale(.88);transform-origin:center center;margin-inline:auto}
.manifest-hub-moniker .hello-line{max-width:100%;justify-content:center}
.manifest-hub-moniker .hello-glyph{font-size:clamp(2rem,7.2vw,6.5rem);letter-spacing:.025em}
.manifest-hub-moniker .hello-glyph.glyph-red{color:#ff3030;text-shadow:0 0 10px rgba(255,48,48,.85),0 0 28px rgba(255,48,48,.4)}
.manifest-hub-moniker .hello-glyph.glyph-orange{color:#ff7a00;text-shadow:0 0 10px rgba(255,122,0,.85),0 0 28px rgba(255,122,0,.4)}
.manifest-hub-moniker .hello-glyph.glyph-yellow{color:#ffd34d;text-shadow:0 0 10px rgba(255,211,77,.85),0 0 28px rgba(255,211,77,.4)}
.manifest-hub-moniker .hello-glyph.glyph-green{color:#52e05a;text-shadow:0 0 10px rgba(82,224,90,.85),0 0 28px rgba(82,224,90,.4)}
.manifest-hub-moniker .hello-glyph.glyph-blue{color:#00a8ff;text-shadow:0 0 10px rgba(0,168,255,.85),0 0 28px rgba(0,168,255,.4)}
.manifest-hub-moniker .hello-glyph.glyph-magenta{color:#ff2cff;text-shadow:0 0 10px rgba(255,44,255,.85),0 0 28px rgba(255,44,255,.4)}
.manifest-hub-arrival{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:.8rem;color:#83a5b4;font-size:.75rem;letter-spacing:.18em}
.manifest-hub-selected{position:relative;width:min(1000px,100%);margin:auto;animation:hubContentWake .75s cubic-bezier(.16,.84,.24,1) both}
.manifest-hub-selected .manifest-hub-card{border-radius:0 1.5rem 1.5rem 1.5rem}
.manifest-hub-support{max-width:780px;margin:auto;padding:clamp(1.5rem,5vw,4rem);border:1px solid rgba(255,211,77,.32);border-radius:0 1.5rem 1.5rem 1.5rem;background:radial-gradient(circle at 80% 15%,rgba(255,211,77,.09),transparent 36%),linear-gradient(145deg,rgba(10,25,38,.94),rgba(3,8,17,.96));box-shadow:0 30px 100px rgba(0,0,0,.4);animation:hubContentWake .75s cubic-bezier(.16,.84,.24,1) both}
.manifest-hub-support .support-kicker{color:#ffd34d;font-size:.7rem;letter-spacing:.22em}
.manifest-hub-support h2{margin:1rem 0;font-size:clamp(2rem,6vw,4.5rem);line-height:.95;letter-spacing:.02em}
.manifest-hub-support p{max-width:65ch;color:#b7c7cf;line-height:1.8}
.manifest-hub-support a{display:inline-flex;margin-top:1rem;padding:.9rem 1.2rem;border:1px solid rgba(255,211,77,.5);border-radius:.5rem;color:#fff;text-decoration:none;font:800 .8rem Consolas,'Courier New',monospace;letter-spacing:.12em;transition:transform .2s ease,box-shadow .2s ease}
.manifest-hub-support a:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(255,211,77,.12)}
@@keyframes hubContentWake{from{opacity:0;transform:translateY(18px) scale(.985);filter:blur(5px)}to{opacity:1;transform:translateY(0) scale(1);filter:none}}
@@media(max-width:700px){.workshop-running-hub .manifest-hub{padding:5.5rem 1rem 2rem}.manifest-hub-tabs{gap:.2rem}.manifest-hub-tab{padding:.6rem .65rem;font-size:.65rem}.manifest-hub-moniker .hello-glyph{font-size:clamp(1.8rem,10vw,4rem)}}

.welcome-signal{position:absolute;z-index:5;left:50%;bottom:clamp(1.5rem,6vh,4.5rem);width:min(54rem,calc(100% - 2rem));transform:translateX(-50%);text-align:center;pointer-events:none;color:#c8dce5;animation:welcomeSignalArrival 1.2s cubic-bezier(.16,1,.3,1) both}
.welcome-signal .welcome-eyebrow{font-size:clamp(.55rem,1vw,.72rem);letter-spacing:.3em;color:#00eaff;text-shadow:0 0 16px rgba(0,234,255,.38);animation:welcomePulse 4.5s ease-in-out infinite}
.welcome-signal h1{margin:.8rem 0 .6rem;font:700 clamp(1.1rem,2.6vw,2rem)/1.1 Consolas,'Courier New',monospace;letter-spacing:.04em;color:#f4fbff;text-shadow:0 0 24px rgba(0,234,255,.12)}
.welcome-signal p{margin:0 auto;max-width:58ch;font:400 clamp(.72rem,1.15vw,.92rem)/1.65 system-ui,sans-serif;color:#9bb5c2}
@@keyframes welcomeSignalArrival{from{opacity:0;transform:translate(-50%,12px);filter:blur(6px)}to{opacity:1;transform:translate(-50%,0);filter:blur(0)}}
@@keyframes welcomePulse{0%,100%{opacity:.68;letter-spacing:.28em}50%{opacity:1;letter-spacing:.34em}}
@@media(max-height:600px){.welcome-signal{bottom:.8rem}.welcome-signal h1{margin:.35rem 0;font-size:1rem}.welcome-signal p{font-size:.68rem}}
@@media(prefers-reduced-motion:reduce){.welcome-signal,.welcome-signal .welcome-eyebrow{animation:none}}

</style>

@code {
    private bool firstRender;
    private string _selectedHubTab = "MONIKER";

    private RenderFragment BuildRootGui()
    {
        return WorkshopGui.Panel(this)
            .Class("workshop-root").Style("position","absolute").Style("inset","0").Style("width","100%").Style("height","100%")
            .Style("min-height","0").Style("overflow","hidden").Style("background","#020711").Style("color","#fff")
            .Style("font-family","Consolas,'Courier New',monospace").Child(BuildExperienceContent()).Build();
    }

    private RenderFragment BuildExperienceContent() => builder =>
    {
        if (Experience.Manifest is null)
        {
            builder.OpenElement(0, "section");
            builder.AddAttribute(1, "class", "landing-stage");
            builder.OpenElement(2, "p");
            builder.AddAttribute(3, "role", "status");
            builder.AddContent(4, "COMPOSING WORKSHOP EXPERIENCE…");
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        if (FSM.CurrentState is PageFSM.FirstContactFirstLabel or PageFSM.FirstContactTransition or PageFSM.FirstContactSecondLabel)
        {
            var state = FSM.CurrentState;
            builder.OpenComponent<TheSingularityWorkshop.Components.FirstContactView>(0);
            builder.AddAttribute(1, "State", state switch
            {
                PageFSM.FirstContactFirstLabel => "FirstOnly",
                PageFSM.FirstContactTransition => "FirstFadingSecondComingIn",
                _ => "SecondOnly"
            });
            builder.AddAttribute(2, "StatementOpacity", state == PageFSM.FirstContactFirstLabel ? 1d : 0d);
            builder.AddAttribute(3, "QuestionOpacity", state == PageFSM.FirstContactSecondLabel ? 1d : state == PageFSM.FirstContactTransition ? 1d : 0d);
            builder.CloseComponent();
            return;
        }

        if (FSM.CurrentState == PageFSM.Gateway)
        {
            builder.OpenComponent<TheSingularityWorkshop.Components.FirstContactView>(0);
            builder.AddAttribute(1, "State", "Gateway");
            builder.AddAttribute(2, "OnEntryRequested", EventCallback.Factory.Create(this, EnterWorkshop));
            builder.CloseComponent();
            return;
        }

        if (FSM.CurrentState is PageFSM.NavigationArrival or PageFSM.Running)
        {
            builder.OpenElement(0, "section");
            builder.AddAttribute(1, "class", "workshop-running-surface");
            builder.OpenElement(2, "div");
            builder.AddAttribute(3, "class", "workshop-running-hub");
            if (FSM.CurrentState == PageFSM.Running)
            {
                BuildManifestHub(builder);
            }
            else
            {
                builder.OpenElement(4, "div");
                builder.AddAttribute(5, "class", "manifest-hub-arrival");
                builder.OpenElement(6, "span");
                builder.AddAttribute(7, "class", "manifest-hub-pulse");
                builder.CloseElement();
                builder.AddContent(8, "WORKSHOP HUB ARRIVING");
                builder.CloseElement();
            }
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        builder.OpenComponent<LivingGui>(0);
        builder.CloseComponent();
    };

    private async Task EnterWorkshop()
    {
        await JS.InvokeVoidAsync("interop.markWorkshopVisited");
        FSM.RequestEnter();
    }

    private void SelectHubTab(string tab)
    {
        if (string.Equals(_selectedHubTab, tab, StringComparison.OrdinalIgnoreCase))
            return;

        _selectedHubTab = tab;
        _ = InvokeAsync(StateHasChanged);
    }

    private void BuildManifestHub(RenderTreeBuilder builder)
    {
        var manifest = Experience.Manifest;
        if (manifest is null)
            return;

        builder.OpenElement(0, "section");
        builder.AddAttribute(1, "class", "manifest-hub");

        var sequence = 10;
        // Navigation belongs to the persistent left Workshop rail, never a
        // second tab strip layered over the living moniker.
        if (string.Equals(_selectedHubTab, "MONIKER", StringComparison.OrdinalIgnoreCase))
        {
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "manifest-hub-moniker");
            builder.OpenComponent<TheSingularityWorkshop.Components.FirstContactView>(sequence++);
            builder.AddAttribute(sequence++, "State", "Landing");
            builder.AddAttribute(sequence++, "MonikerComposition", Experience.MonikerComposition);
            builder.CloseComponent();
            builder.CloseElement();
        }
        else if (string.Equals(_selectedHubTab, "WELCOME", StringComparison.OrdinalIgnoreCase))
        {
            builder.OpenElement(sequence++, "section");
            builder.AddAttribute(sequence++, "class", "welcome-signal");
            builder.AddAttribute(sequence++, "style", "position:relative;left:auto;bottom:auto;transform:none;");
            builder.AddAttribute(sequence++, "aria-label", "Welcome to The Singularity Workshop");
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "welcome-eyebrow");
            builder.AddContent(sequence++, "A LIVING WORKSHOP");
            builder.CloseElement();
            builder.OpenElement(sequence++, "h1");
            builder.AddContent(sequence++, "Ideas become systems. Systems become experiences.");
            builder.CloseElement();
            builder.OpenElement(sequence++, "p");
            builder.AddContent(sequence++, "Explore a growing workshop where explicit state and composable capabilities become living experiences across different environments.");
            builder.CloseElement();
            builder.CloseElement();
        }
        else if (string.Equals(_selectedHubTab, "SUPPORT", StringComparison.OrdinalIgnoreCase))
        {
            builder.OpenElement(sequence++, "section");
            builder.AddAttribute(sequence++, "class", "manifest-hub-support");
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "support-kicker");
            builder.AddContent(sequence++, "A HUMAN POINT OF CONTACT");
            builder.CloseElement();
            builder.OpenElement(sequence++, "h2");
            builder.AddContent(sequence++, "SUPPORT THE WORKSHOP.");
            builder.CloseElement();
            var support = manifest.Hub.FirstOrDefault(x =>
                string.Equals(x.Name, "Support", StringComparison.OrdinalIgnoreCase));
            builder.OpenElement(sequence++, "p");
            builder.AddContent(sequence++, support?.Description ?? "Find a human point of contact for the Workshop.");
            builder.CloseElement();
            builder.OpenElement(sequence++, "a");
            builder.AddAttribute(sequence++, "href", support?.Route ?? support?.AboutUrl ?? "/about-us");
            builder.AddContent(sequence++, "MEET THE WORKSHOP");
            builder.CloseElement();
            builder.CloseElement();
        }
        else
        {
            var item = manifest.Hub.FirstOrDefault(x =>
                string.Equals(x.Name, _selectedHubTab, StringComparison.OrdinalIgnoreCase));
            if (item is not null)
            {
                builder.OpenElement(sequence++, "section");
                builder.AddAttribute(sequence++, "class", "manifest-hub-selected");
                builder.OpenElement(sequence++, "article");
                builder.AddAttribute(sequence++, "class", "manifest-hub-card");
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "manifest-hub-status");
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "manifest-hub-pulse");
                builder.CloseElement();
                builder.AddContent(sequence++, $"MANIFEST DESTINATION // {item.Kind.ToUpperInvariant()}");
                builder.CloseElement();

                builder.OpenElement(sequence++, "h2");
                builder.AddContent(sequence++, item.Name);
                builder.CloseElement();
                builder.OpenElement(sequence++, "p");
                builder.AddAttribute(sequence++, "class", "manifest-hub-description");
                builder.AddContent(sequence++, item.Description);
                builder.CloseElement();

                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "manifest-hub-actions");
                builder.OpenElement(sequence++, "a");
                builder.AddAttribute(sequence++, "class", "manifest-hub-action");
                builder.AddAttribute(sequence++, "href", item.Route ?? item.DeploymentUrl ?? item.AboutUrl);
                if (string.IsNullOrWhiteSpace(item.Route))
                {
                    builder.AddAttribute(sequence++, "target", "_blank");
                    builder.AddAttribute(sequence++, "rel", "noopener noreferrer");
                }
                builder.AddContent(sequence++, string.IsNullOrWhiteSpace(item.Route) ? "OPEN DESTINATION" : "ENTER EXPERIENCE");
                builder.CloseElement();
                builder.CloseElement();
                builder.CloseElement();
                builder.CloseElement();
            }
        }

        builder.CloseElement();
    }

    private void RenderHubTab(
        RenderTreeBuilder builder,
        ref int sequence,
        string key,
        string label,
        string selectedValue)
    {
        var isActive = string.Equals(_selectedHubTab, selectedValue, StringComparison.OrdinalIgnoreCase);
        builder.OpenElement(sequence++, "button");
        builder.AddAttribute(sequence++, "type", "button");
        builder.AddAttribute(sequence++, "class", isActive ? "manifest-hub-tab active" : "manifest-hub-tab");
        builder.AddAttribute(sequence++, "aria-pressed", isActive ? "true" : "false");
        builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => SelectHubTab(selectedValue)));
        builder.AddContent(sequence++, label);
        builder.CloseElement();
    }

    private string _lastRenderedPageState = string.Empty;

    protected override void OnInitialized()
    {
        ApplyRequestedHubTab();
        Navigation.LocationChanged += HandleLocationChanged;
        _lastRenderedPageState = FSM.CurrentState;
        Experience.StateChanged += ExperienceChanged;
        FSM.StateChanged += PageStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || this.firstRender)
            return;

        this.firstRender = true;
        var returningVisitor = await JS.InvokeAsync<bool>("interop.workshopVisited");
        await Experience.InitializeAsync(returningVisitor);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        ApplyRequestedHubTab();
        _ = InvokeAsync(StateHasChanged);
    }

    private void ApplyRequestedHubTab()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var requestedTab = uri.Query
            .TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Split('=', 2))
            .Where(parts => parts.Length == 2
                && string.Equals(Uri.UnescapeDataString(parts[0].Replace('+', ' ')), "tab", StringComparison.OrdinalIgnoreCase))
            .Select(parts => Uri.UnescapeDataString(parts[1].Replace('+', ' ')))
            .FirstOrDefault();

        _selectedHubTab = string.Equals(requestedTab, "welcome", StringComparison.OrdinalIgnoreCase)
            ? "WELCOME"
            : "MONIKER";
    }

    private void ExperienceChanged()
        => _ = InvokeAsync(StateHasChanged);

    private void PageStateChanged(string stateName)
    {
        // PageFSM reports every heartbeat as well as transitions. Re-render this
        // parent only when the state used by BuildExperienceContent actually changes.
        var currentState = FSM.CurrentState;
        if (string.Equals(currentState, _lastRenderedPageState, StringComparison.Ordinal))
            return;

        _lastRenderedPageState = currentState;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Experience.StateChanged -= ExperienceChanged;
        FSM.StateChanged -= PageStateChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}