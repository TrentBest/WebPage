@page "/"
@inject IJSRuntime JS
@inject TheSingularityWorkshop.Services.WorkshopExperienceService Experience
@inject TheSingularityWorkshop.Services.FSMManagerService FSM
@inject TheSingularityWorkshop.Workshop.Composition.WorkshopExperienceCatalog ExperienceCatalog
@implements IDisposable
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Rendering
@using TheSingularityWorkshop.Services
@using TheSingularityWorkshop.Workshop.Gui
<PageTitle>The Singularity Workshop</PageTitle>

@BuildRootGui()

<style>
.manifest-moniker{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.15em;background:radial-gradient(circle at 50% 42%,rgba(0,234,255,.09),transparent 35%),#020711;color:#fff;font:900 clamp(2.8rem,9vw,8rem)/.86 Consolas,'Courier New',monospace;letter-spacing:.07em;text-align:center;text-shadow:0 0 24px rgba(0,234,255,.22);animation:manifestMonikerBreath 3.8s ease-in-out infinite}.manifest-moniker #the{color:#00a8ff}.manifest-moniker #singularity{color:#ff2cff}.manifest-moniker #workshop{color:#ff7a00}.manifest-moniker #moniker-composition{display:flex;flex-direction:column;align-items:center;gap:.15em}.manifest-moniker small{margin-top:1.2rem;font-size:clamp(.55rem,1vw,.8rem);letter-spacing:.18em;color:#617784}@@keyframes manifestMonikerBreath{0%,100%{transform:scale(.985)}50%{transform:scale(1.015)}}
.manifest-hub{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:clamp(1rem,4vw,4rem);overflow:auto;background:radial-gradient(circle at 18% 28%,rgba(0,168,255,.10),transparent 28%),radial-gradient(circle at 82% 72%,rgba(255,44,255,.07),transparent 30%),#020711}
.manifest-hub-shell{width:min(1100px,100%);display:grid;gap:clamp(1rem,2vw,2rem)}
.manifest-hub-header{display:flex;align-items:end;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.manifest-hub-kicker{font-size:clamp(.65rem,1.2vw,.9rem);letter-spacing:.2em;color:#6d8795}
.manifest-hub-title{margin:.25rem 0 0;font-size:clamp(2rem,6vw,5rem);line-height:.9;letter-spacing:.04em}
.manifest-hub-version{font-size:.7rem;letter-spacing:.14em;color:#536873}
.manifest-public-brief{border:1px solid rgba(255,44,255,.24);border-radius:1rem;padding:clamp(1.2rem,2.6vw,2rem);background:linear-gradient(120deg,rgba(0,168,255,.08),rgba(255,44,255,.045),rgba(3,8,17,.92));}.manifest-public-brief h2{margin:.65rem 0;color:#fff;font-size:clamp(1.45rem,3.3vw,2.5rem);line-height:1.05;}.manifest-public-brief p{max-width:78ch;color:#c3d0d6;line-height:1.65;margin:.8rem 0;}.manifest-public-brief .brief-status{color:#ffb15c;font-size:.68rem;letter-spacing:.15em;font-weight:800;}.manifest-public-brief .brief-flow{display:flex;gap:.55rem;align-items:center;flex-wrap:wrap;margin:1.1rem 0;color:#9bdfea;font-size:.72rem;letter-spacing:.07em;}.manifest-public-brief .brief-flow b{color:#ff2cff;}.manifest-public-brief .manifest-hub-actions{margin-top:1rem;}
.manifest-hub-tabs{display:flex;gap:.75rem;overflow:auto;padding:.25rem 0}
.manifest-hub-tab{border:1px solid rgba(0,234,255,.45);border-radius:999px;padding:.65rem 1.1rem;background:rgba(0,234,255,.08);color:#fff;font:700 .8rem Consolas,'Courier New',monospace;letter-spacing:.12em;white-space:nowrap}
.manifest-hub-card{position:relative;border:1px solid rgba(0,234,255,.18);border-radius:1.25rem;padding:clamp(1.25rem,3vw,2.5rem);background:linear-gradient(145deg,rgba(10,25,38,.94),rgba(3,8,17,.94));box-shadow:0 30px 100px rgba(0,0,0,.35);overflow:hidden}
.manifest-hub-card::before{content:"";position:absolute;inset:-50%;background:radial-gradient(circle,rgba(0,234,255,.07),transparent 35%);animation:hubPulse 5s ease-in-out infinite;pointer-events:none}
.manifest-hub-card>*{position:relative}
.manifest-hub-status{display:flex;align-items:center;gap:.6rem;font-size:.7rem;letter-spacing:.16em;color:#83a5b4}
.manifest-hub-pulse{width:.55rem;height:.55rem;border-radius:50%;background:#00eaff;box-shadow:0 0 16px #00eaff;animation:hubDot 1.8s ease-in-out infinite}
.manifest-hub-description{max-width:75ch;margin:1.25rem 0 1.5rem;color:#c3d0d6;font-size:clamp(1rem,1.7vw,1.25rem);line-height:1.65}
.manifest-hub-actions{display:flex;gap:.8rem;flex-wrap:wrap}
.manifest-hub-action{display:inline-flex;align-items:center;justify-content:center;min-height:3.7rem;padding:.8rem 1.5rem;border-radius:.8rem;border:1px solid rgba(0,234,255,.5);background:linear-gradient(135deg,rgba(0,234,255,.18),rgba(0,168,255,.08));color:#fff;text-decoration:none;font:900 .95rem Consolas,'Courier New',monospace;letter-spacing:.1em;transition:transform .2s ease,box-shadow .2s ease}
.manifest-hub-action:hover{transform:translateY(-2px);box-shadow:0 12px 35px rgba(0,234,255,.14)}
.manifest-hub-secondary{border-color:rgba(255,255,255,.18);background:rgba(255,255,255,.04)}
.manifest-hub-note{margin-top:1rem;color:#718792;font-size:.75rem;line-height:1.5}
.manifest-deep-dive{margin-top:1rem;padding:clamp(1.25rem,3vw,2.5rem);border:1px solid rgba(255,211,77,.28);border-radius:1rem;background:linear-gradient(135deg,rgba(255,211,77,.06),rgba(3,8,17,.92))}.manifest-deep-dive h2{margin:.7rem 0;color:#fff;font-size:clamp(1.5rem,3vw,2.4rem);letter-spacing:.02em}.manifest-deep-dive p{max-width:70ch;color:#9fb0b8;line-height:1.7}
@@keyframes hubPulse{0%,100%{transform:scale(.8);opacity:.25}50%{transform:scale(1);opacity:.55}}
@@keyframes hubDot{0%,100%{transform:scale(.8);opacity:.55}50%{transform:scale(1.25);opacity:1}}
.landing-stage{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1.2rem;overflow:hidden;background:radial-gradient(circle at 50% 42%,rgba(0,234,255,.09),transparent 35%),#020711}
.landing-aura{position:absolute;width:60vw;height:60vw;border:1px solid rgba(0,234,255,.08);border-radius:50%;box-shadow:0 0 100px rgba(0,234,255,.04);pointer-events:none}
.workshop-running-surface{position:absolute;inset:0;display:grid;grid-template-columns:minmax(180px,.72fr) minmax(0,1.28fr);min-width:0;min-height:0;overflow:hidden;background:#020711}
.workshop-running-moniker{position:relative;min-width:0;min-height:0;overflow:hidden;border-right:1px solid rgba(0,234,255,.2)}
.workshop-running-hub{position:relative;min-width:0;min-height:0;overflow:auto}
.workshop-running-hub .manifest-hub{position:relative;inset:auto;min-height:100%;box-sizing:border-box;align-items:flex-start}
.workshop-running-hub .manifest-hub-shell{width:100%}
@media(max-width:700px){.workshop-running-surface{grid-template-columns:minmax(0,1fr);grid-template-rows:minmax(150px,.48fr) minmax(0,1fr)}.workshop-running-moniker{border-right:0;border-bottom:1px solid rgba(0,234,255,.2)}.workshop-running-moniker .living-experience-panel{position:absolute;inset:0}}
</style>

@code {
    private bool firstRender;

    private RenderFragment BuildRootGui()
    {
        return WorkshopGui.Panel(this)
            .Class("workshop-root").Style("position","relative").Style("width","100%").Style("height","100%")
            .Style("min-height","100%").Style("overflow","hidden").Style("background","#020711").Style("color","#fff")
            .Style("font-family","Consolas,'Courier New',monospace").Child(BuildExperienceContent()).Build();
    }

    private RenderFragment BuildExperienceContent() => builder =>
    {
        if (Experience.Manifest is null)
        {
            builder.OpenElement(0, "section");
            builder.AddAttribute(1, "class", "landing-stage");
            builder.OpenElement(2, "p");
            builder.AddAttribute(3, "role", "status");
            builder.AddContent(4, "COMPOSING WORKSHOP EXPERIENCE…");
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        if (FSM.CurrentState == PageFSM.Gateway)
        {
            builder.OpenComponent<TheSingularityWorkshop.Components.FirstContactView>(0);
            builder.AddAttribute(1, "State", "Gateway");
            builder.AddAttribute(2, "OnEntryRequested", EventCallback.Factory.Create(this, EnterWorkshop));
            builder.CloseComponent();
            return;
        }

        if (FSM.CurrentState == PageFSM.Running)
        {
            builder.OpenElement(0, "section");
            builder.AddAttribute(1, "class", "workshop-running-surface");

            builder.OpenElement(2, "div");
            builder.AddAttribute(3, "class", "workshop-running-moniker");
            builder.OpenComponent<LivingGui>(4);
            builder.CloseComponent();
            builder.CloseElement();

            builder.OpenElement(5, "div");
            builder.AddAttribute(6, "class", "workshop-running-hub");
            BuildManifestHub(builder);
            builder.CloseElement();

            builder.CloseElement();
            return;
        }

        builder.OpenComponent<LivingGui>(0);
        builder.CloseComponent();
    };

    private async Task EnterWorkshop()
    {
        await JS.InvokeVoidAsync("interop.markWorkshopVisited");
        FSM.RequestEnter();
    }

    private void BuildManifestHub(RenderTreeBuilder builder)
    {
        var manifest = Experience.Manifest;
        if (manifest is null || manifest.Hub.Count == 0)
        {
            builder.OpenElement(0, "section");
            builder.AddAttribute(1, "class", "manifest-hub");
            builder.OpenElement(2, "div");
            builder.AddAttribute(3, "class", "manifest-hub-card");
            builder.OpenElement(4, "div");
            builder.AddContent(5, "THE WORKSHOP MANIFEST HAS NO HUB DESTINATIONS.");
            builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        builder.OpenElement(0, "section");
        builder.AddAttribute(1, "class", "manifest-hub");
        builder.OpenElement(2, "div");
        builder.AddAttribute(3, "class", "manifest-hub-shell");

        builder.OpenElement(4, "header");
        builder.AddAttribute(5, "class", "manifest-hub-header");
        builder.OpenElement(6, "div");
        builder.OpenElement(7, "div"); builder.AddAttribute(8, "class", "manifest-hub-kicker"); builder.AddContent(9, "THE SINGULARITY WORKSHOP // HUB"); builder.CloseElement();
        builder.OpenElement(10, "h1"); builder.AddAttribute(11, "class", "manifest-hub-title"); builder.AddContent(12, "WELCOME"); builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(13, "div"); builder.AddAttribute(14, "class", "manifest-hub-version"); builder.AddContent(15, $"MANIFEST {manifest.ManifestId} // {manifest.Version}"); builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(16, "section");
        builder.AddAttribute(17, "class", "manifest-public-brief");
        builder.OpenElement(18, "div");
        builder.AddAttribute(19, "class", "brief-status");
        builder.AddContent(20, "PUBLIC DEMONSTRATION // ACTIVE PROTOTYPE");
        builder.CloseElement();
        builder.OpenElement(21, "h2");
        builder.AddContent(22, "A public window into composable software.");
        builder.CloseElement();
        builder.OpenElement(23, "p");
        builder.AddContent(24, "The Singularity Workshop is an independent software laboratory exploring how complex applications can be assembled from small, reusable capabilities instead of being built as one inseparable block. This page is a working demonstration of that architecture—not a finished commercial product.");
        builder.CloseElement();
        builder.OpenElement(25, "div");
        builder.AddAttribute(26, "class", "brief-flow");
        builder.AddContent(27, "FSM_API — behavior and state");
        builder.OpenElement(28, "b"); builder.AddContent(29, "→"); builder.CloseElement();
        builder.AddContent(30, "FSM_COS — composition");
        builder.OpenElement(31, "b"); builder.AddContent(32, "→"); builder.CloseElement();
        builder.AddContent(33, "MICROBUNDLES — capabilities");
        builder.OpenElement(34, "b"); builder.AddContent(35, "→"); builder.CloseElement();
        builder.AddContent(36, "BROWSER EXPERIENCE");
        builder.CloseElement();
        builder.OpenElement(37, "p");
        builder.AddContent(38, "What you can verify here: a manifest-selected Workshop Experience, a MicroBundle dependency resolved through FSM_COS, and a living graphical demonstration driven by state-machine technology. Some browser lifecycle behavior is still transitional; the source and architecture pages distinguish working proof from ongoing migration.");
        builder.CloseElement();
        builder.OpenElement(39, "div");
        builder.AddAttribute(40, "class", "manifest-hub-actions");
        builder.OpenElement(41, "a");
        builder.AddAttribute(42, "class", "manifest-hub-action");
        builder.AddAttribute(43, "href", "/about-us");
        builder.AddContent(44, "HOW THE TECHNOLOGY WORKS");
        builder.CloseElement();
        builder.OpenElement(45, "a");
        builder.AddAttribute(46, "class", "manifest-hub-action manifest-hub-secondary");
        builder.AddAttribute(47, "href", "https://github.com/TrentBest/WebPage");
        builder.AddAttribute(48, "target", "_blank");
        builder.AddAttribute(49, "rel", "noopener noreferrer");
        builder.AddContent(50, "INSPECT THE SOURCE");
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(51, "nav");
        builder.AddAttribute(52, "class", "manifest-hub-tabs");
        var sequence = 60;
        foreach (var item in manifest.Hub)
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", "manifest-hub-tab");
            builder.AddContent(sequence++, item.Name.ToUpperInvariant());
            builder.CloseElement();
        }
        builder.CloseElement();

        foreach (var item in manifest.Hub)
        {
            builder.OpenElement(sequence++, "article");
            builder.AddAttribute(sequence++, "class", "manifest-hub-card");
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "manifest-hub-status");
            builder.OpenElement(sequence++, "span"); builder.AddAttribute(sequence++, "class", "manifest-hub-pulse"); builder.CloseElement();
            builder.AddContent(sequence++, $"MANIFEST DESTINATION // {item.Kind.ToUpperInvariant()}");
            builder.CloseElement();

            builder.OpenElement(sequence++, "h2"); builder.AddContent(sequence++, item.Name); builder.CloseElement();
            builder.OpenElement(sequence++, "p"); builder.AddAttribute(sequence++, "class", "manifest-hub-description"); builder.AddContent(sequence++, item.Description); builder.CloseElement();

            builder.OpenElement(sequence++, "div"); builder.AddAttribute(sequence++, "class", "manifest-hub-actions");
            builder.OpenElement(sequence++, "a");
            builder.AddAttribute(sequence++, "class", "manifest-hub-action");
            builder.AddAttribute(sequence++, "href", item.Route ?? item.DeploymentUrl ?? item.AboutUrl);
            if (string.IsNullOrWhiteSpace(item.Route))
            {
                builder.AddAttribute(sequence++, "target", "_blank");
                builder.AddAttribute(sequence++, "rel", "noopener noreferrer");
            }
            builder.AddContent(sequence++, string.IsNullOrWhiteSpace(item.Route) ? "OPEN DESTINATION" : "ENTER EXPERIENCE");
            builder.CloseElement();

            builder.OpenElement(sequence++, "a");
            builder.AddAttribute(sequence++, "class", "manifest-hub-action manifest-hub-secondary");
            builder.AddAttribute(sequence++, "href", item.AboutUrl);
            builder.AddContent(sequence++, "ABOUT THE WORKSHOP");
            builder.CloseElement();
            builder.CloseElement();

            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "manifest-hub-note");
            builder.AddContent(sequence++, string.IsNullOrWhiteSpace(item.Route)
                ? "This destination is externally hosted and opens only when the visitor chooses it."
                : "This destination is hosted by the Workshop and is composed from the Experience's MicroBundle hierarchy.");
            builder.CloseElement();
            builder.CloseElement();
        }

        var deepDiveName = manifest.DeepDive?.Experience;
        var deepDiveExperience = ExperienceCatalog.Experiences.FirstOrDefault(experience =>
            string.Equals(experience.Name, deepDiveName, StringComparison.OrdinalIgnoreCase));

        if (deepDiveExperience is not null)
        {
            builder.OpenElement(sequence++, "section");
            builder.AddAttribute(sequence++, "class", "manifest-deep-dive");
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "manifest-hub-kicker");
            builder.AddContent(sequence++, "AFTER THE EXPERIENCE // DEEP DIVE");
            builder.CloseElement();

            builder.OpenElement(sequence++, "h2");
            builder.AddContent(sequence++, $"SEE HOW {deepDiveExperience.Name} IS BUILT");
            builder.CloseElement();

            builder.OpenElement(sequence++, "p");
            builder.AddContent(sequence++,
                "Inspect the Experience identity, MicroBundle contract, ontology, declared dependencies, and the composition boundary.");
            builder.CloseElement();

            builder.OpenElement(sequence++, "a");
            builder.AddAttribute(sequence++, "class", "manifest-hub-action");
            builder.AddAttribute(sequence++, "href", $"/deep-dive/{deepDiveExperience.Id}");
            builder.AddContent(sequence++, "SHOW DEEP DIVE");
            builder.CloseElement();
            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();
    }

    protected override void OnInitialized()
    {
        Experience.StateChanged += ExperienceChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || this.firstRender)
            return;

        this.firstRender = true;
        var returningVisitor = await JS.InvokeAsync<bool>("interop.workshopVisited");
        await Experience.InitializeAsync(returningVisitor);
    }

    private void ExperienceChanged()
        => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Experience.StateChanged -= ExperienceChanged;
    }
}