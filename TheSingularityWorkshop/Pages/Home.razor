@page "/"
@implements IDisposable
@using TheSingularityWorkshop.Services
@inject FSMManagerService FSM

<PageTitle>The Singularity Workshop</PageTitle>

<div class="workshop-home" @onclick="RegisterActivity">
    @if (FSM.CurrentState == PageFSM.Gateway && !FSM.Context.EnterRequested)
    {
        <div class="gateway-interface">
            <button class="monolith-btn" @onclick:stopPropagation="true" @onclick="EnterLivingGui" aria-label="Enter Workshop">
                <span class="monolith-image"></span>
                <span class="monolith-text">Enter Workshop</span>
            </button>
        </div>
    }
    else
    {
        <div class="living-launch-stage">
            <LivingGui />
        </div>
    }

    <IdleExperienceHost @ref="_idleExperience" />
</div>

<style>
    .workshop-home { position:relative; width:100%; height:100%; min-height:100%; overflow:hidden; background:#03060a; }
    .gateway-interface,.living-launch-stage { position:absolute; inset:0; overflow:hidden; }
    .gateway-interface { z-index:20; display:grid; place-items:center; }
    .living-launch-stage { z-index:10; }
    .monolith-btn { position:relative; width:min(54vw,620px); height:min(54vh,620px); min-width:300px; min-height:300px; border:0; padding:0; background:transparent; cursor:pointer; color:#fff; }
    .monolith-image { position:absolute; left:50%; top:50%; width:min(42vw,480px); height:min(42vw,480px); transform:translate(-50%,-50%); border-radius:50%; background:radial-gradient(circle at 50% 42%,rgba(255,255,255,.08),rgba(0,0,0,.88) 64%,#000 100%); box-shadow:0 0 18px rgba(0,168,255,.35),0 0 60px rgba(255,44,255,.18),inset 0 0 30px rgba(255,255,255,.08); }
    .monolith-text { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); z-index:2; font:900 clamp(2rem,5vw,4rem)/1 Consolas,"Courier New",monospace; letter-spacing:.04em; white-space:nowrap; text-shadow:0 0 12px rgba(255,255,255,.9),0 0 32px rgba(0,168,255,.65); animation:titleBreath 4s ease-in-out infinite; }
    .workshop-warning { position:absolute; left:50%; bottom:4%; transform:translateX(-50%); width:min(760px,80%); box-sizing:border-box; padding:.8rem 1rem; border:1px solid rgba(255,122,0,.42); background:rgba(3,6,10,.78); color:#ffca91; font:600 .7rem/1.45 Consolas,"Courier New",monospace; text-align:center; }
    .warning-mark { color:#ff7a00; font-size:1rem; }.warning-body { display:block; margin-top:.45rem; font-size:clamp(.58rem,.9vw,.72rem); line-height:1.55; letter-spacing:.025em; }.warning-final { color:#ffb15c; font-weight:700; }
    @@keyframes fadeIn { from{opacity:0} to{opacity:1} } @@keyframes gridDrift { from{background-position:0 0,0 0} to{background-position:44px 44px,44px 44px} } @@keyframes scanSweep { 0%,100%{transform:translateY(0)} 50%{transform:translateY(620%)} } @@keyframes orbitPulse { 0%,100%{opacity:.35;transform:rotateX(66deg) rotateZ(-16deg) scale(.98)} 50%{opacity:.75;transform:rotateX(66deg) rotateZ(-16deg) scale(1.02)} } @@keyframes signalBlink { 0%,100%{opacity:.25;transform:scale(.8)} 50%{opacity:1;transform:scale(1.4)} } @@keyframes heroSweep { 0%,68%,100%{transform:translateX(-110%)} 82%{transform:translateX(110%)} } @@keyframes titleBreath { 0%,100%{transform:translate(-50%,-50%) scale(.985);filter:brightness(.95)} 50%{transform:translate(-50%,-50%) scale(1.015);filter:brightness(1.12)} } @@keyframes energyPulse { 0%,100%{transform:scale(.88);opacity:.35} 50%{transform:scale(1.05);opacity:.75} } @@keyframes fracturePulse { from{opacity:.6} to{opacity:1} } @@keyframes fractureDraw { to{stroke-dashoffset:0} } @@keyframes sparkFlicker { from{opacity:.45} to{opacity:1} }
    @@media(max-width:700px){.monolith-btn{width:76%;height:44%;min-width:240px}.monolith-image{width:min(48vw,34vh);height:min(48vw,34vh)}.monolith-text{font-size:clamp(1.55rem,7vw,3.2rem)}.workshop-warning{width:88%;padding:.7rem .8rem}.warning-body{font-size:.58rem}}
</style>

@code {
    private IdleExperienceHost? _idleExperience;

    private void EnterLivingGui() => FSM.RequestEnter();

    private void RegisterActivity()
    {
        _idleExperience?.RegisterActivity();
    }

    private void HandleFSMStateChanged(string state)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        FSM.StateChanged += HandleFSMStateChanged;
    }

    public void Dispose()
    {
        FSM.StateChanged -= HandleFSMStateChanged;
    }
}
