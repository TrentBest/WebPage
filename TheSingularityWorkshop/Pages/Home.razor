@page "/"
@using System.Timers
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>The Singularity Workshop</PageTitle>

<div class="workshop-portal">
    <div class="circuit-field" aria-hidden="true"></div>
    <div class="ambient-core" aria-hidden="true"></div>
    <div class="scanline-field" aria-hidden="true"></div>

    @* --- LAYER 1: THE SOVEREIGN KERNEL (Silently Booting) --- *@
    <div class="unity-layer" style="pointer-events: @(currentPhase == AppPhase.Gateway || currentPhase == AppPhase.Sovereign ? "all" : "none"); opacity: @(currentPhase == AppPhase.Gateway || currentPhase == AppPhase.Sovereign ? "1" : "0");">
        <canvas id="unity-canvas"></canvas>
    </div>

    @* --- LAYER 2: THE CHAOS SWARM & MONOLITH --- *@
    @if (currentPhase == AppPhase.Monolith || currentPhase == AppPhase.Chaos || currentPhase == AppPhase.Collapsing)
    {
        <div class="chaos-container @(currentPhase == AppPhase.Collapsing ? "gravity-failure" : "")">
            @if (currentPhase == AppPhase.Monolith)
            {
                <div class="portal-stack">
                    <button class="monolith-btn" @onclick="ShatterMonolith" aria-label="Enter The Singularity Workshop">
                        <span class="portal-image"></span>
                        <span class="monolith-text">ENTER THE WORKSHOP</span>
                        <span class="portal-corner corner-tl"></span>
                        <span class="portal-corner corner-tr"></span>
                        <span class="portal-corner corner-bl"></span>
                        <span class="portal-corner corner-br"></span>
                    </button>

                    <div class="system-advisory">
                        <div class="advisory-header">
                            <span class="advisory-icon">⚠</span>
                            <span>SYSTEM ADVISORY: MAXIMUM OVERDRIVE ACTIVE</span>
                            <span class="advisory-icon">⚠</span>
                        </div>
                        <div class="advisory-copy">
                            You are transitioning from Blazor WASM UI logic straight into a WebGL Unity engine build.<br />
                            Both domains are aggressively driven by the same featherweight, pure C# <strong>50kb FSM_API</strong> —<br />
                            fully agnostic and backwards-compatible down to legacy frameworks.<br />
                            <span class="advisory-joke">Viewer discretion and spare RAM advised.</span>
                        </div>
                    </div>
                </div>
            }

            @if (currentPhase == AppPhase.Chaos || currentPhase == AppPhase.Collapsing)
            {
                @foreach (var node in activeNodes)
                {
                    <button class="chaos-node" style="left: @(node.X)px; top: @(node.Y)px; width: @(node.Size)px; height: @(node.Size)px; z-index: @node.Generation;">
                        <div class="node-gen">GEN @node.Generation</div>
                        <div class="node-lineage">[@node.Lineage]</div>
                    </button>
                }
            }
        </div>
    }

    @* --- LAYER 3: THE POST-COLLAPSE GATEWAY --- *@
    @if (currentPhase == AppPhase.Gateway)
    {
        <div class="gateway-interface">
            <div class="gateway-glow"></div>
            <div class="kernel-status">
                <span class="kernel-pulse">◉</span>
                <h2>SOVEREIGN KERNEL ACTIVE</h2>
                <p>
                    DOM Authority Terminated. GPU Render Pipeline Online.<br />
                    Select your destination trajectory.
                </p>
            </div>

            <div class="gateway-paths">
                <button class="gateway-btn active-path" @onclick="EnterShowcase">
                    <span class="gateway-kicker">TRAJECTORY 01</span>
                    <h3>THE SHOWCASE</h3>
                    <span>Explore the Architectural Demonstrations</span>
                </button>

                <button class="gateway-btn locked-path" disabled title="Infrastructure actively being built">
                    <span class="gateway-kicker">TRAJECTORY 02</span>
                    <h3>THE FORGE</h3>
                    <span>[ UNDER CONSTRUCTION ]</span>
                </button>
            </div>
        </div>
    }
</div>

@code {
    private enum AppPhase { Monolith, Chaos, Collapsing, Gateway, Sovereign }
    private AppPhase currentPhase = AppPhase.Monolith;

    private sealed class ChaosNode
    {
        public double X { get; set; }
        public double Y { get; set; }
        public double Size { get; set; }
        public int Generation { get; set; }
        public string Lineage { get; set; } = "";
        public int OffspringCount { get; set; }
    }

    private readonly List<ChaosNode> activeNodes = new();
    private readonly Timer chaosTimer = new();
    private readonly Random rng = new();

    private const int CriticalMassThreshold = 100;

    protected override void OnInitialized()
    {
        chaosTimer.Interval = 100;
        chaosTimer.Elapsed += TickChaos;
    }

    private async Task ShatterMonolith()
    {
        currentPhase = AppPhase.Chaos;
        activeNodes.Add(new ChaosNode { X = 800, Y = 400, Size = 200, Generation = 1, Lineage = "1" });
        StateHasChanged();

        chaosTimer.Start();

        try
        {
            await JS.InvokeVoidAsync("interop.initUnity", "unity-canvas");
        }
        catch
        {
            // The visual transition must remain usable even when Unity is unavailable.
        }
    }

    private void TickChaos(object? sender, ElapsedEventArgs e)
    {
        if (currentPhase != AppPhase.Chaos) return;

        List<ChaosNode> newborns = new();

        foreach (var node in activeNodes)
        {
            node.Size += 10;

            if (node.Size > 180)
            {
                node.Size = 60;
                node.OffspringCount++;

                newborns.Add(new ChaosNode
                {
                    X = node.X + rng.Next(-200, 200),
                    Y = node.Y + rng.Next(-200, 200),
                    Generation = node.Generation + 1,
                    Lineage = $"{node.Lineage}.{node.OffspringCount}",
                    Size = 60
                });
            }
        }

        if (newborns.Count > 0)
        {
            activeNodes.AddRange(newborns);

            foreach (var node in activeNodes)
            {
                if (node.X < 100) node.X = 150;
                if (node.X > 1800) node.X = 1700;
                if (node.Y < 100) node.Y = 150;
                if (node.Y > 900) node.Y = 800;
            }
        }

        if (activeNodes.Count >= CriticalMassThreshold)
        {
            _ = TriggerCollapse();
        }
        else
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task TriggerCollapse()
    {
        chaosTimer.Stop();
        currentPhase = AppPhase.Collapsing;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(1500);

        currentPhase = AppPhase.Gateway;
        await InvokeAsync(StateHasChanged);
    }

    private void EnterShowcase()
    {
        currentPhase = AppPhase.Sovereign;
    }

    public void Dispose()
    {
        chaosTimer.Stop();
        chaosTimer.Dispose();
    }
}
