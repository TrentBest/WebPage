</style>

@code {
    private bool _runtimeDiagnosticsOpen;
    private int _runtimeObservationRefresh;
    private bool firstRender;
    private bool _entryRequested;
    private bool _explicitHubRouteRequested;
    private string _selectedHubTab = "MONIKER";
    private string? _selectedDemonstrationId;

    private RenderFragment BuildRuntimeObservationPanel() => builder =>
    {
        // This panel reads the canonical FSM observation snapshot. It is deliberately
        // user-refreshable rather than subscribing to every heartbeat/population tick.
        var observation = FSM.Observation;
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "class", "runtime-observation-toggle");
        builder.AddAttribute(3, "aria-expanded", _runtimeDiagnosticsOpen.ToString().ToLowerInvariant());
        builder.AddAttribute(4, "aria-controls", "runtime-observation-panel");
        builder.AddAttribute(5, "onclick", EventCallback.Factory.Create(this, ToggleRuntimeObservation));
        builder.AddContent(6, _runtimeDiagnosticsOpen ? "CLOSE RUNTIME OBSERVATION" : "RUNTIME OBSERVATION");
        builder.CloseElement();

        if (!_runtimeDiagnosticsOpen)
            return;

        builder.OpenElement(7, "aside");
        builder.AddAttribute(8, "id", "runtime-observation-panel");
        builder.AddAttribute(9, "class", "runtime-observation-panel");
        builder.AddAttribute(10, "aria-label", "Live runtime observation snapshot");
        builder.OpenElement(11, "h2");
        builder.AddContent(12, "RUNTIME OBSERVATION");
        builder.CloseElement();
        builder.OpenElement(13, "p");
        builder.AddContent(14, "Point-in-time snapshot from the active PageFSM; refresh to sample again.");
        builder.CloseElement();
        builder.OpenElement(15, "dl");
        builder.AddAttribute(16, "class", "runtime-observation-grid");
        AddObservationRow(builder, 17, "Page state", observation.PageState);
        AddObservationRow(builder, 21, "Living GUI state", observation.LivingGuiState);
        AddObservationRow(builder, 25, "Active phase", observation.LivingGuiActivePhase);
        AddObservationRow(builder, 29, "Total ticks", observation.TotalTicks.ToString(System.Globalization.CultureInfo.InvariantCulture));
        AddObservationRow(builder, 33, "State ticks", observation.StateTicks.ToString(System.Globalization.CultureInfo.InvariantCulture));
        AddObservationRow(builder, 37, "Population", observation.PopulationCount.ToString(System.Globalization.CultureInfo.InvariantCulture));
        AddObservationRow(builder, 41, "Available slots", observation.AvailablePopulationSlots.ToString(System.Globalization.CultureInfo.InvariantCulture));
        AddObservationRow(builder, 45, "Page FSM valid", FormatObservationFlag(observation.PageFsmIsValid));
        AddObservationRow(builder, 49, "Living GUI valid", FormatObservationFlag(observation.LivingGuiIsValid));
        AddObservationRow(builder, 53, "Living GUI frozen", FormatObservationFlag(observation.LivingGuiFrozen));
        AddObservationRow(builder, 57, "Entry requested", FormatObservationFlag(observation.EnterRequested));
        AddObservationRow(builder, 61, "GUI populated", FormatObservationFlag(observation.LivingGuiPopulated));
        AddObservationRow(builder, 65, "Moniker ready", FormatObservationFlag(observation.MonikerReady));
        AddObservationRow(builder, 69, "Gravity released", FormatObservationFlag(observation.GravityReleased));
        AddObservationRow(builder, 73, "GUI fallen", FormatObservationFlag(observation.LivingGuiFallen));
        AddObservationRow(builder, 77, "Navigation ready", FormatObservationFlag(observation.NavigationReady));
        builder.CloseElement();
         builder.OpenElement(84, "div");
        builder.AddAttribute(85, "class", "runtime-observation-actions");
        builder.OpenElement(86, "button");
        builder.AddAttribute(87, "type", "button");
        builder.AddAttribute(88, "onclick", EventCallback.Factory.Create(this, RefreshRuntimeObservation));
        builder.AddContent(89, "REFRESH SNAPSHOT");
        builder.CloseElement();
        builder.OpenElement(90, "span");
        builder.AddContent(91, $"Sample {_runtimeObservationRefresh}");
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(92, "p");
        builder.AddAttribute(93, "class", "runtime-observation-source");
        builder.AddContent(94, "Observation only — does not imply that the manifest-selected RuntimeAssembly owns lifecycle execution.");
        builder.CloseElement();
        builder.CloseElement();
    };

    private static void AddObservationRow(RenderTreeBuilder builder, int sequence, string label, string value)
    {
        builder.OpenElement(sequence, "dt");
        builder.AddContent(sequence + 1, label);
        builder.CloseElement();
        builder.OpenElement(sequence + 2, "dd");
        builder.AddContent(sequence + 3, value);
        builder.CloseElement();
    }

    private static string FormatObservationFlag(bool value) => value ? "YES" : "NO";

    private void ToggleRuntimeObservation()
    {
        _runtimeDiagnosticsOpen = !_runtimeDiagnosticsOpen;
        StateHasChanged();
    }

    private void RefreshRuntimeObservation()
    {
        _runtimeObservationRefresh++;
        StateHasChanged();
    }

    private RenderFragment BuildRootGui()
    {
        return WorkshopGui.Panel(this)
            .Class("workshop-root").Style("position","absolute").Style("inset","0").Style("width","100%").Style("height","100%")
            .Style("min-height","0").Style("overflow","hidden").Style("background","#020711").Style("color","#fff")
            .Style("font-family","Consolas,'Courier New',monospace").Child(builder =>
            {
                builder.AddContent(0, BuildExperienceContent());
            }).Build();
    }

    private RenderFragment BuildExperienceContent() => builder =>
    {
        // Preserve the founder-established entry beat. The runtime may compose
        // behind this surface, but the visitor explicitly enters before the
        // PageFSM-driven living GUI / Moniker / hub sequence is presented.
        if (!_entryRequested)
        {
            builder.OpenElement(0, "section");
            builder.AddAttribute(1, "class", "entry-monolith-stage");
            builder.AddAttribute(2, "aria-label", "Enter The Singularity Workshop");
            builder.OpenElement(3, "button");
            builder.AddAttribute(4, "type", "button");
            builder.AddAttribute(5, "class", "entry-monolith-btn");
            builder.AddAttribute(6, "onclick", EventCallback.Factory.Create(this, EnterEntryScene));
            builder.AddAttribute(7, "aria-label", "Enter The Singularity Workshop");
            builder.OpenElement(8, "img");
            builder.AddAttribute(9, "class", "entry-monolith-image");
            builder.AddAttribute(10, "src", "/Images/TheSingularityWorkshopLogo.png");
            builder.AddAttribute(11, "alt", "The Singularity Workshop");
            builder.CloseElement();
            builder.OpenElement(12, "span");
            builder.AddAttribute(13, "class", "entry-monolith-label");
            builder.AddContent(14, "ENTER THE WORKSHOP");
            builder.CloseElement();
            builder.CloseElement();
            builder.OpenElement(15, "aside");
            builder.AddAttribute(16, "class", "entry-warning");
            builder.AddAttribute(17, "role", "note");
            builder.OpenElement(18, "div");
            builder.AddAttribute(19, "class", "entry-warning-header");
            builder.AddContent(20, "⚠ SYSTEM ADVISORY: MANIFEST-DRIVEN RUNTIME ⚠");
            builder.CloseElement();
            builder.OpenElement(21, "div");
            builder.AddAttribute(22, "class", "entry-warning-body");
            builder.AddContent(23, "You are entering a live browser experience assembled from declared capabilities. ");
            builder.OpenElement(24, "strong");
            builder.AddContent(25, "FSM_COS");
            builder.CloseElement();
            builder.AddContent(26, " composes the requested MicroBundles; the browser host presents the result. Some lifecycle paths remain transitional.");
            builder.CloseElement();
            if (!string.IsNullOrWhiteSpace(Experience.LastManifestError))
            {
                builder.OpenElement(27, "p");
                builder.AddAttribute(28, "class", "entry-composition-error");
                builder.AddAttribute(29, "role", "alert");
                builder.AddContent(30, "Experience composition failed: " + Experience.LastManifestError);
                builder.CloseElement();
            }
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        if (Experience.Manifest is null)
        {
            builder.OpenElement(0, "section");
            builder.AddAttribute(1, "class", "landing-stage");
            builder.OpenElement(2, "p");
            builder.AddAttribute(3, "role", "status");
            builder.AddContent(4, "COMPOSING WORKSHOP EXPERIENCE…");
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        if (FSM.CurrentState is PageFSM.FirstContactFirstLabel or PageFSM.FirstContactTransition or PageFSM.FirstContactSecondLabel)
        {
            var state = FSM.CurrentState;
            builder.OpenComponent<TheSingularityWorkshop.Components.FirstContactView>(0);
            builder.AddAttribute(1, "State", state switch
            {
                PageFSM.FirstContactFirstLabel => "FirstOnly",
                PageFSM.FirstContactTransition => "FirstFadingSecondComingIn",
                _ => "SecondOnly"
            });
            builder.AddAttribute(2, "StatementOpacity", state == PageFSM.FirstContactFirstLabel ? 1d : 0d);
            builder.AddAttribute(3, "QuestionOpacity", state == PageFSM.FirstContactSecondLabel ? 1d : state == PageFSM.FirstContactTransition ? 1d : 0d);
            builder.CloseComponent();
            return;
        }

        if (FSM.CurrentState == PageFSM.Gateway)
        {
            builder.OpenComponent<TheSingularityWorkshop.Components.FirstContactView>(0);
            builder.AddAttribute(1, "State", "Gateway");
            builder.AddAttribute(2, "OnEntryRequested", EventCallback.Factory.Create(this, EnterWorkshop));
            builder.CloseComponent();
            return;
        }

        if (FSM.CurrentState is PageFSM.GatewayExit
            or PageFSM.LivingGuiIgnition
            or PageFSM.LivingGuiPopulating
            or PageFSM.MonikerReveal
            or PageFSM.Gravity
            or PageFSM.LivingGuiDissipating
            or PageFSM.NavigationArrival
            or PageFSM.Running)
        {
            // Keep one LivingGui instance at one stable render-tree location from
            // ignition through hub arrival. Hub arrival adds navigation content;
            // it must not replace/remount the landing stage or dismiss its moniker.
            builder.OpenElement(0, "section");
            builder.AddAttribute(1, "class",
                string.Equals(_selectedHubTab, "MONIKER", StringComparison.OrdinalIgnoreCase)
                    ? "workshop-running-surface"
                    : "workshop-running-surface destination-selected");
            builder.OpenElement(2, "div");
            builder.AddAttribute(3, "class", "workshop-running-hub");
            builder.OpenComponent<LivingGui>(4);
            builder.CloseComponent();

            if (FSM.CurrentState is PageFSM.NavigationArrival or PageFSM.Running)
            {
                builder.OpenElement(11, "div");
                builder.AddAttribute(12, "class", "workshop-hub-overlay");
                builder.AddAttribute(13, "data-selected-hub-tab", _selectedHubTab);
                BuildManifestHub(builder);
                builder.CloseElement();
            }

            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        builder.OpenComponent<LivingGui>(0);
        builder.CloseComponent();
    };

    private async Task EnterEntryScene()
    {
        // The monolith is a presentation gate, not the FSM entry signal. Keep the
        // existing first-contact and gateway interaction after the visitor enters.
        _entryRequested = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task EnterWorkshop()
    {
        // The explicit gateway click is the authoritative entry signal. Advance the
        // PageFSM before the best-effort browser persistence write so a missing or
        // disconnected JS interop cannot strand the visitor at Gateway.
        FSM.RequestEnter();

        try
        {
            await JS.InvokeVoidAsync("interop.markWorkshopVisited");
        }
        catch (JSException)
        {
            // Remembering the visit improves the next load but must never own entry.
            // The current navigation proceeds through the FSM regardless.
        }
    }

    private void SelectHubTab(string tab)
    {
        if (string.Equals(_selectedHubTab, tab, StringComparison.OrdinalIgnoreCase))
            return;

        _selectedHubTab = tab;
        _ = InvokeAsync(StateHasChanged);
    }

    private void BuildManifestHub(RenderTreeBuilder builder)
    {
        var manifest = Experience.Manifest;
        if (manifest is null)
            return;

        var monikerSelected = string.Equals(
            _selectedHubTab, "MONIKER", StringComparison.OrdinalIgnoreCase);
        builder.OpenElement(0, "section");
        builder.AddAttribute(1, "class",
            monikerSelected ? "manifest-hub manifest-hub-moniker-host" : string.Equals(_selectedHubTab, "ECONOMY", StringComparison.OrdinalIgnoreCase) ? "manifest-hub manifest-hub-economy" : string.Equals(_selectedHubTab, "DIGITENS", StringComparison.OrdinalIgnoreCase) ? "manifest-hub manifest-hub-digitens" : "manifest-hub");

        // The landing Moniker is rendered by the continuously mounted LivingGui.
        // Keep the hub surface present but transparent until a visitor chooses a tab.
        if (monikerSelected)
        {
            builder.CloseElement();
            return;
        }

        var sequence = 10;
        // Navigation belongs to the persistent left Workshop rail, never a
        // second tab strip layered over the living moniker.
        if (string.Equals(_selectedHubTab, "DEMONSTRATIONS", StringComparison.OrdinalIgnoreCase))
        {
            BuildDemonstrations(builder, ref sequence);
        }
        else if (string.Equals(_selectedHubTab, "WELCOME", StringComparison.OrdinalIgnoreCase))
        {
            // Welcome is a hands-on Experience composed through the Workshop GUI builders.
            builder.OpenComponent<TheSingularityWorkshop.Components.WorkshopFloorplan>(sequence++);
            builder.CloseComponent();
        }
        else if (string.Equals(_selectedHubTab, "ECONOMY", StringComparison.OrdinalIgnoreCase))
        {
            builder.OpenElement(sequence++, "iframe");
            builder.AddAttribute(sequence++, "class", "economy-experience");
            builder.AddAttribute(sequence++, "src", "/economy/casino-floor.html");
            builder.AddAttribute(sequence++, "title", "Singularity Casino living economy experience");
            builder.AddAttribute(sequence++, "allow", "fullscreen");
            builder.CloseElement();
        }
        else if (string.Equals(_selectedHubTab, "DIGITENS", StringComparison.OrdinalIgnoreCase))
        {
            builder.OpenElement(sequence++, "iframe");
            builder.AddAttribute(sequence++, "class", "economy-experience");
            builder.AddAttribute(sequence++, "src", "/digitens/index.html");
            builder.AddAttribute(sequence++, "title", "Digitens: digital citizens of the Singularity World");
            builder.AddAttribute(sequence++, "allow", "fullscreen");
            builder.CloseElement();
        }
        else if (string.Equals(_selectedHubTab, "SUPPORT", StringComparison.OrdinalIgnoreCase))
        {
            builder.OpenElement(sequence++, "section");
            builder.AddAttribute(sequence++, "class", "manifest-hub-support");
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "support-kicker");
            builder.AddContent(sequence++, "A HUMAN POINT OF CONTACT");
            builder.CloseElement();
            builder.OpenElement(sequence++, "h2");
            builder.AddContent(sequence++, "SUPPORT THE WORKSHOP.");
            builder.CloseElement();
            var support = manifest.Hub.FirstOrDefault(x =>
                string.Equals(x.Name, "Support", StringComparison.OrdinalIgnoreCase));
            builder.OpenElement(sequence++, "p");
            builder.AddContent(sequence++, support?.Description ?? "Find a human point of contact for the Workshop.");
            builder.CloseElement();
            builder.OpenElement(sequence++, "a");
            builder.AddAttribute(sequence++, "href", support?.Route ?? support?.AboutUrl ?? "/about-us");
            builder.AddContent(sequence++, "MEET THE WORKSHOP");
            builder.CloseElement();
            builder.CloseElement();
        }
        else
        {
            var item = manifest.Hub.FirstOrDefault(x =>
                string.Equals(x.Name, _selectedHubTab, StringComparison.OrdinalIgnoreCase));
            if (item is not null)
            {
                builder.OpenElement(sequence++, "section");
                builder.AddAttribute(sequence++, "class", "manifest-hub-selected");
                builder.OpenElement(sequence++, "article");
                builder.AddAttribute(sequence++, "class", "manifest-hub-card");
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "manifest-hub-status");
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", "manifest-hub-pulse");
                builder.CloseElement();
                builder.AddContent(sequence++, $"MANIFEST DESTINATION // {item.Kind.ToUpperInvariant()}");
                builder.CloseElement();

                builder.OpenElement(sequence++, "h2");
                builder.AddContent(sequence++, item.Name);
                builder.CloseElement();
                builder.OpenElement(sequence++, "p");
                builder.AddAttribute(sequence++, "class", "manifest-hub-description");
                builder.AddContent(sequence++, item.Description);
                builder.CloseElement();

                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "manifest-hub-actions");
                builder.OpenElement(sequence++, "a");
                builder.AddAttribute(sequence++, "class", "manifest-hub-action");
                builder.AddAttribute(sequence++, "href", item.Route ?? item.DeploymentUrl ?? item.AboutUrl);
                if (string.IsNullOrWhiteSpace(item.Route))
                {
                    builder.AddAttribute(sequence++, "target", "_blank");
                    builder.AddAttribute(sequence++, "rel", "noopener noreferrer");
                }
                builder.AddContent(sequence++, string.IsNullOrWhiteSpace(item.Route) ? "OPEN DESTINATION" : "ENTER EXPERIENCE");
                builder.CloseElement();
                builder.CloseElement();
                builder.CloseElement();
                builder.CloseElement();
            }
        }

        builder.CloseElement();
