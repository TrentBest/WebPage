@page "/"
@using System.Timers
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>The Singularity Workshop</PageTitle>

<div class="hypervisor-shell">
    <div class="unity-layer" style="pointer-events: @(currentPhase == AppPhase.Gateway || currentPhase == AppPhase.Sovereign ? "all" : "none"); opacity: @(currentPhase == AppPhase.Gateway || currentPhase == AppPhase.Sovereign ? "1" : "0");">
        <canvas id="unity-canvas"></canvas>
    </div>

    @if (currentPhase == AppPhase.Monolith || currentPhase == AppPhase.Chaos || currentPhase == AppPhase.Collapsing)
    {
        <div class="chaos-container @(currentPhase == AppPhase.Collapsing ? "gravity-failure" : "")" style="display: block !important; position: absolute !important; inset: 0 !important;">
            @if (currentPhase == AppPhase.Monolith)
            {
                <div class="monolith-stage">
                    <div class="ambient-grid" aria-hidden="true"></div>
                    <div class="ambient-scan" aria-hidden="true"></div>
                    <div class="ambient-orbit ambient-orbit-one" aria-hidden="true"></div>
                    <div class="ambient-orbit ambient-orbit-two" aria-hidden="true"></div>
                    <div class="ambient-signal signal-one" aria-hidden="true"></div>
                    <div class="ambient-signal signal-two" aria-hidden="true"></div>
                    <div class="ambient-signal signal-three" aria-hidden="true"></div>

                    <button class="monolith-btn" @onclick="ShatterMonolith" aria-label="Enter The Singularity Workshop">
                        <span class="hero-corner hero-corner-tl" aria-hidden="true"></span>
                        <span class="hero-corner hero-corner-tr" aria-hidden="true"></span>
                        <span class="hero-corner hero-corner-bl" aria-hidden="true"></span>
                        <span class="hero-corner hero-corner-br" aria-hidden="true"></span>
                        <span class="hero-energy" aria-hidden="true"></span>
                        <img class="monolith-image" src="https://avatars.githubusercontent.com/u/16405167?v=4" alt="The Singularity Workshop" />
                        <span class="monolith-text">ENTER THE WORKSHOP</span>
                    </button>

                    <div class="workshop-warning" role="note">
                        <div class="warning-header">
                            <span class="warning-mark">⚠</span>
                            <span>SYSTEM ADVISORY: MAXIMUM OVERDRIVE ACTIVE</span>
                            <span class="warning-mark">⚠</span>
                        </div>
                        <div class="warning-body">
                            You are transitioning from Blazor WASM UI logic straight into a WebGL Unity engine build.<br />
                            Both domains are aggressively driven by the same featherweight, pure C# <strong>50kb FSM_API</strong> —<br />
                            fully agnostic and backwards-compatible down to legacy frameworks.<br />
                            <span class="warning-final">Viewer discretion and spare RAM advised.</span>
                        </div>
                    </div>
                </div>
            }

            @if (currentPhase == AppPhase.Chaos || currentPhase == AppPhase.Collapsing)
            {
                @foreach (var node in activeNodes)
                {
                    <button class="chaos-node" style="left: @(node.X.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))%; top: @(node.Y.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))%; width: @(node.Size)px; height: @(node.Size)px; z-index: @node.Generation; transform: translate(-50%, -50%);">
                        <div class="node-gen">GEN @node.Generation</div>
                        <div class="node-lineage">[@node.Lineage]</div>
                    </button>
                }
            }
        </div>
    }

    @if (currentPhase == AppPhase.Gateway)
    {
        <div class="gateway-interface">
            <div class="kernel-status mb-5 text-center">
                <span class="oi oi-pulse kernel-pulse"></span>
                <h2>SOVEREIGN KERNEL ACTIVE</h2>
                <p>DOM Authority Terminated. GPU Render Pipeline Online.<br />Select your destination trajectory.</p>
            </div>
            <div class="d-flex gap-4">
                <button class="btn gateway-btn active-path" @onclick="EnterShowcase">
                    <h3 class="mb-1">THE SHOWCASE</h3>
                    <span>Explore the Architectural Demonstrations</span>
                </button>
                <button class="btn gateway-btn locked-path" disabled title="Infrastructure actively being built">
                    <h3 class="mb-1">THE FORGE</h3>
                    <span>[ UNDER CONSTRUCTION ]</span>
                </button>
            </div>
        </div>
    }
</div>

<style>
    .hypervisor-shell {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 100%;
        overflow: hidden;
        background:
            radial-gradient(circle at 50% 44%, rgba(0, 234, 255, 0.08), transparent 30%),
            radial-gradient(circle at 28% 62%, rgba(255, 44, 255, 0.055), transparent 34%),
            #020711;
        color: white;
        font-family: 'Consolas', 'Courier New', monospace;
    }

    .unity-layer, .unity-layer canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
    }

    .unity-layer { z-index: 1; transition: opacity 1.5s ease-in; }

    .chaos-container {
        position: absolute;
        inset: 0;
        z-index: 10;
        overflow: hidden;
    }

    .monolith-stage {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: clamp(1rem, 2.5vh, 1.5rem);
        overflow: hidden;
        isolation: isolate;
        background:
            radial-gradient(ellipse at 50% 45%, rgba(0, 234, 255, 0.075), transparent 38%),
            radial-gradient(ellipse at 50% 80%, rgba(255, 44, 255, 0.045), transparent 42%),
            #020711;
    }

    .monolith-stage::before,
    .monolith-stage::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .monolith-stage::before {
        z-index: -2;
        opacity: 0.35;
        background-image:
            linear-gradient(rgba(0, 234, 255, 0.055) 1px, transparent 1px),
            linear-gradient(90deg, rgba(0, 234, 255, 0.055) 1px, transparent 1px);
        background-size: 44px 44px;
        transform: perspective(650px) rotateX(62deg) scale(1.8) translateY(18%);
        transform-origin: center bottom;
        animation: gridDrift 18s linear infinite;
    }

    .monolith-stage::after {
        z-index: -1;
        background:
            linear-gradient(90deg, #020711 0%, transparent 16%, transparent 84%, #020711 100%),
            linear-gradient(0deg, #020711 0%, transparent 14%, transparent 88%, #020711 100%),
            repeating-linear-gradient(0deg, rgba(255,255,255,0.012) 0, rgba(255,255,255,0.012) 1px, transparent 1px, transparent 5px);
        mix-blend-mode: screen;
    }

    .ambient-grid { position: absolute; inset: 0; z-index: -1; pointer-events: none; background: linear-gradient(90deg, transparent 0 9%, rgba(0, 234, 255, 0.08) 9.1%, transparent 9.2% 90.8%, rgba(0, 234, 255, 0.08) 90.9%, transparent 91%), linear-gradient(0deg, transparent 0 14%, rgba(255, 44, 255, 0.055) 14.1%, transparent 14.2% 85.8%, rgba(255, 44, 255, 0.055) 85.9%, transparent 85.8%, rgba(255, 44, 255, 0.055) 85.9%, transparent 86%); opacity: 0.7; }
    .ambient-scan { position: absolute; left: 0; right: 0; top: -15%; height: 18%; z-index: 0; pointer-events: none; background: linear-gradient(180deg, transparent, rgba(0, 234, 255, 0.055), transparent); filter: blur(3px); animation: scanSweep 8s ease-in-out infinite; }
    .ambient-orbit { position: absolute; width: min(70vw, 900px); height: min(70vw, 900px); border: 1px solid rgba(0, 234, 255, 0.09); border-radius: 50%; pointer-events: none; z-index: -1; animation: orbitPulse 7s ease-in-out infinite; }
    .ambient-orbit-one { transform: rotateX(66deg) rotateZ(-16deg); }
    .ambient-orbit-two { width: min(50vw, 650px); height: min(50vw, 650px); transform: rotateX(66deg) rotateZ(32deg); animation-delay: -2.5s; border-color: rgba(255, 44, 255, 0.08); }
    .ambient-signal { position: absolute; width: 7px; height: 7px; border-radius: 50%; background: #00eaff; box-shadow: 0 0 8px #00eaff, 0 0 22px rgba(0, 234, 255, 0.7); pointer-events: none; z-index: 0; animation: signalBlink 3s ease-in-out infinite; }
    .signal-one { left: 18%; top: 31%; }
    .signal-two { right: 17%; top: 57%; animation-delay: -1s; background: #ff2cff; box-shadow: 0 0 8px #ff2cff, 0 0 22px rgba(255, 44, 255, 0.7); }
    .signal-three { left: 31%; bottom: 14%; animation-delay: -2s; }

    .monolith-btn { position: relative; z-index: 5; width: 50%; height: 50%; min-width: 280px; min-height: 220px; padding: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; background: rgba(3, 10, 22, 0.72); border: 2px solid #00eaff; border-radius: 18px; cursor: pointer; box-shadow: 0 0 12px rgba(0, 234, 255, 0.5), 0 0 45px rgba(0, 234, 255, 0.14), inset 0 0 35px rgba(0, 234, 255, 0.06); transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease; }
    .monolith-btn::before { content: ""; position: absolute; inset: 7px; border: 1px solid rgba(0, 234, 255, 0.15); border-radius: 12px; pointer-events: none; }
    .monolith-btn::after { content: ""; position: absolute; inset: 0; background: linear-gradient(105deg, transparent 35%, rgba(255,255,255,0.08) 48%, transparent 61%); transform: translateX(-110%); animation: heroSweep 6s ease-in-out infinite; pointer-events: none; }
    .monolith-btn:hover { transform: scale(1.025); border-color: #ff2cff; box-shadow: 0 0 18px rgba(255, 44, 255, 0.7), 0 0 60px rgba(0, 234, 255, 0.2), inset 0 0 40px rgba(255, 44, 255, 0.08); }
    .monolith-btn:focus-visible { outline: 2px solid #ffd34d; outline-offset: 5px; }

    .monolith-image { width: min(52%, 420px); height: min(62%, 420px); max-width: 100%; max-height: 100%; object-fit: cover; object-position: center; display: block; pointer-events: none; border-radius: 50%; border: 2px solid rgba(0, 234, 255, 0.7); box-shadow: 0 0 12px rgba(0, 234, 255, 0.7), 0 0 38px rgba(0, 234, 255, 0.22), 0 0 60px rgba(255, 44, 255, 0.1); filter: saturate(1.08) contrast(1.04); transition: transform 0.45s ease, filter 0.45s ease, box-shadow 0.45s ease; }
    .monolith-btn:hover .monolith-image { transform: scale(1.045); filter: saturate(1.25) contrast(1.08) brightness(1.08); box-shadow: 0 0 18px rgba(0, 234, 255, 0.9), 0 0 48px rgba(0, 234, 255, 0.3), 0 0 72px rgba(255, 44, 255, 0.18); }

    .monolith-text { position: absolute; left: 50%; bottom: 8%; transform: translateX(-50%); width: 100%; text-align: center; font-size: clamp(1.1rem, 2.5vw, 2.6rem); font-weight: 700; color: #fff; text-shadow: 0 0 8px #00eaff, 0 0 22px rgba(0, 234, 255, 0.75), 0 0 40px rgba(255, 44, 255, 0.25); letter-spacing: 0.18em; white-space: nowrap; pointer-events: none; animation: titleBreath 3.6s ease-in-out infinite; }
    .hero-corner { position: absolute; width: 46px; height: 46px; z-index: 4; pointer-events: none; }
    .hero-corner::before, .hero-corner::after { content: ""; position: absolute; background: rgba(0, 234, 255, 0.55); box-shadow: 0 0 8px rgba(0, 234, 255, 0.35); }
    .hero-corner::before { width: 46px; height: 1px; }
    .hero-corner::after { width: 1px; height: 46px; }
    .hero-corner-tl { left: 16px; top: 16px; }
    .hero-corner-tr { right: 16px; top: 16px; transform: rotate(90deg); }
    .hero-corner-bl { left: 16px; bottom: 16px; transform: rotate(-90deg); }
    .hero-corner-br { right: 16px; bottom: 16px; transform: rotate(180deg); }
    .hero-energy { position: absolute; width: 72%; height: 72%; border: 1px solid rgba(255, 44, 255, 0.1); border-radius: 50%; box-shadow: 0 0 55px rgba(0, 234, 255, 0.04); pointer-events: none; animation: energyPulse 4.5s ease-in-out infinite; }

    .workshop-warning { position: relative; z-index: 6; width: min(680px, 78%); box-sizing: border-box; padding: 0.75rem 1.25rem 0.9rem; text-align: center; color: #f1f7ff; background: rgba(20, 10, 2, 0.92); border: 3px solid #ff6600; border-radius: 5px; box-shadow: 0 0 14px rgba(255, 102, 0, 0.24), 0 0 28px rgba(255, 102, 0, 0.14), inset 0 0 20px rgba(255, 102, 0, 0.045); animation: warningBorderBreath 3.6s ease-in-out infinite; }
    .warning-header { display: flex; align-items: center; justify-content: center; gap: 0.7rem; margin-bottom: 0.45rem; font-size: clamp(0.68rem, 1vw, 0.9rem); font-weight: 700; letter-spacing: 0.14em; color: #ff9933; text-shadow: 0 0 8px rgba(255, 153, 51, 0.65); animation: warningHeaderBreath 3.6s ease-in-out infinite; }
    .warning-mark { color: #ffd34d; filter: drop-shadow(0 0 5px rgba(255, 102, 0, 0.7)); }
    .warning-body { font-size: clamp(0.63rem, 0.92vw, 0.82rem); line-height: 1.65; letter-spacing: 0.025em; color: #dceaf2; }
    .warning-body strong { color: #fff; }
    .warning-final { color: #ffb15c; }

    .chaos-node { position: absolute; border-radius: 8px; border: 1px solid rgba(0, 255, 204, 0.5); color: white; background: rgba(5, 2, 6, 0.8); backdrop-filter: blur(2px); overflow: hidden; display: flex; flex-direction: column; justify-content: center; align-items: center; box-shadow: 0 0 15px rgba(0, 255, 204, 0.3); pointer-events: none; }
    .node-gen { font-size: 0.7rem; color: #00ffcc; font-weight: bold; }
    .node-lineage { font-size: 0.6rem; opacity: 0.7; }
    .gravity-failure { transform: translateY(150vh) rotate(10deg); opacity: 0; transition: all 1.5s cubic-bezier(0.55, 0.085, 0.68, 0.53); pointer-events: none; }

    .gateway-interface { position: absolute; inset: 0; z-index: 20; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(5, 10, 20, 0.88); backdrop-filter: blur(5px); animation: fadeIn 1.5s ease-out; }
    .kernel-pulse { color: #00ffcc; font-size: 2rem; animation: strobe 1s infinite; }
    .kernel-status h2 { color: #00ffcc; font-weight: bold; letter-spacing: 3px; margin-top: 15px; }
    .kernel-status p { color: #8fb7c7; font-size: 1rem; max-width: 500px; }
    .gateway-btn { background: rgba(5, 12, 25, 0.94); border: 1px solid #304b61; color: white; padding: 20px 40px; width: 300px; text-align: left; border-radius: 8px; transition: all 0.3s; }
    .active-path { border-left: 5px solid #00ffcc; }
    .active-path:hover { background: rgba(0, 255, 204, 0.1); border-color: #00ffcc; box-shadow: 0 0 20px rgba(0, 255, 204, 0.2); transform: translateX(5px); color: white; }
    .locked-path { border-left: 5px solid #ff3366; opacity: 0.6; cursor: not-allowed; }
    .locked-path h3 { color: #ff3366; }

    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes strobe { 0% { opacity: 1; } 50% { opacity: 0.2; } 100% { opacity: 1; } }
    @@keyframes gridDrift { from { background-position: 0 0, 0 0; } to { background-position: 0 44px, 44px 0; } }
    @@keyframes scanSweep { 0%, 15% { transform: translateY(-20vh); opacity: 0; } 35% { opacity: 1; } 70% { opacity: 0.7; } 100% { transform: translateY(650%); opacity: 0; } }
    @@keyframes orbitPulse { 0%, 100% { opacity: 0.25; transform: scale(0.96) rotateX(66deg) rotateZ(-16deg); } 50% { opacity: 0.7; transform: scale(1.03) rotateX(66deg) rotateZ(-16deg); } }
    @@keyframes signalBlink { 0%, 100% { opacity: 0.25; transform: scale(0.7); } 50% { opacity: 1; transform: scale(1.5); } }
    @@keyframes heroSweep { 0%, 25% { transform: translateX(-110%); } 55%, 100% { transform: translateX(110%); } }
    @@keyframes energyPulse { 0%, 100% { transform: scale(0.94); opacity: 0.2; } 50% { transform: scale(1.04); opacity: 0.65; } }
    @@keyframes titleBreath { 0%, 100% { text-shadow: 0 0 8px #00eaff, 0 0 22px rgba(0, 234, 255, 0.65); opacity: 0.92; } 50% { text-shadow: 0 0 12px #00eaff, 0 0 30px rgba(0, 234, 255, 0.9), 0 0 45px rgba(255, 44, 255, 0.35); opacity: 1; } }
    @@keyframes warningBorderBreath { 0%, 100% { border-color: #ff6600; box-shadow: 0 0 10px rgba(255, 102, 0, 0.2), 0 0 24px rgba(255, 102, 0, 0.1), inset 0 0 16px rgba(255, 102, 0, 0.035); } 50% { border-color: #ff7a00; box-shadow: 0 0 20px rgba(255, 102, 0, 0.48), 0 0 42px rgba(255, 102, 0, 0.2), inset 0 0 24px rgba(255, 102, 0, 0.07); } }
    @@keyframes warningHeaderBreath { 0%, 49% { color: #ff9933; text-shadow: 0 0 8px rgba(255, 153, 51, 0.7); } 50%, 100% { color: #ffd34d; text-shadow: 0 0 10px rgba(255, 211, 77, 0.8); } }

    @@media (max-width: 700px) {
        .monolith-btn { width: 80%; height: 50%; min-width: 0; }
        .monolith-text { letter-spacing: 0.08em; font-size: clamp(0.85rem, 4vw, 1.5rem); }
        .workshop-warning { width: 88%; padding: 0.65rem 0.8rem; }
        .warning-header { letter-spacing: 0.07em; }
        .warning-body br { display: none; }
        .ambient-orbit { width: 90vw; height: 90vw; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .monolith-stage::before,
        .ambient-scan,
        .ambient-orbit,
        .ambient-signal,
        .monolith-btn::after,
        .hero-energy,
        .monolith-text,
        .workshop-warning,
        .warning-header { animation: none; }
    }
</style>

@code {
    private enum AppPhase { Monolith, Chaos, Collapsing, Gateway, Sovereign }
    private AppPhase currentPhase = AppPhase.Monolith;

    private class ChaosNode
    {
        public double X { get; set; }
        public double Y { get; set; }
        public double Size { get; set; }
        public int Generation { get; set; }
        public string Lineage { get; set; } = "";
        public int OffspringCount { get; set; } = 0;
    }

    private List<ChaosNode> activeNodes = new();
    private Timer chaosTimer = new();
    private Random rng = new();
    private const int CriticalMassThreshold = 100;

    // The living GUI owns a local 0..100 coordinate space. CSS maps that space to
    // the actual Workshop surface, so the simulation never needs viewport pixels.
    private const double LocalCoordinateMax = 100.0;
    private const double QuadrantBoundary = 50.0;
    private const double PlacementPadding = 14.0;
    private const double MinimumPlacementSpan = 8.0;

    protected override void OnInitialized()
    {
        chaosTimer.Interval = 100;
        chaosTimer.Elapsed += TickChaos;
    }

    private async Task ShatterMonolith()
    {
        currentPhase = AppPhase.Chaos;
        activeNodes.Add(new ChaosNode { X = 50, Y = 50, Size = 200, Generation = 1, Lineage = "1" });
        StateHasChanged();
        chaosTimer.Start();
        try { await JS.InvokeVoidAsync("interop.initUnity", "unity-canvas"); }
        catch { /* Suppress optional Unity bootstrap failure. */ }
    }

    private void TickChaos(object? sender, ElapsedEventArgs e)
    {
        if (currentPhase != AppPhase.Chaos) return;
        List<ChaosNode> newborns = new();

        foreach (var node in activeNodes)
        {
            node.Size += 10;
            if (node.Size > 180)
            {
                node.Size = 60;
                node.OffspringCount++;

                var quadrant = FindLeastPopulatedQuadrant();
                var bounds = GetQuadrantPlacementBounds(quadrant);

                newborns.Add(new ChaosNode
                {
                    X = NextWithin(bounds.MinX, bounds.MaxX),
                    Y = NextWithin(bounds.MinY, bounds.MaxY),
                    Generation = node.Generation + 1,
                    Lineage = $"{node.Lineage}.{node.OffspringCount}",
                    Size = 60
                });
            }
        }

        if (newborns.Any())
            activeNodes.AddRange(newborns);

        if (activeNodes.Count >= CriticalMassThreshold) _ = TriggerCollapse();
        else InvokeAsync(StateHasChanged);
    }

    private int FindLeastPopulatedQuadrant()
    {
        var counts = new int[4];

        foreach (var node in activeNodes)
            counts[GetQuadrant(node.X, node.Y)]++;

        var minimum = counts.Min();
        var candidates = Enumerable.Range(0, 4)
            .Where(index => counts[index] == minimum)
            .ToList();

        // Equal-density quadrants remain stochastic, so the swarm does not acquire
        // a mechanical left-to-right or top-to-bottom construction pattern.
        return candidates[rng.Next(candidates.Count)];
    }

    private static int GetQuadrant(double x, double y)
    {
        var right = x >= QuadrantBoundary;
        var bottom = y >= QuadrantBoundary;

        return (bottom ? 2 : 0) + (right ? 1 : 0);
    }

    private (double MinX, double MaxX, double MinY, double MaxY) GetQuadrantPlacementBounds(int quadrant)
    {
        var quadrantMinX = quadrant % 2 == 0 ? 0.0 : QuadrantBoundary;
        var quadrantMaxX = quadrant % 2 == 0 ? QuadrantBoundary : LocalCoordinateMax;
        var quadrantMinY = quadrant < 2 ? 0.0 : QuadrantBoundary;
        var quadrantMaxY = quadrant < 2 ? QuadrantBoundary : LocalCoordinateMax;

        var occupied = activeNodes
            .Where(node => GetQuadrant(node.X, node.Y) == quadrant)
            .ToList();

        if (occupied.Count == 0)
            return (quadrantMinX + PlacementPadding, quadrantMaxX - PlacementPadding,
                    quadrantMinY + PlacementPadding, quadrantMaxY - PlacementPadding);

        // The occupied min/max values become the local constraints for the next
        // arrival. Padding keeps the range alive when a quadrant contains only one
        // node, while the quadrant itself remains the hard boundary.
        var minX = Math.Max(quadrantMinX, occupied.Min(node => node.X) - PlacementPadding);
        var maxX = Math.Min(quadrantMaxX, occupied.Max(node => node.X) + PlacementPadding);
        var minY = Math.Max(quadrantMinY, occupied.Min(node => node.Y) - PlacementPadding);
        var maxY = Math.Min(quadrantMaxY, occupied.Max(node => node.Y) + PlacementPadding);

        EnsureMinimumSpan(ref minX, ref maxX, quadrantMinX, quadrantMaxX);
        EnsureMinimumSpan(ref minY, ref maxY, quadrantMinY, quadrantMaxY);

        return (minX, maxX, minY, maxY);
    }

    private static void EnsureMinimumSpan(ref double min, ref double max, double hardMin, double hardMax)
    {
        if (max - min >= MinimumPlacementSpan) return;

        var center = (min + max) * 0.5;
        var halfSpan = MinimumPlacementSpan * 0.5;
        min = Math.Max(hardMin, center - halfSpan);
        max = Math.Min(hardMax, center + halfSpan);

        if (max - min < MinimumPlacementSpan)
        {
            min = hardMin;
            max = hardMax;
        }
    }

    private double NextWithin(double min, double max)
        => min + (rng.NextDouble() * (max - min));

    private async Task TriggerCollapse()
    {
        chaosTimer.Stop();
        currentPhase = AppPhase.Collapsing;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(1500);
        currentPhase = AppPhase.Gateway;
        await InvokeAsync(StateHasChanged);
    }

    private void EnterShowcase() => currentPhase = AppPhase.Sovereign;

    public void Dispose()
    {
        chaosTimer.Stop();
        chaosTimer.Dispose();
    }
}
