@page "/"
@using TheSingularityWorkshop.Services
@inject FSMManagerService FSM
@implements IDisposable

<PageTitle>The Singularity Workshop</PageTitle>

<div class="hypervisor-shell"
     @onmousemove="RegisterActivity"
     @onmousedown="RegisterActivity"
     @onwheel="RegisterActivity"
     @ontouchstart="RegisterActivity"
     @onkeydown="RegisterActivity">
    @if (FSM.CurrentState == PageFSM.Gateway && !FSM.Context.EnterRequested)
    {
        <div class="gateway-interface">
            <div class="gateway-atmosphere" aria-hidden="true">
                <div class="ambient-grid"></div>
                <div class="ambient-scan"></div>
                <div class="ambient-orbit ambient-orbit-one"></div>
                <div class="ambient-orbit ambient-orbit-two"></div>
                <div class="ambient-signal signal-one"></div>
                <div class="ambient-signal signal-two"></div>
                <div class="ambient-signal signal-three"></div>
            </div>

            <button class="monolith-btn"
                    @onclick="EnterLivingGui"
                    aria-label="Enter The Singularity Workshop">
                <span class="hero-corner hero-corner-tl" aria-hidden="true"></span>
                <span class="hero-corner hero-corner-tr" aria-hidden="true"></span>
                <span class="hero-corner hero-corner-bl" aria-hidden="true"></span>
                <span class="hero-corner hero-corner-br" aria-hidden="true"></span>
                <span class="hero-energy" aria-hidden="true"></span>
                <img class="monolith-image" src="https://avatars.githubusercontent.com/u/16405167?v=4" alt="" />
                <span class="monolith-text">Enter Workshop</span>
            </button>

            <button class="workshop-warning"
                    type="button"
                    aria-label="Open system advisory">
                <span class="warning-header">
                    <span class="warning-mark">⚠</span>
                    <span>SYSTEM ADVISORY: MAXIMUM OVERDRIVE ACTIVE</span>
                    <span class="warning-mark">⚠</span>
                </span>
                <span class="warning-body">
                    You are transitioning from Blazor WASM UI logic straight into a WebGL Unity engine build.<br />
                    Both domains are aggressively driven by the same featherweight, pure C# <strong>50kb FSM_API</strong> —<br />
                    fully agnostic and backwards-compatible down to legacy frameworks.<br />
                    <span class="warning-final">Viewer discretion and spare RAM advised.</span>
                </span>
            </button>
        </div>
    }
    else
    {
        <div class="living-launch-stage">
            <LivingGui />
        </div>
    }

    <IdleExperienceHost @ref="_idleExperience" />
</div>

<style>
    .hypervisor-shell { position:relative; width:100%; height:100%; min-height:100%; overflow:hidden; background:radial-gradient(circle at 50% 44%,rgba(0,234,255,.08),transparent 30%),radial-gradient(circle at 28% 62%,rgba(255,44,255,.055),transparent 34%),#020711; color:white; font-family:'Consolas','Courier New',monospace; }
    .gateway-interface,.living-launch-stage { position:absolute; inset:0; overflow:hidden; }
    .gateway-interface { z-index:20; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:clamp(1rem,2.5vh,1.5rem); isolation:isolate; background:radial-gradient(ellipse at 50% 45%,rgba(0,234,255,.075),transparent 38%),radial-gradient(ellipse at 50% 80%,rgba(255,44,255,.045),transparent 42%),#020711; animation:fadeIn 1.5s ease-out; }
    .gateway-interface::before,.gateway-interface::after { content:""; position:absolute; inset:0; pointer-events:none; }
    .gateway-interface::before { z-index:-2; opacity:.35; background-image:linear-gradient(rgba(0,234,255,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(0,234,255,.055) 1px,transparent 1px); background-size:44px 44px; transform:perspective(650px) rotateX(62deg) scale(1.8) translateY(18%); transform-origin:center bottom; animation:gridDrift 18s linear infinite; }
    .gateway-interface::after { z-index:-1; background:linear-gradient(90deg,#020711 0%,transparent 16%,transparent 84%,#020711 100%),linear-gradient(0deg,#020711 0%,transparent 14%,transparent 88%,#020711 100%),repeating-linear-gradient(0deg,rgba(255,255,255,.012) 0,rgba(255,255,255,.012) 1px,transparent 1px,transparent 5px); mix-blend-mode:screen; }
    .gateway-atmosphere,.ambient-grid,.ambient-scan,.ambient-orbit,.ambient-signal { position:absolute; pointer-events:none; }
    .gateway-atmosphere { inset:0; z-index:-1; }.ambient-grid { inset:0; opacity:.7; background:linear-gradient(90deg,transparent 0 9%,rgba(0,234,255,.08) 9.1%,transparent 9.2% 90.8%,rgba(0,234,255,.08) 90.9%,transparent 91%),linear-gradient(0deg,transparent 0 14%,rgba(255,44,255,.055) 14.1%,transparent 14.2% 85.8%,rgba(255,44,255,.055) 85.9%,transparent 86%); }
    .ambient-scan { left:0; right:0; top:-15%; height:18%; background:linear-gradient(180deg,transparent,rgba(0,234,255,.055),transparent); filter:blur(3px); animation:scanSweep 8s ease-in-out infinite; }
    .ambient-orbit { width:min(70vw,900px); height:min(70vw,900px); border:1px solid rgba(0,234,255,.09); border-radius:50%; z-index:-1; animation:orbitPulse 7s ease-in-out infinite; }.ambient-orbit-one { transform:rotateX(66deg) rotateZ(-16deg); }.ambient-orbit-two { width:min(50vw,650px); height:min(50vw,650px); transform:rotateX(66deg) rotateZ(32deg); animation-delay:-2.5s; border-color:rgba(255,44,255,.08); }
    .ambient-signal { width:7px; height:7px; border-radius:50%; background:#00eaff; box-shadow:0 0 8px #00eaff,0 0 22px rgba(0,234,255,.7); z-index:0; animation:signalBlink 3s ease-in-out infinite; }.signal-one { left:18%; top:31%; }.signal-two { right:17%; top:57%; animation-delay:-1s; background:#ff2cff; box-shadow:0 0 8px #ff2cff,0 0 22px rgba(255,44,255,.7); }.signal-three { left:31%; bottom:14%; animation-delay:-2s; }
    .monolith-btn { position:relative; z-index:5; width:50%; height:50%; min-width:280px; min-height:220px; padding:0; display:flex; align-items:center; justify-content:center; overflow:hidden; background:rgba(3,10,22,.72); border:2px solid #00eaff; border-radius:18px; cursor:pointer; box-shadow:0 0 12px rgba(0,234,255,.5),0 0 45px rgba(0,234,255,.14),inset 0 0 35px rgba(0,234,255,.06); transition:transform .35s ease,box-shadow .35s ease,border-color .35s ease; }
    .monolith-btn::before { content:""; position:absolute; inset:7px; border:1px solid rgba(0,234,255,.15); border-radius:12px; pointer-events:none; }.monolith-btn::after { content:""; position:absolute; inset:0; background:linear-gradient(105deg,transparent 35%,rgba(255,255,255,.08) 48%,transparent 61%); transform:translateX(-110%); animation:heroSweep 6s ease-in-out infinite; pointer-events:none; }.monolith-btn:hover { transform:scale(1.025); border-color:#ff2cff; box-shadow:0 0 18px rgba(255,44,255,.7),0 0 60px rgba(0,234,255,.2),inset 0 0 40px rgba(255,44,255,.08); }.monolith-btn:focus-visible { outline:2px solid #ffd34d; outline-offset:5px; }
    .monolith-image { width:min(52%,420px); height:min(62%,420px); max-width:100%; max-height:100%; object-fit:cover; object-position:center; display:block; pointer-events:none; border-radius:50%; border:2px solid rgba(0,234,255,.7); box-shadow:0 0 12px rgba(0,234,255,.7),0 0 38px rgba(0,234,255,.22),0 0 60px rgba(255,44,255,.1); filter:saturate(1.08) contrast(1.04); transition:transform .45s cubic-bezier(.16,1,.3,1),filter .45s ease,box-shadow .45s ease; }.monolith-btn:hover .monolith-image { transform:scale(1.16); filter:saturate(1.25) contrast(1.08) brightness(1.08); box-shadow:0 0 18px rgba(0,234,255,.9),0 0 48px rgba(0,234,255,.3),0 0 72px rgba(255,44,255,.18); }
    .monolith-text { position:absolute; left:50%; bottom:8%; transform:translateX(-50%); width:100%; text-align:center; font-size:clamp(1.1rem,2.5vw,2.6rem); font-weight:700; color:#fff; text-shadow:0 0 8px #00eaff,0 0 22px rgba(0,234,255,.75),0 0 40px rgba(255,44,255,.25); letter-spacing:.18em; white-space:nowrap; pointer-events:none; animation:titleBreath 3.6s ease-in-out infinite; }
    .hero-corner { position:absolute; width:46px; height:46px; z-index:4; pointer-events:none; }.hero-corner::before,.hero-corner::after { content:""; position:absolute; background:rgba(0,234,255,.55); box-shadow:0 0 8px rgba(0,234,255,.35); }.hero-corner::before { width:46px; height:1px; }.hero-corner::after { width:1px; height:46px; }.hero-corner-tl { left:16px; top:16px; }.hero-corner-tr { right:16px; top:16px; transform:rotate(90deg); }.hero-corner-bl { left:16px; bottom:16px; transform:rotate(-90deg); }.hero-corner-br { right:16px; bottom:16px; transform:rotate(180deg); }.hero-energy { position:absolute; width:72%; height:72%; border:1px solid rgba(255,44,255,.1); border-radius:50%; box-shadow:0 0 55px rgba(0,234,255,.04); pointer-events:none; animation:energyPulse 4.5s ease-in-out infinite; }
    .workshop-warning { position:relative; z-index:6; width:min(680px,78%); box-sizing:border-box; padding:.75rem 1.25rem .9rem; text-align:center; color:#f1f7ff; background:rgba(20,10,2,.92); border:3px solid #ff6600; border-radius:5px; box-shadow:0 0 14px rgba(255,102,0,.24),0 0 28px rgba(255,102,0,.14),inset 0 0 20px rgba(255,102,0,.045); cursor:pointer; font:inherit; animation:warningBorderBreath 3.6s ease-in-out infinite; }
    .warning-header { display:flex; align-items:center; justify-content:center; gap:.7rem; margin-bottom:.45rem; font-size:clamp(.68rem,1vw,.9rem); font-weight:700; letter-spacing:.14em; color:#ff9933; text-shadow:0 0 8px rgba(255,153,51,.65); animation:warningHeaderBreath 3.6s ease-in-out infinite; }.warning-mark { color:#ffd34d; filter:drop-shadow(0 0 5px rgba(255,102,0,.7)); }.warning-body { display:block; font-size:clamp(.63rem,.92vw,.82rem); line-height:1.65; letter-spacing:.025em; color:#dceaf2; }.warning-body strong { color:#fff; }.warning-final { color:#ffb15c; }
    .living-launch-stage { z-index:25; }
    @@keyframes fadeIn{from{opacity:0}to{opacity:1}}@@keyframes gridDrift{from{background-position:0 0,0 0}to{background-position:0 44px,44px 0}}@@keyframes scanSweep{0%,15%{transform:translateY(-20vh);opacity:0}35%{opacity:1}70%{opacity:.7}100%{transform:translateY(650%);opacity:0}}@@keyframes orbitPulse{0%,100%{opacity:.25;transform:scale(.96) rotateX(66deg) rotateZ(-16deg)}50%{opacity:.7;transform:scale(1.03) rotateX(66deg) rotateZ(-16deg)}}@@keyframes signalBlink{0%,100%{opacity:.25;transform:scale(.7)}50%{opacity:1;transform:scale(1.5)}}@@keyframes heroSweep{0%,25%{transform:translateX(-110%)}55%,100%{transform:translateX(110%)}}@@keyframes energyPulse{0%,100%{transform:scale(.94);opacity:.2}50%{transform:scale(1.04);opacity:.65}}@@keyframes titleBreath{0%,100%{text-shadow:0 0 8px #00eaff,0 0 22px rgba(0,234,255,.65);opacity:.92}50%{text-shadow:0 0 12px #00eaff,0 0 30px rgba(0,234,255,.9),0 0 45px rgba(255,44,255,.35);opacity:1}}@@keyframes warningBorderBreath{0%,100%{border-color:#ff6600;box-shadow:0 0 10px rgba(255,102,0,.2),0 0 24px rgba(255,102,0,.1),inset 0 0 16px rgba(255,102,0,.035)}50%{border-color:#ff7a00;box-shadow:0 0 20px rgba(255,102,0,.48),0 0 42px rgba(255,102,0,.2),inset 0 0 24px rgba(255,102,0,.07)}}@@keyframes warningHeaderBreath{0%,49%{color:#ff9933;text-shadow:0 0 8px rgba(255,153,51,.7)}50%,100%{color:#ffd34d;text-shadow:0 0 10px rgba(255,211,77,.8)}}
    @@media(max-width:700px){.monolith-btn{width:80%;height:50%;min-width:0}.monolith-text{letter-spacing:.08em;font-size:clamp(.85rem,4vw,1.5rem)}.workshop-warning{width:88%;padding:.65rem .8rem}.warning-header{letter-spacing:.07em}.warning-body br{display:none}.ambient-orbit{width:90vw;height:90vw}}
    @@media(prefers-reduced-motion:reduce){.gateway-interface::before,.ambient-scan,.ambient-orbit,.ambient-signal,.monolith-btn::after,.hero-energy,.monolith-text,.workshop-warning,.warning-header{animation:none}}
</style>

@code {
    private IdleExperienceHost? _idleExperience;

    protected override void OnInitialized()
    {
        FSM.StateChanged += HandleFSMStateChanged;
    }

    private void HandleFSMStateChanged(string _) => InvokeAsync(StateHasChanged);

    private void RegisterActivity()
    {
        _idleExperience?.RegisterActivity();
    }

    private void EnterLivingGui()
    {
        if (FSM.CurrentState != PageFSM.Gateway || FSM.Context.EnterRequested)
            return;

        _idleExperience?.RegisterActivity();
        FSM.RequestEnter();
        StateHasChanged();
    }

    public void Dispose() => FSM.StateChanged -= HandleFSMStateChanged;
}