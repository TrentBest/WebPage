@page "/"
@using TheSingularityWorkshop.Services
@inject FSMManagerService FSM
@implements IDisposable

<!-- The gateway deliberately uses neutral page metadata. The Workshop moniker is
     promoted only by LivingGui after the FSM reaches the exact 100-node boundary. -->
<PageTitle>Workshop Gateway</PageTitle>

<div class="hypervisor-shell"
     @onmousemove="RegisterActivity"
     @onmousedown="RegisterActivity"
     @onwheel="RegisterActivity"
     @ontouchstart="RegisterActivity"
     @onkeydown="RegisterActivity">
    @if (FSM.CurrentState == PageFSM.Gateway && !FSM.Context.EnterRequested)
    {
        <div class="gateway-interface">
            <div class="gateway-atmosphere" aria-hidden="true">
                <div class="ambient-grid"></div>
                <div class="ambient-scan"></div>
                <div class="ambient-orbit ambient-orbit-one"></div>
                <div class="ambient-orbit ambient-orbit-two"></div>
                <div class="ambient-signal signal-one"></div>
                <div class="ambient-signal signal-two"></div>
                <div class="ambient-signal signal-three"></div>
            </div>

            <button class="monolith-btn"
                    @onclick="EnterLivingGui"
                    aria-label="Enter Workshop">
                <span class="hero-corner hero-corner-tl" aria-hidden="true"></span>
                <span class="hero-corner hero-corner-tr" aria-hidden="true"></span>
                <span class="hero-corner hero-corner-bl" aria-hidden="true"></span>
                <span class="hero-corner hero-corner-br" aria-hidden="true"></span>
                <span class="hero-energy" aria-hidden="true"></span>
                <img class="monolith-image" src="https://avatars.githubusercontent.com/u/16405167?v=4" alt="" />
                <span class="monolith-text">Enter Workshop</span>
            </button>

            <!-- The fracture is presentation-only. It is dormant until the gateway
                 is physically pushed by hover, then appears to tear through the screen. -->
            <svg class="screen-fracture" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                <g class="fracture-lines">
                    <path d="M38 7 L35 2 L31 0 M43 6 L41 2 L43 0 M57 6 L60 2 L58 0 M63 7 L66 3 L70 0" />
                    <path d="M38 93 L35 98 L31 100 M44 94 L42 98 L44 100 M56 94 L59 98 L58 100 M63 93 L67 97 L71 100" />
                    <path d="M7 35 L2 32 L0 28 M6 43 L2 41 L0 43 M6 57 L2 60 L0 58 M7 65 L3 68 L0 72" />
                    <path d="M93 35 L98 32 L100 28 M94 43 L98 41 L100 43 M94 57 L98 60 L100 58 M93 65 L97 68 L100 72" />
                    <path d="M18 11 L13 7 L10 8 L6 5 M82 11 L87 7 L90 8 L94 5" />
                    <path d="M18 89 L13 93 L10 92 L6 95 M82 89 L87 93 L90 92 L94 95" />
                </g>
                <g class="fracture-sparks">
                    <circle cx="31" cy="0" r=".8" /><circle cx="70" cy="0" r=".8" />
                    <circle cx="31" cy="100" r=".8" /><circle cx="71" cy="100" r=".8" />
                    <circle cx="0" cy="28" r=".8" /><circle cx="100" cy="28" r=".8" />
                    <circle cx="0" cy="72" r=".8" /><circle cx="100" cy="72" r=".8" />
                </g>
            </svg>

            <button class="workshop-warning"
                    type="button"
                    aria-label="Read what will happen before entering the Workshop">
                <span class="warning-header">
                    <span class="warning-mark">⚠</span>
                    <span>BEFORE YOU ENTER: HERE'S WHAT YOU'RE ABOUT TO SEE</span>
                    <span class="warning-mark">⚠</span>
                </span>
                <span class="warning-body">
                    Click <strong>Enter Workshop</strong> and the gateway gives way to a living software sequence.<br />
                    You'll watch a GUI assemble itself into 100 nodes, reach critical mass, then reveal the Workshop moniker.<br />
                    Gravity takes over, the living field falls away, and the navigation surface arrives. If you wait here instead,<br />
                    the system eventually decides you are idle and takes the screen back with an experience of its own.<br />
                    <span class="warning-final">The orange card is the longer explanation. Click it if you want the whole runway before the ride.</span>
                </span>
            </button>
        </div>
    }
    else
    {
        <div class="living-launch-stage">
            <LivingGui />
        </div>
    }

    <IdleExperienceHost @ref="_idleExperience" />
</div>

<style>
    .hypervisor-shell { position:relative; width:100%; height:100%; min-height:100%; overflow:hidden; background:radial-gradient(circle at 50% 44%,rgba(0,234,255,.08),transparent 30%),radial-gradient(circle at 28% 62%,rgba(255,44,255,.055),transparent 34%),#020711; color:white; font-family:'Consolas','Courier New',monospace; }
    .gateway-interface,.living-launch-stage { position:absolute; inset:0; overflow:hidden; }
    .gateway-interface { z-index:20; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:clamp(1rem,2.5vh,1.5rem); isolation:isolate; background:radial-gradient(ellipse at 50% 45%,rgba(0,234,255,.075),transparent 38%),radial-gradient(ellipse at 50% 80%,rgba(255,44,255,.045),transparent 42%),#020711; animation:fadeIn 1.5s ease-out; }
    .gateway-interface::before,.gateway-interface::after { content:""; position:absolute; inset:0; pointer-events:none; }
    .gateway-interface::before { z-index:-2; opacity:.35; background-image:linear-gradient(rgba(0,234,255,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(0,234,255,.055) 1px,transparent 1px); background-size:44px 44px; transform:perspective(650px) rotateX(62deg) scale(1.8) translateY(18%); transform-origin:center bottom; animation:gridDrift 18s linear infinite; }
    .gateway-interface::after { z-index:-1; background:linear-gradient(90deg,#020711 0%,transparent 16%,transparent 84%,#020711 100%),linear-gradient(0deg,#020711 0%,transparent 14%,transparent 88%,#020711 100%),repeating-linear-gradient(0deg,rgba(255,255,255,.012) 0,rgba(255,255,255,.012) 1px,transparent 1px,transparent 5px); mix-blend-mode:screen; }
    .gateway-atmosphere,.ambient-grid,.ambient-scan,.ambient-orbit,.ambient-signal { position:absolute; pointer-events:none; }
    .gateway-atmosphere { inset:0; z-index:-1; }.ambient-grid { inset:0; opacity:.7; background:linear-gradient(90deg,transparent 0 9%,rgba(0,234,255,.08) 9.1%,transparent 9.2% 90.8%,rgba(0,234,255,.08) 90.9%,transparent 91%),linear-gradient(0deg,transparent 0 14%,rgba(255,44,255,.055) 14.1%,transparent 14.2% 85.8%,rgba(255,44,255,.055) 85.9%,transparent 86%); }
    .ambient-scan { left:0; right:0; top:-15%; height:18%; background:linear-gradient(180deg,transparent,rgba(0,234,255,.055),transparent); filter:blur(3px); animation:scanSweep 8s ease-in-out infinite; }
    .ambient-orbit { width:min(70vw,900px); height:min(70vw,900px); border:1px solid rgba(0,234,255,.09); border-radius:50%; z-index:-1; animation:orbitPulse 7s ease-in-out infinite; }.ambient-orbit-one { transform:rotateX(66deg) rotateZ(-16deg); }.ambient-orbit-two { width:min(50vw,650px); height:min(50vw,650px); transform:rotateX(66deg) rotateZ(32deg); animation-delay:-2.5s; border-color:rgba(255,44,255,.08); }
    .ambient-signal { width:7px; height:7px; border-radius:50%; background:#00eaff; box-shadow:0 0 8px #00eaff,0 0 22px rgba(0,234,255,.7); z-index:0; animation:signalBlink 3s ease-in-out infinite; }.signal-one { left:18%; top:31%; }.signal-two { right:17%; top:57%; animation-delay:-1s; background:#ff2cff; box-shadow:0 0 8px #ff2cff,0 0 22px rgba(255,44,255,.7); }.signal-three { left:31%; bottom:14%; animation-delay:-2s; }
    .monolith-btn { position:relative; z-index:5; width:50%; height:50%; min-width:280px; min-height:220px; padding:0; display:flex; align-items:center; justify-content:center; overflow:visible; background:rgba(3,10,22,.72); border:2px solid #00eaff; border-radius:18px; cursor:pointer; box-shadow:0 0 12px rgba(0,234,255,.5),0 0 45px rgba(0,234,255,.14),inset 0 0 35px rgba(0,234,255,.06); transition:transform .35s cubic-bezier(.16,1,.3,1),box-shadow .35s ease,border-color .35s ease,border-width .35s ease; }
    .monolith-btn::before { content:""; position:absolute; inset:7px; border:1px solid rgba(0,234,255,.15); border-radius:12px; pointer-events:none; transition:border-color .35s ease,box-shadow .35s ease; }.monolith-btn::after { content:""; position:absolute; inset:0; background:linear-gradient(105deg,transparent 35%,rgba(255,255,255,.08) 48%,transparent 61%); transform:translateX(-110%); animation:heroSweep 6s ease-in-out infinite; pointer-events:none; border-radius:inherit; }.monolith-btn:hover { transform:scale(1.025); border-width:2.05px; border-color:#ff2cff; box-shadow:0 0 18px rgba(255,44,255,.7),0 0 60px rgba(0,234,255,.2),inset 0 0 40px rgba(255,44,255,.08); }.monolith-btn:hover::before { border-color:rgba(255,44,255,.45); box-shadow:0 0 18px rgba(255,44,255,.18); }.monolith-btn:focus-visible { outline:2px solid #ffd34d; outline-offset:5px; }
    .monolith-image { width:min(42vw,42vh); height:min(42vw,42vh); max-width:80%; max-height:80%; flex:0 0 auto; aspect-ratio:1 / 1; object-fit:cover; object-position:center; display:block; pointer-events:none; border-radius:50%; clip-path:circle(50% at 50% 50%); border:2px solid rgba(0,234,255,.7); box-shadow:0 0 12px rgba(0,234,255,.7),0 0 38px rgba(0,234,255,.22),0 0 60px rgba(255,44,255,.1); filter:saturate(1.08) contrast(1.04); transition:transform .45s cubic-bezier(.16,1,.3,1),filter .45s ease,box-shadow .45s ease,border-color .35s ease,border-width .35s ease; }
    .monolith-btn:hover .monolith-image { transform:scale(1.16); border-width:2.32px; border-color:#ff2cff; filter:saturate(1.32) contrast(1.08) brightness(1.1); box-shadow:0 0 18px rgba(255,44,255,.95),0 0 48px rgba(0,234,255,.35),0 0 82px rgba(255,44,255,.3); }
    /* The call-to-action is deliberately allowed to grow well beyond the old
       one-line sizing. It belongs over the avatar, not beneath it. */
    .monolith-text { position:absolute; left:50%; top:50%; bottom:auto; transform:translate(-50%,-50%); width:115%; max-width:none; text-align:center; font-size:clamp(1.8rem,5.2vw,5.4rem); font-weight:900; color:#fff; text-shadow:0 0 8px #00eaff,0 0 22px rgba(0,234,255,.75),0 0 40px rgba(255,44,255,.25); letter-spacing:.08em; white-space:nowrap; pointer-events:none; animation:titleBreath 3.6s ease-in-out infinite; }
    .hero-corner { position:absolute; width:46px; height:46px; z-index:4; pointer-events:none; }.hero-corner::before,.hero-corner::after { content:""; position:absolute; background:rgba(0,234,255,.55); box-shadow:0 0 8px rgba(0,234,255,.35); }.hero-corner::before { width:46px; height:1px; }.hero-corner::after { width:1px; height:46px; }.hero-corner-tl { left:16px; top:16px; }.hero-corner-tr { right:16px; top:16px; transform:rotate(90deg); }.hero-corner-bl { left:16px; bottom:16px; transform:rotate(-90deg); }.hero-corner-br { right:16px; bottom:16px; transform:rotate(180deg); }.hero-energy { position:absolute; width:72%; height:72%; border:1px solid rgba(255,44,255,.1); border-radius:50%; box-shadow:0 0 55px rgba(0,234,255,.04); pointer-events:none; animation:energyPulse 4.5s ease-in-out infinite; }
    .screen-fracture { position:absolute; left:50%; top:50%; width:54%; height:54%; transform:translate(-50%,-50%); z-index:4; overflow:visible; pointer-events:none; opacity:0; filter:drop-shadow(0 0 4px rgba(0,234,255,.8)) drop-shadow(0 0 14px rgba(255,44,255,.45)); transition:opacity .18s ease,filter .35s ease; }
    .fracture-lines { fill:none; stroke:#00eaff; stroke-width:.45; stroke-linecap:round; stroke-linejoin:round; stroke-dasharray:4 2; stroke-dashoffset:10; }.fracture-sparks { fill:#00eaff; opacity:.7; }
    .gateway-interface:has(.monolith-btn:hover) .screen-fracture { opacity:1; filter:drop-shadow(0 0 5px rgba(255,44,255,.95)) drop-shadow(0 0 18px rgba(0,234,255,.7)); animation:fracturePulse .75s ease-in-out infinite alternate; }.gateway-interface:has(.monolith-btn:hover) .fracture-lines { stroke:#ff2cff; animation:fractureDraw .9s linear infinite; }.gateway-interface:has(.monolith-btn:hover) .fracture-sparks { fill:#ffd34d; opacity:1; animation:sparkFlicker .42s ease-in-out infinite alternate; }
    .workshop-warning { position:relative; z-index:6; width:min(760px,82%); box-sizing:border-box; padding:.9rem 1.35rem 1rem; text-align:center; color:#f1f7ff; background:rgba(20,10,2,.92); border:3px solid #ff6600; border-radius:5px; box-shadow:0 0 14px rgba(255,102,0,.24),0 0 28px rgba(255,102,0,.14),inset 0 0 20px rgba(255,102,0,.045); cursor:pointer; font:inherit; animation:warningBorderBreath 3.6s ease-in-out infinite; }
    .warning-header { display:flex; align-items:center; justify-content:center; gap:.7rem; margin-bottom:.45rem; font-size:clamp(.7rem,1.15vw,1rem); font-weight:700; letter-spacing:.1em; color:#ff9933; text-shadow:0 0 8px rgba(255,153,51,.65); animation:warningHeaderBreath 3.6s ease-in-out infinite; }.warning-mark { color:#ffd34d; filter:drop-shadow(0 0 5px rgba(255,102,0,.7)); }.warning-body { display:block; font-size:clamp(.68rem,.98vw,.88rem); line-height:1.62; letter-spacing:.02em; color:#dceaf2; }.warning-body strong { color:#fff; }.warning-final { color:#ffb15c; }
    .living-launch-stage { z-index:25; }
    @@keyframes fadeIn{from{opacity:0}to{opacity:1}}@@keyframes gridDrift{from{background-position:0 0,0 0}to{background-position:0 44px,44px 0}}@@keyframes scanSweep{0%,15%{transform:translateY(-20vh);opacity:0}35%{opacity:1}70%{opacity:.7}100%{transform:translateY(650%);opacity:0}}@@keyframes orbitPulse{0%,100%{opacity:.25;transform:scale(.96) rotateX(66deg) rotateZ(-16deg)}50%{opacity:.7;transform:scale(1.03) rotateX(66deg) rotateZ(-16deg)}}@@keyframes signalBlink{0%,100%{opacity:.25;transform:scale(.7)}50%{opacity:1;transform:scale(1.5)}}@@keyframes heroSweep{0%,25%{transform:translateX(-110%)}55%,100%{transform:translateX(110%)}}@@keyframes energyPulse{0%,100%{transform:scale(.94);opacity:.2}50%{transform:scale(1.04);opacity:.65}}@@keyframes fracturePulse{from{transform:translate(-50%,-50%) scale(1)}to{transform:translate(-50%,-50%) scale(1.012)}}@@keyframes fractureDraw{from{stroke-dashoffset:12}to{stroke-dashoffset:0}}@@keyframes sparkFlicker{from{transform:scale(.65);opacity:.35}to{transform:scale(1.45);opacity:1}}@@keyframes titleBreath{0%,100%{text-shadow:0 0 8px #00eaff,0 0 22px rgba(0,234,255,.65);opacity:.92}50%{text-shadow:0 0 12px #00eaff,0 0 30px rgba(0,234,255,.9),0 0 45px rgba(255,44,255,.35);opacity:1}}@@keyframes warningBorderBreath{0%,100%{border-color:#ff6600;box-shadow:0 0 10px rgba(255,102,0,.2),0 0 24px rgba(255,102,0,.1),inset 0 0 16px rgba(255,102,0,.035)}50%{border-color:#ff7a00;box-shadow:0 0 20px rgba(255,102,0,.48),0 0 42px rgba(255,102,0,.2),inset 0 0 24px rgba(255,102,0,.07)}}@@keyframes warningHeaderBreath{0%,49%{color:#ff9933;text-shadow:0 0 8px rgba(255,153,51,.7)}50%,100%{color:#ffd34d;text-shadow:0 0 10px rgba(255,211,77,.8)}}
    @@media(max-width:700px){.monolith-btn{width:88vw;height:52vh;min-width:0;min-height:0}.monolith-image{width:min(72vw,42vh);height:min(72vw,42vh);max-width:82%;max-height:82%}.monolith-text{width:125%;letter-spacing:.035em;font-size:clamp(1.25rem,7.5vw,2.8rem)}.workshop-warning{width:92%;padding:.7rem .8rem}.warning-header{letter-spacing:.045em}.warning-body br{display:none}.ambient-orbit{width:90vw;height:90vw}.screen-fracture{width:88%;height:54%}}
    @@media(prefers-reduced-motion:reduce){.gateway-interface::before,.ambient-scan,.ambient-orbit,.ambient-signal,.monolith-btn::after,.hero-energy,.monolith-text,.workshop-warning,.warning-header,.screen-fracture,.fracture-lines,.fracture-sparks{animation:none}.gateway-interface:has(.monolith-btn:hover) .screen-fracture{opacity:1}.gateway-interface:has(.monolith-btn:hover) .fracture-lines{stroke:#ff2cff}}
</style>

@code {
    private IdleExperienceHost? _idleExperience;

    protected override void OnInitialized()
    {
        FSM.StateChanged += HandleFSMStateChanged;
    }

    private void HandleFSMStateChanged(string _) => InvokeAsync(StateHasChanged);

    private void RegisterActivity()
    {
        _idleExperience?.RegisterActivity();
    }

    private void EnterLivingGui()
    {
        if (FSM.CurrentState != PageFSM.Gateway || FSM.Context.EnterRequested)
            return;

        _idleExperience?.RegisterActivity();
        FSM.RequestEnter();
        StateHasChanged();
    }

    public void Dispose() => FSM.StateChanged -= HandleFSMStateChanged;
}
