    private string _lastRenderedPageState = string.Empty;

    protected override void OnInitialized()
    {
        ApplyRequestedHubTab();
        Navigation.LocationChanged += HandleLocationChanged;
        _lastRenderedPageState = FSM.CurrentState;
        Experience.StateChanged += ExperienceChanged;
        FSM.StateChanged += PageStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || this.firstRender)
            return;

        this.firstRender = true;
        var returningVisitor = await JS.InvokeAsync<bool>("interop.workshopVisited");
        // The monolith is a first-visit gate. Preserve the existing return-visitor
        // journey when browser navigation reloads the root route after entry.
        _entryRequested = _explicitHubRouteRequested
            || returningVisitor
            || FSM.Context.EnterRequested
            || FSM.CurrentState is PageFSM.GatewayExit
                or PageFSM.LivingGuiIgnition
                or PageFSM.LivingGuiPopulating
                or PageFSM.MonikerReveal
                or PageFSM.Gravity
                or PageFSM.LivingGuiDissipating
                or PageFSM.NavigationArrival
                or PageFSM.Running;
        await Experience.InitializeAsync(returningVisitor);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        ApplyRequestedHubTab();
        _ = InvokeAsync(StateHasChanged);
    }

    private void ApplyRequestedHubTab()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var requestedTab = uri.Query
            .TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Split('=', 2))
            .Where(parts => parts.Length == 2
                && string.Equals(Uri.UnescapeDataString(parts[0].Replace('+', ' ')), "tab", StringComparison.OrdinalIgnoreCase))
            .Select(parts => Uri.UnescapeDataString(parts[1].Replace('+', ' ')))
            .FirstOrDefault();

        _selectedHubTab = string.IsNullOrWhiteSpace(requestedTab)
            ? "MONIKER"
            : requestedTab.Replace('-', ' ').Trim().ToUpperInvariant();

        // A direct, explicit hub URL is already a navigation intent. In particular,
        // browser-back to /?tab=welcome must restore the chosen destination instead
        // of resurrecting the first-visit monolith over it.
        _explicitHubRouteRequested = !string.IsNullOrWhiteSpace(requestedTab);
        if (_explicitHubRouteRequested)
            _entryRequested = true;

        _selectedDemonstrationId = DemonstrationRoutes.ReadSelectedId(uri.Query);
    }

    private void ExperienceChanged()
        => _ = InvokeAsync(StateHasChanged);

    private void PageStateChanged(string stateName)
    {
        // PageFSM reports every heartbeat as well as transitions. Re-render this
        // parent only when the state used by BuildExperienceContent actually changes.
        var currentState = FSM.CurrentState;
        if (string.Equals(currentState, _lastRenderedPageState, StringComparison.Ordinal))
            return;

        _lastRenderedPageState = currentState;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Experience.StateChanged -= ExperienceChanged;
        FSM.StateChanged -= PageStateChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}