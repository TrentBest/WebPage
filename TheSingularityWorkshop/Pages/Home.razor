@page "/"
@inject IJSRuntime JS
@inject TheSingularityWorkshop.Services.WorkshopExperienceService Experience
@inject TheSingularityWorkshop.Services.FSMManagerService FSM
@inject TheSingularityWorkshop.Workshop.Composition.WorkshopExperienceCatalog ExperienceCatalog
@implements IDisposable
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Rendering
@using TheSingularityWorkshop.Services
@using TheSingularityWorkshop.Workshop.Gui
<PageTitle>The Singularity Workshop</PageTitle>

@BuildRootGui()

<style>
.manifest-moniker{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.15em;background:radial-gradient(circle at 50% 42%,rgba(0,234,255,.09),transparent 35%),#020711;color:#fff;font:900 clamp(2.8rem,9vw,8rem)/.86 Consolas,'Courier New',monospace;letter-spacing:.07em;text-align:center;text-shadow:0 0 24px rgba(0,234,255,.22);animation:manifestMonikerBreath 3.8s ease-in-out infinite}.manifest-moniker #the{color:#00a8ff}.manifest-moniker #singularity{color:#ff2cff}.manifest-moniker #workshop{color:#ff7a00}.manifest-moniker #moniker-composition{display:flex;flex-direction:column;align-items:center;gap:.15em}.manifest-moniker small{margin-top:1.2rem;font-size:clamp(.55rem,1vw,.8rem);letter-spacing:.18em;color:#617784}@@keyframes manifestMonikerBreath{0%,100%{transform:scale(.985)}50%{transform:scale(1.015)}}
.manifest-hub{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:clamp(1rem,4vw,4rem);overflow:auto;background:radial-gradient(circle at 18% 28%,rgba(0,168,255,.10),transparent 28%),radial-gradient(circle at 82% 72%,rgba(255,44,255,.07),transparent 30%),#020711}
.manifest-hub-shell{width:min(1100px,100%);display:grid;gap:clamp(1rem,2vw,2rem)}
.manifest-hub-header{display:flex;align-items:end;justify-content:space-between;gap:1rem;flex-wrap:wrap}
.manifest-hub-kicker{font-size:clamp(.65rem,1.2vw,.9rem);letter-spacing:.2em;color:#6d8795}
.manifest-hub-title{margin:.25rem 0 0;font-size:clamp(2rem,6vw,5rem);line-height:.9;letter-spacing:.04em}
.manifest-hub-version{font-size:.7rem;letter-spacing:.14em;color:#536873}
.manifest-public-brief{border:1px solid rgba(255,44,255,.24);border-radius:1rem;padding:clamp(1.2rem,2.6vw,2rem);background:linear-gradient(120deg,rgba(0,168,255,.08),rgba(255,44,255,.045),rgba(3,8,17,.92));}.manifest-public-brief h2{margin:.65rem 0;color:#fff;font-size:clamp(1.45rem,3.3vw,2.5rem);line-height:1.05;}.manifest-public-brief p{max-width:78ch;color:#c3d0d6;line-height:1.65;margin:.8rem 0;}.manifest-public-brief .brief-status{color:#ffb15c;font-size:.68rem;letter-spacing:.15em;font-weight:800;}.manifest-public-brief .brief-flow{display:flex;gap:.55rem;align-items:center;flex-wrap:wrap;margin:1.1rem 0;color:#9bdfea;font-size:.72rem;letter-spacing:.07em;}.manifest-public-brief .brief-flow b{color:#ff2cff;}.manifest-public-brief .manifest-hub-actions{margin-top:1rem;}
.manifest-hub-tabs{display:flex;gap:.75rem;overflow:auto;padding:.25rem 0}
.manifest-hub-tab{border:1px solid rgba(0,234,255,.45);border-radius:999px;padding:.65rem 1.1rem;background:rgba(0,234,255,.08);color:#fff;font:700 .8rem Consolas,'Courier New',monospace;letter-spacing:.12em;white-space:nowrap}
.manifest-hub-card{position:relative;border:1px solid rgba(0,234,255,.18);border-radius:1.25rem;padding:clamp(1.25rem,3vw,2.5rem);background:linear-gradient(145deg,rgba(10,25,38,.94),rgba(3,8,17,.94));box-shadow:0 30px 100px rgba(0,0,0,.35);overflow:hidden}
