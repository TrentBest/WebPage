@page "/"
@using System.Timers
@using TheSingularityWorkshop.FSM_API
@inject IJSRuntime JS
@inject TheSingularityWorkshop.Services.WorkshopExperienceService Experience
@implements IDisposable

<PageTitle>The Singularity Workshop</PageTitle>

<div class="workshop-root">
    @if (Experience.CurrentState is "Intro" or "Living" or "FlexHello" or "CriticalMass")
    {
        <div class="experience-layer">
            @if (Experience.CurrentState == "Intro")
            {
                <section class="monolith-stage">
                    <div class="ambient-grid" aria-hidden="true"></div>
                    <div class="ambient-scan" aria-hidden="true"></div>
                    <div class="ambient-orbit ambient-orbit-one" aria-hidden="true"></div>
                    <div class="ambient-orbit ambient-orbit-two" aria-hidden="true"></div>
                    <div class="ambient-signal signal-one" aria-hidden="true"></div>
                    <div class="ambient-signal signal-two" aria-hidden="true"></div>
                    <div class="ambient-signal signal-three" aria-hidden="true"></div>
                    <button class="monolith-btn" @onclick="EnterWorkshop" aria-label="Enter The Singularity Workshop">
                        <span class="hero-corner hero-corner-tl" aria-hidden="true"></span>
                        <span class="hero-corner hero-corner-tr" aria-hidden="true"></span>
                        <span class="hero-corner hero-corner-bl" aria-hidden="true"></span>
                        <span class="hero-corner hero-corner-br" aria-hidden="true"></span>
                        <span class="hero-energy" aria-hidden="true"></span>
                        <img class="monolith-image" src="/Images/TheSingularityWorkshopLogo.png" alt="The Singularity Workshop" />
                        <span class="monolith-text">ENTER THE WORKSHOP</span>
                    </button>
                    <div class="workshop-warning" role="note">
                        <div class="warning-header"><span class="warning-mark">⚠</span><span>EXPERIENCE ADVISORY: FLEX SYSTEM ACTIVE</span><span class="warning-mark">⚠</span></div>
                        <div class="warning-body">
                            You are entering a living WebPage Experience assembled from state, geometry, and recursive GUI behavior.<br />
                            Each glyph owns a phase and moves independently through the same mathematical wave field.<br />
                            <span class="warning-final">Viewer discretion and spare GPU advised.</span>
                        </div>
                    </div>
                </section>
            }

            @if (Experience.CurrentState is "FlexHello" or "Living" or "CriticalMass")
            {
                <section class="flex-hello" aria-live="polite" aria-label="The Singularity Workshop">
                    <div class="flex-hello-water" aria-hidden="true"></div>
                    <div class="flex-hello-orbit flex-hello-orbit-one" aria-hidden="true"></div>
                    <div class="flex-hello-orbit flex-hello-orbit-two" aria-hidden="true"></div>
                    <div class="flex-hello-kicker">FLEX EXPERIENCE</div>
                    <div class="flex-hello-moniker" aria-label="THE SINGULARITY WORKSHOP">
                        @foreach (var line in MonikerLines)
                        {
                            <div class="flex-hello-line">
                                @foreach (var glyph in line)
                                {
                                    <span class="flex-hello-glyph" style="--phase:@(glyph.PhaseDegrees)deg;--glyph-color:@glyph.Color;">@glyph.Character</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="flex-hello-state">STATE: @Experience.CurrentState</div>
                </section>
            }

            @foreach (var node in Nodes)
            {
                <div class="living-node @(node.IsSeed ? "seed" : "")" style="left:@(node.X)%;top:@(node.Y)%;transform:translate(-50%,-50%) rotate(@(node.Rotation)deg) scale(@(node.Scale));">
                    <div class="node-core"></div><div class="node-ring"></div><span>GEN @node.Generation</span>
                </div>
            }
        </div>
    }
</div>

<style>
    .experience-layer { position:absolute; inset:0; z-index:10; overflow:hidden; }
    .flex-hello { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.7rem; overflow:hidden; isolation:isolate; perspective:1000px; background:radial-gradient(circle at 50% 46%,rgba(0,234,255,.12),transparent 32%),radial-gradient(ellipse at 50% 90%,rgba(0,168,255,.12),transparent 48%),#020711; }
    .flex-hello::before { content:""; position:absolute; inset:0; z-index:-4; background-image:linear-gradient(rgba(0,234,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,44,255,.035) 1px,transparent 1px); background-size:44px 44px; animation:flexGridDrift 18s linear infinite; }
    .flex-hello::after { content:""; position:absolute; inset:0; z-index:-3; pointer-events:none; background:linear-gradient(180deg,rgba(2,7,17,.05),rgba(0,168,255,.035) 55%,rgba(2,7,17,.65)); }
    .flex-hello-water { position:absolute; left:-12%; right:-12%; bottom:-18%; height:65%; z-index:-2; opacity:.72; background:radial-gradient(ellipse at 50% 100%,rgba(0,168,255,.2),transparent 60%),repeating-radial-gradient(ellipse at 50% 115%,transparent 0 7%,rgba(0,234,255,.045) 7.3% 7.6%,transparent 8% 14%); filter:blur(1px); transform:perspective(700px) rotateX(66deg); transform-origin:center bottom; animation:flexWaterBreath 8s ease-in-out infinite; }
    .flex-hello-orbit { position:absolute; border-radius:50%; pointer-events:none; z-index:-1; }
    .flex-hello-orbit-one { width:min(78vw,980px); height:min(48vw,600px); border:1px solid rgba(0,234,255,.12); transform:rotateX(68deg) rotateZ(-11deg); animation:flexOrbitOne 11s ease-in-out infinite; }
    .flex-hello-orbit-two { width:min(58vw,760px); height:min(34vw,440px); border:1px solid rgba(255,44,255,.09); transform:rotateX(68deg) rotateZ(19deg); animation:flexOrbitTwo 13s ease-in-out infinite; }
    .flex-hello-kicker { position:relative; z-index:4; margin-bottom:.2rem; font-size:clamp(.7rem,1.2vw,1rem); letter-spacing:.42em; color:#ff9933; text-shadow:0 0 10px rgba(255,153,51,.7); animation:flexHelloBreath 3.2s ease-in-out infinite; }
    .flex-hello-moniker { position:relative; z-index:4; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:clamp(.08rem,.3vw,.24rem); transform-style:preserve-3d; text-align:center; color:#fff; }
    .flex-hello-line { display:flex; align-items:center; justify-content:center; transform-style:preserve-3d; white-space:nowrap; }
    .flex-hello-line:nth-child(1) { font-size:clamp(1rem,2.1vw,1.8rem); letter-spacing:.42em; }
    .flex-hello-line:nth-child(2) { font-size:clamp(2rem,7vw,6.5rem); letter-spacing:.11em; font-weight:900; }
    .flex-hello-line:nth-child(3) { font-size:clamp(1.45rem,4.8vw,4.6rem); letter-spacing:.2em; font-weight:850; }
    /* Unitless --wave-time avoids Razor interpreting CSS generic syntax as an HTML tag. */
    @@property --wave-time { syntax: "&lt;number&gt;"; inherits: false; initial-value: 0; }
    /*
       The motion is the requested wave model:
         phase = glyphIndex * phaseStep
         x = sin(time * fx + phase) * Ax
         y = sin(time * fy + phase + phiY) * Ay
         z = sin(time * fz + phase + phiZ) * Az
         rotateX = sin(time * rx + phase + phiRX) * Rx
         rotateY = sin(time * ry + phase + phiRY) * Ry
         rotateZ = sin(time * rz + phase + phiRZ) * Rz

       --wave-time is a shared unitless cycle variable. Every glyph gets a different phase.
    */
    .flex-hello-glyph { --phase:0deg; --glyph-color:#fff; display:inline-block; position:relative; color:var(--glyph-color); transform-style:preserve-3d; transform-origin:center 72%; will-change:transform,filter; text-shadow:0 0 7px color-mix(in srgb,var(--glyph-color) 82%,white),0 0 18px color-mix(in srgb,var(--glyph-color) 48%,transparent); animation:flexGlyphWave 9s linear infinite; }
    .flex-hello-glyph::after { content:""; position:absolute; left:20%; right:20%; bottom:-.2em; height:.08em; border-radius:50%; background:var(--glyph-color); opacity:.28; filter:blur(4px); transform:scaleX(.7); }
    @@keyframes flexGlyphWave { from { --wave-time:0; } to { --wave-time:1; } }
    .flex-hello-glyph { transform:translate3d(calc(sin(calc(var(--wave-time) * 360deg + var(--phase))) * 18px),calc(sin(calc(var(--wave-time) * 421.2deg + var(--phase) + 55deg)) * 14px),calc(sin(calc(var(--wave-time) * 298.8deg + var(--phase) + 120deg)) * 24px)) rotateX(calc(sin(calc(var(--wave-time) * 388.8deg + var(--phase) + 20deg)) * 7deg)) rotateY(calc(sin(calc(var(--wave-time) * 327.6deg + var(--phase) + 95deg)) * 11deg)) rotateZ(calc(sin(calc(var(--wave-time) * 406.8deg + var(--phase) + 145deg)) * 4.5deg)); }
    .flex-hello-state { position:relative; z-index:4; margin-top:.55rem; font-size:clamp(.65rem,1vw,.9rem); letter-spacing:.24em; color:#8eefff; opacity:.78; }
    @@keyframes flexGridDrift { from{background-position:0 0,0 0} to{background-position:0 44px,44px 0} }
    @@keyframes flexWaterBreath { 0%,100%{opacity:.42;transform:perspective(700px) rotateX(66deg) scale(1)} 50%{opacity:.82;transform:perspective(700px) rotateX(66deg) scale(1.04,1.08)} }
    @@keyframes flexOrbitOne { 0%,100%{opacity:.18;transform:scale(.96) rotateX(68deg) rotateZ(-11deg)} 50%{opacity:.72;transform:scale(1.04) rotateX(68deg) rotateZ(9deg)} }
    @@keyframes flexOrbitTwo { 0%,100%{opacity:.12;transform:scale(1.02) rotateX(68deg) rotateZ(19deg)} 50%{opacity:.55;transform:scale(.94) rotateX(68deg) rotateZ(-15deg)} }
    @@keyframes flexHelloBreath { 0%,100%{opacity:.7} 50%{opacity:1} }
    @@media(max-width:700px){ .flex-hello-line:nth-child(1){font-size:clamp(.8rem,3vw,1.2rem);letter-spacing:.3em} .flex-hello-line:nth-child(2){font-size:clamp(1.45rem,8vw,3.6rem);letter-spacing:.07em} .flex-hello-line:nth-child(3){font-size:clamp(1.05rem,6vw,2.6rem);letter-spacing:.12em} }
    @@media(prefers-reduced-motion:reduce){ .flex-hello-water,.flex-hello-orbit,.flex-hello-kicker,.flex-hello-glyph{animation:none} .flex-hello-glyph{transform:none} }
</style>

@code {
    private const string NodeDefinitionName = "WorkshopLivingGuiNode";
    private const string NodeGroup = "WorkshopLivingGui";
    private const int MonikerPhaseStepDegrees = 27;
    private static readonly string[] Palette = ["#52e05a", "#00a8ff", "#ff2cff", "#ff3030", "#ff7a00", "#ffd34d"];
    private static readonly IReadOnlyList<IReadOnlyList<MonikerGlyph>> MonikerLines = BuildMonikerLines();

    private readonly List<LivingNode> Nodes = new();
    private readonly System.Timers.Timer heartbeat = new(50);
    private bool firstRender;
    private int nextNodeId;
    private bool nodeDefinitionBuilt;

    protected override void OnInitialized()
    {
        heartbeat.Elapsed += Tick;
        Experience.StateChanged += ExperienceChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || this.firstRender) return;
        this.firstRender = true;
        bool returningVisitor = string.Equals(await JS.InvokeAsync<string?>("localStorage.getItem", "WorkshopVisited"), "true", StringComparison.OrdinalIgnoreCase);
        Experience.Initialize(returningVisitor);
        heartbeat.Start();
    }

    private async Task EnterWorkshop()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "WorkshopVisited", "true");
        Experience.RequestEntry();

        // Present the moniker by itself first. Only after three seconds do we release
        // the living constructs into the Experience; the moniker remains visible after release.
        await Task.Delay(TimeSpan.FromSeconds(3));

        if (Experience.CurrentState != "FlexHello") return;
        Experience.SetState("Living");
        EnsureNodeDefinition();
        SpawnSeed(50, 50, 0);
    }

    private void Tick(object? sender, ElapsedEventArgs e)
    {
        if (!Experience.IsInitialized) return;
        if (Experience.CurrentState is "Living" or "CriticalMass")
        {
            foreach (var node in Nodes.ToArray())
            {
                node.Handle.Update(NodeGroup);
                if (node.Context.ReproductionRequested)
                {
                    node.Context.ReproductionRequested = false;
                    SpawnChild(node);
                }
            }
            if (Experience.CurrentState == "Living" && Nodes.Count >= 24) Experience.SetCriticalMassReached();
        }
        Experience.Tick();
        InvokeAsync(StateHasChanged);
    }

    private static IReadOnlyList<IReadOnlyList<MonikerGlyph>> BuildMonikerLines()
    {
        var words = new[] { "THE", "SINGULARITY", "WORKSHOP" };
        var result = new List<IReadOnlyList<MonikerGlyph>>();
        var glyphIndex = -words[0].Length;
        foreach (var word in words)
        {
            var line = new List<MonikerGlyph>(word.Length);
            foreach (var character in word)
            {
                var paletteIndex = ((glyphIndex % Palette.Length) + Palette.Length) % Palette.Length;
                line.Add(new MonikerGlyph(character, glyphIndex, glyphIndex * MonikerPhaseStepDegrees, Palette[paletteIndex]));
                glyphIndex++;
            }
            result.Add(line);
        }
        return result;
    }

    private void EnsureNodeDefinition()
    {
        if (nodeDefinitionBuilt) return;
        TheSingularityWorkshop.FSM_API.FSM_API.Create.CreateFiniteStateMachine(NodeDefinitionName, -1, NodeGroup)
            .State("Seed", NodeEnter, NodeSeedUpdate, NodeExit)
            .State("Living", NodeEnter, NodeLivingUpdate, NodeExit)
            .State("Reproducing", NodeReproduceEnter, NodeReproduceUpdate, NodeExit)
            .WithInitialState("Seed")
            .Transition("Seed", "Living", c => ((LivingNodeContext)c).DistanceToTarget <= 1.5)
            .Transition("Living", "Reproducing", c => ((LivingNodeContext)c).Scale >= 2.0)
            .Transition("Reproducing", "Living", c => ((LivingNodeContext)c).Scale <= 1.0)
            .BuildDefinition();
        nodeDefinitionBuilt = true;
    }

    private void SpawnSeed(double x, double y, int generation)
    {
        var random = Random.Shared;
        var targetX = Math.Clamp(x + random.NextDouble() * 20 - 10, 8, 92);
        var targetY = Math.Clamp(y + random.NextDouble() * 20 - 10, 12, 88);
        AddNode(x, y, targetX, targetY, generation, true);
    }

    private void SpawnChild(LivingNode parent)
    {
        var angle = Random.Shared.NextDouble() * Math.PI * 2;
        var distance = 12 + Random.Shared.NextDouble() * 10;
        var targetX = Math.Clamp(parent.X + Math.Cos(angle) * distance, 8, 92);
        var targetY = Math.Clamp(parent.Y + Math.Sin(angle) * distance, 12, 88);
        AddNode(parent.X, parent.Y, targetX, targetY, parent.Generation + 1, false);
    }

    private void AddNode(double x, double y, double targetX, double targetY, int generation, bool seed)
    {
        var context = new LivingNodeContext
        {
            Id = ++nextNodeId,
            Name = $"WorkshopLivingGuiNode-{nextNodeId}",
            IsValid = true,
            X = x,
            Y = y,
            TargetX = targetX,
            TargetY = targetY,
            Generation = generation,
            IsSeed = seed,
            Scale = seed ? .55 : .2,
            Rotation = Random.Shared.NextDouble() * 360 - 180
        };
        var handle = TheSingularityWorkshop.FSM_API.FSM_API.Create.CreateInstance(NodeDefinitionName, context, NodeGroup);
        Nodes.Add(new LivingNode(context, handle));
    }

    private static void NodeEnter(IStateContext context) { }
    private static void NodeExit(IStateContext context) { }
    private static void NodeSeedUpdate(IStateContext context) { }
    private static void NodeLivingUpdate(IStateContext context) { }
    private static void NodeReproduceEnter(IStateContext context) => ((LivingNodeContext)context).ReproductionRequested = true;
    private static void NodeReproduceUpdate(IStateContext context) { }

    private void ExperienceChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        heartbeat.Stop();
        heartbeat.Elapsed -= Tick;
        Experience.StateChanged -= ExperienceChanged;
        heartbeat.Dispose();
    }

    private sealed record MonikerGlyph(char Character, int Index, int PhaseDegrees, string Color);

    private sealed class LivingNode
    {
        public LivingNode(LivingNodeContext context, dynamic handle) { Context = context; Handle = handle; }
        public LivingNodeContext Context { get; }
        public dynamic Handle { get; }
        public double X => Context.X;
        public double Y => Context.Y;
        public double Rotation => Context.Rotation;
        public double Scale => Context.Scale;
        public int Generation => Context.Generation;
        public bool IsSeed => Context.IsSeed;
    }

    private sealed class LivingNodeContext : IStateContext
    {
        public string Name { get; set; } = string.Empty;
        public int Context_ID { get; } = Random.Shared.Next();
        public bool IsValid { get; set; }
        public int Id { get; set; }
        public double X { get; set; }
        public double Y { get; set; }
        public double TargetX { get; set; }
        public double TargetY { get; set; }
        public double Scale { get; set; }
        public double Rotation { get; set; }
        public int Generation { get; set; }
        public bool IsSeed { get; set; }
        public bool ReproductionRequested { get; set; }
        public double DistanceToTarget => Math.Sqrt(Math.Pow(TargetX - X, 2) + Math.Pow(TargetY - Y, 2));
    }
}
