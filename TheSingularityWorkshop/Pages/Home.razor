@page "/"
@inject IJSRuntime JS
@inject TheSingularityWorkshop.Services.WorkshopExperienceService Experience
@implements IDisposable
<PageTitle>The Singularity Workshop</PageTitle>

<div class="workshop-root">
    @if (Experience.CurrentState == "FirstContact")
    {
        <FirstContactView State="@Experience.FirstContact.CurrentState" Ticks="@Experience.FirstContact.StateTicks" OnEntryRequested="EnterWorkshop" />
    }
    else if (Experience.CurrentState == "Intro")
    {
        @* The landing state is the completed Hub, not a second screen. The geometry
           that grew during first contact remains the geometry of the living Hub. *@
        <FirstContactView State="Landing" Ticks="@Experience.FirstContact.StateTicks" />
    }
</div>

<style>
.workshop-root{position:relative;width:100%;height:100%;min-height:100%;overflow:hidden;background:#020711;color:#fff;font-family:Consolas,'Courier New',monospace}
.landing-stage{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1.2rem;overflow:hidden;background:radial-gradient(circle at 50% 42%,rgba(0,234,255,.09),transparent 35%),#020711}
.landing-aura{position:absolute;width:60vw;height:60vw;border:1px solid rgba(0,234,255,.08);border-radius:50%;box-shadow:0 0 100px rgba(0,234,255,.04);pointer-events:none}
.enter-workshop{position:relative;width:min(560px,62vw);height:min(390px,48vh);min-width:280px;min-height:230px;display:flex;align-items:center;justify-content:center;overflow:hidden;border:2px solid #00eaff;border-radius:16px;background:rgba(3,10,22,.76);color:#fff;cursor:pointer;box-shadow:0 0 18px rgba(0,234,255,.35),0 0 65px rgba(0,234,255,.1),inset 0 0 35px rgba(0,234,255,.06)}
.enter-workshop img{width:62%;height:62%;object-fit:cover;border-radius:50%;opacity:.88;filter:saturate(1.1);transition:transform .8s ease,filter .8s ease}.enter-workshop strong{position:absolute;bottom:8%;font-size:clamp(1rem,2vw,1.7rem);letter-spacing:.18em;text-shadow:0 0 12px #00eaff}.enter-workshop:hover img{transform:scale(1.08);filter:saturate(1.3) brightness(1.08)}
.enter-corner{position:absolute;width:42px;height:42px;z-index:2}.enter-corner::before,.enter-corner::after{content:"";position:absolute;background:#00eaff;box-shadow:0 0 8px rgba(0,234,255,.55)}.enter-corner::before{width:42px;height:1px}.enter-corner::after{width:1px;height:42px}.tl{left:15px;top:15px}.tr{right:15px;top:15px;transform:rotate(90deg)}.bl{left:15px;bottom:15px;transform:rotate(-90deg)}.br{right:15px;bottom:15px;transform:rotate(180deg)}
.enter-orbit{position:absolute;width:48%;aspect-ratio:1;border:1px solid rgba(255,44,255,.22);border-radius:50%;pointer-events:none}
.workshop-warning{width:min(680px,78%);padding:.75rem 1.2rem .85rem;box-sizing:border-box;text-align:center;background:rgba(20,10,2,.92);border:3px solid #ff6600;border-radius:5px;box-shadow:0 0 14px rgba(255,102,0,.22),0 0 30px rgba(255,102,0,.12)}
.warning-header{display:flex;justify-content:center;gap:.65rem;margin-bottom:.4rem;color:#ffb15c;font-size:clamp(.65rem,1vw,.86rem);font-weight:700;letter-spacing:.13em}.warning-body{font-size:clamp(.62rem,.9vw,.8rem);line-height:1.6;color:#dceaf2}.warning-final{color:#ffb15c}
@@media(max-width:700px){.enter-workshop{width:82vw;height:46vh}.workshop-warning{width:88%}}@@media(prefers-reduced-motion:reduce){.enter-workshop img{transition:none}}
</style>

@code {
    private readonly System.Timers.Timer heartbeat = new(50);
    private bool firstRender;
    private string lastSoundCue = "";

    protected override void OnInitialized()
    {
        heartbeat.Elapsed += Tick;
        Experience.StateChanged += ExperienceChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || this.firstRender) return;
        this.firstRender = true;
        var returningVisitor = await JS.InvokeAsync<bool>("interop.workshopVisited");
        Experience.Initialize(returningVisitor);
        heartbeat.Start();
        if (Experience.CurrentState == "FirstContact")
            await JS.InvokeVoidAsync("interop.firstContactSound", "pressure");
    }

    private async Task EnterWorkshop()
    {
        await JS.InvokeVoidAsync("interop.markWorkshopVisited");
        Experience.RequestEntry();
    }

    private void Tick(object? sender, System.Timers.ElapsedEventArgs e)
    {
        if (!Experience.IsInitialized) return;
        Experience.Tick();

        var cue = $"{Experience.FirstContact.LastSoundCue}:{Experience.Plant?.LastSoundCue}";
        if (cue != lastSoundCue)
        {
            lastSoundCue = cue;
            _ = InvokeAsync(() => JS.InvokeVoidAsync("interop.firstContactSound", cue));
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void ExperienceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        heartbeat.Stop();
        heartbeat.Elapsed -= Tick;
        Experience.StateChanged -= ExperienceChanged;
        heartbeat.Dispose();
        Experience.Dispose();
    }
}