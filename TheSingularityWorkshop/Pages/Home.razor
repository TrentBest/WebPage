@page "/"
@using System.Timers
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>The Singularity Workshop</PageTitle>

<div class="hypervisor-shell" style="position: relative; width: 100vw; height: 100vh; overflow: hidden; background: #050206; font-family: monospace; color: white;">

    @* --- LAYER 1: THE SOVEREIGN KERNEL (Silently Booting) --- *@
    <div class="unity-layer" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; pointer-events: @(currentPhase == AppPhase.Gateway || currentPhase == AppPhase.Sovereign ? "all" : "none"); opacity: @(currentPhase == AppPhase.Gateway || currentPhase == AppPhase.Sovereign ? "1" : "0"); transition: opacity 1.5s ease-in;">
        <canvas id="unity-canvas" style="width: 100%; height: 100%; display: block;"></canvas>
    </div>

    @* --- LAYER 2: THE CHAOS SWARM & MONOLITH --- *@
    @if (currentPhase == AppPhase.Monolith || currentPhase == AppPhase.Chaos || currentPhase == AppPhase.Collapsing)
    {
        <div class="chaos-container @(currentPhase == AppPhase.Collapsing ? "gravity-failure" : "")" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 10;">
            
            @* The Initial Hook *@
            @if (currentPhase == AppPhase.Monolith)
            {
                <button class="monolith-btn" @onclick="EnterHello" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 80vw; height: 80vh; background-image: url('/Images/TheSingularityWorkshopLogo.png'); background-size: contain; background-repeat: no-repeat; background-position: center; background-color: rgba(10, 10, 15, 0.9); border: 2px solid #00ffcc; border-radius: 15px; cursor: pointer; box-shadow: 0 0 50px rgba(0, 255, 204, 0.2); transition: all 0.3s ease;">
                    <div class="monolith-text" style="position: absolute; bottom: 10%; left: 50%; transform: translateX(-50%); font-size: 3rem; font-weight: bold; color: white; text-shadow: 0 0 10px #00ffcc; letter-spacing: 5px;">
                        ENTER THE WORKSHOP
                    </div>
                </button>
            }

            @* The Living Software (Breeding Buttons) *@
            @if (currentPhase == AppPhase.Chaos || currentPhase == AppPhase.Collapsing)
            {
                @foreach (var node in activeNodes)
                {
                    <button class="chaos-node" style="position: absolute; left: @(node.X)px; top: @(node.Y)px; width: @(node.Size)px; height: @(node.Size)px; z-index: @node.Generation; transform: translate(-50%, -50%); transition: width 0.1s linear, height 0.1s linear;">
                        <div class="node-gen">GEN @node.Generation</div>
                        <div class="node-lineage">[@node.Lineage]</div>
                    </button>
                }
            }
        </div>
    }

    @* --- LAYER 3: THE POST-COLLAPSE GATEWAY --- *@
    @if (currentPhase == AppPhase.Gateway)
    {
        <div class="gateway-interface" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 20; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(5, 2, 6, 0.85); backdrop-filter: blur(5px); animation: fadeIn 1.5s ease-out;">
            
            <div class="kernel-status mb-5 text-center">
                <span class="oi oi-pulse" style="color: #00ffcc; font-size: 2rem; animation: strobe 1s infinite;"></span>
                <h2 style="color: #00ffcc; font-weight: bold; letter-spacing: 3px; margin-top: 15px;">SOVEREIGN KERNEL ACTIVE</h2>
                <p style="color: #aaa; font-size: 1rem; max-width: 500px;">
                    DOM Authority Terminated. GPU Render Pipeline Online.<br/>
                    Select your destination trajectory.
                </p>
            </div>

            <div class="d-flex gap-4">
                @* Path 1: The Showcase (Active) *@
                <button class="btn gateway-btn active-path" @onclick="EnterShowcase">
                    <h3 class="mb-1">THE SHOWCASE</h3>
                    <span style="font-size: 0.8rem; opacity: 0.8;">Explore the Architectural Demonstrations</span>
                </button>

                @* Path 2: The Forge (Locked) *@
                <button class="btn gateway-btn locked-path" disabled title="Infrastructure actively being built">
                    <h3 class="mb-1" style="color: #ff3366;">THE FORGE</h3>
                    <span style="font-size: 0.8rem; opacity: 0.8;">[ UNDER CONSTRUCTION ]</span>
                </button>
            </div>
        </div>
    }

    @if (currentPhase == AppPhase.Hello)
    {
        <section class="hello-world" aria-live="polite" aria-label="The Singularity Workshop">
            <div class="hello-water" aria-hidden="true"></div>
            <div class="hello-orbit hello-orbit-one" aria-hidden="true"></div>
            <div class="hello-orbit hello-orbit-two" aria-hidden="true"></div>
            <div class="hello-moniker" aria-label="THE SINGULARITY WORKSHOP">
                @foreach (var line in MonikerLines)
                {
                    <div class="hello-line">
                        @foreach (var glyph in line)
                        {
                            <span class="hello-glyph" style="--phase:@(glyph.PhaseDegrees)deg;--glyph-color:@glyph.Color;">@glyph.Character</span>
                        }
                    </div>
                }
            </div>
        </section>
    }
</div>

<style>
    /* Swarm Node Styles */
    .chaos-node {
        border-radius: 8px; border: 1px solid rgba(0, 255, 204, 0.5);
        color: white; background: rgba(5, 2, 6, 0.8); backdrop-filter: blur(2px);
        overflow: hidden; display: flex; flex-direction: column; justify-content: center; align-items: center;
        box-shadow: 0 0 15px rgba(0, 255, 204, 0.3); pointer-events: none;
    }
    .node-gen { font-size: 0.7rem; color: #00ffcc; font-weight: bold; }
    .node-lineage { font-size: 0.6rem; opacity: 0.7; }

    /* The Gravity Drop Animation */
    .gravity-failure {
        transform: translateY(150vh) rotate(10deg);
        opacity: 0;
        transition: all 1.5s cubic-bezier(0.55, 0.085, 0.68, 0.53);
        pointer-events: none;
    }

    /* Gateway Styles */
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes strobe { 0% { opacity: 1; } 50% { opacity: 0.2; } 100% { opacity: 1; } }
    
    .gateway-btn {
        background: rgba(10, 10, 15, 0.9); border: 1px solid #444; color: white;
        padding: 20px 40px; width: 300px; text-align: left; border-radius: 8px; transition: all 0.3s;
    }
    .active-path { border-left: 5px solid #00ffcc; }
    .active-path:hover { background: rgba(0, 255, 204, 0.1); border-color: #00ffcc; box-shadow: 0 0 20px rgba(0, 255, 204, 0.2); transform: translateX(5px); color: white; }
    .locked-path { border-left: 5px solid #ff3366; opacity: 0.6; cursor: not-allowed; }

    /* Hello World: the first Experience after the gateway click. */
    .hello-world { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; overflow:hidden; isolation:isolate; perspective:1000px; background:radial-gradient(circle at 50% 46%,rgba(0,234,255,.12),transparent 32%),radial-gradient(ellipse at 50% 90%,rgba(0,168,255,.12),transparent 48%),#020711; }
    .hello-world::before { content:""; position:absolute; inset:0; z-index:-4; background-image:linear-gradient(rgba(0,234,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,44,255,.035) 1px,transparent 1px); background-size:44px 44px; animation:helloGridDrift 18s linear infinite; }
    .hello-world::after { content:""; position:absolute; inset:0; z-index:-3; pointer-events:none; background:linear-gradient(180deg,rgba(2,7,17,.05),rgba(0,168,255,.035) 55%,rgba(2,7,17,.65)); }
    .hello-water { position:absolute; left:-12%; right:-12%; bottom:-18%; height:65%; z-index:-2; opacity:.72; background:radial-gradient(ellipse at 50% 100%,rgba(0,168,255,.2),transparent 60%),repeating-radial-gradient(ellipse at 50% 115%,transparent 0 7%,rgba(0,234,255,.045) 7.3% 7.6%,transparent 8% 14%); filter:blur(1px); transform:perspective(700px) rotateX(66deg); transform-origin:center bottom; animation:helloWaterBreath 8s ease-in-out infinite; }
    .hello-orbit { position:absolute; border-radius:50%; pointer-events:none; z-index:-1; }
    .hello-orbit-one { width:min(78vw,980px); height:min(48vw,600px); border:1px solid rgba(0,234,255,.12); transform:rotateX(68deg) rotateZ(-11deg); animation:helloOrbitOne 11s ease-in-out infinite; }
    .hello-orbit-two { width:min(58vw,760px); height:min(34vw,440px); border:1px solid rgba(255,44,255,.09); transform:rotateX(68deg) rotateZ(19deg); animation:helloOrbitTwo 13s ease-in-out infinite; }
    .hello-moniker { position:relative; z-index:4; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:clamp(.08rem,.3vw,.24rem); transform-style:preserve-3d; text-align:center; color:#fff; }
    .hello-line { display:flex; align-items:center; justify-content:center; transform-style:preserve-3d; white-space:nowrap; }
    .hello-line:nth-child(1) { font-size:clamp(1rem,2.1vw,1.8rem); letter-spacing:.42em; }
    .hello-line:nth-child(2) { font-size:clamp(2rem,7vw,6.5rem); letter-spacing:.11em; font-weight:900; }
    .hello-line:nth-child(3) { font-size:clamp(1.45rem,4.8vw,4.6rem); letter-spacing:.2em; font-weight:850; }
    @@property --wave-time { syntax: "&lt;number&gt;"; inherits: false; initial-value: 0; }
    /*
       The motion is the requested wave model:
         phase = glyphIndex * phaseStep
         x = sin(time * fx + phase) * Ax
         y = sin(time * fy + phase + phiY) * Ay
         z = sin(time * fz + phase + phiZ) * Az
         rotateX = sin(time * rx + phase + phiRX) * Rx
         rotateY = sin(time * ry + phase + phiRY) * Ry
         rotateZ = sin(time * rz + phase + phiRZ) * Rz

       --wave-time is a shared unitless cycle variable. Every glyph gets a different phase.
    */
    .hello-glyph { --phase:0deg; --glyph-color:#fff; display:inline-block; position:relative; color:var(--glyph-color); transform-style:preserve-3d; transform-origin:center 72%; will-change:transform,filter; text-shadow:0 0 7px color-mix(in srgb,var(--glyph-color) 82%,white),0 0 18px color-mix(in srgb,var(--glyph-color) 48%,transparent); animation:helloGlyphWave 9s linear infinite; }
    .hello-glyph::after { content:""; position:absolute; left:20%; right:20%; bottom:-.2em; height:.08em; border-radius:50%; background:var(--glyph-color); opacity:.28; filter:blur(4px); transform:scaleX(.7); }
    @@keyframes helloGlyphWave { from { --wave-time:0; } to { --wave-time:1; } }
    .hello-glyph { transform:translate3d(calc(sin(calc(var(--wave-time) * 360deg + var(--phase))) * 18px),calc(sin(calc(var(--wave-time) * 421.2deg + var(--phase) + 55deg)) * 14px),calc(sin(calc(var(--wave-time) * 298.8deg + var(--phase) + 120deg)) * 24px)) rotateX(calc(sin(calc(var(--wave-time) * 388.8deg + var(--phase) + 20deg)) * 7deg)) rotateY(calc(sin(calc(var(--wave-time) * 327.6deg + var(--phase) + 95deg)) * 11deg)) rotateZ(calc(sin(calc(var(--wave-time) * 406.8deg + var(--phase) + 145deg)) * 4.5deg)); }
    @@keyframes helloGridDrift { from{background-position:0 0,0 0} to{background-position:0 44px,44px 0} }
    @@keyframes helloWaterBreath { 0%,100%{opacity:.42;transform:perspective(700px) rotateX(66deg) scale(1)} 50%{opacity:.82;transform:perspective(700px) rotateX(66deg) scale(1.04,1.08)} }
    @@keyframes helloOrbitOne { 0%,100%{opacity:.18;transform:scale(.96) rotateX(68deg) rotateZ(-11deg)} 50%{opacity:.72;transform:scale(1.04) rotateX(68deg) rotateZ(9deg)} }
    @@keyframes helloOrbitTwo { 0%,100%{opacity:.12;transform:scale(1.02) rotateX(68deg) rotateZ(19deg)} 50%{opacity:.55;transform:scale(.94) rotateX(68deg) rotateZ(-15deg)} }
    @@media(max-width:700px){ .hello-line:nth-child(1){font-size:clamp(.8rem,3vw,1.2rem);letter-spacing:.3em} .hello-line:nth-child(2){font-size:clamp(1.45rem,8vw,3.6rem);letter-spacing:.07em} .hello-line:nth-child(3){font-size:clamp(1.05rem,6vw,2.6rem);letter-spacing:.12em} }
    @@media(prefers-reduced-motion:reduce){ .hello-water,.hello-orbit,.hello-glyph{animation:none} .hello-glyph{transform:none} }
</style>

@code {
    private enum AppPhase { Monolith, Chaos, Collapsing, Gateway, Sovereign, Hello }
    private AppPhase currentPhase = AppPhase.Monolith;

    private class ChaosNode
    {
        public double X { get; set; }
        public double Y { get; set; }
        public double Size { get; set; }
        public int Generation { get; set; }
        public string Lineage { get; set; } = "";
        public int OffspringCount { get; set; } = 0;
    }

    private List<ChaosNode> activeNodes = new();
    private Timer chaosTimer = new();
    private Random rng = new();
    
    private const int CriticalMassThreshold = 100; // Drops when 100 buttons fill the screen
    private const int MonikerPhaseStepDegrees = 27;
    private static readonly string[] Palette = ["#52e05a", "#00a8ff", "#ff2cff", "#ff3030", "#ff7a00", "#ffd34d"];
    private static readonly IReadOnlyList<IReadOnlyList<MonikerGlyph>> MonikerLines = BuildMonikerLines();

    protected override void OnInitialized()
    {
        chaosTimer.Interval = 100;
        chaosTimer.Elapsed += TickChaos;
    }

    private void EnterHello()
    {
        currentPhase = AppPhase.Hello;
        StateHasChanged();
    }

    private void TickChaos(object? sender, ElapsedEventArgs e)
    {
        if (currentPhase != AppPhase.Chaos) return;
        List<ChaosNode> newborns = new();
        foreach (var node in activeNodes)
        {
            node.Size += 10;
            if (node.Size > 180)
            {
                node.Size = 60;
                node.OffspringCount++;
                newborns.Add(new ChaosNode
                {
                    X = node.X + rng.Next(-200, 200),
                    Y = node.Y + rng.Next(-200, 200),
                    Generation = node.Generation + 1,
                    Lineage = $"{node.Lineage}.{node.OffspringCount}",
                    Size = 60
                });
            }
        }
        if (newborns.Any())
        {
            activeNodes.AddRange(newborns);
            foreach(var n in activeNodes)
            {
                if (n.X < 100) n.X = 150; if (n.X > 1800) n.X = 1700;
                if (n.Y < 100) n.Y = 150; if (n.Y > 900) n.Y = 800;
            }
        }
        if (activeNodes.Count >= CriticalMassThreshold) _ = TriggerCollapse();
        else InvokeAsync(StateHasChanged);
    }

    private async Task TriggerCollapse()
    {
        chaosTimer.Stop();
        currentPhase = AppPhase.Collapsing;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(1500);
        currentPhase = AppPhase.Gateway;
        await InvokeAsync(StateHasChanged);
    }

    private void EnterShowcase()
    {
        currentPhase = AppPhase.Sovereign;
    }

    private static IReadOnlyList<IReadOnlyList<MonikerGlyph>> BuildMonikerLines()
    {
        var words = new[] { "THE", "SINGULARITY", "WORKSHOP" };
        var result = new List<IReadOnlyList<MonikerGlyph>>();
        var glyphIndex = -words[0].Length;
        foreach (var word in words)
        {
            var line = new List<MonikerGlyph>(word.Length);
            foreach (var character in word)
            {
                var paletteIndex = ((glyphIndex % Palette.Length) + Palette.Length) % Palette.Length;
                line.Add(new MonikerGlyph(character, glyphIndex, glyphIndex * MonikerPhaseStepDegrees, Palette[paletteIndex]));
                glyphIndex++;
            }
            result.Add(line);
        }
        return result;
    }

    public void Dispose()
    {
        chaosTimer.Stop();
        chaosTimer.Dispose();
    }

    private readonly record struct MonikerGlyph(char Character, int GlyphIndex, int PhaseDegrees, string Color);
}