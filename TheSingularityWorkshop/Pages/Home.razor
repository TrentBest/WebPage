@page "/"

<PageTitle>The Singularity Workshop</PageTitle>

<div class="text-center py-5 bg-white">
    <div class="container">

        <img src="TheSingularityWorkshopSplashSceneWithLetters.jpg"
             alt="The Singularity Workshop Splash Logo"
             class="img-fluid mb-4"
             style="max-width: 800px; height: auto; border-radius: 10px; box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);" />

        <h1 class="display-4 fw-bold text-dark mt-4 mb-3">
            Welcome to the Workshop
        </h1>

        <p class="lead text-muted fst-italic">
            **Forging Software for the Singularity.** Our core mission is to provide the engine-agnostic logic layer essential for the next generation of digital experiences.
        </p>

        <a href="about-us" class="btn btn-lg btn-primary mt-3">
            Explore Our Mission
        </a>
        <a href="https://www.nuget.org/packages/TheSingularityWorkshop.FSM_API" target="_blank" class="btn btn-lg btn-outline-secondary mt-3 ms-3">
            FSM API on NuGet
        </a>
    </div>
</div>

<div class="container py-5">
    <div class="row">
        <div class="col-md-6">
            <h2 class="h3 fw-bold text-primary">Deterministic Power</h2>
            <p>The FSM\_API is your foundation for reliable, scalable, and fully testable application logic, proven across console, WPF, and now, Blazor WebAssembly.</p>
        </div>
        <div class="col-md-6">
            <h2 class="h3 fw-bold text-primary">Compliance First</h2>
            <p>This site serves as our compliant publisher hub, ensuring our upcoming Unity Asset Store package has the required web presence, documentation, and contact points.</p>
        </div>
    </div>
</div>