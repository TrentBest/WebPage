@page "/"
@using System.Timers
@using TheSingularityWorkshop.FSM_API
@inject IJSRuntime JS
@inject TheSingularityWorkshop.Services.WorkshopExperienceService Experience
@implements IDisposable

<PageTitle>The Singularity Workshop</PageTitle>

<div class="workshop-root">
    <div class="unity-layer @(Experience.ShowUnity ? "visible" : "")">
        <canvas id="unity-canvas"></canvas>
        @if (Experience.CurrentState == "Unity")
        {
            <div class="unity-transition" aria-hidden="true">
                <div class="unity-made">MADE WITH UNITY</div>
                <div class="unity-moniker">THE SINGULARITY WORKSHOP</div>
            </div>
        }
    </div>

    @if (Experience.CurrentState is "Intro" or "Living")
    {
        <div class="experience-layer">
            <div class="ambient-grid"></div>
            <div class="ambient-orbit orbit-one"></div>
            <div class="ambient-orbit orbit-two"></div>

            @if (Experience.CurrentState == "Intro")
            {
                <section class="monolith-stage">
                    <div class="monolith-aura"></div>
                    <button class="monolith-btn" @onclick="EnterWorkshop" @onmouseover="WarningHovered" aria-label="Enter The Singularity Workshop">
                        <span class="corner tl"></span><span class="corner tr"></span>
                        <span class="corner bl"></span><span class="corner br"></span>
                        <img src="/Images/TheSingularityWorkshopLogo.png" alt="The Singularity Workshop" />
                        <span class="enter-label">ENTER THE WORKSHOP</span>
                    </button>
                    <div class="warning @(warningHovered ? "warning-hot" : "")">
                        <div>⚠ SYSTEM ADVISORY ⚠</div>
                        <small>Maximum overdrive active. Viewer discretion and spare RAM advised.</small>
                    </div>
                </section>
            }

            @foreach (var node in Nodes)
            {
                <div class="living-node @(node.IsSeed ? "seed" : "")" style="left:@(node.X)%;top:@(node.Y)%;transform:translate(-50%,-50%) rotate(@(node.Rotation)deg) scale(@(node.Scale));">
                    <div class="node-core"></div>
                    <div class="node-ring"></div>
                    <span>GEN @node.Generation</span>
                </div>
            }
        </div>
    }
</div>

<style>
    .workshop-root { position:relative; width:100%; height:100%; min-height:calc(100vh - 4rem); overflow:hidden; background:#020711; color:#fff; font-family:Consolas,'Courier New',monospace; }
    .unity-layer { position:absolute; inset:0; z-index:1; opacity:0; pointer-events:none; transition:opacity 1.25s ease; background:#000; }
    .unity-layer.visible { opacity:1; pointer-events:auto; }
    .unity-layer canvas { position:absolute; inset:0; width:100%; height:100%; display:block; }
    .experience-layer { position:absolute; inset:0; z-index:10; overflow:hidden; background:radial-gradient(circle at 50% 45%,rgba(0,234,255,.08),transparent 35%),radial-gradient(circle at 25% 70%,rgba(255,44,255,.06),transparent 35%),#020711; }
    .ambient-grid { position:absolute; inset:0; opacity:.3; background-image:linear-gradient(rgba(0,234,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(0,234,255,.05) 1px,transparent 1px); background-size:44px 44px; animation:grid-drift 18s linear infinite; }
    .ambient-orbit { position:absolute; left:50%; top:50%; border:1px solid rgba(0,234,255,.1); border-radius:50%; transform:translate(-50%,-50%) rotateX(65deg); pointer-events:none; animation:orbit 7s ease-in-out infinite; }
    .orbit-one { width:min(78vw,1000px); height:min(78vw,1000px); }
    .orbit-two { width:min(55vw,700px); height:min(55vw,700px); border-color:rgba(255,44,255,.09); animation-delay:-2.4s; }
    .monolith-stage { position:absolute; inset:0; display:flex; flex-direction:column; justify-content:center; align-items:center; gap:2rem; }
    .monolith-aura { position:absolute; width:min(65vw,850px); height:min(65vw,850px); border-radius:50%; background:radial-gradient(circle,rgba(0,234,255,.08),transparent 62%); animation:aura 4s ease-in-out infinite; }
    .monolith-btn { position:relative; z-index:3; width:min(58vw,760px); height:min(50vh,520px); min-width:300px; min-height:260px; padding:1rem; display:flex; align-items:center; justify-content:center; overflow:hidden; border:2px solid #00eaff; border-radius:18px; background:rgba(3,10,22,.76); cursor:pointer; box-shadow:0 0 18px rgba(0,234,255,.45),0 0 70px rgba(0,234,255,.12),inset 0 0 45px rgba(0,234,255,.06); transition:transform .35s ease,box-shadow .35s ease,border-color .35s ease; }
    .monolith-btn:hover { transform:scale(1.025); border-color:#ff2cff; box-shadow:0 0 22px rgba(255,44,255,.65),0 0 80px rgba(0,234,255,.16),inset 0 0 45px rgba(255,44,255,.08); }
    .monolith-btn img { max-width:82%; max-height:78%; object-fit:contain; filter:saturate(1.08); pointer-events:none; }
    .enter-label { position:absolute; bottom:7%; font-size:clamp(1rem,2.1vw,2rem); font-weight:700; letter-spacing:.16em; text-shadow:0 0 10px #00eaff,0 0 28px rgba(0,234,255,.7); animation:breathe 3.4s ease-in-out infinite; }
    .corner { position:absolute; width:42px; height:42px; border-color:#00eaff; border-style:solid; opacity:.65; }
    .tl { left:14px; top:14px; border-width:2px 0 0 2px; } .tr { right:14px; top:14px; border-width:2px 2px 0 0; }
    .bl { left:14px; bottom:14px; border-width:0 0 2px 2px; } .br { right:14px; bottom:14px; border-width:0 2px 2px 0; }
    .warning { position:relative; z-index:4; width:min(620px,80vw); padding:.8rem 1.1rem; text-align:center; border:2px solid #ff6600; background:rgba(25,10,2,.9); box-shadow:0 0 16px rgba(255,102,0,.2); animation:warning-breathe 3s ease-in-out infinite; transition:transform .3s ease,box-shadow .3s ease; }
    .warning-hot { transform:scale(1.045); box-shadow:0 0 30px rgba(255,102,0,.55); }
    .warning small { display:block; margin-top:.35rem; opacity:.9; }
    .living-node { position:absolute; width:54px; height:54px; z-index:20; transition:left .08s linear,top .08s linear; }
    .living-node .node-core { position:absolute; inset:13px; border-radius:50%; background:#00eaff; box-shadow:0 0 10px #00eaff,0 0 30px rgba(0,234,255,.7); }
    .living-node .node-ring { position:absolute; inset:0; border:1px solid rgba(255,44,255,.65); border-radius:50%; animation:ring 2.8s ease-in-out infinite; }
    .living-node span { position:absolute; top:60px; left:50%; transform:translateX(-50%); font-size:9px; white-space:nowrap; opacity:.65; }
    .living-node.seed .node-core { background:#fff; }
    .unity-transition { position:absolute; inset:0; z-index:5; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:1rem; background:radial-gradient(circle,rgba(0,0,0,.1),rgba(0,0,0,.65)); pointer-events:none; }
    .unity-made { font-size:clamp(.8rem,1.5vw,1.2rem); letter-spacing:.35em; opacity:.85; animation:fade-up 1.2s ease forwards; }
    .unity-moniker { font-size:clamp(1.4rem,4vw,3.5rem); font-weight:800; letter-spacing:.18em; text-align:center; text-shadow:0 0 15px #00eaff,0 0 40px rgba(255,44,255,.4); animation:moniker 2.8s ease forwards; }
    @@keyframes breathe { 0%,100%{opacity:.82}50%{opacity:1} }
    @@keyframes warning-breathe { 0%,100%{border-color:#ff6600}50%{border-color:#ffd34d} }
    @@keyframes aura { 0%,100%{transform:scale(.94);opacity:.45}50%{transform:scale(1.04);opacity:.8} }
    @@keyframes orbit { 0%,100%{transform:translate(-50%,-50%) rotateX(65deg) scale(.96);opacity:.35}50%{transform:translate(-50%,-50%) rotateX(65deg) scale(1.04);opacity:.7} }
    @@keyframes ring { 0%,100%{transform:scale(.86);opacity:.3}50%{transform:scale(1.18);opacity:.9} }
    @@keyframes grid-drift { to{background-position:44px 44px} }
    @@keyframes fade-up { from{opacity:0;transform:translateY(15px)} to{opacity:1;transform:none} }
    @@keyframes moniker { 0%{opacity:0;transform:scale(.92)}35%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(1.03)} }
    @@media(max-width:700px){.monolith-btn{width:82vw;height:48vh}.warning{width:86vw}.living-node{width:42px;height:42px}.living-node span{top:47px}}
</style>

@code {
    private const string NodeDefinitionName = "WorkshopLivingGuiNode";
    private const string NodeGroup = "WorkshopLivingGui";
    private readonly List<LivingNode> Nodes = new();
    private readonly System.Timers.Timer heartbeat = new(50);
    private bool firstRender;
    private bool warningHovered;
    private int nextNodeId;
    private bool nodeDefinitionBuilt;
    private bool unityStarted;

    protected override void OnInitialized()
    {
        heartbeat.Elapsed += Tick;
        Experience.StateChanged += ExperienceChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || this.firstRender) return;
        this.firstRender = true;

        bool returningVisitor = await JS.InvokeAsync<bool>("interop.workshopVisited");
        Experience.Initialize(returningVisitor);
        heartbeat.Start();

        if (returningVisitor)
        {
            unityStarted = true;
            await StartUnity();
        }
    }

    private async Task EnterWorkshop()
    {
        warningHovered = false;
        await JS.InvokeVoidAsync("interop.markWorkshopVisited");
        Experience.RequestEntry();
        EnsureNodeDefinition();
        SpawnSeed(50, 50, 0);
    }

    private void WarningHovered() => warningHovered = true;

    private void Tick(object? sender, ElapsedEventArgs e)
    {
        if (!Experience.IsInitialized) return;

        if (Experience.CurrentState == "Living")
        {
            foreach (var node in Nodes.ToArray())
            {
                node.Handle.Update(NodeGroup);
                if (node.Context.ReproductionRequested)
                {
                    node.Context.ReproductionRequested = false;
                    SpawnChild(node);
                }
            }

            if (Nodes.Count >= 24)
            {
                Experience.SetCriticalMassReached();
            }
        }

        Experience.Tick();

        if (Experience.CurrentState == "Unity" && !unityStarted)
        {
            unityStarted = true;
            _ = StartUnity();
        }

        InvokeAsync(StateHasChanged);
    }

    private async Task StartUnity()
    {
        try
        {
            await InvokeAsync(StateHasChanged);
            await Task.Delay(100);
            await JS.InvokeVoidAsync("interop.initUnity", "unity-canvas");
            Experience.MarkUnityStarted();
        }
        catch { }
    }

    private void EnsureNodeDefinition()
    {
        if (nodeDefinitionBuilt) return;

        FSM_API.FSM_API.Create.CreateFiniteStateMachine(NodeDefinitionName, -1, NodeGroup)
            .State("Seed", NodeEnter, NodeSeedUpdate, NodeExit)
            .State("Living", NodeEnter, NodeLivingUpdate, NodeExit)
            .State("Reproducing", NodeReproduceEnter, NodeReproduceUpdate, NodeExit)
            .WithInitialState("Seed")
            .Transition("Seed", "Living", c => ((LivingNodeContext)c).DistanceToTarget <= 1.5)
            .Transition("Living", "Reproducing", c => ((LivingNodeContext)c).Scale >= 2.0)
            .Transition("Reproducing", "Living", c => ((LivingNodeContext)c).Scale <= 1.0)
            .BuildDefinition();

        nodeDefinitionBuilt = true;
    }

    private void SpawnSeed(double x, double y, int generation)
    {
        var random = Random.Shared;
        var targetX = Math.Clamp(x + random.NextDouble() * 60 - 30, 8, 92);
        var targetY = Math.Clamp(y + random.NextDouble() * 60 - 30, 10, 88);
        var context = new LivingNodeContext(nextNodeId++, generation, x, y, targetX, targetY)
        {
            Lineage = generation == 0 ? "0" : $"{generation}"
        };
        var handle = FSM_API.FSM_API.Create.CreateInstance(NodeDefinitionName, context, NodeGroup);
        Nodes.Add(new LivingNode(handle, context));
    }

    private void SpawnChild(LivingNode parent)
    {
        var random = Random.Shared;
        var angle = random.NextDouble() * Math.PI * 2;
        var distance = 7 + random.NextDouble() * 13;
        var x = Math.Clamp(parent.Context.X + Math.Cos(angle) * distance, 6, 94);
        var y = Math.Clamp(parent.Context.Y + Math.Sin(angle) * distance, 8, 90);
        var targetX = Math.Clamp(x + random.NextDouble() * 28 - 14, 6, 94);
        var targetY = Math.Clamp(y + random.NextDouble() * 28 - 14, 8, 90);
        var generation = parent.Context.Generation + 1;
        var context = new LivingNodeContext(nextNodeId++, generation, x, y, targetX, targetY)
        {
            Lineage = $"{parent.Context.Lineage}.{random.Next(10, 99)}"
        };
        var handle = FSM_API.FSM_API.Create.CreateInstance(NodeDefinitionName, context, NodeGroup);
        Nodes.Add(new LivingNode(handle, context));
    }

    private static void NodeEnter(IStateContext context) { }
    private static void NodeExit(IStateContext context) { }
    private static void NodeSeedUpdate(IStateContext context)
    {
        var node = (LivingNodeContext)context;
        var dx = node.TargetX - node.X;
        var dy = node.TargetY - node.Y;
        var distance = Math.Sqrt(dx * dx + dy * dy);
        node.DistanceToTarget = distance;
        if (distance > 0.01)
        {
            var step = Math.Min(1.8, distance);
            node.X += dx / distance * step;
            node.Y += dy / distance * step;
            node.Rotation += 18;
            node.Scale = Math.Min(1, node.Scale + .08);
        }
    }

    private static void NodeLivingUpdate(IStateContext context)
    {
        var node = (LivingNodeContext)context;
        node.Scale += .035;
        node.Rotation += .6;
        node.X = Math.Clamp(node.X + Math.Sin(node.Age * .035 + node.Id) * .035, 5, 95);
        node.Y = Math.Clamp(node.Y + Math.Cos(node.Age * .029 + node.Id) * .035, 7, 93);
        node.Age++;
    }

    private static void NodeReproduceEnter(IStateContext context) => ((LivingNodeContext)context).ReproductionRequested = true;
    private static void NodeReproduceUpdate(IStateContext context)
    {
        var node = (LivingNodeContext)context;
        node.Scale -= .12;
        node.Rotation += 1.5;
    }

    private void ExperienceChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        heartbeat.Stop();
        heartbeat.Elapsed -= Tick;
        Experience.StateChanged -= ExperienceChanged;
        heartbeat.Dispose();
    }

    private sealed record LivingNode(FSMHandle Handle, LivingNodeContext Context)
    {
        public double X => Context.X;
        public double Y => Context.Y;
        public double Scale => Context.Scale;
        public double Rotation => Context.Rotation;
        public int Generation => Context.Generation;
        public bool IsSeed => Handle.CurrentState == "Seed";
    }

    private sealed class LivingNodeContext : IStateContext
    {
        public LivingNodeContext(int id, int generation, double x, double y, double targetX, double targetY)
        {
            Id = id; Generation = generation; X = x; Y = y; TargetX = targetX; TargetY = targetY;
        }
        public string Name { get; set; } = NodeDefinitionName;
        public bool IsValid { get; set; } = true;
        public int Id { get; }
        public int Generation { get; }
        public double X { get; set; }
        public double Y { get; set; }
        public double TargetX { get; }
        public double TargetY { get; }
        public double DistanceToTarget { get; set; } = double.MaxValue;
        public double Scale { get; set; } = .15;
        public double Rotation { get; set; }
        public int Age { get; set; }
        public string Lineage { get; set; } = "0";
        public bool ReproductionRequested { get; set; }
    }
}
