    private static void RenderDemonstrationDiagram(
        RenderTreeBuilder builder,
        ref int sequence,
        DemonstrationDefinition demonstration)
    {
        if (string.Equals(demonstration.DiagramKind, "event-horizon-buckets", StringComparison.OrdinalIgnoreCase))
        {
            builder.OpenElement(sequence++, "section");
            builder.AddAttribute(sequence++, "class", "demonstration-diagram");
            builder.AddAttribute(sequence++, "aria-label", "Conceptual near and far event horizon processing buckets");
            builder.OpenElement(sequence++, "p");
            builder.AddAttribute(sequence++, "class", "demonstration-diagram-label");
            builder.AddContent(sequence++, "CONCEPTUAL MODEL // DIFFERENT UPDATE CADENCES");
            builder.CloseElement();
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "demonstration-diagram-grid");
            AddDiagramNode(builder, ref sequence, "NEAR FIELD", "Refresh more often when detail is relevant; update the representation from current source data.");
            AddDiagramNode(builder, ref sequence, "FAR FIELD", "Refresh less often; retain cached output while its dependencies remain valid.");
            builder.CloseElement();
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "demonstration-diagram-flow");
            builder.AddContent(sequence++, "SOURCE CHANGE");
            builder.OpenElement(sequence++, "b");
            builder.AddContent(sequence++, "→");
            builder.CloseElement();
            builder.AddContent(sequence++, "INVALIDATE AFFECTED DEPENDENTS");
            builder.OpenElement(sequence++, "b");
            builder.AddContent(sequence++, "→");
            builder.CloseElement();
            builder.AddContent(sequence++, "RECOMPUTE WHEN ELIGIBLE");
            builder.CloseElement();
            builder.OpenElement(sequence++, "p");
            builder.AddAttribute(sequence++, "class", "demonstration-diagram-disclaimer");
            builder.AddContent(sequence++, "Architecture illustration only. It does not represent a running renderer or measured frame-rate gain.");
            builder.CloseElement();
            builder.CloseElement();
        }
        else if (string.Equals(demonstration.DiagramKind, "native-surface-lifecycle", StringComparison.OrdinalIgnoreCase))
        {
            builder.OpenElement(sequence++, "section");
            builder.AddAttribute(sequence++, "class", "demonstration-diagram");
            builder.AddAttribute(sequence++, "aria-label", "Conceptual native WPF and Direct3D 12 surface lifecycle");
            builder.OpenElement(sequence++, "p");
            builder.AddAttribute(sequence++, "class", "demonstration-diagram-label");
            builder.AddContent(sequence++, "SOURCE-SCOPE DIAGRAM // NOT A RUNTIME CAPTURE");
            builder.CloseElement();
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "demonstration-native-flow");
            foreach (var step in new[] { "WPF HOST", "DEVICE / QUEUE", "SWAPCHAIN", "PRESENT / RESIZE", "RESOURCE LIFETIME" })
            {
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "demonstration-native-step");
                builder.AddContent(sequence++, step);
                builder.CloseElement();
            }
            builder.CloseElement();
            builder.OpenElement(sequence++, "p");
            builder.AddAttribute(sequence++, "class", "demonstration-diagram-disclaimer");
            builder.AddContent(sequence++, "This diagram summarizes the areas described by the sample; it is not evidence of geometry rendering or a verified hardware run.");
            builder.CloseElement();
            builder.CloseElement();
        }
    }

