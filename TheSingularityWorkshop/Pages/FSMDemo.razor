@page "/fsmdemo"
@using TheSingularityWorkshop.Services
@inject FSMManagerService FSMService

<PageTitle>FSM Demo</PageTitle>

<h1>FSM Service Integration</h1>
<p>This demonstrates injecting the FSMManagerService and driving the real PageFSM through its context signals.</p>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">FSM State and Context</h5>
        <dl>
            <dt>Current FSM State:</dt>
            <dd><strong>@FSMService.CurrentState</strong></dd>

            <dt>Enter Requested:</dt>
            <dd>@FSMService.Context.EnterRequested</dd>

            <dt>Living GUI Populated:</dt>
            <dd>@FSMService.Context.LivingGuiPopulated</dd>

            <dt>Moniker Ready:</dt>
            <dd>@FSMService.Context.MonikerReady</dd>

            <dt>Gravity Released:</dt>
            <dd>@FSMService.Context.GravityReleased</dd>

            <dt>Navigation Ready:</dt>
            <dd>@FSMService.Context.NavigationReady</dd>

            <dt>Total Ticks:</dt>
            <dd>@FSMService.Context.TotalTicks</dd>
        </dl>
    </div>
</div>

<button class="btn btn-primary mt-3" @onclick="StepFSM">
    Step FSM (Update Loop)
</button>

<button class="btn btn-secondary mt-3" @onclick="RequestEnter">
    Request Enter
</button>

<button class="btn btn-outline-danger mt-3" @onclick="Shutdown">
    Shutdown
</button>

@code {
    private void StepFSM()
    {
        FSMService.Step();
        StateHasChanged();
    }

    private void RequestEnter()
    {
        FSMService.RequestEnter();
        StateHasChanged();
    }

    private void Shutdown()
    {
        FSMService.Shutdown();
        StateHasChanged();
    }
}
