@using TheSingularityWorkshop.Shared

<div class="top-row ps-3 navbar navbar-dark workshop-navbar-brand">
    <div class="container-fluid workshop-brand-stack" aria-label="The Singularity Workshop">
        <a class="navbar-brand workshop-brand" href="">
            <span>T</span><span>H</span><span>E</span>
            <span class="brand-gap"></span>
            <span>S</span><span>I</span><span>N</span><span>G</span><span>U</span><span>L</span><span>A</span><span>R</span><span>I</span><span>T</span><span>Y</span>
            <span class="brand-gap"></span>
            <span>W</span><span>O</span><span>R</span><span>K</span><span>S</span><span>H</span><span>O</span><span>P</span>
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="demos">
                <span class="oi oi-list" aria-hidden="true"></span> Demos
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="privacypolicy">
                <span class="oi oi-info" aria-hidden="true"></span> Privacy Policy
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="naming-poll">
                <span class="oi oi-graph" aria-hidden="true"></span> Vote on Name
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="about">
                <span class="oi oi-info" aria-hidden="true"></span> About
            </NavLink>
        </div>

        <LoginStatus />
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}

<style>
    .workshop-navbar-brand {
        min-height: 7.5rem;
        padding: 0.75rem 0.5rem;
    }

    .workshop-brand-stack {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
    }

    .workshop-brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0;
        margin: 0;
        padding: 0;
        font-family: Consolas, 'Courier New', monospace;
        font-size: clamp(0.95rem, 1.5vw, 1.35rem);
        font-weight: 800;
        line-height: 0.86;
        letter-spacing: 0.03em;
        text-decoration: none;
        text-align: center;
        white-space: nowrap;
    }

    .workshop-brand span:not(.brand-gap) {
        display: block;
        animation: workshopBrandBreath 3.4s ease-in-out infinite;
    }

    .workshop-brand span:nth-child(6n + 1) { color: #00a8ff; }
    .workshop-brand span:nth-child(6n + 2) { color: #ff2cff; }
    .workshop-brand span:nth-child(6n + 3) { color: #ff7a00; }
    .workshop-brand span:nth-child(6n + 4) { color: #ff3030; }
    .workshop-brand span:nth-child(6n + 5) { color: #ffd34d; }
    .workshop-brand span:nth-child(6n + 6) { color: #52e05a; }

    .workshop-brand .brand-gap {
        height: 0.32em;
    }

    .workshop-brand span:nth-child(2) { animation-delay: -0.17s; }
    .workshop-brand span:nth-child(3) { animation-delay: -0.34s; }
    .workshop-brand span:nth-child(4) { animation-delay: -0.51s; }
    .workshop-brand span:nth-child(5) { animation-delay: -0.68s; }
    .workshop-brand span:nth-child(6) { animation-delay: -0.85s; }

    /* Razor treats a single @ as C# syntax inside .razor markup.
       CSS therefore requires @@keyframes here so the emitted stylesheet
       contains the normal CSS @keyframes rule. */
    @@keyframes workshopBrandBreath {
        0%, 100% { filter: brightness(.82); text-shadow: 0 0 4px currentColor; transform: translateY(0); }
        50% { filter: brightness(1.35); text-shadow: 0 0 10px currentColor, 0 0 20px currentColor; transform: translateY(-1px); }
    }
</style>
