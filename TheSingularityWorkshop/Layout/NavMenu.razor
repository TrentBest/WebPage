@using TheSingularityWorkshop.Shared

<div class="top-row ps-3 navbar navbar-dark workshop-navbar-brand">
    <div class="container-fluid workshop-brand-stack" aria-label="The Singularity Workshop">
        <a class="navbar-brand workshop-brand" href="">
            <span class="brand-word">
                <span class="brand-letter blue">T</span><span class="brand-letter magenta">H</span><span class="brand-letter orange">E</span>
            </span>
            <span class="brand-word">
                <span class="brand-letter red">S</span><span class="brand-letter yellow">I</span><span class="brand-letter green">N</span><span class="brand-letter blue">G</span><span class="brand-letter magenta">U</span><span class="brand-letter orange">L</span><span class="brand-letter red">A</span><span class="brand-letter yellow">R</span><span class="brand-letter green">I</span><span class="brand-letter blue">T</span><span class="brand-letter magenta">Y</span>
            </span>
            <span class="brand-word">
                <span class="brand-letter orange">W</span><span class="brand-letter red">O</span><span class="brand-letter yellow">R</span><span class="brand-letter green">K</span><span class="brand-letter blue">S</span><span class="brand-letter magenta">H</span><span class="brand-letter orange">O</span><span class="brand-letter red">P</span>
            </span>
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="demos">
                <span class="oi oi-list" aria-hidden="true"></span> Demos
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="privacypolicy">
                <span class="oi oi-info" aria-hidden="true"></span> Privacy Policy
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="naming-poll">
                <span class="oi oi-graph" aria-hidden="true"></span> Vote on Name
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="about">
                <span class="oi oi-info" aria-hidden="true"></span> About
            </NavLink>
        </div>

        <LoginStatus />
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}

<style>
    .workshop-navbar-brand {
        min-height: 7.5rem;
        padding: 0.75rem 0.5rem;
    }

    .workshop-brand-stack {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
    }

    .workshop-brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.18rem;
        width: 100%;
        margin: 0;
        padding: 0;
        font-family: Consolas, 'Courier New', monospace;
        font-size: clamp(0.7rem, 1.25vw, 1.05rem);
        font-weight: 800;
        line-height: 1;
        text-decoration: none;
        text-align: center;
        white-space: nowrap;
    }

    .workshop-brand .brand-word {
        display: block;
        width: max-content;
        max-width: 100%;
        white-space: nowrap;
        line-height: 1;
    }

    .workshop-brand .brand-letter {
        display: inline-block;
        animation: workshopBrandBreath 3.4s ease-in-out infinite;
        transform-origin: center;
    }

    .workshop-brand .blue { color: #00a8ff; }
    .workshop-brand .magenta { color: #ff2cff; }
    .workshop-brand .orange { color: #ff7a00; }
    .workshop-brand .red { color: #ff3030; }
    .workshop-brand .yellow { color: #ffd34d; }
    .workshop-brand .green { color: #52e05a; }

    .workshop-brand .brand-letter:nth-child(2) { animation-delay: -0.17s; }
    .workshop-brand .brand-letter:nth-child(3) { animation-delay: -0.34s; }
    .workshop-brand .brand-letter:nth-child(4) { animation-delay: -0.51s; }
    .workshop-brand .brand-letter:nth-child(5) { animation-delay: -0.68s; }
    .workshop-brand .brand-letter:nth-child(6) { animation-delay: -0.85s; }
    .workshop-brand .brand-letter:nth-child(7) { animation-delay: -1.02s; }
    .workshop-brand .brand-letter:nth-child(8) { animation-delay: -1.19s; }
    .workshop-brand .brand-letter:nth-child(9) { animation-delay: -1.36s; }
    .workshop-brand .brand-letter:nth-child(10) { animation-delay: -1.53s; }
    .workshop-brand .brand-letter:nth-child(11) { animation-delay: -1.70s; }

    /* Razor requires the escaped form below so the emitted stylesheet contains the CSS animation rule. */
    @@keyframes workshopBrandBreath {
        0%, 100% { filter: brightness(.82); text-shadow: 0 0 4px currentColor; transform: translateY(0) scale(1); }
        50% { filter: brightness(1.35); text-shadow: 0 0 10px currentColor, 0 0 20px currentColor; transform: translateY(-1px) scale(1.05); }
    }
</style>
