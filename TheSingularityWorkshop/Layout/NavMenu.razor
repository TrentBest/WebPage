<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">TheSingularityWorkshop</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        @* >>> CORE TECHNOLOGY TABS <<< *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="fsm-api">
                <span class="oi oi-aperture" aria-hidden="true"></span> FSM_API
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="fsm-layer">
                <span class="oi oi-puzzle-piece" aria-hidden="true"></span> FSM Layer
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="experience">
                <span class="oi oi-monitor" aria-hidden="true"></span> Experience
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="my-vr">
                <span class="oi oi-cloud" aria-hidden="true"></span> MyVR
            </NavLink>
        </div>

        @* >>> ADMINISTRATIVE TABS <<< *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="about-us">
                <span class="oi oi-people" aria-hidden="true"></span> About Us
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
