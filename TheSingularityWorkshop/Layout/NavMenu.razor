@using TheSingularityWorkshop.Shared

<div class="workshop-nav-shell @(collapseNavMenu ? "collapsed" : "expanded")">
    <div class="workshop-nav-head">
        <a class="navbar-brand workshop-brand" href="" aria-label="The Singularity Workshop">
            <span class="brand-word"><span class="brand-letter blue">T</span><span class="brand-letter magenta">H</span><span class="brand-letter orange">E</span></span>
            <span class="brand-word"><span class="brand-letter red">S</span><span class="brand-letter yellow">I</span><span class="brand-letter green">N</span><span class="brand-letter blue">G</span><span class="brand-letter magenta">U</span><span class="brand-letter orange">L</span><span class="brand-letter red">A</span><span class="brand-letter yellow">R</span><span class="brand-letter green">I</span><span class="brand-letter blue">T</span><span class="brand-letter magenta">Y</span></span>
            <span class="brand-word"><span class="brand-letter orange">W</span><span class="brand-letter red">O</span><span class="brand-letter yellow">R</span><span class="brand-letter green">K</span><span class="brand-letter blue">S</span><span class="brand-letter magenta">H</span><span class="brand-letter orange">O</span><span class="brand-letter red">P</span></span>
        </a>
        <button type="button" title="@(collapseNavMenu ? "Expand Workshop navigation" : "Collapse Workshop navigation")" class="workshop-nav-toggle" @onclick="ToggleNavMenu" aria-label="@(collapseNavMenu ? "Expand Workshop navigation" : "Collapse Workshop navigation")">
            @(collapseNavMenu ? "≪" : "≫")
        </button>
    </div>

    @if (!collapseNavMenu)
    {
        <div class="workshop-nav-links">
            <NavLink class="nav-link explore-nav-item" href="explore" @onclick="CollapseNavMenu"><span class="oi oi-eye" aria-hidden="true"></span> Explore</NavLink>
            <NavLink class="nav-link explore3d-nav-item" href="rendering" @onclick="CollapseNavMenu"><span class="oi oi-globe" aria-hidden="true"></span> Rendering</NavLink>
            <NavLink class="nav-link research-nav-item" href="research" @onclick="CollapseNavMenu"><span class="oi oi-project" aria-hidden="true"></span> Research</NavLink>
            <NavLink class="nav-link create-nav-item" href="create" @onclick="CollapseNavMenu"><span class="oi oi-wrench" aria-hidden="true"></span> Create</NavLink>
            <NavLink class="nav-link" href="education" @onclick="CollapseNavMenu">Education</NavLink>
            <NavLink class="nav-link" href="madmen" @onclick="CollapseNavMenu">Madmen</NavLink>
            <NavLink class="nav-link about-nav-item" href="about-us" @onclick="CollapseNavMenu"><span class="oi oi-info" aria-hidden="true"></span> About Us</NavLink>
        </div>
    }
</div>

<style>
    .workshop-nav-shell{position:relative;min-height:100vh;width:100%;box-sizing:border-box;padding:.75rem .5rem;background:linear-gradient(180deg,rgba(2,7,17,.98),rgba(7,2,17,.96));border-right:1px solid rgba(0,234,255,.22);box-shadow:inset -12px 0 30px rgba(255,44,255,.025)}
    .workshop-nav-head{display:flex;align-items:center;justify-content:center;gap:.4rem;min-height:6rem}.workshop-nav-shell.expanded .workshop-nav-head{justify-content:space-between}
    .workshop-brand{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.16rem;margin:0;padding:0;font-family:Consolas,'Courier New',monospace;font-size:clamp(.58rem,1vw,.86rem);font-weight:800;line-height:1;text-decoration:none;white-space:nowrap}.workshop-nav-shell.collapsed .workshop-brand{display:none}.workshop-brand .brand-word{display:block;width:max-content;line-height:1}.workshop-brand .brand-letter{display:inline-block;animation:workshopMonikerWave 3.8s cubic-bezier(.42,0,.58,1) infinite;transform-origin:50% 55%;transform-style:preserve-3d}.workshop-brand .blue{color:#00a8ff}.workshop-brand .magenta{color:#ff2cff}.workshop-brand .orange{color:#ff7a00}.workshop-brand .red{color:#ff3030}.workshop-brand .yellow{color:#ffd34d}.workshop-brand .green{color:#52e05a}.workshop-brand .brand-letter:nth-child(2){animation-delay:-.14s}.workshop-brand .brand-letter:nth-child(3){animation-delay:-.28s}.workshop-brand .brand-letter:nth-child(4){animation-delay:-.42s}.workshop-brand .brand-letter:nth-child(5){animation-delay:-.56s}.workshop-brand .brand-letter:nth-child(6){animation-delay:-.70s}.workshop-brand .brand-letter:nth-child(7){animation-delay:-.84s}.workshop-brand .brand-letter:nth-child(8){animation-delay:-.98s}.workshop-brand .brand-letter:nth-child(9){animation-delay:-1.12s}.workshop-brand .brand-letter:nth-child(10){animation-delay:-1.26s}.workshop-brand .brand-letter:nth-child(11){animation-delay:-1.40s}
    .workshop-nav-toggle{width:2.4rem;height:2.4rem;border:1px solid rgba(0,234,255,.45);background:rgba(0,234,255,.04);color:#00eaff;font:800 1rem Consolas,'Courier New',monospace;box-shadow:0 0 14px rgba(0,234,255,.08);cursor:pointer}.workshop-nav-toggle:hover{color:#ff2cff;border-color:#ff2cff;box-shadow:0 0 18px rgba(255,44,255,.16)}
    .workshop-nav-shell.collapsed .workshop-nav-toggle{margin:0 auto}.workshop-nav-links{display:flex;flex-direction:column;gap:.35rem;margin-top:.5rem}.workshop-nav-links .nav-link{padding:.7rem .75rem;border-left:2px solid transparent;color:#7e9aa5;text-decoration:none;font:700 .72rem Consolas,'Courier New',monospace;letter-spacing:.08em;text-transform:uppercase}.workshop-nav-links .nav-link:hover{color:#fff;border-left-color:#ff2cff;background:rgba(255,44,255,.045)}.workshop-nav-links .nav-link.active{color:#fff;border-left-color:#00eaff;background:linear-gradient(90deg,rgba(0,234,255,.07),transparent)}.explore3d-nav-item{color:#00eaff!important}.research-nav-item{color:#ff38d1!important}.create-nav-item{color:#ffd34d!important}.about-nav-item{color:#ff6fff!important}
    @@keyframes workshopMonikerWave{0%,100%{transform:translateY(0) rotateX(0deg) rotateY(0deg) rotateZ(-1.65deg) scale(1);filter:brightness(.92) saturate(.96)}18%{transform:translateY(-.08em) rotateX(3deg) rotateY(-4deg) rotateZ(2.35deg) scale(1.012);filter:brightness(1.02) saturate(1.04)}38%{transform:translateY(-.18em) rotateX(-2deg) rotateY(6deg) rotateZ(3.65deg) scale(1.025);filter:brightness(1.1) saturate(1.12)}58%{transform:translateY(.055em) rotateX(4deg) rotateY(-7deg) rotateZ(-3.05deg) scale(1.008);filter:brightness(1.04) saturate(1.06)}78%{transform:translateY(-.12em) rotateX(-3deg) rotateY(5deg) rotateZ(2.25deg) scale(1.018);filter:brightness(1.07) saturate(1.1)}}
    @@media(max-width:700px){.workshop-nav-shell{min-height:auto}.workshop-nav-shell.expanded{min-height:8rem}.workshop-nav-links{flex-direction:row;flex-wrap:wrap}.workshop-nav-links .nav-link{flex:1 1 auto}}
</style>

@code {
    private bool collapseNavMenu;
    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
    private void CollapseNavMenu() => collapseNavMenu = true;
}
