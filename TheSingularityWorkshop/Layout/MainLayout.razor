@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject TheSingularityWorkshop.Services.FSMManagerService FSM
@inject TheSingularityWorkshop.Services.WorkshopExperienceService Experience
@inject IJSRuntime JS
@implements IDisposable

<div class="page @(IsWorkshopLanding ? "workshop-page" : "") @(ShowWorkshopChrome ? "workshop-chrome-visible" : "workshop-chrome-hidden")">
    @if (!IsWorkshopLanding)
    {
        <div class="sidebar workshop-sidebar"><NavMenu /></div>
    }
    else
    {
        <div class="sidebar workshop-sidebar" aria-hidden="true"><NavMenu /></div>
    }

    <main>
        @if (!IsWorkshopLanding || ShowWorkshopChrome)
        {
            <div class="top-row px-4 workshop-tab-header"><span class="workshop-tab-title">@CurrentTabTitle</span></div>
        }
        else
        {
            <div class="top-row workshop-tab-header workshop-top-row-placeholder" aria-hidden="true"></div>
        }

        <article class="content px-4 @(IsWorkshopLanding ? "workshop-content" : "")">@Body</article>
    </main>
</div>

@code {
    private bool IsWorkshopLanding => string.IsNullOrWhiteSpace(Navigation.ToBaseRelativePath(Navigation.Uri));

    // The Hub belongs to the execution host. It presents after the terminal
    // startup Experience has had its presentation window, not after an arbitrary
    // moniker-specific FSM transition completes.
    private bool ShowWorkshopChrome => !IsWorkshopLanding || _startupPresentationComplete;

    private bool _entryRequested;
    private bool _chromeReleased;
    private bool _startupPresentationComplete;
    private CancellationTokenSource? _monikerTimer;

    private string CurrentTabTitle
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');
            return path.ToLowerInvariant() switch
            {
                "" => "THE WORKSHOP",
                "demos" => "DEMOS",
                "ai" => "AI",
                "library" => "LIBRARY",
                "about" => "ABOUT",
                "living-gui" => "THE LIVING GUI",
                "privacypolicy" => "PRIVACY POLICY",
                "naming-poll" => "VOTE ON NAME",
                _ => path.Replace('-', ' ').ToUpperInvariant()
            };
        }
    }

    protected override void OnInitialized()
    {
        FSM.StateChanged += HandleFSMStateChanged;
        Experience.StateChanged += HandleExperienceStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsWorkshopLanding && !_entryRequested && Experience.CurrentState == "FlexHello")
        {
            _entryRequested = true;
            FSM.RequestEnter();
            return;
        }

        if (!IsWorkshopLanding || !ShowWorkshopChrome || _chromeReleased)
            return;

        _chromeReleased = true;

        try
        {
            await JS.InvokeVoidAsync(
                "eval",
                "if(document.fullscreenElement&&document.exitFullscreen)document.exitFullscreen();document.documentElement.classList.remove('workshop-splash-locked');document.documentElement.classList.add('workshop-splash-released');");
        }
        catch (JSException)
        {
            _chromeReleased = false;
        }
    }

    private void HandleFSMStateChanged(string state)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleExperienceStateChanged()
    {
        // FlexHello is the actual visible Moniker Experience on the landing page.
        // Start the host-owned presentation window when that Experience becomes
        // visible, rather than waiting for PageFSM's internal MonikerReveal tick.
        if (Experience.CurrentState == "FlexHello" && _monikerTimer is null && !_startupPresentationComplete)
            StartStartupPresentationTimer();

        _ = InvokeAsync(StateHasChanged);
    }

    private void StartStartupPresentationTimer()
    {
        _monikerTimer = new CancellationTokenSource();
        var token = _monikerTimer.Token;
        _ = CompleteStartupPresentationAsync(token);
    }

    private async Task CompleteStartupPresentationAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(FSM.Page.MonikerPresentationDuration, cancellationToken);

            if (cancellationToken.IsCancellationRequested)
                return;

            _startupPresentationComplete = true;
            FSM.SignalNavigationReady();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Normal disposal cancellation.
        }
    }

    public void Dispose()
    {
        FSM.StateChanged -= HandleFSMStateChanged;
        Experience.StateChanged -= HandleExperienceStateChanged;
        _monikerTimer?.Cancel();
        _monikerTimer?.Dispose();
    }
}
