@inherits LayoutComponentBase
@inject NavigationManager Navigation
@using TheSingularityWorkshop.Components

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 workshop-tab-header">
            <span class="workshop-tab-title">@CurrentTabTitle</span>
        </div>

        <article class="content px-4 @(IsWorkshopLanding ? "workshop-content" : "")"
                 @onclick="HandleLandingClick">
            @if (IsWorkshopLanding)
            {
                <CascadingValue Value="(Action)StopPong">
                    @Body
                </CascadingValue>
            }
            else
            {
                @Body
            }
        </article>

        @if (IsWorkshopLanding && _pongActive)
        {
            <PongField @ref="_pongField" />
        }
    </main>
</div>

@if (IsWorkshopLanding)
{
    <style>
        .workshop-content {
            position: fixed !important;
            inset: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden !important;
            z-index: 9000;
        }

        .workshop-content .hypervisor-shell {
            position: fixed !important;
            inset: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            min-height: 100vh !important;
        }

        /*
           The landing no longer asks the visitor to choose between Showcase and Forge.
           Once the existing landing FSM reaches Gateway, the gateway itself becomes
           the hand-off: The Singularity Workshop appears for three seconds while the
           ordinary browser chrome wakes back up underneath it.

           This is deliberately CSS-driven for this visual transition. The underlying
           landing state is still supplied by Home.razor; the next pass can move this
           presentation state into the Workshop/FSM machinery once that boundary exists.
        */
        .workshop-content:has(.gateway-interface) {
            pointer-events: none;
        }

        .workshop-content:has(.gateway-interface) .gateway-interface {
            background: rgba(2, 7, 17, 0.96);
            backdrop-filter: blur(8px);
            animation: landingMonikerFade 3s ease-in-out forwards;
        }

        .workshop-content:has(.gateway-interface) .gateway-interface > * {
            display: none !important;
        }

        .workshop-content:has(.gateway-interface) .gateway-interface::before {
            content: "THE SINGULARITY WORKSHOP";
            display: block;
            color: #ffffff;
            font-family: Consolas, 'Courier New', monospace;
            font-size: clamp(1.4rem, 4.5vw, 5rem);
            font-weight: 800;
            letter-spacing: clamp(.08em, .35vw, .2em);
            text-align: center;
            text-shadow:
                0 0 10px #00eaff,
                0 0 30px rgba(0, 234, 255, .75),
                0 0 65px rgba(255, 44, 255, .45);
            animation: landingMonikerBreath 1.5s ease-in-out infinite;
        }

        /*
           The experience feed was originally a stock-style overlay. Its observations
           belong with the warning label, not floating across the living interface.
           Present the useful facts as the first layer of that warning instead.
        */
        .workshop-content:has(.workshop-warning) .workshop-warning::before {
            content: "OBSERVATIONS BEFORE ENTRY\\A\\A• PONG STARTS AFTER 200 HEARTBEATS.\\A• EACH HEARTBEAT IS 50 MILLISECONDS.\\A• PONG IS DRIVEN BY FSM_API.\\A• CYAN IS THE VISITOR. MAGENTA IS THE MACHINE.\\A• THE FIRST SERVE GOES TOWARD THE MACHINE.\\A• THE MACHINE KEEPS SCORE.\\A";
            display: block;
            margin: 0 0 .65rem;
            padding: .45rem .6rem .6rem;
            border-bottom: 1px solid rgba(255, 102, 0, .42);
            color: rgba(255, 226, 196, .88);
            font-family: Consolas, 'Courier New', monospace;
            font-size: clamp(.52rem, .72vw, .66rem);
            font-weight: 600;
            letter-spacing: .06em;
            line-height: 1.45;
            text-align: left;
            white-space: pre-line;
        }

        /* Guarantee the paddle label is physically stacked, regardless of inherited button styles. */
        .pong-paddle {
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
        }

        .pong-paddle > span {
            display: block !important;
            width: 100% !important;
            height: auto !important;
            text-align: center !important;
            writing-mode: horizontal-tb !important;
            white-space: nowrap !important;
        }

        .page:has(.gateway-interface) .sidebar,
        .page:has(.gateway-interface) main > .top-row {
            position: relative;
            z-index: 10001;
            animation: landingChromeAppear 3s ease-in-out both;
        }

        @@keyframes landingMonikerFade {
            0%, 72% { opacity: 1; }
            100% { opacity: 0; visibility: hidden; }
        }

        @@keyframes landingMonikerBreath {
            0%, 100% { transform: scale(.985); opacity: .82; }
            50% { transform: scale(1.025); opacity: 1; }
        }

        @@keyframes landingChromeAppear {
            0%, 72% { opacity: 0; }
            100% { opacity: 1; }
        }
    </style>
}

@code {
    private PongField? _pongField;
    private bool _pongActive = true;

    private bool IsWorkshopLanding => string.IsNullOrWhiteSpace(Navigation.ToBaseRelativePath(Navigation.Uri));

    private string CurrentTabTitle
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');

            return path.ToLowerInvariant() switch
            {
                "" => "THE WORKSHOP",
                "demos" => "DEMOS",
                "ai" => "AI",
                "privacypolicy" => "PRIVACY POLICY",
                "naming-poll" => "VOTE ON NAME",
                _ => path.Replace('-', ' ').ToUpperInvariant()
            };
        }
    }

    private void HandleLandingClick()
    {
        StopPong();
    }

    private void StopPong()
    {
        if (!_pongActive) return;

        _pongActive = false;
        _pongField?.StopFromLandingInteraction();
        StateHasChanged();
    }
}
