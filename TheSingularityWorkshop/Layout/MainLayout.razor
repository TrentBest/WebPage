@inherits LayoutComponentBase
@inject NavigationManager Navigation
@using TheSingularityWorkshop.Components

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 workshop-tab-header">
            <span class="workshop-tab-title">@CurrentTabTitle</span>
        </div>

        <article class="content px-4 @(IsWorkshopLanding ? "workshop-content" : "")"
                 @onclick="HandleLandingClick">
            @if (IsWorkshopLanding)
            {
                <CascadingValue Value="(Action)StopPong">
                    @Body
                </CascadingValue>
            }
            else
            {
                @Body
            }
        </article>

        @if (IsWorkshopLanding)
        {
            <WorkshopExperienceFeed />
            <WorkshopBrowserRuntime />
        }

        @if (IsWorkshopLanding && _pongActive)
        {
            <PongField @ref="_pongField" />
        }
    </main>
</div>

@if (IsWorkshopLanding)
{
    <style>
        .workshop-content {
            position: fixed !important;
            inset: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden !important;
            z-index: 9000;
        }

        .workshop-content .hypervisor-shell {
            position: fixed !important;
            inset: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            min-height: 100vh !important;
        }

        /*
           The landing layers are mutually exclusive.

           The browser-native runtime is mounted with the normal layout so it can
           exist for the entire lifetime of the landing page, but it MUST NOT paint
           until the Gateway hand-off. Previously it was visible during Monolith /
           Chaos / Collapse, which put the new runtime above the actual entry button
           and warning because the runtime owns z-index 9990 while the landing owns
           z-index 9000.

           This is a visibility gate, not a stacking-order hack: the old landing gets
           the screen first; the browser runtime gets the screen only at Gateway.
        */
        .page:has(.browser-runtime) main > .browser-runtime {
            visibility: hidden;
            opacity: 0;
            pointer-events: none;
        }

        .workshop-content:has(.gateway-interface) {
            pointer-events: none;
            z-index: 1;
        }

        .workshop-content:has(.gateway-interface) .gateway-interface {
            background: rgba(2, 7, 17, 0.96);
            backdrop-filter: blur(8px);
            animation: landingMonikerFade 3s ease-in-out forwards;
        }

        .workshop-content:has(.gateway-interface) .gateway-interface > * {
            display: none !important;
        }

        .workshop-content:has(.gateway-interface) .gateway-interface::before {
            content: "TRENT BEST";
            display: block;
            color: #ffffff;
            font-family: Consolas, 'Courier New', monospace;
            font-size: clamp(2rem, 6vw, 6rem);
            font-weight: 800;
            letter-spacing: clamp(.16em, .5vw, .28em);
            text-align: center;
            text-shadow:
                0 0 10px #00eaff,
                0 0 30px rgba(0, 234, 255, .75),
                0 0 65px rgba(255, 44, 255, .45);
            animation: landingMonikerBreath 1.5s ease-in-out infinite;
        }

        .page:has(.gateway-interface) .sidebar,
        .page:has(.gateway-interface) main > .top-row {
            position: relative;
            z-index: 10001;
            animation: landingChromeAppear 3s ease-in-out both;
        }

        /*
           Gateway hands the content surface back to the normal page layout.
           The sidebar and top row remain outside this surface; the runtime fills
           the remaining main flex region beneath the top row.
        */
        .page:has(.gateway-interface) main > .browser-runtime {
            visibility: hidden;
            opacity: 0;
            pointer-events: none;
            animation: browserRuntimeRelease .9s ease-out 3s forwards;
        }

        @@keyframes landingMonikerFade {
            0%, 72% { opacity: 1; }
            100% { opacity: 0; visibility: hidden; }
        }

        @@keyframes landingMonikerBreath {
            0%, 100% { transform: scale(.985); opacity: .82; }
            50% { transform: scale(1.025); opacity: 1; }
        }

        @@keyframes landingChromeAppear {
            0%, 72% { opacity: 0; }
            100% { opacity: 1; }
        }

        @@keyframes browserRuntimeRelease {
            from { visibility: hidden; opacity: 0; transform: scale(1.015); }
            to { visibility: visible; opacity: 1; transform: scale(1); pointer-events: auto; }
        }
    </style>
}

@code {
    private PongField? _pongField;
    private bool _pongActive = true;

    private bool IsWorkshopLanding => string.IsNullOrWhiteSpace(Navigation.ToBaseRelativePath(Navigation.Uri));

    private string CurrentTabTitle
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');

            return path.ToLowerInvariant() switch
            {
                "" => "THE WORKSHOP",
                "demos" => "DEMOS",
                "ai" => "AI",
                "privacypolicy" => "PRIVACY POLICY",
                "naming-poll" => "VOTE ON NAME",
                _ => path.Replace('-', ' ').ToUpperInvariant()
            };
        }
    }

    private void HandleLandingClick()
    {
        StopPong();
    }

    private void StopPong()
    {
        if (!_pongActive) return;

        _pongActive = false;
        _pongField?.StopFromLandingInteraction();
        StateHasChanged();
    }
}
