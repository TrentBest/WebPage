<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <BlazorEnableCompression>false</BlazorEnableCompression>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WorkshopUseRepositorySources)' == 'true'">
    <DefineConstants>$(DefineConstants);WORKSHOP_USE_REPOSITORY_SOURCES;WORKSHOP_USE_RENDERER_SOURCE</DefineConstants>
    <WorkshopSourceRoot>$(MSBuildThisFileDirectory)..\..\</WorkshopSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="8.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.20" PrivateAssets="all" />
    <!-- NuGet mode is the safe default. Opt into sibling development sources with
         -p:WorkshopUseRepositorySources=true from a workspace containing the repositories below. -->
    <PackageReference Include="TheSingularityWorkshop.FSM_API" Version="1.0.13" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.MicroBundleDomain" Version="1.0.1" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.FSM_COS" Version="0.1.0-alpha.6" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.GUI.Blazor" Version="0.1.0-alpha.8" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.ProtocolAi" Version="0.1.0-alpha.2" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />
    <PackageReference Include="TheSingularityWorkshop.GrammarAi" Version="0.1.0-alpha.2" Condition="'$(WorkshopUseRepositorySources)' != 'true'" />

    <ProjectReference Include="..\..\FSM_API\FSM_API\FSM_API.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
    <ProjectReference Include="..\..\TheSingularityWorkshop.MicroBundleDomain\TheSingularityWorkshop.MicroBundleDomain.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
    <ProjectReference Include="..\..\TheSingularityWorkshop.FSM_COS\src\FSM_COS\FSM_COS.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
    <ProjectReference Include="..\..\TheSingularityWorkshop.GUI\src\Blazor\TheSingularityWorkshop.GUI.Blazor.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
    <ProjectReference Include="..\..\TheSingularityWorkshop.ProtocolAi\TheSingularityWorkshop.ProtocolAi.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
    <ProjectReference Include="..\..\TheSingularityWorkshop.GrammarAi\TheSingularityWorkshop.GrammarAi.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
    <ProjectReference Include="..\..\TheSingularityWorkshop.Renderer\TheSingularityWorkshop.Renderer.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
    <ProjectReference Include="..\..\TheSingularityWorkshop.Visualize\TheSingularityWorkshop.Visualize.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" />
    <ProjectReference Include="..\..\TheSingularityWorkshop.Visualize\integrations\RendererAdapter\TheSingularityWorkshop.Renderer.VisualizeAdapter.csproj" Condition="'$(WorkshopUseRepositorySources)' == 'true'" AdditionalProperties="WorkshopUseRepositorySources=true;WorkshopSourceRoot=$(WorkshopSourceRoot)" />
    <ProjectReference Include="..\SingularityHub\SingularityHub.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\Images\TheSingularityWorkshopLogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\Images\TheSingularityWorkshopSplashSceneWithLetters.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Infastructure\Demos\FoxesAndDogs\" />
  </ItemGroup>


  <Target Name="ValidateWorkshopRepositorySources" BeforeTargets="PrepareForBuild" Condition="'$(WorkshopUseRepositorySources)' == 'true'">
    <Error Condition="!Exists('..\..\FSM_API\FSM_API\FSM_API.csproj')" Text="Workshop source mode requires sibling repository FSM_API on development." />
    <Error Condition="!Exists('..\..\TheSingularityWorkshop.MicroBundleDomain\TheSingularityWorkshop.MicroBundleDomain.csproj')" Text="Workshop source mode requires sibling repository TheSingularityWorkshop.MicroBundleDomain on development." />
    <Error Condition="!Exists('..\..\TheSingularityWorkshop.FSM_COS\src\FSM_COS\FSM_COS.csproj')" Text="Workshop source mode requires sibling repository TheSingularityWorkshop.FSM_COS on development." />
    <Error Condition="!Exists('..\..\TheSingularityWorkshop.GUI\src\Blazor\TheSingularityWorkshop.GUI.Blazor.csproj')" Text="Workshop source mode requires sibling repository TheSingularityWorkshop.GUI on development." />
    <Error Condition="!Exists('..\..\TheSingularityWorkshop.ProtocolAi\TheSingularityWorkshop.ProtocolAi.csproj')" Text="Workshop source mode requires sibling repository TheSingularityWorkshop.ProtocolAi on development." />
    <Error Condition="!Exists('..\..\TheSingularityWorkshop.GrammarAi\TheSingularityWorkshop.GrammarAi.csproj')" Text="Workshop source mode requires sibling repository TheSingularityWorkshop.GrammarAi on development." />
    <Error Condition="!Exists('..\..\TheSingularityWorkshop.Renderer\TheSingularityWorkshop.Renderer.csproj')" Text="Workshop source mode requires sibling repository TheSingularityWorkshop.Renderer on development." />
    <Error Condition="!Exists('..\..\TheSingularityWorkshop.Visualize\TheSingularityWorkshop.Visualize.csproj')" Text="Workshop source mode requires sibling repository TheSingularityWorkshop.Visualize on development." />
  </Target>


  <ItemGroup>
    <!-- The file is generated during the build, so declare it explicitly before it exists. -->
    <Content Remove="wwwroot\\Workshop\\Forge\\StreamingAssets\\Experiences\\singularity-studios-stage-plan.svg" />
    <Content Include="wwwroot\\Workshop\\Forge\\StreamingAssets\\Experiences\\singularity-studios-stage-plan.svg" />
  </ItemGroup>

  <Target Name="GenerateSingularityStudiosStagePlan" BeforeTargets="ResolveStaticWebAssetsInputs"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\samples\SingularityStudiosPlan\SingularityStudiosPlan.csproj&quot; --configuration $(Configuration) -- &quot;$(MSBuildProjectDirectory)\wwwroot\Workshop\Forge\StreamingAssets\Experiences\singularity-studios-stage-plan.svg&quot;" />
  </Target>

</Project>
