<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API documentation is expanded incrementally; do not turn every undocumented member into build noise. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <BlazorEnableCompression>false</BlazorEnableCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="8.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.20" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.20" PrivateAssets="all" />
    <PackageReference Include="TheSingularityWorkshop.FSM_API" Version="1.0.13" />
    <PackageReference Include="TheSingularityWorkshop.FSM_COS" Version="0.1.0-alpha.1" />
    <PackageReference Include="TheSingularityWorkshop.GUI.Blazor" Version="0.1.0-alpha.5" />
    <ProjectReference Include="..\SingularityHub\SingularityHub.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\Images\TheSingularityWorkshopLogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\Images\TheSingularityWorkshopSplashSceneWithLetters.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Infastructure\Demos\FoxesAndDogs\" />
  </ItemGroup>

</Project>
