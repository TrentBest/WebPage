{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/_framework/*",
      "/Workshop/*",
      "/css/*",
      "/Images/*"
    ]
  },
  "mimeTypes": {
    ".wasm": "application/wasm",
    ".dll": "application/octet-stream",
    ".data": "application/octet-stream",
    ".br": "application/brotli",
    ".gz": "application/gzip",
    ".js": "text/javascript",
    ".json": "application/json"
  },
  "globalHeaders": {
    "Cache-Control": "no-store, must-revalidate"
  }
}