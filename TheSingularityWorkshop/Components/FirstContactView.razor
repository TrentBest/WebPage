@using TheSingularityWorkshop.Workshop.Plant

<section class="first-contact-stage @(State == "Moniker" || State == "HubGrowth" ? "living" : "")" aria-live="polite">
    @if (State == "Statement" || State == "Question")
    {
        var secondProgress = State == "Statement" ? 0d : Math.Clamp(Ticks / 30d, 0d, 1d);
        var fadeProgress = State == "Statement" ? 0d : Math.Clamp((Ticks - 30d) / 40d, 0d, 1d);
        var firstOpacity = State == "Statement"
            ? Math.Clamp(Ticks / 35d, 0d, 1d)
            : .18 * (1d - fadeProgress);

        <div class="contact-half top">
            <div class="contact-label statement" style="@LabelStyle(firstOpacity, State == "Statement" ? Ticks / 35d : secondProgress)">THEY SAY A PICTURE IS WORTH A THOUSAND WORDS.</div>
        </div>
        <div class="contact-half bottom">
            <div class="contact-label question" style="@QuestionStyle(secondProgress, fadeProgress)">HOW MANY WORDS IS A LIVING IMAGE WORTH?</div>
        </div>
    }
    else if (State == "Gateway")
    {
        <section class="gateway-stage" aria-label="Workshop entry">
            <div class="gateway-copy" aria-hidden="true">
                <div class="gateway-memory">THEY SAY A PICTURE IS WORTH A THOUSAND WORDS.</div>
                <div class="gateway-memory">HOW MANY WORDS IS A LIVING IMAGE WORTH?</div>
            </div>

            <button class="enter-workshop" @onclick="EnterWorkshop" aria-label="Enter The Singularity Workshop">
                <span class="enter-corner tl" aria-hidden="true"></span><span class="enter-corner tr" aria-hidden="true"></span>
                <span class="enter-corner bl" aria-hidden="true"></span><span class="enter-corner br" aria-hidden="true"></span>
                <span class="enter-orbit" aria-hidden="true"></span>
                <img src="/Images/TheSingularityWorkshopLogo.png" alt="" />
                <strong>ENTER THE WORKSHOP</strong>
            </button>

            <div class="workshop-warning" role="note">
                <div class="warning-header"><span>⚠</span> SYSTEM ADVISORY: MAXIMUM OVERDRIVE ACTIVE <span>⚠</span></div>
                <div class="warning-body">You are entering a living software environment assembled from state, capability, composition, and interaction.<br /><span class="warning-final">Viewer discretion and spare RAM advised.</span></div>
            </div>
        </section>
    }
    else
    {
        <div class="moniker-water" aria-hidden="true"></div>

        @if (State == "Moniker" || State == "HubGrowth")
        {
            <section class="flex-hello" aria-label="The Singularity Workshop">
                <div class="flex-hello-orbit" aria-hidden="true"></div>
                <div class="hello-moniker">
                    <div class="hello-line">@RenderMonikerLine("THE", 0)</div>
                    <div class="hello-line">@RenderMonikerLine("SINGULARITY", 3)</div>
                    <div class="hello-line">@RenderMonikerLine("WORKSHOP", 14)</div>
                </div>
            </section>
        }
        @if (Plant is not null)
        {
            <svg class="plant-hub" viewBox="0 0 100 60" preserveAspectRatio="none" aria-label="The Hub growing through its invisible navigation mesh">
                <circle cx="@PlantGrowthMicroBundle.HubGeometry.Root.X" cy="@PlantGrowthMicroBundle.HubGeometry.Root.Y" r="1.5" class="root-hole" />
                @foreach (var vine in Plant.Vines)
                {
                    <path d="@vine.Path" pathLength="100" class="vine" style="stroke-dashoffset:@(100 - vine.Progress * 100);" />
                }
                @foreach (var panel in Plant.Panels)
                {
                    var bloom = panel.BloomProgress;
                    var bloomScale = Math.Max(.001, bloom);
                    var flowerOpacity = bloom < 1 ? .95 : 0;
                    var panelOpacity = Math.Clamp(bloom, 0, 1);
                    <g transform="translate(@panel.X @panel.Y)">
                        <g class="flower" style="transform:scale(@bloomScale);transform-origin:0 0;opacity:@flowerOpacity;">
                            <circle r="1.8" class="flower-core" />
                            <circle cx="0" cy="-2.7" r="1.7" class="petal" /><circle cx="2.6" cy="-0.9" r="1.7" class="petal" />
                            <circle cx="1.7" cy="2.1" r="1.7" class="petal" /><circle cx="-1.7" cy="2.1" r="1.7" class="petal" />
                            <circle cx="-2.6" cy="-0.9" r="1.7" class="petal" />
                        </g>
                        <g class="hub-panel" style="transform:scale(@bloomScale);transform-origin:0 0;opacity:@panelOpacity;">
                            <rect x="@(-panel.Width / 2)" y="@(-panel.Height / 2)" width="@panel.Width" height="@panel.Height" rx=".8" />
                            @PanelText(panel, panel.Title, panel.Width, panel.Height, 2.5)
                        </g>
                    </g>
                }
            </svg>
        }
    }
</section>

<style>
