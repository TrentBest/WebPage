.contact-half{position:absolute;left:0;right:0;height:50%;display:flex;align-items:center;justify-content:center;box-sizing:border-box;padding:6vw;text-align:center}.contact-half.top{top:0}.contact-half.bottom{bottom:0}
.contact-label{will-change:opacity,transform,filter,text-shadow}.statement{font-family:Georgia,'Times New Roman',serif;font-size:clamp(1.1rem,3.2vw,3.4rem);font-weight:700;letter-spacing:.035em;color:#eefaff}.question{font-family:Georgia,'Times New Roman',serif;font-size:clamp(1.4rem,4vw,4.4rem);font-weight:700;letter-spacing:.02em;color:#ffd34d}
