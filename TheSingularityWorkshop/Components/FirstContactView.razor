@using TheSingularityWorkshop.Workshop.Plant
@using TheSingularityWorkshop.Gui

<section class="first-contact-stage @(State == "Moniker" || State == "HubGrowth" ? "living" : "")" aria-live="polite">
    @if (State == "FirstOnly" || State == "FirstFadingSecondComingIn" || State == "SecondOnly")
    {
        <div class="contact-half top">
            <div class="contact-label statement" style="@LabelStyle(StatementOpacity)">THEY SAY A PICTURE IS WORTH A THOUSAND WORDS.</div>
        </div>
        <div class="contact-half bottom">
            <div class="contact-label question" style="@QuestionStyle(QuestionOpacity)" aria-hidden="@(QuestionOpacity <= 0d ? "true" : "false")">HOW MANY WORDS IS A LIVING IMAGE WORTH?</div>
        </div>
    }
    else if (State == "Gateway")
    {
        <section class="gateway-stage" aria-label="Workshop entry">
            @BuildGateway()
        </section>
    }
    else
    {
        <div class="moniker-water" aria-hidden="true"></div>

        @if (State == "Moniker" || State == "HubGrowth")
        {
            <section class="flex-hello" aria-label="The Singularity Workshop">
                <div class="flex-hello-orbit" aria-hidden="true"></div>
                <div class="hello-moniker">
                    <div class="hello-line">@RenderMonikerLine("THE", 0)</div>
                    <div class="hello-line">@RenderMonikerLine("SINGULARITY", 3)</div>
                    <div class="hello-line">@RenderMonikerLine("WORKSHOP", 14)</div>
                </div>
            </section>
        }
        @if (State == "HubGrowth" || State == "Landing")
        {
            <section class="hub-warp" aria-label="The Workshop Hub materializing">
                <div class="warp-core" aria-hidden="true"></div>
                <div class="warp-ring ring-one" aria-hidden="true"></div>
                <div class="warp-ring ring-two" aria-hidden="true"></div>
                <div class="warp-ring ring-three" aria-hidden="true"></div>
                <div class="warp-grid" aria-hidden="true"></div>
                <div class="hub-manifest">
                    @foreach (var panel in PlantGrowthMicroBundle.FinalHubGeometry)
                    {
                        <div class="warp-panel" style="--panel-index:@panel.MeshSlot;">
                            <span>@panel.Title</span>
                        </div>
                    }
                </div>
            </section>
        }
    }
</section>

<style>
.first-contact-stage{position:absolute;inset:0;overflow:hidden;background:#020711;color:#fff}
.contact-half{position:absolute;left:0;right:0;height:50%;display:flex;align-items:center;justify-content:center;box-sizing:border-box;padding:6vw;text-align:center}.contact-half.top{top:0}.contact-half.bottom{bottom:0}
.contact-label{will-change:opacity,filter,text-shadow}.statement{font-family:Georgia,'Times New Roman',serif;font-size:clamp(1.1rem,3.2vw,3.4rem);font-weight:700;letter-spacing:.035em;color:#eefaff}.question{font-family:Georgia,'Times New Roman',serif;font-size:clamp(1.4rem,4vw,4.4rem);font-weight:700;letter-spacing:.02em;color:#ffd34d}
.gateway-stage{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1.2rem;overflow:hidden;background:radial-gradient(circle at 50% 42%,rgba(0,234,255,.09),transparent 35%),#020711}
.gateway-corner{position:absolute;width:42px;height:42px;z-index:2}.gateway-corner::before,.gateway-corner::after{content:"";position:absolute;background:#00eaff;box-shadow:0 0 8px rgba(0,234,255,.55)}.gateway-corner::before{width:42px;height:1px}.gateway-corner::after{width:1px;height:42px}.gateway-corner.tl{left:15px;top:15px}.gateway-corner.tr{right:15px;top:15px;transform:rotate(90deg)}.gateway-corner.bl{left:15px;bottom:15px;transform:rotate(-90deg)}.gateway-corner.br{right:15px;bottom:15px;transform:rotate(180deg)}
.enter-corner{position:absolute;width:42px;height:42px;z-index:2}.enter-corner::before,.enter-corner::after{content:"";position:absolute;background:#00eaff;box-shadow:0 0 8px rgba(0,234,255,.55)}.enter-corner::before{width:42px;height:1px}.enter-corner::after{width:1px;height:42px}.tl{left:15px;top:15px}.tr{right:15px;top:15px;transform:rotate(90deg)}.bl{left:15px;bottom:15px;transform:rotate(-90deg)}.br{right:15px;bottom:15px;transform:rotate(180deg)}
.workshop-warning{width:min(680px,78%);padding:.75rem 1.2rem .85rem;box-sizing:border-box;text-align:center;background:rgba(20,10,2,.92);border:3px solid #ff6600;border-radius:5px;box-shadow:0 0 14px rgba(255,102,0,.22),0 0 30px rgba(255,102,0,.12)}.warning-header{display:flex;justify-content:center;gap:.65rem;margin-bottom:.4rem;color:#ffb15c;font-size:clamp(.65rem,1vw,.86rem);font-weight:700;letter-spacing:.13em}.warning-body{font-size:clamp(.62rem,.9vw,.8rem);line-height:1.6;color:#dceaf2}.warning-final{color:#ffb15c}
.moniker-water{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 78%,rgba(0,168,255,.18),transparent 28%),radial-gradient(ellipse at 48% 88%,rgba(0,234,255,.08),transparent 42%);opacity:.8}.moniker-water::after{content:"";position:absolute;left:18%;right:18%;bottom:14%;height:18%;border-radius:50%;border-top:1px solid rgba(0,234,255,.35);box-shadow:0 -12px 35px rgba(0,168,255,.08)}
.flex-hello{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;overflow:hidden;isolation:isolate;background:radial-gradient(circle at 50% 48%,rgba(0,234,255,.09),transparent 34%),transparent}.flex-hello-orbit{position:absolute;width:min(55vw,720px);height:min(55vw,720px);border:1px solid rgba(0,234,255,.16);border-radius:50%;box-shadow:0 0 50px rgba(0,234,255,.06);animation:helloOrbit 6s ease-in-out infinite}
.hello-moniker{position:relative;z-index:3;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.03em;perspective:900px;transform-style:preserve-3d}.hello-line{display:flex;justify-content:center;align-items:center;white-space:nowrap;line-height:.84}.hello-glyph{display:inline-block;transform-origin:50% 100%;transform-style:preserve-3d;font-size:clamp(2rem,7vw,6.5rem);font-weight:900;letter-spacing:.015em;animation:helloGlyphWave 7.2s ease-in-out infinite;animation-delay:calc(var(--phase-index) * -.22s);will-change:transform,filter}.hello-glyph.glyph-red{color:#ff3030;text-shadow:0 0 10px rgba(255,48,48,.85),0 0 28px rgba(255,48,48,.4)}.hello-glyph.glyph-orange{color:#ff7a00;text-shadow:0 0 10px rgba(255,122,0,.85),0 0 28px rgba(255,122,0,.4)}.hello-glyph.glyph-yellow{color:#ffd34d;text-shadow:0 0 10px rgba(255,211,77,.85),0 0 28px rgba(255,211,77,.4)}.hello-glyph.glyph-green{color:#52e05a;text-shadow:0 0 10px rgba(82,224,90,.85),0 0 28px rgba(82,224,90,.4)}.hello-glyph.glyph-blue{color:#00a8ff;text-shadow:0 0 10px rgba(0,168,255,.85),0 0 28px rgba(0,168,255,.4)}.hello-glyph.glyph-magenta{color:#ff2cff;text-shadow:0 0 10px rgba(255,44,255,.85),0 0 28px rgba(255,44,255,.4)}
.moniker-foreground{position:absolute;left:50%;bottom:8%;transform:translateX(-50%);z-index:4;text-align:center;font-size:clamp(1.1rem,3vw,3rem);font-weight:900;line-height:.86;letter-spacing:.08em;color:#eefaff;text-shadow:0 0 12px rgba(0,234,255,.75),0 0 35px rgba(0,168,255,.18)}
.hub-warp{position:absolute;inset:0;z-index:4;display:flex;align-items:center;justify-content:center;overflow:hidden;isolation:isolate;background:radial-gradient(circle at 50% 50%,rgba(0,234,255,.13),transparent 22%),radial-gradient(circle at 50% 50%,rgba(105,70,255,.10),transparent 48%);animation:hubWarpIn 1.15s cubic-bezier(.16,.84,.24,1) both}.warp-core{position:absolute;width:min(18vw,240px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.95) 0 2%,rgba(0,234,255,.72) 7%,rgba(80,70,255,.25) 28%,transparent 68%);filter:blur(.4px);box-shadow:0 0 24px rgba(0,234,255,.8),0 0 90px rgba(70,90,255,.32);animation:warpCore 1.8s ease-out both}.warp-ring{position:absolute;width:min(54vw,700px);aspect-ratio:1;border:1px solid rgba(0,234,255,.32);border-radius:50%;box-shadow:0 0 24px rgba(0,234,255,.08),inset 0 0 24px rgba(0,234,255,.05);transform:rotateX(68deg) rotateZ(-14deg) scaleX(1.35);animation:warpRing 1.35s cubic-bezier(.18,.86,.24,1) both}.ring-two{width:min(43vw,560px);animation-delay:.09s;border-color:rgba(255,211,77,.22);transform:rotateX(68deg) rotateZ(17deg) scaleX(1.35)}.ring-three{width:min(66vw,850px);animation-delay:.18s;border-color:rgba(255,44,255,.16);transform:rotateX(68deg) rotateZ(-31deg) scaleX(1.35)}.warp-grid{position:absolute;width:75%;height:55%;border:1px solid rgba(0,234,255,.12);background:linear-gradient(rgba(0,234,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(0,234,255,.05) 1px,transparent 1px);background-size:32px 32px;transform:perspective(600px) rotateX(62deg) scaleY(.72);mask-image:radial-gradient(ellipse,black 20%,transparent 78%);animation:gridArrival 1.4s ease-out both}.hub-manifest{position:relative;width:min(86vw,1000px);height:min(62vh,620px);display:grid;grid-template-columns:repeat(2,1fr);grid-template-rows:repeat(3,1fr);gap:clamp(.65rem,2vw,1.5rem);padding:clamp(2rem,5vw,4rem);box-sizing:border-box;transform:perspective(900px) rotateX(5deg);animation:manifestFrame 1.2s .18s cubic-bezier(.16,.84,.24,1) both}.warp-panel{position:relative;display:flex;align-items:center;justify-content:center;min-height:54px;border:1px solid rgba(0,234,255,.62);background:linear-gradient(135deg,rgba(0,234,255,.10),rgba(12,5,30,.56));box-shadow:0 0 14px rgba(0,234,255,.13),inset 0 0 18px rgba(0,234,255,.04);color:#eefaff;font:700 clamp(.62rem,1.15vw,.9rem) Consolas,'Courier New',monospace;letter-spacing:.18em;opacity:0;transform:translateY(24px) scale(.72);animation:warpPanelArrival .85s calc(.28s + var(--panel-index) * .09s) cubic-bezier(.16,.84,.24,1) forwards}.warp-panel::before,.warp-panel::after{content:"";position:absolute;background:#00eaff;box-shadow:0 0 7px rgba(0,234,255,.7)}.warp-panel::before{left:8px;top:8px;width:18px;height:1px}.warp-panel::after{right:8px;bottom:8px;width:18px;height:1px}
@@keyframes hubWarpIn{0%{opacity:0;filter:blur(9px);transform:scale(.72)}65%{opacity:1;filter:blur(.7px);transform:scale(1.025)}100%{opacity:1;filter:none;transform:scale(1)}}@@keyframes warpCore{0%{opacity:0;transform:scale(.05)}35%{opacity:1;transform:scale(.75)}70%{transform:scale(1.25)}100%{opacity:.72;transform:scale(.9)}}@@keyframes warpRing{0%{opacity:0;transform:rotateX(68deg) rotateZ(0deg) scale(.15,1)}55%{opacity:.85}100%{opacity:.45;transform:rotateX(68deg) rotateZ(32deg) scale(1.35,1)}}@@keyframes gridArrival{0%{opacity:0;transform:perspective(600px) rotateX(62deg) scaleY(.08)}100%{opacity:1;transform:perspective(600px) rotateX(62deg) scaleY(.72)}}@@keyframes manifestFrame{0%{opacity:0;transform:perspective(900px) rotateX(24deg) scale(.76)}100%{opacity:1;transform:perspective(900px) rotateX(5deg) scale(1)}}@@keyframes warpPanelArrival{0%{opacity:0;transform:translateY(24px) scale(.72);filter:blur(5px)}65%{opacity:1;transform:translateY(-2px) scale(1.03);filter:blur(0)}100%{opacity:1;transform:translateY(0) scale(1)}}
@@keyframes gatewayManifest{0%{opacity:0;filter:blur(5px);clip-path:inset(49% 0 49% 0)}35%{opacity:.35;clip-path:inset(22% 0 22% 0)}70%{opacity:.82;filter:blur(.7px);clip-path:inset(4% 0 4% 0)}100%{opacity:1;filter:none;clip-path:inset(0)}}@@keyframes helloOrbit{0%,100%{transform:scale(.94) rotateX(64deg) rotateZ(-12deg);opacity:.28}50%{transform:scale(1.04) rotateX(64deg) rotateZ(12deg);opacity:.75}}@@keyframes helloGlyphWave{0%,100%{transform:translate3d(0,0,0) rotateZ(-1deg) scaleY(.98)}12.5%{transform:translate3d(0,-.09em,0) rotateZ(.8deg) scaleY(1.01)}25%{transform:translate3d(0,-.02em,0) rotateZ(1.8deg) scaleY(1.03)}37.5%{transform:translate3d(0,.10em,0) rotateZ(.2deg) scaleY(1.01)}50%{transform:translate3d(0,.14em,0) rotateZ(-1.6deg) scaleY(.97)}62.5%{transform:translate3d(0,.02em,0) rotateZ(-2deg) scaleY(.99)}75%{transform:translate3d(0,-.08em,0) rotateZ(-.4deg) scaleY(1.02)}87.5%{transform:translate3d(0,-.12em,0) rotateZ(1deg) scaleY(1.01)}}
@@media(max-width:700px){.enter-workshop{width:82vw;height:46vh}.workshop-warning{width:88%}.hello-glyph{font-size:clamp(1.8rem,11vw,3.8rem)}}@@media(prefers-reduced-motion:reduce){.enter-workshop,.hello-glyph,.flex-hello-orbit{animation:none}.enter-workshop img{transition:none}}
</style>

@code {
    private const int MonikerPhaseStepDegrees = 27;

    [Parameter] public string State { get; set; } = "FirstOnly";
    [Parameter] public long Ticks { get; set; }
    [Parameter] public double PresentationProgress { get; set; }
    [Parameter] public double StatementOpacity { get; set; }
    [Parameter] public double QuestionOpacity { get; set; }
    [Parameter] public PlantGrowthMicroBundle? Plant { get; set; }

    private static string LabelStyle(double opacity)
    {
        var blur = (1d - opacity) * 2.2;
        var glow = Math.Max(.02, opacity) * 18d;
        return $"opacity:{Math.Clamp(opacity, 0, 1):0.###};filter:blur({blur:0.##}px);text-shadow:0 0 {glow:0.##}px rgba(0,234,255,.28);";
    }

    private static string QuestionStyle(double opacity)
    {
        var clamped = Math.Clamp(opacity, 0, 1);
        var blur = (1d - clamped) * 3.2;
        var visibility = clamped <= 0d ? "hidden" : "visible";

        return $"opacity:{clamped:0.###};visibility:{visibility};filter:blur({blur:0.##}px);text-shadow:0 0 {Math.Max(.02, clamped) * 22d:0.##}px rgba(255,211,77,.32);";
    }

    private bool _gatewayHovered;

    private RenderFragment BuildGateway()
    {
        var button = WorkshopGui.Button(this)
            .Class("enter-workshop")
            .AriaLabel("Enter The Singularity Workshop")
            .Style("position", "relative")
            .Style("width", "min(560px,62vw)")
            .Style("height", "min(390px,48vh)")
            .Style("min-width", "280px")
            .Style("min-height", "230px")
            .Style("display", "flex")
            .Style("align-items", "center")
            .Style("justify-content", "center")
            .Style("overflow", "visible")
            .Style("padding", "0")
            .Style("box-sizing", "border-box")
            .Style("border", $"2px solid {(_gatewayHovered ? "#ff2cff" : "#00eaff")}")
            .Style("border-radius", "16px")
            .Style("background", "rgba(3,10,22,.76)")
            .Style("color", "#fff")
            .Style("cursor", "pointer")
            .Style("box-shadow", _gatewayHovered
                ? "0 0 18px rgba(255,44,255,.7),0 0 60px rgba(0,234,255,.2),inset 0 0 40px rgba(255,44,255,.08)"
                : "0 0 18px rgba(0,234,255,.35),0 0 65px rgba(0,234,255,.1),inset 0 0 35px rgba(0,234,255,.06)")
            .Style("transform", _gatewayHovered ? "scale(1.025)" : "scale(1)")
            .Style("transition", "transform .35s cubic-bezier(.16,1,.3,1),box-shadow .35s ease,border-color .35s ease")
            .OnClick(EnterWorkshop)
            .OnMouseEnter(() => _gatewayHovered = true)
            .OnMouseLeave(() => _gatewayHovered = false);

        button.Child(WorkshopGui.Element(this, "span")
            .Class("gateway-avatar")
            .Attribute("aria-hidden", "true")
            .Style("position", "absolute")
            .Style("left", "50%")
            .Style("top", "50%")
            .Style("width", "100cqh")
            .Style("height", "100cqh")
            .Style("transform", _gatewayHovered ? "translate(-50%,-50%) scale(1.16)" : "translate(-50%,-50%)")
            .Style("transform-origin", "center")
            .Style("border", $"2px solid {(_gatewayHovered ? "#ff2cff" : "#00eaff")}")
            .Style("border-radius", "50%")
            .Style("overflow", "hidden")
            .Style("display", "flex")
            .Style("align-items", "center")
            .Style("justify-content", "center")
            .Style("box-sizing", "border-box")
            .Style("pointer-events", "none")
            .Style("z-index", "1")
            .Style("box-shadow", _gatewayHovered
                ? "0 0 18px rgba(255,44,255,.95),0 0 48px rgba(0,234,255,.35),0 0 82px rgba(255,44,255,.3)"
                : "0 0 12px rgba(0,234,255,.7),0 0 38px rgba(0,234,255,.22),0 0 60px rgba(255,44,255,.1)")
            .Style("transition", "transform .45s cubic-bezier(.16,1,.3,1),filter .45s ease,box-shadow .45s ease,border-color .35s ease")
            .Child(WorkshopGui.Image(this)
                .Class("gateway-avatar-image")
                .Attribute("alt", "")
                .Style("display", "block")
                .Style("width", "100%")
                .Style("height", "100%")
                .Style("margin", "0")
                .Style("padding", "0")
                .Style("object-fit", "cover")
                .Style("object-position", "center")
                .Style("border-radius", "50%")
                .Style("opacity", ".88")
                .Style("filter", _gatewayHovered ? "saturate(1.32) contrast(1.08) brightness(1.1)" : "saturate(1.08) contrast(1.04)")
                .Attribute("src", "/Images/TheSingularityWorkshopLogo.png")));

        button.Child(WorkshopGui.Element(this, "span")
            .Class("gateway-corner tl")
            .Attribute("aria-hidden", "true"));
        button.Child(WorkshopGui.Element(this, "span")
            .Class("gateway-corner tr")
            .Attribute("aria-hidden", "true"));
        button.Child(WorkshopGui.Element(this, "span")
            .Class("gateway-corner bl")
            .Attribute("aria-hidden", "true"));
        button.Child(WorkshopGui.Element(this, "span")
            .Class("gateway-corner br")
            .Attribute("aria-hidden", "true"));

        button.Child(WorkshopGui.Element(this, "strong")
            .Style("position", "absolute")
            .Style("bottom", "8%")
            .Style("font-size", "clamp(1rem,2vw,1.7rem)")
            .Style("letter-spacing", ".18em")
            .Style("text-shadow", "0 0 12px #00eaff")
            .Text("ENTER THE WORKSHOP"));

        var warning = WorkshopGui.Element(this, "div")
            .Class("workshop-warning")
            .Attribute("role", "note")
            .Style("display", "block")
            .Style("width", "min(680px,78%)")
            .Style("padding", ".75rem 1.2rem .85rem")
            .Style("box-sizing", "border-box")
            .Style("text-align", "center")
            .Style("background", "rgba(20,10,2,.92)")
            .Style("border", "3px solid #ff6600")
            .Style("border-radius", "5px")
            .Style("box-shadow", "0 0 14px rgba(255,102,0,.22),0 0 30px rgba(255,102,0,.12)");

        warning.Child(WorkshopGui.Element(this, "div")
            .Class("warning-header")
            .Style("display", "flex")
            .Style("justify-content", "center")
            .Style("gap", ".65rem")
            .Style("margin-bottom", ".4rem")
            .Style("color", "#ffb15c")
            .Style("font-size", "clamp(.65rem,1vw,.86rem)")
            .Style("font-weight", "700")
            .Style("letter-spacing", ".13em")
            .Text("⚠ SYSTEM ADVISORY: MAXIMUM OVERDRIVE ACTIVE ⚠"));

        warning.Child(WorkshopGui.Element(this, "div")
            .Class("warning-body")
            .Style("font-size", "clamp(.62rem,.9vw,.8rem)")
            .Style("line-height", "1.6")
            .Style("color", "#dceaf2")
            .Text("You are entering a living software environment assembled from state, capability, composition, and interaction. Viewer discretion and spare RAM advised."));

        var root = WorkshopGui.Panel(this)
            .Class("gateway-builder-surface")
            .Style("display", "flex")
            .Style("flex-direction", "column")
            .Style("align-items", "center")
            .Style("justify-content", "center")
            .Style("gap", "1.2rem");

        root.Child(button);
        root.Child(warning);
        return root.Build();
    }

    private async Task EnterWorkshop()
        => await OnEntryRequested.InvokeAsync();

    [Parameter] public EventCallback OnEntryRequested { get; set; }

    private static RenderFragment RenderMonikerLine(string text, int startIndex) => builder =>
    {
        for (var glyphIndex = 0; glyphIndex < text.Length; glyphIndex++)
        {
            var phaseIndex = startIndex + glyphIndex;
            var phase = phaseIndex * MonikerPhaseStepDegrees;
            var colorClass = (phaseIndex % 6) switch
            {
                0 => "glyph-red",
                1 => "glyph-orange",
                2 => "glyph-yellow",
                3 => "glyph-green",
                4 => "glyph-blue",
                _ => "glyph-magenta"
            };

            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", $"hello-glyph {colorClass}");
            builder.AddAttribute(2, "style", $"--phase:{phase}deg;--phase-index:{phaseIndex};");
            builder.AddContent(3, text[glyphIndex].ToString());
            builder.CloseElement();
        }
    };

    private static MarkupString PanelText(PlantGrowthMicroBundle.PlantPanel panel, string value, double width, double height, double y)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(value);
        return new MarkupString($"<text x=\"{-width / 2 + 1.4}\" y=\"{-height / 2 + y}\">{encoded}</text>");
    }
}