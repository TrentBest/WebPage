.enter-workshop{position:relative;container-type:size;width:min(560px,62vw);height:min(390px,48vh);min-width:280px;min-height:230px;display:flex;align-items:center;justify-content:center;overflow:hidden;border:2px solid #00eaff;border-radius:16px;background:rgba(3,10,22,.76);color:#fff;cursor:pointer;box-shadow:0 0 18px rgba(0,234,255,.35),0 0 65px rgba(0,234,255,.1),inset 0 0 35px rgba(0,234,255,.06);animation:gatewayManifest .55s steps(6,end) both}.enter-workshop img{width:min(100cqw,100cqh);height:min(100cqw,100cqh);max-width:100%;max-height:100%;aspect-ratio:1;object-fit:cover;border-radius:50%;opacity:.88;filter:saturate(1.1);transition:transform .8s ease,filter .8s ease}.enter-workshop strong{position:absolute;bottom:8%;font-size:clamp(1rem,2vw,1.7rem);letter-spacing:.18em;text-shadow:0 0 12px #00eaff}.enter-workshop:hover img{transform:scale(1.04);filter:saturate(1.3) brightness(1.08)}
.enter-corner{position:absolute;width:42px;height:42px;z-index:2}.enter-corner::before,.enter-corner::after{content:"";position:absolute;background:#00eaff;box-shadow:0 0 8px rgba(0,234,255,.55)}.enter-corner::before{width:42px;height:1px}.enter-corner::after{width:1px;height:42px}.tl{left:15px;top:15px}.tr{right:15px;top:15px;transform:rotate(90deg)}.bl{left:15px;bottom:15px;transform:rotate(-90deg)}.br{right:15px;bottom:15px;transform:rotate(180deg)}
.enter-orbit{position:absolute;width:48%;aspect-ratio:1;border:1px solid rgba(255,44,255,.22);border-radius:50%;pointer-events:none}.workshop-warning{width:min(680px,78%);padding:.75rem 1.2rem .85rem;box-sizing:border-box;text-align:center;background:rgba(20,10,2,.92);border:3px solid #ff6600;border-radius:5px;box-shadow:0 0 14px rgba(255,102,0,.22),0 0 30px rgba(255,102,0,.12)}.warning-header{display:flex;justify-content:center;gap:.65rem;margin-bottom:.4rem;color:#ffb15c;font-size:clamp(.65rem,1vw,.86rem);font-weight:700;letter-spacing:.13em}.warning-body{font-size:clamp(.62rem,.9vw,.8rem);line-height:1.6;color:#dceaf2}.warning-final{color:#ffb15c}
.moniker-water{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 78%,rgba(0,168,255,.18),transparent 28%),radial-gradient(ellipse at 48% 88%,rgba(0,234,255,.08),transparent 42%);opacity:.8}.moniker-water::after{content:"";position:absolute;left:18%;right:18%;bottom:14%;height:18%;border-radius:50%;border-top:1px solid rgba(0,234,255,.35);box-shadow:0 -12px 35px rgba(0,168,255,.08)}
.flex-hello{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;overflow:hidden;isolation:isolate;background:radial-gradient(circle at 50% 48%,rgba(0,234,255,.09),transparent 34%),transparent}.flex-hello-orbit{position:absolute;width:min(55vw,720px);height:min(55vw,720px);border:1px solid rgba(0,234,255,.16);border-radius:50%;box-shadow:0 0 50px rgba(0,234,255,.06);animation:helloOrbit 6s ease-in-out infinite}
.hello-moniker{position:relative;z-index:3;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.03em;perspective:900px;transform-style:preserve-3d}.hello-line{display:flex;justify-content:center;align-items:center;white-space:nowrap;line-height:.84}.hello-glyph{display:inline-block;transform-origin:50% 100%;transform-style:preserve-3d;font-size:clamp(2rem,7vw,6.5rem);font-weight:900;letter-spacing:.015em;animation:helloGlyphWave 7.2s ease-in-out infinite;animation-delay:calc(var(--phase-index) * -.22s);will-change:transform,filter}.hello-glyph.glyph-red{color:#ff3030;text-shadow:0 0 10px rgba(255,48,48,.85),0 0 28px rgba(255,48,48,.4)}.hello-glyph.glyph-orange{color:#ff7a00;text-shadow:0 0 10px rgba(255,122,0,.85),0 0 28px rgba(255,122,0,.4)}.hello-glyph.glyph-yellow{color:#ffd34d;text-shadow:0 0 10px rgba(255,211,77,.85),0 0 28px rgba(255,211,77,.4)}.hello-glyph.glyph-green{color:#52e05a;text-shadow:0 0 10px rgba(82,224,90,.85),0 0 28px rgba(82,224,90,.4)}.hello-glyph.glyph-blue{color:#00a8ff;text-shadow:0 0 10px rgba(0,168,255,.85),0 0 28px rgba(0,168,255,.4)}.hello-glyph.glyph-magenta{color:#ff2cff;text-shadow:0 0 10px rgba(255,44,255,.85),0 0 28px rgba(255,44,255,.4)}
.moniker-foreground{position:absolute;left:50%;bottom:8%;transform:translateX(-50%);z-index:4;text-align:center;font-size:clamp(1.1rem,3vw,3rem);font-weight:900;line-height:.86;letter-spacing:.08em;color:#eefaff;text-shadow:0 0 12px rgba(0,234,255,.75),0 0 35px rgba(0,168,255,.18)}
.plant-hub{position:absolute;inset:0;width:100%;height:100%;z-index:3}.root-hole{fill:#000;stroke:#00eaff;stroke-width:.35;filter:drop-shadow(0 0 2px #00eaff)}.vine{fill:none;stroke:#64e6a0;stroke-width:.7;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:100;filter:drop-shadow(0 0 1.5px rgba(100,230,160,.8))}.flower .petal{fill:#ff7adf;stroke:#ffd34d;stroke-width:.22;filter:drop-shadow(0 0 1.5px rgba(255,122,223,.9))}.flower .flower-core{fill:#ffd34d;stroke:#fff;stroke-width:.18}.hub-panel rect{fill:#020a14;stroke:#00eaff;stroke-width:.35;filter:drop-shadow(0 0 2px rgba(0,234,255,.8))}.hub-panel text{fill:#eefaff;font-family:Consolas,'Courier New',monospace;font-size:2.2px;font-weight:700;letter-spacing:.12px}
@@keyframes gatewayManifest{0%{opacity:0;filter:blur(5px);transform:scale(.985);clip-path:inset(49% 0 49% 0)}35%{opacity:.35;clip-path:inset(22% 0 22% 0)}70%{opacity:.82;filter:blur(.7px);clip-path:inset(4% 0 4% 0)}100%{opacity:1;filter:none;transform:scale(1);clip-path:inset(0)}}@@keyframes helloOrbit{0%,100%{transform:scale(.94) rotateX(64deg) rotateZ(-12deg);opacity:.28}50%{transform:scale(1.04) rotateX(64deg) rotateZ(12deg);opacity:.75}}@@keyframes helloGlyphWave{0%,100%{transform:translate3d(0,0,0) rotateZ(-1deg) scaleY(.98)}12.5%{transform:translate3d(0,-.09em,0) rotateZ(.8deg) scaleY(1.01)}25%{transform:translate3d(0,-.02em,0) rotateZ(1.8deg) scaleY(1.03)}37.5%{transform:translate3d(0,.10em,0) rotateZ(.2deg) scaleY(1.01)}50%{transform:translate3d(0,.14em,0) rotateZ(-1.6deg) scaleY(.97)}62.5%{transform:translate3d(0,.02em,0) rotateZ(-2deg) scaleY(.99)}75%{transform:translate3d(0,-.08em,0) rotateZ(-.4deg) scaleY(1.02)}87.5%{transform:translate3d(0,-.12em,0) rotateZ(1deg) scaleY(1.01)}}
@@media(max-width:700px){.enter-workshop{width:82vw;height:46vh}.workshop-warning{width:88%}.hello-glyph{font-size:clamp(1.8rem,11vw,3.8rem)}}@@media(prefers-reduced-motion:reduce){.enter-workshop,.hello-glyph,.flex-hello-orbit{animation:none}.enter-workshop img{transition:none}}
</style>

@code {
    private const int MonikerPhaseStepDegrees = 27;

    [Parameter] public string State { get; set; } = "Statement";
    [Parameter] public long Ticks { get; set; }
    [Parameter] public PlantGrowthMicroBundle? Plant { get; set; }

    private static string LabelStyle(double opacity, double progress)
    {
        var jitter = (1d - progress) * 2.5;
        var blur = (1d - progress) * 2.2;
        var glow = Math.Max(.02, progress) * 18d;
        return $"opacity:{Math.Clamp(opacity, 0, 1):0.###};transform:translate({jitter:0.##}px,{-jitter:0.##}px) scale({(1d + (1d - progress) * .015):0.###});filter:blur({blur:0.##}px);text-shadow:0 0 {glow:0.##}px rgba(0,234,255,.28);";
    }

    private static string QuestionStyle(double progress, double fadeProgress)
    {
        var reveal = progress * (1d - fadeProgress);
        var pixel = (1d - progress) * 3.5;
        var blur = (1d - progress) * 3.2 + fadeProgress * 1.8;
        return $"opacity:{Math.Clamp(reveal, 0, 1):0.###};transform:translate({pixel:0.##}px,{-pixel:0.##}px) scale({(1d + (1d - progress) * .018):0.###});filter:blur({blur:0.##}px);text-shadow:0 0 {Math.Max(.02, reveal) * 22d:0.##}px rgba(255,211,77,.32);";
    }

    private async Task EnterWorkshop()
        => await OnEntryRequested.InvokeAsync();

    [Parameter] public EventCallback OnEntryRequested { get; set; }

    private static RenderFragment RenderMonikerLine(string text, int startIndex) => builder =>
    {
        for (var glyphIndex = 0; glyphIndex < text.Length; glyphIndex++)
        {
            var phaseIndex = startIndex + glyphIndex;
            var phase = phaseIndex * MonikerPhaseStepDegrees;
            var colorClass = (phaseIndex % 6) switch
            {
                0 => "glyph-red",
                1 => "glyph-orange",
                2 => "glyph-yellow",
                3 => "glyph-green",
                4 => "glyph-blue",
                _ => "glyph-magenta"
            };

            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", $"hello-glyph {colorClass}");
            builder.AddAttribute(2, "style", $"--phase:{phase}deg;--phase-index:{phaseIndex};");
            builder.AddContent(3, text[glyphIndex].ToString());
            builder.CloseElement();
        }
    };

    private static MarkupString PanelText(PlantGrowthMicroBundle.PlantPanel panel, string value, double width, double height, double y)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(value);
        return new MarkupString($"<text x=\"{-width / 2 + 1.4}\" y=\"{-height / 2 + y}\">{encoded}</text>");
    }
}