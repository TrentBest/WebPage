@using TheSingularityWorkshop.Workshop.Plant

<section class="first-contact-stage @(State == "Moniker" || State == "HubGrowth" ? "living" : "")" aria-live="polite">
    @if (State == "Statement")
    {
        <div class="contact-half top">
            <div class="contact-label statement" style="@LabelStyle(1, 0)">THEY SAY A PICTURE IS WORTH A THOUSAND WORDS.</div>
        </div>
    }
    else if (State == "Question")
    {
        var secondProgress = Math.Clamp(Ticks / 30d, 0d, 1d);
        var fadeProgress = Math.Clamp((Ticks - 30d) / 40d, 0d, 1d);

        <div class="contact-half top">
            <div class="contact-label statement" style="@LabelStyle(.18 * (1d - fadeProgress), secondProgress)">THEY SAY A PICTURE IS WORTH A THOUSAND WORDS.</div>
        </div>
        <div class="contact-half bottom">
            <div class="contact-label question" style="@QuestionStyle(secondProgress, fadeProgress)">HOW MANY WORDS IS A LIVING IMAGE WORTH?</div>
        </div>
    }
    else if (State == "Gateway")
    {
        <section class="gateway-stage" aria-label="Workshop entry">
            <div class="gateway-copy" aria-hidden="true">
                <div class="gateway-memory">THEY SAY A PICTURE IS WORTH A THOUSAND WORDS.</div>
                <div class="gateway-memory">HOW MANY WORDS IS A LIVING IMAGE WORTH?</div>
            </div>

            <button class="enter-workshop" @onclick="EnterWorkshop" aria-label="Enter The Singularity Workshop">
                <span class="enter-corner tl" aria-hidden="true"></span><span class="enter-corner tr" aria-hidden="true"></span>
                <span class="enter-corner bl" aria-hidden="true"></span><span class="enter-corner br" aria-hidden="true"></span>
                <span class="enter-orbit" aria-hidden="true"></span>
                <img src="/Images/TheSingularityWorkshopLogo.png" alt="" />
                <strong>ENTER THE WORKSHOP</strong>
            </button>

            <div class="workshop-warning" role="note">
                <div class="warning-header"><span>⚠</span> SYSTEM ADVISORY: MAXIMUM OVERDRIVE ACTIVE <span>⚠</span></div>
                <div class="warning-body">You are entering a living software environment assembled from state, capability, composition, and interaction.<br /><span class="warning-final">Viewer discretion and spare RAM advised.</span></div>
            </div>
        </section>
    }
    else
    {
        <div class="moniker-water" aria-hidden="true"></div>
        <div class="moniker-foreground" aria-label="The Singularity Workshop"><div>THE</div><div>SINGULARITY</div><div>WORKSHOP</div></div>

        @if (Plant is not null)
        {
            <svg class="plant-hub" viewBox="0 0 100 60" preserveAspectRatio="none" aria-label="The Hub growing from a plant">
                <circle cx="2" cy="4" r="1.5" class="root-hole" />
                @foreach (var vine in Plant.Vines)
                {
                    <path d="@vine.Path" pathLength="100" class="vine" style="stroke-dashoffset:@(100 - vine.Progress * 100);" />
                }
                @foreach (var panel in Plant.Panels)
                {
                    var bloom = panel.BloomProgress;
                    var open = panel.OpenProgress;
                    <g transform="translate(@panel.X @panel.Y)">
                        <g class="flower" style="transform:scale(@(0.001 + bloom * 0.999));transform-origin:0 0;opacity:@(1 - open);">
                            <circle r="2.1" class="flower-core" />
                            <circle cx="0" cy="-3.2" r="2" class="petal" /><circle cx="3.1" cy="-1" r="2" class="petal" />
                            <circle cx="2" cy="2.5" r="2" class="petal" /><circle cx="-2" cy="2.5" r="2" class="petal" />
                            <circle cx="-3.1" cy="-1" r="2" class="petal" />
                        </g>
                        <g class="hub-panel" style="transform:scale(@(0.001 + open * 0.999));transform-origin:0 0;opacity:@open;">
                            <rect x="@(-panel.Width / 2)" y="@(-panel.Height / 2)" width="@panel.Width" height="@panel.Height" rx=".8" />
                            @PanelText(panel, panel.Title, panel.Width, panel.Height, 3.2)
                            @if (panel.Id == "content") { @PanelText(panel, "LIVE EXPERIENCE", panel.Width, panel.Height, 6.2, "panel-detail") }
                            @if (panel.Id == "ai") { @PanelText(panel, "PROTOCOL / GRAMMAR", panel.Width, panel.Height, 6.2, "panel-detail") }
                        </g>
                    </g>
                }
            </svg>
        }
    }
</section>

<style>
.first-contact-stage{position:absolute;inset:0;overflow:hidden;background:#020711;color:#fff}
.contact-half{position:absolute;left:0;right:0;height:50%;display:flex;align-items:center;justify-content:center;box-sizing:border-box;padding:6vw;text-align:center}.contact-half.top{top:0}.contact-half.bottom{bottom:0}
.contact-label{will-change:opacity,transform,filter,text-shadow}.statement{font-family:Georgia,'Times New Roman',serif;font-size:clamp(1.1rem,3.2vw,3.4rem);font-weight:700;letter-spacing:.035em;color:#eefaff}.question{font-family:Georgia,'Times New Roman',serif;font-size:clamp(1.4rem,4vw,4.4rem);font-weight:700;letter-spacing:.02em;color:#ffd34d}
.gateway-stage{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1.2rem;overflow:hidden;background:radial-gradient(circle at 50% 42%,rgba(0,234,255,.09),transparent 35%),#020711}.gateway-copy{position:absolute;inset:0;pointer-events:none;display:flex;flex-direction:column;justify-content:space-between;align-items:center;padding:5vh 4vw;color:rgba(238,250,255,.035);font:700 clamp(.7rem,1.2vw,1rem) Georgia,'Times New Roman',serif;letter-spacing:.035em}.gateway-memory{opacity:.65}
.enter-workshop{position:relative;width:min(560px,62vw);height:min(390px,48vh);min-width:280px;min-height:230px;display:flex;align-items:center;justify-content:center;overflow:hidden;border:2px solid #00eaff;border-radius:16px;background:rgba(3,10,22,.76);color:#fff;cursor:pointer;box-shadow:0 0 18px rgba(0,234,255,.35),0 0 65px rgba(0,234,255,.1),inset 0 0 35px rgba(0,234,255,.06);animation:gatewayManifest .55s steps(6,end) both}.enter-workshop img{width:62%;height:62%;object-fit:cover;border-radius:50%;opacity:.88;filter:saturate(1.1);transition:transform .8s ease,filter .8s ease}.enter-workshop strong{position:absolute;bottom:8%;font-size:clamp(1rem,2vw,1.7rem);letter-spacing:.18em;text-shadow:0 0 12px #00eaff}.enter-workshop:hover img{transform:scale(1.08);filter:saturate(1.3) brightness(1.08)}
.enter-corner{position:absolute;width:42px;height:42px;z-index:2}.enter-corner::before,.enter-corner::after{content:"";position:absolute;background:#00eaff;box-shadow:0 0 8px rgba(0,234,255,.55)}.enter-corner::before{width:42px;height:1px}.enter-corner::after{width:1px;height:42px}.tl{left:15px;top:15px}.tr{right:15px;top:15px;transform:rotate(90deg)}.bl{left:15px;bottom:15px;transform:rotate(-90deg)}.br{right:15px;bottom:15px;transform:rotate(180deg)}
.enter-orbit{position:absolute;width:48%;aspect-ratio:1;border:1px solid rgba(255,44,255,.22);border-radius:50%;pointer-events:none}.workshop-warning{width:min(680px,78%);padding:.75rem 1.2rem .85rem;box-sizing:border-box;text-align:center;background:rgba(20,10,2,.92);border:3px solid #ff6600;border-radius:5px;box-shadow:0 0 14px rgba(255,102,0,.22),0 0 30px rgba(255,102,0,.12)}.warning-header{display:flex;justify-content:center;gap:.65rem;margin-bottom:.4rem;color:#ffb15c;font-size:clamp(.65rem,1vw,.86rem);font-weight:700;letter-spacing:.13em}.warning-body{font-size:clamp(.62rem,.9vw,.8rem);line-height:1.6;color:#dceaf2}.warning-final{color:#ffb15c}
.moniker-water{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 78%,rgba(0,168,255,.18),transparent 28%),radial-gradient(ellipse at 48% 88%,rgba(0,234,255,.08),transparent 42%);opacity:.8}.moniker-water::after{content:"";position:absolute;left:18%;right:18%;bottom:14%;height:18%;border-radius:50%;border-top:1px solid rgba(0,234,255,.35);box-shadow:0 -12px 35px rgba(0,168,255,.08)}
.moniker-foreground{position:absolute;left:50%;bottom:8%;transform:translateX(-50%);z-index:4;text-align:center;font-size:clamp(1.1rem,3vw,3rem);font-weight:900;line-height:.86;letter-spacing:.08em;color:#eefaff;text-shadow:0 0 12px rgba(0,234,255,.75),0 0 35px rgba(0,168,255,.18)}
.plant-hub{position:absolute;inset:0;width:100%;height:100%;z-index:3}.root-hole{fill:#000;stroke:#00eaff;stroke-width:.35;filter:drop-shadow(0 0 2px #00eaff)}.vine{fill:none;stroke:#64e6a0;stroke-width:.7;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:100;filter:drop-shadow(0 0 1.5px rgba(100,230,160,.8))}.flower .petal{fill:#ff7adf;stroke:#ffd34d;stroke-width:.22;filter:drop-shadow(0 0 1.5px rgba(255,122,223,.9))}.flower .flower-core{fill:#ffd34d;stroke:#fff;stroke-width:.18}.hub-panel rect{fill:#020a14;stroke:#00eaff;stroke-width:.35;filter:drop-shadow(0 0 2px rgba(0,234,255,.8))}.hub-panel text{fill:#eefaff;font-family:Consolas,'Courier New',monospace;font-size:2.2px;font-weight:700;letter-spacing:.12px}.hub-panel .panel-detail{fill:#8eefff;font-size:1.35px}
@@keyframes gatewayManifest{0%{opacity:0;filter:blur(5px);transform:scale(.985);clip-path:inset(49% 0 49% 0)}35%{opacity:.35;clip-path:inset(22% 0 22% 0)}70%{opacity:.82;filter:blur(.7px);clip-path:inset(4% 0 4% 0)}100%{opacity:1;filter:none;transform:scale(1);clip-path:inset(0)}}@@media(max-width:700px){.enter-workshop{width:82vw;height:46vh}.workshop-warning{width:88%}}@@media(prefers-reduced-motion:reduce){.enter-workshop{animation:none}.contact-label{transition:none}}
</style>

@code {
    [Parameter] public string State { get; set; } = "Statement";
    [Parameter] public long Ticks { get; set; }
    [Parameter] public PlantGrowthMicroBundle? Plant { get; set; }

    private static string LabelStyle(double opacity, double progress)
    {
        var jitter = (1d - progress) * 2.5;
        var blur = (1d - progress) * 2.2;
        var glow = Math.Max(.02, progress) * 18d;
        return $"opacity:{Math.Clamp(opacity, 0, 1):0.###};transform:translate({jitter:0.##}px,{-jitter:0.##}px) scale({(1d + (1d - progress) * .015):0.###});filter:blur({blur:0.##}px);text-shadow:0 0 {glow:0.##}px rgba(0,234,255,.28);";
    }

    private static string QuestionStyle(double progress, double fadeProgress)
    {
        var reveal = progress * (1d - fadeProgress);
        var pixel = (1d - progress) * 3.5;
        var blur = (1d - progress) * 3.2 + fadeProgress * 1.8;
        return $"opacity:{Math.Clamp(reveal, 0, 1):0.###};transform:translate({pixel:0.##}px,{-pixel:0.##}px) scale({(1d + (1d - progress) * .018):0.###});filter:blur({blur:0.##}px);text-shadow:0 0 {Math.Max(.02, reveal) * 22d:0.##}px rgba(255,211,77,.32);";
    }

    private async Task EnterWorkshop()
        => await OnEntryRequested.InvokeAsync();

    [Parameter] public EventCallback OnEntryRequested { get; set; }

    private static MarkupString PanelText(PlantGrowthMicroBundle.PlantPanel panel, string value, double width, double height, double y, string? cssClass = null)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(value);
        var classAttribute = string.IsNullOrWhiteSpace(cssClass) ? string.Empty : $" class=\"{cssClass}\"";
        return new MarkupString($"<text x=\"{-width / 2 + 1.4}\" y=\"{-height / 2 + y}\"{classAttribute}>{encoded}</text>");
    }
}