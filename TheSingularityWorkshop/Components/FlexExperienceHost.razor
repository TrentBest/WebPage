@implements IDisposable

@if (_active)
{
    <div class="flex-experience" aria-label="Living GUI flex experience">
        @foreach (var node in _nodes)
        {
            <div class="flex-node" style="left:@$"{node.X}%";top:@$"{node.Y}%";--node-delay:@$"{node.DelayMs}ms";" title="Lineage @node.Lineage">
                <span class="flex-node-label">@node.Lineage</span>
            </div>
        }
        <div class="flex-readout">
            <span>FLEX // LIVING GUI</span>
            <strong>@_nodes.Count</strong>
            <small>DIGITAL IMPOSSIBLE</small>
        </div>
    </div>
}

<style>
    .flex-experience { position:absolute; inset:0; overflow:hidden; pointer-events:none; background:radial-gradient(circle at 50% 50%,rgba(0,234,255,.055),transparent 58%); }
    .flex-node { position:absolute; width:14px; height:14px; margin:-7px 0 0 -7px; border:1px solid #00eaff; border-radius:3px; background:rgba(0,234,255,.22); box-shadow:0 0 8px rgba(0,234,255,.85),0 0 24px rgba(255,44,255,.28); transform:scale(0); animation:flexBirth .36s cubic-bezier(.16,1,.3,1) var(--node-delay) forwards; }
    .flex-node:nth-child(3n) { border-radius:50%; border-color:#ff2cff; box-shadow:0 0 8px rgba(255,44,255,.85),0 0 24px rgba(0,234,255,.25); }
    .flex-node:nth-child(5n) { border-radius:0; }
    .flex-node-label { position:absolute; left:50%; top:calc(100% + 3px); transform:translateX(-50%); font-size:6px; line-height:1; color:rgba(220,250,255,.55); white-space:nowrap; opacity:.8; }
    .flex-readout { position:absolute; left:50%; bottom:7%; transform:translateX(-50%); display:flex; flex-direction:column; align-items:center; gap:.15rem; color:#8eefff; text-shadow:0 0 10px rgba(0,234,255,.65); letter-spacing:.18em; font-family:Consolas,'Courier New',monospace; font-size:.65rem; }
    .flex-readout strong { font-size:clamp(2rem,5vw,4rem); line-height:.9; color:#fff; }
    .flex-readout small { color:#ffb15c; font-size:.55rem; }
    @@keyframes flexBirth { 0% { transform:scale(0); opacity:0; } 55% { transform:scale(1); opacity:1; } 100% { transform:scale(2); opacity:1; } }
    @@media(prefers-reduced-motion:reduce) { .flex-node { animation:none; transform:scale(1.5); opacity:1; } }
</style>

@code {
    private sealed record FlexNode(string Lineage, double X, double Y, int DelayMs);

    private readonly List<FlexNode> _nodes = new();
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _shutdown;
    private Task? _loop;
    private bool _active;
    private int _generation;
    private static readonly TimeSpan GenerationInterval = TimeSpan.FromMilliseconds(625);

    public void Start()
    {
        if (_active) return;
        _active = true;
        _generation = 0;
        _nodes.Clear();
        AddGeneration([("0", 50d, 50d)]);
        _shutdown = new CancellationTokenSource();
        _loop = GrowAsync(_shutdown.Token);
    }

    private async Task GrowAsync(CancellationToken cancellationToken)
    {
        _timer = new PeriodicTimer(GenerationInterval);
        try
        {
            while (_generation < 6 && await _timer.WaitForNextTickAsync(cancellationToken))
            {
                _generation++;
                var parents = _nodes.Where(n => n.Lineage.Count(c => c == '.') == _generation - 1).ToArray();
                var children = new List<(string Lineage, double X, double Y)>();

                foreach (var parent in parents)
                {
                    var offset = 4.5 + (_generation * 1.4);
                    children.Add(($"{parent.Lineage}.0", Math.Clamp(parent.X - offset, 7, 93), Math.Clamp(parent.Y - offset, 7, 93)));
                    children.Add(($"{parent.Lineage}.1", Math.Clamp(parent.X + offset, 7, 93), Math.Clamp(parent.Y + offset, 7, 93)));
                }

                AddGeneration(children);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private void AddGeneration(IEnumerable<(string Lineage, double X, double Y)> generation)
    {
        var delay = _generation * 20;
        foreach (var child in generation)
            _nodes.Add(new FlexNode(child.Lineage, child.X, child.Y, delay));
    }

    public void Dispose()
    {
        _shutdown?.Cancel();
        _timer?.Dispose();
        _shutdown?.Dispose();
    }
}