@using Microsoft.AspNetCore.Components.Web
@using TheSingularityWorkshop.Services
@using TheSingularityWorkshop.Workshop.MicroBundles
@inject FSMManagerService FSM
@implements IAsyncDisposable

@if (_idleActive && _pongBundle is not null)
{
    <section class="idle-screen-saver" aria-label="Workshop idle experience">
        <div class="idle-frame">
            <header class="idle-header">
                <span>WORKSHOP // IDLE</span>
                <span>PONG</span>
            </header>

            <div class="pong-board" aria-label="Pong idle experience">
                <div class="pong-center-line"></div>
                <div class="pong-score pong-score-left">@_pongBundle.LeftScore</div>
                <div class="pong-score pong-score-right">@_pongBundle.RightScore</div>
                <div class="pong-paddle pong-paddle-left"
                     style="@($"--paddle-position:{_pongBundle.LeftPaddle}%")"
                     @onpointerdown="BeginLeftDrag"
                     @onpointermove="DragLeftPaddle"
                     @onpointerup="EndLeftPaddleDrag"
                     @onpointercancel="EndLeftPaddleDrag"
                     @onpointerdown:stopPropagation="true"
                     @onpointermove:stopPropagation="true"
                     @onpointerup:stopPropagation="true"
                     @onpointercancel:stopPropagation="true"
                     aria-label="Player paddle">
                    <span>P</span><span>A</span><span>D</span><span>D</span><span>L</span><span>E</span>
                </div>
                <div class="pong-paddle pong-paddle-right"
                     style="@($"--paddle-position:{_pongBundle.RightPaddle}%")"
                     aria-label="AI paddle">
                    <span>P</span><span>A</span><span>D</span><span>D</span><span>L</span><span>E</span>
                </div>
                <div class="pong-ball" style="left:@(_pongBundle.BallX)%;top:@(_pongBundle.BallY)%"></div>
            </div>

            <footer class="idle-footer">
                <span>THE USER HAS GONE AWAY.</span>
                <span>THE WORKSHOP HAS NOT.</span>
            </footer>
        </div>
    </section>
}

<style>
    .idle-screen-saver { position:fixed; inset:0; z-index:90000; display:flex; align-items:center; justify-content:center; background:radial-gradient(circle at 50% 45%,rgba(0,234,255,.09),transparent 38%),rgba(1,3,8,.97); color:#dffaff; font-family:Consolas,'Courier New',monospace; animation:idleArrival .8s ease-out; }
    .idle-frame { width:min(1100px,92vw); height:min(760px,88vh); display:flex; flex-direction:column; overflow:hidden; border:1px solid rgba(0,234,255,.65); box-shadow:0 0 22px rgba(0,234,255,.28),0 0 90px rgba(255,44,255,.12),inset 0 0 40px rgba(0,234,255,.035); background:rgba(2,7,17,.96); }
    .idle-header,.idle-footer { display:flex; justify-content:space-between; gap:1rem; padding:.7rem 1rem; font-size:.7rem; letter-spacing:.16em; text-transform:uppercase; border-bottom:1px solid rgba(0,234,255,.28); color:#8eefff; }
    .idle-footer { border-top:1px solid rgba(0,234,255,.28); border-bottom:0; color:#ffb15c; }
    .pong-board { position:relative; flex:1; min-height:0; margin:2rem; overflow:hidden; border:1px solid rgba(0,234,255,.38); background:radial-gradient(circle,rgba(0,234,255,.035),transparent 60%); }
    .pong-center-line { position:absolute; top:0; bottom:0; left:50%; border-left:1px dashed rgba(255,255,255,.18); }
    .pong-score { position:absolute; top:4%; font-size:clamp(3rem,8vw,6rem); color:rgba(0,234,255,.18); user-select:none; }
    .pong-score-left { left:43%; }.pong-score-right { left:53%; }
    .pong-paddle { position:absolute; top:clamp(calc(9% + 5px),var(--paddle-position),calc(91% - 5px)); width:10px; height:18%; transform:translateY(-50%); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:0; background:#00eaff; box-shadow:0 0 12px #00eaff,0 0 30px rgba(0,234,255,.55); color:#020711; font-size:8px; line-height:.92; font-weight:900; letter-spacing:0; user-select:none; cursor:ns-resize; touch-action:none; }
    .pong-paddle-left { left:2%; }.pong-paddle-right { right:2%; background:#ff2cff; box-shadow:0 0 12px #ff2cff,0 0 30px rgba(255,44,255,.55); cursor:default; }
    .pong-paddle span { display:block; }
    .pong-ball { position:absolute; width:14px; height:14px; transform:translate(-50%,-50%); border-radius:0; background:#ffd34d; box-shadow:0 0 12px #ffd34d,0 0 30px rgba(255,211,77,.65); }
    @@keyframes idleArrival { from { opacity:0; transform:scale(1.03); } to { opacity:1; transform:scale(1); } }
    @@media(max-width:700px) { .idle-frame{width:96vw;height:90vh}.pong-board{margin:1rem}.idle-header,.idle-footer{font-size:.55rem;letter-spacing:.08em}.pong-paddle{width:7px;font-size:6px}.pong-ball{width:10px;height:10px} }
</style>

@code {
    private readonly Random _random = new();
    private CancellationTokenSource? _shutdown;
    private Task? _loop;
    private DateTime _lastActivityUtc = DateTime.UtcNow;
    private bool _idleActive;
    private PongMicroBundle? _pongBundle;
    private bool _draggingLeftPaddle;

    private static readonly TimeSpan IdleThreshold = TimeSpan.FromSeconds(7);

    protected override void OnInitialized()
    {
        _shutdown = new CancellationTokenSource();
        _loop = RunAsync(_shutdown.Token);
    }

    public void RegisterActivity()
    {
        _lastActivityUtc = DateTime.UtcNow;
        if (_idleActive)
            StopIdleExperience();
    }

    private async Task RunAsync(CancellationToken cancellationToken)
    {
        // This timer is only the Blazor repaint/activity observer. It does not
        // advance Pong. Pong simulation time belongs to its FSM_API process group.
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(33));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (FSM.Context.EnterRequested)
                {
                    StopIdleExperience();
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                if (!_idleActive && DateTime.UtcNow - _lastActivityUtc >= IdleThreshold)
                    StartIdleExperience();

                if (_idleActive && _pongBundle is not null)
                    _pongBundle.Update();

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private void StartIdleExperience()
    {
        StopIdleExperience();
        _idleActive = true;
        _pongBundle = MicroBundleCatalog.CreatePong();
    }

    private void StopIdleExperience()
    {
        _idleActive = false;
        _draggingLeftPaddle = false;
        _pongBundle?.Dispose();
        _pongBundle = null;
    }

    private void BeginLeftDrag(PointerEventArgs _)
    {
        if (_idleActive && _pongBundle is not null)
            _draggingLeftPaddle = true;
    }

    private void DragLeftPaddle(PointerEventArgs e)
    {
        if (!_draggingLeftPaddle || _pongBundle is null) return;
        _pongBundle.MoveLeftPaddle(e.MovementY / 7.0);
    }

    private void EndLeftPaddleDrag(PointerEventArgs _)
    {
        _draggingLeftPaddle = false;
    }

    public async ValueTask DisposeAsync()
    {
        if (_shutdown is null) return;

        await _shutdown.CancelAsync();
        if (_loop is not null)
        {
            try { await _loop; } catch (OperationCanceledException) { }
        }

        _pongBundle?.Dispose();
        _pongBundle = null;
        _shutdown.Dispose();
    }
}
