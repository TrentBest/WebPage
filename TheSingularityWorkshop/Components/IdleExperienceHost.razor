@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using TheSingularityWorkshop.Workshop.Experiences
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (_active)
{
    <section class="pong-experience" tabindex="0" aria-label="PONG experience"
             @onkeydown="HandleKeyDown" @onkeyup="HandleKeyUp">
        <div class="pong-frame">
            <header class="pong-header"><span>EXPERIENCE // PONG</span><span>SIGHT <b>+</b> HEARING</span></header>
            <div class="pong-board">
                <div class="pong-center-line"></div>
                <div class="pong-score pong-score-left">@_runtime.PlayerScore</div>
                <div class="pong-score pong-score-right">@_runtime.OpponentScore</div>
                <div class="pong-paddle pong-paddle-left" style="top:@_runtime.PlayerPaddle%" aria-label="Player paddle"></div>
                <div class="pong-paddle pong-paddle-right" style="top:@_runtime.OpponentPaddle%" aria-label="Opponent paddle"></div>
                <div class="pong-ball" style="left:@_runtime.BallX%;top:@_runtime.BallY%"></div>
                <div class="pong-help">↑ / W &nbsp; UP &nbsp;&nbsp; ↓ / S &nbsp; DOWN</div>
            </div>
            <footer class="pong-footer"><span>MICROBUNDLES: @_experience.MicroBundleIds.Count</span><span>INPUT // PHYSICS // PRESENTATION</span><button type="button" @onclick="Exit">RETURN</button></footer>
        </div>
    </section>
}

<style>
    .pong-experience{position:fixed;inset:0;z-index:90000;outline:none;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 45%,rgba(0,234,255,.09),transparent 38%),#010308;color:#dffaff;font-family:Consolas,'Courier New',monospace}
    .pong-frame{width:min(1100px,92vw);height:min(760px,88vh);display:flex;flex-direction:column;overflow:hidden;border:1px solid rgba(0,234,255,.65);box-shadow:0 0 22px rgba(0,234,255,.28),0 0 90px rgba(255,44,255,.12),inset 0 0 40px rgba(0,234,255,.035);background:rgba(2,7,17,.97)}
    .pong-header,.pong-footer{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.7rem 1rem;font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;border-bottom:1px solid rgba(0,234,255,.28);color:#8eefff}.pong-footer{border-top:1px solid rgba(0,234,255,.28);border-bottom:0;color:#ffb15c}.pong-footer button{border:1px solid rgba(0,234,255,.55);background:transparent;color:#8eefff;padding:.3rem .65rem;font:inherit;cursor:pointer}
    .pong-board{position:relative;flex:1;min-height:0;margin:2rem;overflow:hidden;border:1px solid rgba(0,234,255,.38);background:radial-gradient(circle,rgba(0,234,255,.035),transparent 60%);box-shadow:inset 0 0 45px rgba(0,234,255,.025)}.pong-board::after{content:"";position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(255,255,255,.012) 0,rgba(255,255,255,.012) 1px,transparent 1px,transparent 5px)}
    .pong-center-line{position:absolute;top:0;bottom:0;left:50%;border-left:1px dashed rgba(255,255,255,.18)}.pong-score{position:absolute;top:4%;z-index:1;font-size:clamp(3rem,8vw,6rem);color:rgba(0,234,255,.18);user-select:none}.pong-score-left{left:43%}.pong-score-right{left:53%}
    .pong-paddle{position:absolute;z-index:2;width:10px;height:18%;transform:translateY(-50%);background:#00eaff;box-shadow:0 0 12px #00eaff,0 0 30px rgba(0,234,255,.55)}.pong-paddle-left{left:2%}.pong-paddle-right{right:2%;background:#ff2cff;box-shadow:0 0 12px #ff2cff,0 0 30px rgba(255,44,255,.55)}.pong-ball{position:absolute;z-index:3;width:14px;height:14px;transform:translate(-50%,-50%);background:#ffd34d;box-shadow:0 0 12px #ffd34d,0 0 30px rgba(255,211,77,.65)}.pong-help{position:absolute;z-index:4;left:50%;bottom:2%;transform:translateX(-50%);font-size:.65rem;letter-spacing:.1em;color:rgba(223,250,255,.45);white-space:nowrap}
    @@media(max-width:700px){.pong-frame{width:96vw;height:90vh}.pong-board{margin:1rem}.pong-header,.pong-footer{font-size:.55rem;letter-spacing:.08em}.pong-paddle{width:7px}.pong-ball{width:10px;height:10px}}
</style>

@code {
    private static readonly TimeSpan IdleThreshold=TimeSpan.FromSeconds(7);
    private readonly PongExperience _experience=new();
    private readonly PongExperienceRuntime _runtime=new();
    private CancellationTokenSource? _shutdown;
    private Task? _loop;
    private DateTime _lastActivityUtc=DateTime.UtcNow;
    private bool _active;
    private IJSObjectReference? _audio;

    protected override void OnInitialized(){_shutdown=new CancellationTokenSource();_runtime.SoundTriggered+=OnSound;_loop=RunAsync(_shutdown.Token);}

    private async Task RunAsync(CancellationToken token){using var timer=new PeriodicTimer(TimeSpan.FromMilliseconds(33));try{while(await timer.WaitForNextTickAsync(token)){if(!_active&&DateTime.UtcNow-_lastActivityUtc>=IdleThreshold){_active=true;_runtime.Reset();await InvokeAsync(StateHasChanged);}if(_active){_runtime.Step();await InvokeAsync(StateHasChanged);}}}catch(OperationCanceledException)when(token.IsCancellationRequested){}}

    private async void OnSound(PongSoundEvent sound){if(sound==PongSoundEvent.None||_audio is null)return;try{await _audio.InvokeVoidAsync("play",sound.ToString().ToLowerInvariant());}catch(JSDisconnectedException){}}
    private Task HandleKeyDown(KeyboardEventArgs e){if(!_active)return Task.CompletedTask;var key=e.Key.ToLowerInvariant();_runtime.SetInput(key is "arrowup" or "w",key is "arrowdown" or "s");return Task.CompletedTask;}
    private Task HandleKeyUp(KeyboardEventArgs e){if(!_active)return Task.CompletedTask;var key=e.Key.ToLowerInvariant();if(key is "arrowup" or "w" or "arrowdown" or "s")_runtime.SetInput(false,false);return Task.CompletedTask;}
    private void Exit(){_active=false;_lastActivityUtc=DateTime.UtcNow;_runtime.SetInput(false,false);}

    public async ValueTask DisposeAsync(){_runtime.SoundTriggered-=OnSound;if(_shutdown is not null){await _shutdown.CancelAsync();if(_loop is not null){try{await _loop;}catch(OperationCanceledException){}}_shutdown.Dispose();}if(_audio is not null)await _audio.DisposeAsync();}
    protected override async Task OnAfterRenderAsync(bool firstRender){if(firstRender)_audio=await JS.InvokeAsync<IJSObjectReference>("import","./js/pong-audio.js");}
}
