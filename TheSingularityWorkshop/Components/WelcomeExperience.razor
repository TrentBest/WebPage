@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using TheSingularityWorkshop.FSM_API
@using FsmApi = TheSingularityWorkshop.FSM_API.FSM_API
@using TheSingularityWorkshop.Gui
@implements IDisposable

@BuildWelcome()

<style>
    @@keyframes welcomeFsmBreath {
        0%, 100% { filter: brightness(.9) saturate(.9); transform: scale(1); }
        50% { filter: brightness(1.65) saturate(1.5); transform: scale(1.035); }
    }
    .welcome-fsm-action-breathing { will-change: transform, filter; }
</style>

@code {
    private const string Cyan = "#00eaff";
    private const string Magenta = "#ff2cff";
    private const string Green = "#52e05a";
    private const string Yellow = "#ffd34d";
    private const string Ink = "#020711";

    private static int _nextLabId;
    private readonly string _labId = Interlocked.Increment(ref _nextLabId).ToString();
    private readonly string _processingGroup = $"WelcomeLab_{Guid.NewGuid():N}";
    private readonly List<string> _events = new();
    private FSMHandle? _handle;
    private WelcomeLabContext? _context;
    private string _machineName = string.Empty;
    private bool _disposed;
    private bool _showLab;
    private bool _transitioning;
    private string _selectedMachine = "Lifecycle";
    private string[] StateNames => _selectedMachine switch
    {
        "Movement" => new[] { "Idle", "Walking", "Jumping" },
        "Spellcasting" => new[] { "Idle", "Casting Magic", "Complete" },
        _ => new[] { "Ready", "Running", "Complete" }
    };
    private bool IsComplete => CurrentState == StateNames[^1];
    private bool CanStart => CurrentState == StateNames[0];
    private bool CanTick => CurrentState == StateNames[1];
    private bool CanReset => IsComplete;

    private string CurrentState => _handle?.CurrentState ?? "NOT COMPOSED";
    private int TickCount => _context?.UpdateCount ?? 0;
    private bool IsRunning => _context?.IsValid == true && _handle?.IsValid == true;

    protected override void OnInitialized()
    {
        // The Welcome lab owns a dedicated processing group; no visitor's ticks
        // may advance another visitor's machine.
        FsmApi.Create.CreateProcessingGroup(_processingGroup);
        ComposeMachine();
    }

    private void ComposeMachine()
    {
        if (_disposed)
            return;

        _context = new WelcomeLabContext
        {
            Name = $"WelcomeLabContext_{_labId}_{Guid.NewGuid():N}",
            Context_ID = Interlocked.Increment(ref WelcomeLabContext.NextContextId)
        };
        _events.Clear();
        _machineName = $"WelcomeLabMachine_{_labId}_{Guid.NewGuid():N}";

        var machine = FsmApi.Create.CreateFiniteStateMachine(
            _machineName,
            processRate: -1,
            processingGroup: _processingGroup);

        var states = StateNames;
        foreach (var state in states)
        {
            var capturedState = state;
            machine.State(capturedState,
                onEnter: _ => Record($"OnEnter → {capturedState}"),
                onUpdate: _ => UpdateState(capturedState, states),
                onExit: _ => Record($"OnExit → {capturedState}"));
        }

        machine.WithInitialState(states[0]);
        machine.Transition(states[0], states[1], ctx => ((WelcomeLabContext)ctx).StartRequested);
        machine.Transition(states[1], states[2], ctx => ((WelcomeLabContext)ctx).UpdateCount >= 2);
        machine.BuildDefinition();

        _handle = FsmApi.Create.CreateInstance(_machineName, _context, _processingGroup);

        // Enter Ready during composition so the first visitor signal is evaluated
        // as a signal, rather than being consumed by the FSM's initial lifecycle step.
        FsmApi.Interaction.Update(_processingGroup);
    }

    private void Begin()
    {
        if (_context is null || !_context.IsValid || !CanStart)
            return;

        _context.StartRequested = true;

        // FSM_API defers state transitions to the processing-group update. Tick
        // until Running becomes the current state, then deliver its OnEnter before
        // leaving the visitor in control of subsequent runtime ticks.
        for (var tick = 0; tick < 3 && CurrentState != StateNames[1]; tick++)
            StepMachine();

        if (CurrentState == StateNames[1])
            StepMachine();
    }

    private void StepMachine()
    {
        if (!IsRunning)
            return;

        FsmApi.Interaction.Update(_processingGroup);
        StateHasChanged();
    }

    private void Reset()
    {
        DestroyMachine();

        // The unique processing group belongs only to this visitor's lab instance.
        // A reset creates a fresh FSM rather than resetting a shared/global machine.
        ComposeMachine();
        StateHasChanged();
    }

    private void DestroyMachine()
    {
        if (_context is not null)
            _context.IsValid = false;

        if (!string.IsNullOrWhiteSpace(_machineName))
            FsmApi.Interaction.DestroyFiniteStateMachine(_machineName, _processingGroup);

        _handle = null;
        _context = null;
    }

    private void UpdateState(string state, string[] states)
    {
        if (state == states[1] && _context is not null)
            _context.UpdateCount++;

        Record(state == states[1] && _context is not null
            ? $"OnUpdate → {state} // tick {_context.UpdateCount}"
            : $"OnUpdate → {state}");
    }

    private void Record(string entry)
    {
        _events.Add(entry);
        if (_events.Count > 8)
            _events.RemoveAt(0);
    }

    private RenderFragment BuildWelcome()
    {
        var stateIndex = Array.IndexOf(StateNames, CurrentState);
        var stateAccent = stateIndex switch
        {
            0 => Cyan,
            1 => Magenta,
            _ => Green
        };

        var root = WorkshopGui.Panel(this)
            .Style("position", "relative")
            .Style("width", "100%")
            .Style("height", "100%")
            .Style("min-height", "0")
            .Style("box-sizing", "border-box")
            .Style("overflow", "hidden")
            .Style("transition", "opacity 650ms ease, transform 850ms cubic-bezier(.2,.8,.2,1)")
            .Style("opacity", _transitioning ? "0" : "1")
            .Style("transform", _transitioning ? "scale(.94)" : "scale(1)")
            .Style("padding", "clamp(1rem,3vw,2.5rem)")
            .Style("background", "radial-gradient(ellipse at 50% 0%,rgba(0,234,255,.08),transparent 45%),#020711")
            .Style("color", "#f4fbff")
            .Style("font-family", "Consolas,'Courier New',monospace");

        root.Content(WorkshopGui.Element(this, "div")
            .Style("color", Cyan)
            .Style("font-size", ".65rem")
            .Style("letter-spacing", ".22em")
            .Text("WELCOME // A WORKING SYSTEM, NOT A STATIC PAGE"));

        root.Content(WorkshopGui.Element(this, "h1")
            .Style("max-width", "18ch")
            .Style("margin", ".7rem 0")
            .Style("font-size", "clamp(1.8rem,5vw,4rem)")
            .Style("line-height", ".98")
            .Text("Make a system. Change its state. Watch it respond."));

        root.Content(WorkshopGui.Element(this, "p")
            .Style("max-width", "70ch")
            .Style("color", "#9bb5c2")
            .Style("font-family", "system-ui,sans-serif")
            .Style("font-size", "clamp(.8rem,1.2vw,1rem)")
            .Style("line-height", "1.7")
            .Text("The Workshop builds experiences from explicit state, composable capabilities, and shared GUI grammar. Start with a real finite-state machine below: you control the signal, the FSM_API runtime drives transitions, and the lifecycle trace records what actually happens."));

        if (!_showLab)
        {
            root.Content(WorkshopGui.Element(this, "p")
                .Style("max-width", "56ch")
                .Style("margin-top", "1.5rem")
                .Style("color", "#d8faff")
                .Style("font-size", "clamp(1rem,2vw,1.3rem)")
                .Style("line-height", "1.6")
                .Text("First, meet the idea in words. A system waits. You give it a signal. It changes state. Then we open the controls and let you drive the runtime."));
            root.Content(WorkshopGui.Button(this)
                .Label("REVEAL THE FSM")
                .Style("margin-top", "1rem")
                .Style("padding", ".9rem 1.1rem")
                .Style("border", "1px solid " + Cyan)
                .Style("background", Cyan + "18")
                .Style("color", Cyan)
                .Style("font-family", "inherit")
                .Style("font-weight", "800")
                .Style("letter-spacing", ".12em")
                .Style("cursor", "pointer")
                .Style("animation", "welcomeFsmBreath 1.45s ease-in-out infinite")
                .Style("box-shadow", "0 0 22px " + Cyan + "55")
                .OnClick(RevealLab));
            return root.Build();
        }

        var workspace = WorkshopGui.MultiPanel(this)
            .Style("display", "grid")
            .Style("grid-template-columns", "repeat(auto-fit,minmax(min(100%,320px),1fr))")
            .Style("gap", "1rem")
            .Style("align-items", "stretch")
            .Style("margin-top", "1.2rem");

        var machine = WorkshopGui.Panel(this)
            .Style("min-width", "0")
            .Style("padding", "clamp(1rem,2vw,1.5rem)")
            .Style("border", $"1px solid {stateAccent}55")
            .Style("background", "linear-gradient(145deg,rgba(0,168,255,.055),rgba(3,8,17,.95))");

        machine.Content(WorkshopGui.Element(this, "div")
            .Style("color", "#78939c")
            .Style("font-size", ".55rem")
            .Style("letter-spacing", ".18em")
            .Text("LIVE FSM // CURRENT STATE"));

        machine.Content(WorkshopGui.Element(this, "div")
            .Attribute("class", "welcome-fsm-current-state")
            .Style("display", "flex")
            .Style("align-items", "center")
            .Style("justify-content", "center")
            .Style("min-height", "8rem")
            .Style("margin", ".8rem 0")
            .Style("border", $"1px solid {stateAccent}55")
            .Style("background", stateAccent)
            .Style("color", Ink)
            .Style("box-shadow", $"0 0 36px {stateAccent}44")
            .Style("font-size", "clamp(1.7rem,4vw,3rem)")
            .Style("font-weight", "800")
            .Style("letter-spacing", ".08em")
            .Text(CurrentState));

        var stateFlow = WorkshopGui.MultiPanel(this)
            .Style("display", "grid")
            .Style("grid-template-columns", "repeat(3,minmax(0,1fr))")
            .Style("gap", ".4rem");

        var cardIndex = 0;
        foreach (var state in StateNames)
        {
            var active = string.Equals(CurrentState, state, StringComparison.Ordinal);
            var accent = cardIndex++ switch { 0 => Cyan, 1 => Magenta, _ => Green };
            var stateCard = WorkshopGui.Panel(this)
                .Style("padding", ".7rem .4rem")
                .Style("text-align", "center")
                .Style("border", $"1px solid {accent}{(active ? "cc" : "33")}")
                .Style("background", active ? accent : "rgba(255,255,255,.015)")
                .Style("color", active ? Ink : accent);
            stateCard.Content(WorkshopGui.Element(this, "div")
                .Style("color", accent)
                .Style("font-size", ".58rem")
                .Style("font-weight", "800")
                .Text(state));
            stateFlow.Content(stateCard);
        }
        machine.Content(stateFlow);

        var controls = WorkshopGui.MultiPanel(this)
            .Style("display", "flex")
            .Style("flex-wrap", "wrap")
            .Style("gap", ".5rem")
            .Style("margin-top", "1rem");
        controls.Content(Action("SEND START SIGNAL", Begin, Cyan, CanStart));
        controls.Content(Action("TICK RUNTIME", StepMachine, Magenta, CanTick));
        controls.Content(Action("RESET MACHINE", Reset, Yellow, CanReset));

        var samplePicker = WorkshopGui.Element(this, "select")
            .Attribute("aria-label", "Choose an example finite-state machine")
            .Style("width", "100%")
            .Style("margin-top", "1rem")
            .Style("padding", ".75rem")
            .Style("border", "1px solid rgba(0,234,255,.35)")
            .Style("background", "#071321")
            .Style("color", "#f4fbff")
            .Style("font-family", "inherit")
            .Style("font-size", ".75rem")
            .Attribute("value", _selectedMachine)
            .Attribute("onchange", MachineChanged);
        foreach (var sample in new[] { "Lifecycle", "Movement", "Spellcasting" })
            samplePicker.Child(WorkshopGui.Element(this, "option").Attribute("value", sample).Text(sample switch
            {
                "Movement" => "Movement — Idle, Walking, Jumping",
                "Spellcasting" => "Spellcasting — Idle, Casting Magic, Complete",
                _ => "Lifecycle — Ready, Running, Complete"
            }));
        machine.Content(WorkshopGui.Element(this, "div")
            .Style("margin-top", "1.1rem")
            .Style("color", Cyan)
            .Style("font-size", ".58rem")
            .Style("letter-spacing", ".12em")
            .Text("CHOOSE AN FSM EXAMPLE"));
        machine.Content(samplePicker);
        machine.Content(controls);

        machine.Content(WorkshopGui.Element(this, "p")
            .Style("margin", ".8rem 0 0")
            .Style("color", "#78939c")
            .Style("font-family", "system-ui,sans-serif")
            .Style("font-size", ".75rem")
            .Style("line-height", "1.6")
            .Text($"UPDATE COUNT // {TickCount} — {StateNames[1]} transitions to {StateNames[2]} after two runtime updates. Choose another sample above to compose a fresh FSM."));

        var trace = WorkshopGui.Panel(this)
            .Style("min-width", "0")
            .Style("padding", "1rem")
            .Style("border", "1px solid rgba(255,44,255,.28)")
            .Style("background", "rgba(7,2,12,.92)");

        trace.Content(WorkshopGui.Element(this, "div")
            .Style("color", Magenta)
            .Style("font-size", ".55rem")
            .Style("letter-spacing", ".18em")
            .Text("RUNTIME // LIFECYCLE TRACE"));

        foreach (var entry in _events.AsEnumerable().Reverse())
        {
            trace.Content(WorkshopGui.Element(this, "div")
                .Style("padding", ".45rem 0")
                .Style("border-bottom", "1px solid rgba(255,255,255,.055)")
                .Style("color", entry.Contains("OnExit", StringComparison.Ordinal) ? Yellow : "#b9d8df")
                .Style("font-size", ".68rem")
                .Style("line-height", "1.45")
                .Text("› " + entry));
        }

        if (_events.Count == 0)
        {
            trace.Content(WorkshopGui.Element(this, "p")
                .Style("color", "#78939c")
                .Style("font-family", "system-ui,sans-serif")
                .Style("font-size", ".8rem")
                .Text("The machine is composed and waiting. Send the start signal to see its lifecycle begin."));
        }

        trace.Content(WorkshopGui.Element(this, "p")
            .Style("margin-top", "1rem")
            .Style("color", "#78939c")
            .Style("font-family", "system-ui,sans-serif")
            .Style("font-size", ".72rem")
            .Style("line-height", "1.6")
            .Text("This is a live FSM_API-backed interaction—not a prerecorded animation. The surrounding Welcome surface is composed with the Workshop GUI builders."));

        workspace.Content(machine);
        workspace.Content(trace);
        root.Content(workspace);

        root.Content(WorkshopGui.Element(this, "p")
            .Style("margin-top", "1.2rem")
            .Style("color", "#58747e")
            .Style("font-family", "system-ui,sans-serif")
            .Style("font-size", ".7rem")
            .Text("NEXT: this hands-on pattern can grow into manifest-selected MicroBundles and FSM_COS-composed Experiences. This first slice demonstrates real FSM lifecycle behavior; it does not pretend the lab itself is a complete FSM_COS assembly authoring tool."));

        return root.Build();
    }

    private async Task RevealLab()
    {
        if (_showLab || _transitioning)
            return;
        _transitioning = true;
        StateHasChanged();
        await Task.Delay(720);
        _showLab = true;
        _transitioning = false;
        StateHasChanged();
    }

    private EventCallback<ChangeEventArgs> MachineChanged => EventCallback.Factory.Create<ChangeEventArgs>(this, ChangeMachine);

    private void ChangeMachine(ChangeEventArgs args)
    {
        var next = args.Value?.ToString();
        if (next is not ("Lifecycle" or "Movement" or "Spellcasting"))
            return;
        _selectedMachine = next;
        ComposeMachine();
        StateHasChanged();
    }

    private ElementBuilder Action(string label, Action action, string accent, bool breathe)
        => WorkshopGui.Button(this)
            .Label(label)
            .Attribute("class", breathe ? "welcome-fsm-action welcome-fsm-action-breathing" : "welcome-fsm-action")
            .Attribute("disabled", !breathe)
            .Style("padding", ".75rem .8rem")
            .Style("border", $"1px solid {accent}66")
            .Style("background", $"{accent}0c")
            .Style("color", accent)
            .Style("font-family", "inherit")
            .Style("font-size", ".6rem")
            .Style("letter-spacing", ".08em")
            .Style("cursor", breathe ? "pointer" : "default")
            .Style("opacity", breathe ? "1" : ".38")
            .Style("animation", breathe ? "welcomeFsmBreath 1.45s ease-in-out infinite" : "none")
            .Style("box-shadow", breathe ? $"0 0 22px {accent}55" : "none")
            .OnClick(action);

}