@* =================================================================================================
   THE SINGULARITY WORKSHOP — OBSERVABLE EXPERIENCE FEED
   -------------------------------------------------------------------------------------------------
   This is intentionally a small manifestation of facts already present in the landing experiment.
   It is not telemetry and it does not invent runtime events. The long-term destination is a real
   WorkshopExperience/fact model; for now these observations are kept close to the manifestation.
   ================================================================================================= *@

@inject TheSingularityWorkshop.Services.WorkshopExperienceService Experience

<div class="workshop-experience-feed" aria-label="Workshop experience observations">
    <div class="experience-feed-label">WORKSHOP // OBSERVATIONS</div>
    <div class="experience-feed-window">
        <div class="experience-feed-track">
            @foreach (var fact in RuntimeFacts)
            {
                <div class="experience-fact">
                    <span class="experience-marker">&gt;</span>
                    <span>@fact</span>
                </div>
            }

            @* Duplicate the sequence so the CSS loop can be continuous. *@
            @foreach (var fact in RuntimeFacts)
            {
                <div class="experience-fact" aria-hidden="true">
                    <span class="experience-marker">&gt;</span>
                    <span>@fact</span>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .workshop-experience-feed {
        position: fixed;
        left: clamp(.75rem, 2vw, 2rem);
        bottom: clamp(.75rem, 2vw, 2rem);
        z-index: 9500;
        width: min(34rem, calc(100vw - 1.5rem));
        box-sizing: border-box;
        padding: .55rem .7rem .65rem;
        border: 1px solid rgba(0, 234, 255, .22);
        border-left: 2px solid rgba(0, 234, 255, .65);
        background: linear-gradient(90deg, rgba(2, 7, 17, .88), rgba(2, 7, 17, .58));
        box-shadow: 0 0 18px rgba(0, 234, 255, .08), inset 0 0 18px rgba(0, 234, 255, .025);
        color: #dffcff;
        font-family: Consolas, 'Courier New', monospace;
        pointer-events: none;
        overflow: hidden;
        backdrop-filter: blur(4px);
    }

    .experience-feed-label {
        margin-bottom: .35rem;
        color: #00eaff;
        font-size: .58rem;
        letter-spacing: .18em;
        text-transform: uppercase;
        opacity: .8;
    }

    .experience-feed-window {
        position: relative;
        height: 3.2rem;
        overflow: hidden;
        mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    }

    .experience-feed-track {
        display: flex;
        width: max-content;
        height: 100%;
        align-items: center;
        animation: workshopExperienceScroll 72s linear infinite;
    }

    .experience-fact {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: .5rem;
        margin-right: 3rem;
        color: rgba(234, 252, 255, .86);
        font-size: clamp(.65rem, .9vw, .78rem);
        letter-spacing: .08em;
        line-height: 1.35;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .experience-marker {
        color: #ff2cff;
        text-shadow: 0 0 8px rgba(255, 44, 255, .7);
    }

    @@keyframes workshopExperienceScroll {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }

    @@media (prefers-reduced-motion: reduce) {
        .experience-feed-track { animation-play-state: paused; }
    }

    @@media (max-width: 650px) {
        .workshop-experience-feed {
            left: .5rem;
            right: .5rem;
            bottom: .5rem;
            width: auto;
        }
    }
</style>

@code {
    private IReadOnlyList<string> RuntimeFacts
    {
        get
        {
            var assembly = Experience.RuntimeAssembly;
            if (assembly is null)
                return ["RUNTIME ASSEMBLY NOT LOADED."];

            var facts = new List<string>
            {
                $"EXPERIENCE: {Experience.SelectedExperience?.Name ?? "UNNAMED"}",
                $"EXPERIENCE ID: {Experience.SelectedExperience?.Id ?? 0}",
                $"EXPERIENCE VERSION: {FormatVersion(Experience.SelectedExperience?.Version)}",
                $"RUNTIME BUNDLES LOADED: {assembly.Bundles.Count}"
            };

            facts.AddRange(
                assembly.Bundles
                    .OrderBy(bundle => bundle.Id)
                    .Select(bundle => $"MICROBUNDLE LOADED: {bundle.Id}"));

            facts.Add($"PROCESSING GROUPS: {string.Join(", ", Experience.SelectedExperience?.ProcessingGroups ?? Array.Empty<string>())}");
            return facts;
        }
    }

    private static string FormatVersion(TheSingularityWorkshop.SingularityHub.BundleVersion? version)
        => version is null ? "UNKNOWN" : $"{version.Value.Major}.{version.Value.Minor}.{version.Value.Patch}";
}