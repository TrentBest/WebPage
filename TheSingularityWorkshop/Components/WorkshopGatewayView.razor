<section class="gateway-stage" aria-label="Workshop entry">
    <div class="gateway-copy" aria-hidden="true">
        <div class="gateway-memory">THEY SAY A PICTURE IS WORTH A THOUSAND WORDS.</div>
        <div class="gateway-memory">HOW MANY WORDS IS A LIVING IMAGE WORTH?</div>
    </div>

    <button class="enter-workshop" @onclick="EnterWorkshop" aria-label="Enter The Singularity Workshop">
        <span class="enter-corner tl" aria-hidden="true"></span><span class="enter-corner tr" aria-hidden="true"></span>
        <span class="enter-corner bl" aria-hidden="true"></span><span class="enter-corner br" aria-hidden="true"></span>
        <span class="enter-image" aria-hidden="true">
            <img src="/Images/TheSingularityWorkshopLogo.png" alt="" />
        </span>
        <strong>ENTER THE WORKSHOP</strong>
    </button>

    <div class="workshop-warning" role="note">
        <div class="warning-header"><span>⚠</span> SYSTEM ADVISORY: MAXIMUM OVERDRIVE ACTIVE <span>⚠</span></div>
        <div class="warning-body">You are entering a living software environment assembled from state, capability, composition, and interaction.<br /><span class="warning-final">Viewer discretion and spare RAM advised.</span></div>
    </div>
</section>

<style>
.gateway-stage{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:clamp(.65rem,2vh,1.2rem);padding:clamp(.65rem,2vmin,1.5rem);box-sizing:border-box;overflow:hidden;background:radial-gradient(circle at 50% 42%,rgba(0,234,255,.09),transparent 35%),#020711}.gateway-copy{position:absolute;inset:0;pointer-events:none;display:flex;flex-direction:column;justify-content:space-between;align-items:center;padding:5vh 4vw;color:rgba(238,250,255,.035);font:700 clamp(.7rem,1.2vw,1rem) Georgia,'Times New Roman',serif;letter-spacing:.035em}.gateway-memory{opacity:.65}
.enter-workshop{position:relative;width:min(560px,78vw,45vh);height:auto;aspect-ratio:560 / 390;min-width:0;min-height:0;padding:0;box-sizing:border-box;display:flex;align-items:center;justify-content:center;overflow:visible;border:2px solid #00eaff;border-radius:16px;background:rgba(3,10,22,.76);color:#fff;cursor:pointer;box-shadow:0 0 18px rgba(0,234,255,.35),0 0 65px rgba(0,234,255,.1),inset 0 0 35px rgba(0,234,255,.06);animation:gatewayManifest .55s steps(6,end) both;transition:transform .35s cubic-bezier(.16,1,.3,1),box-shadow .35s ease,border-color .35s ease}.enter-workshop:hover{transform:scale(1.025);border-color:#ff2cff;box-shadow:0 0 18px rgba(255,44,255,.7),0 0 60px rgba(0,234,255,.2),inset 0 0 40px rgba(255,44,255,.08)}.enter-image{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);height:100%;width:auto;max-width:100%;aspect-ratio:1;border:2px solid #00eaff;border-radius:50%;box-sizing:border-box;overflow:hidden;background:#020711;box-shadow:0 0 12px rgba(0,234,255,.7),0 0 38px rgba(0,234,255,.22),0 0 60px rgba(255,44,255,.1);transition:transform .45s cubic-bezier(.16,1,.3,1),filter .45s ease,box-shadow .45s ease,border-color .35s ease,border-width .35s ease;transform-origin:center}.enter-image img{position:absolute;left:-30%;top:-30%;display:block;width:160%;height:160%;max-width:none;max-height:none;object-fit:cover;opacity:.88;filter:saturate(1.1);transition:filter .45s ease;transform-origin:center}.enter-workshop:hover .enter-image{transform:translate(-50%,-50%) scale(1.16);border-color:#ff2cff;box-shadow:0 0 18px rgba(255,44,255,.95),0 0 48px rgba(0,234,255,.35),0 0 82px rgba(255,44,255,.3)}.enter-workshop:hover .enter-image img{filter:saturate(1.32) contrast(1.08) brightness(1.1)}.enter-workshop strong{position:absolute;bottom:8%;font-size:clamp(1rem,2vw,1.7rem);letter-spacing:.18em;text-shadow:0 0 12px #00eaff}
.enter-corner{position:absolute;width:42px;height:42px;z-index:2}.enter-corner::before,.enter-corner::after{content:"";position:absolute;background:#00eaff;box-shadow:0 0 8px rgba(0,234,255,.55)}.enter-corner::before{width:42px;height:1px}.enter-corner::after{width:1px;height:42px}.tl{left:15px;top:15px}.tr{right:15px;top:15px;transform:rotate(90deg)}.bl{left:15px;bottom:15px;transform:rotate(-90deg)}.br{right:15px;bottom:15px;transform:rotate(180deg)}
.workshop-warning{width:min(680px,78%);padding:.75rem 1.2rem .85rem;box-sizing:border-box;text-align:center;background:rgba(20,10,2,.92);border:3px solid #ff6600;border-radius:5px;box-shadow:0 0 14px rgba(255,102,0,.22),0 0 30px rgba(255,102,0,.12)}.warning-header{display:flex;justify-content:center;gap:.65rem;margin-bottom:.4rem;color:#ffb15c;font-size:clamp(.65rem,1vw,.86rem);font-weight:700;letter-spacing:.13em}.warning-body{font-size:clamp(.62rem,.9vw,.8rem);line-height:1.6;color:#dceaf2}.warning-final{color:#ffb15c}
@@keyframes gatewayManifest{0%{opacity:0;filter:blur(5px);clip-path:inset(49% 0 49% 0)}35%{opacity:.35;clip-path:inset(22% 0 22% 0)}70%{opacity:.82;filter:blur(.7px);clip-path:inset(4% 0 4% 0)}100%{opacity:1;filter:none;clip-path:inset(0)}}@@media(max-width:700px){.enter-workshop{width:min(88vw,45vh)}.workshop-warning{width:88%}}@@media(prefers-reduced-motion:reduce){.enter-workshop{animation:none}}
</style>

@code {
    [Parameter] public EventCallback OnEntryRequested { get; set; }

    private Task EnterWorkshop() => OnEntryRequested.InvokeAsync();
}