@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using TheSingularityWorkshop.Services
@using TheSingularityWorkshop.Workshop.Composition
@using TheSingularityWorkshop.Workshop.Gui
@inject IJSRuntime JS
@inject WorkshopExperienceService Experience

@BuildPanel()

@code {
    /// <summary>
    /// Optional host-owned task/context to include in the clipboard exchange.
    /// This component never contacts an LLM or provider.
    /// </summary>
    [Parameter] public string? ContextPayload { get; set; }

    /// <summary>
    /// Receives clipboard text for host-side parsing, validation, and review.
    /// The terminal itself never treats model output as executable authority.
    /// </summary>
    [Parameter] public EventCallback<string> OnResponseImported { get; set; }

    private string _status = "READY";
    private string _responsePreview = string.Empty;
    private bool _awaitingResponse;
    private bool _hasContext => Exchange?.Protocol is not null && Exchange?.Grammar is not null;

    protected override async Task OnInitializedAsync()
    {
        if (!Experience.IsInitialized)
            await Experience.InitializeAsync();
    }

    private AiExchangeCompositionBundle? Exchange =>
        Experience.AiExchangeComposition;

    private RenderFragment BuildPanel()
    {
        var exchange = Exchange;
        var exchangeText = BuildExchangeText(exchange);

        return WorkshopGui.Panel(this)
            .Heading("PROTOCOLAI TERMINAL", 2)
            .Paragraph("Copy the semantic exchange into the LLM of your choice. Copy its response back to your clipboard, then import it here. This terminal does not call an LLM.")
            .Content(
                WorkshopGui.Element(this, "div")
                    .Class("ai-exchange-grid")
                    .Child(BuildReadonlyBlock("Protocol", exchange?.Protocol?.Describe() ?? "Waiting for composition..."))
                    .Child(BuildReadonlyBlock("Grammar", exchange?.Grammar?.Describe() ?? "Waiting for composition...")))
            .Content(
                WorkshopGui.Element(this, "div")
                    .Class("ai-terminal-actions")
                    .Child(
                        WorkshopGui.Button(this)
                            .Text("Copy to Clipboard")
                            .Class(_hasContext ? "ai-terminal-button ai-breathing" : "ai-terminal-button")
                            .OnClick(() => CopyToClipboardAsync(exchangeText)))
                    .Child(
                        WorkshopGui.Button(this)
                            .Text("Paste from Clipboard")
                            .Class(_awaitingResponse ? "ai-terminal-button ai-breathing" : "ai-terminal-button")
                            .OnClick(ImportFromClipboardAsync)))
            .Content(
                WorkshopGui.Element(this, "section")
                    .Class("ai-response-panel")
                    .Child(WorkshopGui.Element(this, "strong").Text("Clipboard response / read-only preview"))
                    .Child(
                        WorkshopGui.Element(this, "textarea")
                            .Attribute("id", "ai-llm-response")
                            .Attribute("rows", 8)
                            .Attribute("placeholder", "Use Paste from Clipboard to stage the response here...")
                            .Attribute("value", _responsePreview)
                            .Attribute("readonly", true)
                            .Attribute("aria-label", "Imported LLM response preview")
                            .Class("ai-response-preview")))
            .Paragraph($"STATUS // {_status}")
            .Build();
    }

    private ElementBuilder BuildReadonlyBlock(string label, string value) =>
        WorkshopGui.Element(this, "section")
            .Class("ai-exchange-block")
            .Child(WorkshopGui.Element(this, "strong").Text(label))
            .Child(WorkshopGui.Element(this, "pre").Class("ai-exchange-value").Text(value));

    private string BuildExchangeText(AiExchangeCompositionBundle? exchange)
    {
        var parts = new List<string>
        {
            "WORKSHOP PROTOCOLAI TERMINAL EXCHANGE",
            "The response is a proposal only. Do not invent IDs or claim validation.",
            "PROTOCOL",
            exchange?.Protocol?.Describe() ?? "Protocol vocabulary is not composed.",
            "GRAMMAR",
            exchange?.Grammar?.Describe() ?? "Grammar definition is not composed."
        };

        if (!string.IsNullOrWhiteSpace(ContextPayload))
        {
            parts.Add("HOST CONTEXT / TASK");
            parts.Add(ContextPayload.Trim());
        }

        parts.Add("RESPONSE CONTRACT");
        parts.Add("Return a structured proposal matching the host task's requested format. Preserve stable IDs where supplied. Explain conflicts instead of silently guessing. The host will validate and review the response before applying changes.");
        return string.Join(Environment.NewLine + Environment.NewLine, parts);
    }

    private async Task CopyToClipboardAsync(string exchangeText)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", exchangeText);
            _awaitingResponse = true;
            _status = "CONTEXT COPIED — PASTE INTO YOUR CHOSEN LLM";
        }
        catch (JSException)
        {
            _awaitingResponse = false;
            _status = "CLIPBOARD COPY FAILED — CHECK BROWSER PERMISSION";
        }

        StateHasChanged();
    }

    private async Task ImportFromClipboardAsync()
    {
        try
        {
            var response = await JS.InvokeAsync<string>("navigator.clipboard.readText");
            if (string.IsNullOrWhiteSpace(response))
            {
                _status = "CLIPBOARD IS EMPTY";
                StateHasChanged();
                return;
            }

            _responsePreview = response;
            _awaitingResponse = false;
            if (OnResponseImported.HasDelegate)
            {
                await OnResponseImported.InvokeAsync(response);
                _status = "RESPONSE STAGED — VALIDATION AND ACTUATION NOT YET IMPLEMENTED";
            }
            else
            {
                _status = "RESPONSE READ — NO HOST PROCESSOR ATTACHED; NO ACTUATION OCCURRED";
            }
        }
        catch (JSException)
        {
            _status = "CLIPBOARD READ FAILED — CHECK BROWSER PERMISSION";
        }

        StateHasChanged();
    }
}

<style>
    .ai-exchange-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,18rem),1fr));gap:1rem;margin:1rem 0}
    .ai-exchange-block{min-width:0;padding:.9rem;border:1px solid rgba(0,234,255,.18);background:rgba(0,10,20,.55)}
    .ai-exchange-block strong{display:block;margin-bottom:.6rem;color:#00eaff;font:700 .75rem Consolas,'Courier New',monospace;letter-spacing:.12em;text-transform:uppercase}
    .ai-exchange-value{max-height:18rem;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;margin:0;color:#b9d4de;font:.78rem/1.55 Consolas,'Courier New',monospace}
    .ai-response-panel{min-width:0;margin:1rem 0;padding:.9rem;border:1px solid rgba(255,44,255,.24);background:rgba(15,5,22,.4)}
    .ai-response-panel strong{display:block;margin-bottom:.6rem;color:#ff8cff;font:700 .75rem Consolas,'Courier New',monospace;letter-spacing:.1em;text-transform:uppercase}
    .ai-response-preview{display:block;width:100%;box-sizing:border-box;min-height:10rem;max-height:24rem;overflow:auto;resize:vertical;padding:.8rem;border:1px solid rgba(0,234,255,.22);background:rgba(0,0,0,.35);color:#edfaff;font:.8rem/1.55 Consolas,'Courier New',monospace;white-space:pre-wrap;overflow-wrap:anywhere}
    .ai-terminal-actions{display:flex;flex-wrap:wrap;align-items:center;gap:1rem;margin:1rem 0}
    .ai-terminal-button{min-height:3rem;padding:.8rem 1.2rem;border:1px solid rgba(0,234,255,.65);border-radius:.25rem;background:rgba(0,234,255,.07);color:#eafcff;font:700 .9rem Consolas,'Courier New',monospace;letter-spacing:.04em;cursor:pointer}
    .ai-terminal-button:hover{border-color:#ff2cff;box-shadow:0 0 16px rgba(255,44,255,.22)}
    .ai-terminal-button.ai-breathing{animation:aiTerminalBreathing 2.2s ease-in-out infinite}
    @@keyframes aiTerminalBreathing{0%,100%{box-shadow:0 0 0 rgba(0,234,255,0);border-color:rgba(0,234,255,.55)}50%{box-shadow:0 0 18px rgba(0,234,255,.28);border-color:rgba(0,234,255,1)}}
    @@media(prefers-reduced-motion:reduce){.ai-terminal-button.ai-breathing{animation:none;box-shadow:0 0 12px rgba(0,234,255,.2)}}
</style>
