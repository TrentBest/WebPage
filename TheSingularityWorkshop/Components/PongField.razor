@using System.Timers
@using TheSingularityWorkshop.FSM_API

@if (_visible)
{
    <div class="pong-field" role="application" aria-label="FSM powered Pong simulation">
        <div class="pong-header">
            <span>FSM_API // PONG SIMULATION</span>
            <span>DRAG THE PADDLE</span>
        </div>

        <button class="pong-paddle pong-player-one" style="top: @GetPaddleTop(true)%" aria-label="Paddle" @onpointerdown="BeginDrag" @onpointermove="DragPaddle" @onpointerup="EndDrag" @onpointercancel="EndDrag">PADDLE</button>
        <button class="pong-paddle pong-player-two" style="top: @GetPaddleTop(false)%" aria-label="Paddle">PADDLE</button>
        <button class="pong-ball" style="left: @_context.BallX%; top: @_context.BallY%;" aria-label="Ball"></button>

        <div class="pong-status">
            <span>STATE: @_state</span>
            <span>FSM TICKS: @_ticks</span>
        </div>
    </div>
}

<style>
    .pong-field { position: fixed; inset: 0; z-index: 99999; overflow: hidden; background: radial-gradient(circle at 50% 50%, rgba(0,234,255,.035), transparent 35%), #020711; color: #dffcff; font-family: Consolas, 'Courier New', monospace; border: 1px solid rgba(0,234,255,.18); box-sizing: border-box; }
    .pong-field::before { content: ""; position: absolute; inset: 4%; border: 1px dashed rgba(0,234,255,.13); pointer-events: none; }
    .pong-field::after { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; border-left: 1px dashed rgba(255,44,255,.22); pointer-events: none; }
    .pong-header, .pong-status { position: absolute; left: 2rem; right: 2rem; display: flex; justify-content: space-between; gap: 1rem; z-index: 2; font-size: clamp(.62rem,.9vw,.82rem); letter-spacing: .12em; text-transform: uppercase; }
    .pong-header { top: 1.25rem; color: #00eaff; }
    .pong-status { bottom: 1.25rem; color: rgba(255,44,255,.72); }
    .pong-paddle, .pong-ball { position: absolute; z-index: 3; padding: 0; color: inherit; font: inherit; box-sizing: border-box; }
    .pong-paddle { width: clamp(4.5rem,7vw,7rem); height: clamp(7rem,18vh,10rem); transform: translateY(-50%); background: rgba(0,234,255,.025); border: 2px solid #00eaff; box-shadow: 0 0 14px rgba(0,234,255,.35), inset 0 0 14px rgba(0,234,255,.04); color: #00eaff; font-weight: 700; letter-spacing: .08em; cursor: grab; touch-action: none; user-select: none; }
    .pong-paddle:active { cursor: grabbing; }
    .pong-player-one { left: 6%; }
    .pong-player-two { right: 6%; border-color: #ff2cff; color: #ff2cff; box-shadow: 0 0 14px rgba(255,44,255,.35), inset 0 0 14px rgba(255,44,255,.04); }
    .pong-ball { width: clamp(12px,1vw,18px); height: clamp(12px,1vw,18px); transform: translate(-50%,-50%); border: 1px solid #fff; background: #fff; box-shadow: 0 0 10px #00eaff, 0 0 18px rgba(255,44,255,.55); pointer-events: none; }
    @@media (max-width:700px) { .pong-header,.pong-status { left:.75rem; right:.75rem; flex-direction:column; gap:.2rem; } .pong-header { top:.75rem; } .pong-status { bottom:.75rem; } .pong-paddle { width:3.5rem; height:6rem; font-size:.65rem; } }
</style>

@code {
    private const string ProcessingGroup = "WorkshopPong";
    private const string DefinitionName = "WorkshopPongFSM";

    private sealed class PongContext : IStateContext
    {
        public string Name { get; set; } = "WorkshopPong";
        public bool IsValid { get; set; } = true;
        public bool ManifestRequested { get; set; }
        public bool StopRequested { get; set; }
        public bool PaddleDragging { get; set; }
        public double PaddleY { get; set; } = 50;
        public double BallX { get; set; } = 50;
        public double BallY { get; set; } = 50;
        public double BallVX { get; set; } = .72;
        public double BallVY { get; set; } = .48;
        public int Ticks { get; set; }
    }

    private readonly PongContext _context = new();
    private FSMHandle? _fsm;
    private Timer? _timer;
    private bool _visible;
    private bool _disposed;
    private bool _started;
    private string _state = "DORMANT";
    private int _ticks;

    protected override void OnInitialized() => BuildFsm();

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        _timer = new Timer(50) { AutoReset = true };
        _timer.Elapsed += Tick;
        _timer.Start();
        _started = true;
    }

    private void BuildFsm()
    {
        if (!FSM_API.Interaction.Exists(DefinitionName, ProcessingGroup))
        {
            FSM_API.Create.CreateProcessingGroup(ProcessingGroup);
            FSM_API.Create.CreateFiniteStateMachine(DefinitionName, -1, ProcessingGroup)
                .State("Dormant", null, OnDormant, null)
                .State("Manifesting", OnManifesting, OnManifestingUpdate, null)
                .State("Playing", OnEnterPlaying, OnPlaying, null)
                .State("Stopped", OnEnterStopped, null, null)
                .Transition("Dormant", "Manifesting", c => ((PongContext)c).ManifestRequested)
                .Transition("Manifesting", "Playing", c => true)
                .Transition("Playing", "Stopped", c => ((PongContext)c).StopRequested)
                .BuildDefinition();
        }
        _fsm = FSM_API.Create.CreateInstance(DefinitionName, _context, ProcessingGroup);
    }

    private void Tick(object? sender, ElapsedEventArgs e)
    {
        if (_disposed || !_started) return;
        if (!_visible)
        {
            _context.Ticks++;
            if (_context.Ticks >= 200) _context.ManifestRequested = true;
        }
        FSM_API.Interaction.Update(ProcessingGroup);
        _ticks = _context.Ticks;
        _state = _fsm?.CurrentState ?? "DORMANT";
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnDormant(IStateContext context) => _state = "DORMANT";
    private void OnManifesting(IStateContext context) { _visible = true; _state = "MANIFESTING"; }
    private void OnManifestingUpdate(IStateContext context) => _visible = true;
    private void OnEnterPlaying(IStateContext context) { _visible = true; _state = "PLAYING"; }

    private void OnPlaying(IStateContext context)
    {
        var c = (PongContext)context;
        c.BallX += c.BallVX;
        c.BallY += c.BallVY;
        if (c.BallY <= 5 || c.BallY >= 95) c.BallVY *= -1;
        if (c.BallX <= 9 || c.BallX >= 91) c.BallVX *= -1;
        _state = "PLAYING";
    }

    private void OnEnterStopped(IStateContext context) { _visible = false; _state = "STOPPED"; }

    private double GetPaddleTop(bool left) => left ? Math.Clamp(_context.PaddleY, 14, 86) : Math.Clamp(100 - _context.BallY, 14, 86);

    private void BeginDrag(PointerEventArgs e)
    {
        if (_disposed || !_visible) return;
        _context.PaddleDragging = true;
        UpdatePaddleFromPointer(e.ClientY);
    }

    private void DragPaddle(PointerEventArgs e)
    {
        if (_disposed || !_context.PaddleDragging) return;
        UpdatePaddleFromPointer(e.ClientY);
    }

    private void EndDrag(PointerEventArgs e) => _context.PaddleDragging = false;

    private void UpdatePaddleFromPointer(double clientY)
    {
        var viewportHeight = Math.Max(1, BrowserViewportHeight);
        _context.PaddleY = Math.Clamp(clientY / viewportHeight * 100.0, 14, 86);
    }

    private double BrowserViewportHeight { get; set; } = 900;

    public void Dispose()
    {
        _disposed = true;
        _context.IsValid = false;
        _timer?.Stop();
        _timer?.Dispose();
    }
}
